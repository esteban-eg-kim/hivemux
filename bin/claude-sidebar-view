#!/usr/bin/python3
"""tmux 왼쪽 사이드바: 모든 세션의 Claude 상태판.

bin/claude-sidebar 가 각 창 왼쪽 칸에서 실행한다.
- 프로젝트(세션)별로 묶어 작업마다 두 줄 타일로 표시
- 지금 보고 있는 작업은 흰 타일 + ▶
- 클릭하거나 숫자 1-9 를 누르면 그 작업으로 이동, q 또는 Esc 는 원래 칸으로
"""
import math, os, re, socket, select, signal, subprocess, sys, termios, time, tty, unicodedata

TMUX = "/opt/homebrew/bin/tmux"
ME = os.environ.get("TMUX_PANE", "")
PAUSE = f"/tmp/claude-sidebar-pause-{os.getuid()}"
US = "\x1f"
FIELDS = ["pane_id", "session_name", "window_index", "window_name", "@claude_state",
          "@claude_state_at", "@claude_session", "window_id", "pane_active", "pane_last",
          "window_active", "session_attached", "pane_title", "@claude_title", "@claude_name"]

def width(s):
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def fit(s, w):
    out = ""
    for c in s:
        if width(out + c) > w:
            out = out[:-1] + "…" if out else ""
            return out + " " * max(0, w - width(out))
        out += c
    return out + " " * (w - width(out))


def tmux(*a):
    return subprocess.run([TMUX, *a], capture_output=True, text=True).stdout


def age(at, now):
    try:
        s = max(0, now - int(at))
    except ValueError:
        return ""
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m"
    return f"{s // 3600}h{(s % 3600) // 60:02d}"



# ── 디자인 토큰 (24비트 색) ──────────────────────────────────────────
C = {
    "bg":      (22, 24, 29),     # 사이드바 바탕
    "card":    (30, 33, 40),     # 카드
    "card_hi": (42, 47, 58),     # 선택된 카드
    "rule":    (44, 48, 57),     # 구분선
    "text":    (230, 233, 239),  # 본문
    "text2":   (154, 163, 178),  # 보조
    "text3":   (98, 106, 120),   # 흐림
    "run":     (90, 169, 255),
    "run_hi":  (170, 215, 255),
    "glow":    (52, 104, 168),   # 작업 중 빛 띠
    "wait":    (245, 165, 36),
    "wait_bg": (52, 40, 18),
    "wait_hi": (78, 58, 20),
    "done":    (62, 207, 142),
    "idle":    (92, 99, 112),
}
STATE_TEXT = {"wait": "입력 필요", "run": "작업 중", "done": "완료", "idle": "대기"}
STATE_ICON = {"wait": "●", "run": "◐", "done": "✓", "idle": "○"}
# 프로젝트 점 색 (이름 해시로 고정)
PROJECT_HUES = [(167, 139, 250), (244, 114, 182), (45, 212, 191), (251, 146, 60),
                (96, 165, 250), (163, 230, 53), (250, 204, 21), (232, 121, 249)]

FRAME = 0
TICK = 0.08
SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
ANIM = True


def sgr(bg, fg, bold=False):
    return "\x1b[0;48;2;%d;%d;%d;38;2;%d;%d;%d%sm" % (*bg, *fg, ";1" if bold else "")


def mix(a, b, t):
    t = max(0.0, min(1.0, t))
    return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))


def hue_of(name):
    return PROJECT_HUES[sum(ord(c) for c in name) % len(PROJECT_HUES)]


def snapshot():
    fmt = US.join("#{%s}" % f for f in FIELDS)
    panes = [dict(zip(FIELDS, l.split(US))) for l in tmux("list-panes", "-a", "-F", fmt).splitlines()]
    panes = [p for p in panes if len(p) == len(FIELDS)]
    me = next((p for p in panes if p["pane_id"] == ME), None)
    if not me:
        return None
    mywin = [p for p in panes if p["window_id"] == me["window_id"] and p["pane_id"] != ME]
    act = next((p for p in mywin if p["pane_active"] == "1"), None) or \
        next((p for p in mywin if p["pane_last"] == "1"), None) or (mywin[0] if mywin else None)
    current = act["pane_id"] if act else ""
    visible = me["window_active"] == "1" and me["session_attached"] not in ("", "0")
    items = [p for p in panes if p["@claude_session"] and p["@claude_state"]]
    return items, current, visible, me["session_name"]



HOST_RE = re.compile(r"^[^@\s]+@[^:\s]+:")
LEAD_RE = re.compile(r"^[^\w가-힣]+")


def task_name(p):
    """작업 이름: 사이드바에서 바꾼 이름 > Claude가 보낸 터미널 제목 > -n 이름 > 창 이름."""
    if p.get("@claude_name"):
        return p["@claude_name"]
    t = LEAD_RE.sub("", p.get("pane_title", "")).strip()
    host = socket.gethostname()
    if t and not HOST_RE.match(p.get("pane_title", "")) and t not in (host, host.split(".")[0]) \
            and t.lower() not in ("claude code", "claude"):
        return t
    if p.get("@claude_title"):
        return p["@claude_title"]
    win = p["window_name"]
    return win if win not in ("claude", p["session_name"]) else "새 대화"


class Line:
    """한 줄을 (글자, 바탕, 글자색, 굵게) 칸 단위로 쌓아 폭 w에 맞춰 출력한다."""

    def __init__(self, w, bg):
        self.w, self.bg, self.cells = w, bg, []

    def used(self):
        return sum(width(c) for c, *_ in self.cells)

    def put(self, text, fg=None, bg=None, bold=False, limit=None):
        fg = fg or C["text3"]
        bg = bg or self.bg
        room = (limit if limit is not None else self.w) - self.used()
        if width(text) > room:
            text = fit(text, room)
        for ch in text:
            self.cells.append((ch, bg, fg, bold))
        return self

    def fill(self, to, bg=None):
        n = to - self.used()
        if n > 0:
            self.put(" " * n, C["text"], bg)
        return self

    def right(self, text, fg, bg=None, bold=False, margin=0):
        self.fill(self.w - margin - width(text), bg)
        return self.put(text, fg, bg, bold)

    def glow(self, start, end, pos, base, color, radius=3.2):
        """start~end 열 바탕에 pos 중심의 부드러운 빛을 섞는다."""
        out, col = [], 0
        for ch, bg, fg, b in self.cells:
            if start <= col < end and bg == base:
                d = (col - pos) / radius
                bg = mix(base, color, 2.718 ** (-d * d))
            out.append((ch, bg, fg, b))
            col += width(ch)
        self.cells = out
        return self

    def render(self):
        self.fill(self.w)
        out, cur = [], None
        for ch, bg, fg, b in self.cells:
            k = (bg, fg, b)
            if k != cur:
                out.append(sgr(bg, fg, b))
                cur = k
            out.append(ch)
        return "".join(out)


def render(items, current, w, h, cur_sess=""):
    now = int(time.time())
    BG = C["bg"]
    L = lambda: Line(w, BG)
    lines, targets = [], {}
    n_wait = sum(1 for p in items if p["@claude_state"] == "wait")
    n_run = sum(1 for p in items if p["@claude_state"] == "run")

    # 머리: 제목 + 개수
    hd = L().put("  Claude", C["text"], bold=True).put("  세션", C["text3"])
    hd.right(f" {len(items)} ", C["text"], C["card_hi"], True, margin=2)
    lines += [L(), hd, L()]
    summary = L().put("  ")
    if n_run:
        summary.put(f"◐ {n_run} 작업 중", C["run"]).put("   ")
    if n_wait:
        summary.put(f"● {n_wait} 입력 필요", C["wait"], bold=True)
    if not n_run and not n_wait and items:
        summary.put("모두 대기 중", C["text3"])
    lines += [summary, L().put("  " + "─" * (w - 4), C["rule"])]

    groups = []
    for i, p in enumerate(items, 1):
        if not groups or groups[-1][0] != p["session_name"]:
            groups.append((p["session_name"], []))
        groups[-1][1].append((i, p))

    def build(compact, gaps):
        out, tg = [], {}
        for sess, members in groups:
            out.append(L())
            cur = sess == cur_sess
            g = L().put("  ").put("●", hue_of(sess)).put(" ")
            g.put(sess, C["text"] if cur else C["text2"], bold=cur, limit=w - 5)
            g.right(str(len(members)), C["text3"], margin=2)
            out.append(g)
            for mi, (i, p) in enumerate(members):
                if gaps and mi:
                    out.append(L())
                st = p["@claude_state"] if p["@claude_state"] in STATE_TEXT else "idle"
                sel = p["pane_id"] == current
                card = C["card_hi"] if sel else C["card"]
                bar = C[st]
                icon = STATE_ICON[st]
                f = FRAME
                if st == "wait":
                    card = mix(C["wait_bg"], C["wait_hi"], (0.5 + 0.5 * math.sin(f * 0.18))) if ANIM else C["wait_bg"]
                if st == "run" and ANIM:
                    icon = SPIN[(f // 1) % len(SPIN)]
                    bar = mix(C["run"], C["run_hi"], 0.5 + 0.5 * math.sin(f * 0.25))
                t = age(p["@claude_state_at"], now) if st != "idle" else ""
                key = f"⌥{i}" if i <= 9 else ""
                name = task_name(p)
                bar_ch = "▌" if sel else "▎"
                x0, x1 = 2, w - 1          # 카드 가로 범위 (좌 여백 2, 우 여백 1)

                def card_line():
                    return L().put("  ").put(bar_ch, bar, card)

                rows = []
                if compact:
                    r = card_line().put(" ", C["text"], card)
                    r.put(name, C["text"], card, bold=sel or st == "wait", limit=x1 - 7)
                    r.fill(x1 - 6, card).right(f"{icon} {t}".rstrip(), bar if st != "idle" else C["text3"], card, margin=2).fill(x1, card)
                    rows.append(r)
                else:
                    r1 = card_line().put(" ", C["text"], card)
                    r1.put(name, C["text"] if st != "idle" or sel else C["text2"], card, bold=True, limit=x1 - 5)
                    r1.right(key, C["text"] if sel else C["text3"], card, margin=2).fill(x1, card)
                    r2 = card_line().put(" ", C["text"], card)
                    r2.put(f"{icon} {STATE_TEXT[st]}", bar if st != "idle" else C["text3"], card, bold=st == "wait")
                    r2.right(t, C["text2"] if st != "wait" else C["wait"], card, margin=2).fill(x1, card)
                    rows += [r1, r2]
                if st == "run" and ANIM:
                    span = x1 - x0
                    pos = x0 + (f * 0.9) % (span + 12) - 6
                    for r in rows:
                        r.glow(x0 + 1, x1, pos, card, C["glow"])
                for r in rows:
                    tg[len(out)] = p["pane_id"]
                    out.append(r)
        return out, tg

    reserve = len(lines) + 4
    for compact, gaps in ((False, True), (False, False), (True, False)):
        body, tg = build(compact, gaps)
        if reserve + len(body) <= h:
            break
    if not items:
        body = [L(), L().put("  실행 중인 Claude가 없습니다", C["text2"]), L(),
                L().put("  ", C["text3"]).put("Ctrl+A ⇧C", C["text"]).put("  새 Claude", C["text3"]),
                L().put("  ", C["text3"]).put("tp 폴더", C["text"]).put("    프로젝트 열기", C["text3"])]
        tg = {}
    base = len(lines)
    lines += body
    targets = {base + k: v for k, v in tg.items()}
    lines = lines[:h - 3]
    while len(lines) < h - 3:
        lines.append(L())
    lines.append(L().put("  " + "─" * (w - 4), C["rule"]))
    k = L().put("  ")
    if n_wait:
        k.put(" ⌥0 ", C["bg"], C["wait"], True).put("  기다리는 작업으로", C["wait"])
    else:
        k.put(" ⌥0 ", C["text"], C["card_hi"], True).put("  기다리는 작업", C["text3"])
    lines.append(k)
    lines.append(L().put("  ").put(" ⌥1-9 ", C["text"], C["card_hi"], True).put("  이동 · 우클릭 이름", C["text3"]))
    return [l.render() for l in lines], targets


def rename(pid):
    sess = tmux("display", "-p", "-t", ME, "#{session_name}").strip()
    client = (tmux("list-clients", "-t", f"={sess}", "-F", "#{client_name}").split() or [""])[0]
    tmux("run-shell", "-b", os.path.join(os.path.dirname(os.path.abspath(__file__)), "claude-rename") + f" prompt {pid} '{client}'")


def goto(pid):
    sess = tmux("display", "-p", "-t", pid, "#{session_name}").strip()
    win = tmux("display", "-p", "-t", pid, "#{window_id}").strip()
    if not sess:
        return
    tmux("switch-client", "-t", f"={sess}")
    tmux("select-window", "-t", win)
    tmux("select-pane", "-t", pid)



def main():
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    out = sys.stdout
    out.write("\x1b[?1049h\x1b[?25l\x1b[?7l\x1b[?1000h\x1b[?1006h")
    out.flush()
    resized = [True]
    signal.signal(signal.SIGWINCH, lambda *_: resized.__setitem__(0, True))
    global FRAME, ANIM
    targets, buf = {}, ""
    snap, last_poll, last_spin = None, 0.0, None
    try:
        while True:
            nowf = time.time()
            if snap is None or nowf - last_poll >= 1.0:
                snap = snapshot()
                last_poll = nowf
                if snap is None:
                    break
                ANIM = tmux("show", "-gqv", "@sidebar-anim").strip() != "off"
            items, current, visible, cur_sess = snap
            if os.path.exists(PAUSE):          # 이름 바꾸기 팝업이 열려 있음: 그리지 않는다
                r, _, _ = select.select([fd], [], [], 0.2)
                if r:
                    os.read(fd, 1024)
                continue
            animating = visible and ANIM and any(p["@claude_state"] in ("run", "wait") for p in items)
            FRAME += 1
            if visible:
                # 맨 위 창 목록의 작업 중 스피너 (보이는 사이드바 하나가 맡는다)
                spin = SPIN[(FRAME // 2) % len(SPIN)] if animating and any(p["@claude_state"] == "run" for p in items) else ""
                if spin != last_spin and (FRAME % 2 == 0 or not spin):
                    if spin:
                        tmux("set", "-g", "@claude_spin", spin)
                    else:
                        tmux("set", "-gu", "@claude_spin")
                    tmux("refresh-client", "-S")
                    last_spin = spin
                for p in items:  # 보고 있는 완료 작업은 "봤음"
                    if p["pane_id"] == current and p["@claude_state"] == "done":
                        tmux("set", "-p", "-t", current, "@claude_state", "idle")
                        tmux("set", "-w", "-t", current, "@claude_state", "idle")
                        p["@claude_state"] = "idle"
                w, h = os.get_terminal_size()
                lines, targets = render(items, current, w, h, cur_sess)
                out.write("\x1b[H" + "\r\n".join(lines) + "\x1b[0m")
                out.flush()
            r, _, _ = select.select([fd], [], [], TICK if animating else (1.0 if visible else 3.0))
            if not r:
                continue
            last_poll = 0  # 클릭/키 입력 뒤에는 바로 새로 읽는다
            buf += os.read(fd, 1024).decode(errors="ignore")
            for m in re.finditer(r"\x1b\[<(\d+);(\d+);(\d+)([Mm])", buf):
                b, y, kind = int(m.group(1)), int(m.group(3)), m.group(4)
                if kind != "M" or (y - 1) not in targets:
                    continue
                pid = targets[y - 1]
                if b == 2:                      # 오른쪽 클릭: 이름 바꾸기
                    rename(pid)
                elif b == 0:
                    # 더블클릭: 첫 클릭이 다른 세션으로 이동시키므로 기록은 tmux 전역 옵션에 둔다
                    last = tmux("show", "-gqv", "@sidebar_lastclick").split()
                    t = time.time()
                    tmux("set", "-g", "@sidebar_lastclick", f"{pid} {t:.3f}")
                    if len(last) == 2 and last[0] == pid and t - float(last[1]) < 0.45:
                        tmux("set", "-gu", "@sidebar_lastclick")
                        rename(pid)
                    else:
                        goto(pid)
            # 클릭하면 tmux가 초점을 사이드바로 옮긴다. 이 창의 작업 칸으로 돌려놓는다
            # (안 그러면 초점이 사이드바에 남은 채 저장/복원되고 창 이름도 Python이 된다)
            if re.search(r"\x1b\[<\d+;\d+;\d+M", buf) and current:
                tmux("select-pane", "-t", current)
            buf = re.sub(r"\x1b\[<\d+;\d+;\d+[Mm]", "", buf)
            for ch in buf:
                if ch.isdigit() and ch != "0":
                    tmux("run-shell", "-b", os.path.join(os.path.dirname(__file__), "claude-agents") + f" jump {ch}")
                elif ch in ("q", "\x1b"):
                    tmux("select-pane", "-t", "{last}")
            buf = ""
    finally:
        out.write("\x1b[?1000l\x1b[?1006l\x1b[?7h\x1b[?25h\x1b[?1049l\x1b[0m")
        out.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


if __name__ == "__main__":
    if len(sys.argv) == 3 and sys.argv[1] == "--name":
        fmt = US.join("#{%s}" % f for f in FIELDS)
        line = tmux("display", "-p", "-t", sys.argv[2], fmt).strip("\n")
        p = dict(zip(FIELDS, line.split(US)))
        print(task_name(p) if len(p) == len(FIELDS) else "")
        sys.exit(0)
    try:
        main()
    except KeyboardInterrupt:
        pass
