WAKE_R, WAKE_W = os.pipe()          # SIGUSR1 -> wakes select() via this pipe / SIGUSR1 -> 이 파이프로 select() 를 깨운다
os.set_blocking(WAKE_R, False)
os.set_blocking(WAKE_W, False)
US = "\x1f"
FIELDS = ["pane_id", "session_name", "window_index", "window_name", "@claude_state",
          "@claude_state_at", "@claude_session", "window_id", "pane_active", "pane_last",
          "window_active", "session_attached", "pane_title", "@claude_title", "@claude_name", "pane_current_command",
          "@hivemux-closing", "@claude_wait", "@claude_touched", "@claude_bg", "@claude_offwork", "pane_index"]
# a shell in front means Claude has quit there (its SessionEnd hook comes a second or two later, or never)
# 칸 앞에 셸이 있으면 그 Claude 는 끝났다 (SessionEnd 훅은 1~2초 늦게 오거나 안 온다)
SHELLS = {"zsh", "bash", "fish", "sh", "dash", "tcsh", "ksh", "login"}

@functools.lru_cache(maxsize=4096)
def cwidth(c):
    """Cell width of one character (cached) / 글자 하나의 칸 폭 (캐시)"""
    return 0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1


def width(s):
    return sum(cwidth(c) for c in s)


def fit(s, w):
    out = ""
    for c in s:
        if width(out + c) > w:
            out = out[:-1] + "…" if out else ""
            return out + " " * max(0, w - width(out))
        out += c
    return out + " " * (w - width(out))


def tmux(*a):
    return subprocess.run([TMUX, *a], capture_output=True, text=True).stdout


def age(at, now):
    try:
        s = max(0, now - int(at))
    except ValueError:
        return ""
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m"
    return f"{s // 3600}h{(s % 3600) // 60:02d}"



