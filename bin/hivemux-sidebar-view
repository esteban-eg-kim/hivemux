}
STATE_TEXT = {"wait": tr("입력 필요", "needs input"), "run": tr("작업 중", "running"), "done": tr("완료", "done"), "idle": tr("대기", "idle"),
              "home": tr("퇴근 · 오른쪽 클릭으로 출근", "home · right-click to clock in")}
STATE_ICON = {"wait": "●", "run": "◐", "done": "✓", "idle": "○", "home": "☾"}
# why a pane waits (@claude_wait from bin/hivemux-hook: "<kind>\t<tool>\t<text>") / 칸이 기다리는 이유
WHY_TEXT = {"approve": tr("승인", "approve"), "plan": tr("계획 승인", "plan"), "ask": tr("질문", "question"),
            "input": tr("입력", "input"), "error": tr("오류", "error")}


def state_line(p, st):
    """The card's second line: the state, with why it waits (and the line about it: a command's description,
    a file, the question) or how many files a finished turn changed
    카드 둘째 줄: 상태, 그리고 기다리는 이유 (와 그 한 줄: 명령 설명, 파일, 질문) 또는 끝난 턴이 고친 파일 수"""
    if p.get("@claude_offwork") and st in ("run", "wait"):   # clocked out, works on until done / 퇴근했지만 끝날 때까지 일한다
        return state_line(dict(p, **{"@claude_offwork": ""}), st) + tr(" · 야근 후 퇴근", " · overtime")
    if st == "wait" and p.get("@claude_wait"):
        kind, tool, text = (p["@claude_wait"].split("\t") + ["", "", ""])[:3]
        if kind in WHY_TEXT:
            if tool in ("Edit", "Write", "MultiEdit", "NotebookEdit"):
                text = os.path.basename(text)
            return f"{WHY_TEXT[kind]} · {text}" if text else WHY_TEXT[kind]
    bg = [int(x) for x in p.get("@claude_bg", "").split() if x.isdigit()] + [0, 0]
    if st == "run" and (bg[0] or bg[1]):
        # the turn ended, its background agents or shells work on / 턴은 끝났고 배경 에이전트나 셸이 일한다
        a, sh = bg[0], bg[1]
        if a and sh:
            return tr(f"에이전트 {a}개 · 셸 {sh}개 실행 중", f"{a} agent{'s' if a > 1 else ''}, {sh} shell{'s' if sh > 1 else ''} running")
        if a:
            return tr(f"에이전트 {a}개 실행 중", f"{a} agent" + ("s" if a > 1 else "") + " running")
        return tr(f"셸 {sh}개 기다리는 중", f"waiting on {sh} shell" + ("s" if sh > 1 else ""))
    if st == "done":
        n = len([f for f in p.get("@claude_touched", "").split("\t") if f])
        if n:
            return STATE_TEXT[st] + tr(f" · 파일 {n}개", f" · {n} file" + ("s" if n > 1 else ""))
    return STATE_TEXT[st]
# Project dot colors (fixed by a hash of the name)
