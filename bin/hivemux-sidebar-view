#!/usr/bin/env python3
"""Left tmux sidebar: Claude status board for every session.
tmux 왼쪽 사이드바: 모든 세션의 Claude 상태판.

Run by bin/hivemux-sidebar in the left pane of each window.
bin/hivemux-sidebar 가 각 창 왼쪽 칸에서 실행한다.
- one card per task, grouped by project (tmux session)
  프로젝트(세션)별로 묶어 작업마다 카드로 표시
- the task you are looking at is highlighted with ▶
  지금 보고 있는 작업은 밝은 카드 + ▶
- click or press 1-9 to jump; double/right click to rename; q or Esc returns focus
  클릭하거나 1-9 를 누르면 이동, 더블/오른쪽 클릭은 이름 바꾸기, q 나 Esc 는 원래 칸으로
"""
import functools, math, os, re, shlex, socket, select, shutil, signal, subprocess, sys, termios, time, tty, unicodedata

# Ignore the redraw signal (SIGUSR1) first, so it cannot kill us before the handler is installed
# 바로 다시 그리기 신호(SIGUSR1)를 처리기 등록 전에 받아도 종료되지 않게 먼저 무시한다
signal.signal(signal.SIGUSR1, signal.SIG_IGN)

TMUX = shutil.which("tmux") or "/opt/homebrew/bin/tmux"


def _is_ko():
    """UI language: HIVEMUX_LANG > tmux @hivemux-lang (set by hivemux setup) > LANG / 화면 언어: HIVEMUX_LANG > tmux @hivemux-lang (hivemux setup 이 정함) > LANG"""
    v = os.environ.get("HIVEMUX_LANG") or subprocess.run([TMUX, "show", "-gqv", "@hivemux-lang"],
                                                          capture_output=True, text=True).stdout.strip()
    return (v or os.environ.get("LANG", "")).startswith("ko")


KO = _is_ko()


def tr(ko, en):
    return ko if KO else en
ME = os.environ.get("TMUX_PANE", "")
# a popup of this tmux server is open (bin/hivemux-rename, -open, -settings, hm --ask) / 이 tmux 서버의 팝업이 열려 있다
PAUSE = "/tmp/hivemux-pause-%d-%s" % (os.getuid(), subprocess.run([TMUX, "display", "-p", "#{pid}"], capture_output=True, text=True).stdout.strip())
