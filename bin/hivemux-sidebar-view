MENU = None
REMOTE_HERE = None  # a screen from another Mac looks at this window: that Mac's name, or "" / 다른 Mac 화면이 이 창을 봄: 그 Mac 이름 또는 ""
OFFICE_BTN = None   # (row, first column, end column) of the bee office button / 벌 사무실 버튼의 (줄, 첫 열, 끝 열)
SHIFT_BTN = None    # row of "clocked out · clock in" / "퇴근 중 · 출근하기" 줄
SHIFT_FILE = os.path.join(os.path.dirname(ORDER_FILE), "shift")
_shift = [None, False]


def clocked_out():
    """Clocked out (bin/hivemux-shift), read again only when the file changes / 퇴근 중인지. 파일이 바뀔 때만 다시 읽는다"""
    try:
        m = os.stat(SHIFT_FILE).st_mtime
    except OSError:
        return False
    if m != _shift[0]:
        try:
            with open(SHIFT_FILE) as f:
                _shift[:] = [m, f.read().split()[:1] == ["off"]]
        except OSError:
            _shift[:] = [m, False]
    return _shift[1]
OFFWORK_FILE = os.path.join(os.path.dirname(ORDER_FILE), "offwork.tsv")
_offwork = [None, []]


def offwork_rows():
    """offwork.tsv (bin/hivemux-shift): "<pane> <target> <session id> <cwd> <tmux pid> <bee>" per Claude clocked
    out, read again only when the file changes / 퇴근한 Claude 목록. 파일이 바뀔 때만 다시 읽는다"""
    try:
        m = os.stat(OFFWORK_FILE).st_mtime
    except OSError:
        return []
    if m != _offwork[0]:
        try:
            with open(OFFWORK_FILE, errors="replace") as f:
                _offwork[:] = [m, [r for r in (l.rstrip("\n").split("\t") for l in f) if len(r) == 6]]
        except OSError:
            _offwork[:] = [m, []]
    return _offwork[1]


_server = []


def home_cards(panes):
    """Claudes clocked out and home: their panes (a shell in front), as dimmed cards. A click does nothing
    (one landed on a card by mistake while picking a project); the right-click menu clocks in.
    The pane by its id while the same tmux runs; after a reboot by its place (as bin/hivemux-shift does)
    퇴근해서 집에 간 Claude: 그 칸 (앞에 셸) 을 흐린 카드로. 클릭해도 아무 일 없다 (프로젝트를 고르다 카드를 잘못
    눌렀다). 출근은 오른쪽 클릭 메뉴에서. 같은 tmux 가 도는 동안은 칸 id 로, 재부팅 뒤에는 자리로 (bin/hivemux-shift 와 같다)"""
    rows = offwork_rows()
    if not rows:
        return []
    if not _server:
        _server.append(tmux("display", "-p", "#{pid}").strip())
    by_id = {p["pane_id"]: p for p in panes}
    by_place = {f'{p["session_name"]}:{p["window_index"]}.{p["pane_index"]}': p for p in panes}
    out, seen = [], set()
    for pane, target, _sid, _cwd, srv, bee in rows:
        p = (by_id.get(pane) if srv == _server[0] else None) or by_place.get(target)
        if not p or p["pane_id"] in seen or p["pane_current_command"].lstrip("-") not in SHELLS:
            continue
        seen.add(p["pane_id"])
        name = bee.rsplit("/", 1)[-1] if bee != "-" else ""
        out.append(dict(p, **{"@claude_state": "home", "@claude_state_at": "",
                              "@claude_name": p["@claude_name"] or p["@claude_title"] or (name if name != "claude" else "")}))
    return out


PENDING = None      # menu action to run once the closed menu is off the screen / 닫힌 메뉴가 화면에서 지워진 뒤 실행할 동작


def sgr(bg, fg, bold=False):
    # bold may be (bold, colour): also underline the cell in that colour (a thin line under a card)
    # bold 가 (굵게, 색) 이면 그 색 밑줄도 긋는다 (카드 아래 가는 선)
    ul = ""
    if isinstance(bold, tuple):
        bold, c = bold
        ul = ";4;58;2;%d;%d;%d" % c
    return "\x1b[0;48;2;%d;%d;%d;38;2;%d;%d;%d%s%sm" % (*bg, *fg, ";1" if bold else "", ul)


def mix(a, b, t):
    t = max(0.0, min(1.0, t))
    return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))


def hue_of(name):
    return PROJECT_HUES[sum(ord(c) for c in name) % len(PROJECT_HUES)]


def snapshot():
    fmt = US.join("#{%s}" % f for f in FIELDS)
    panes = [dict(zip(FIELDS, l.split(US))) for l in tmux("list-panes", "-a", "-F", fmt).splitlines()]
    panes = [p for p in panes if len(p) == len(FIELDS)]
    me = next((p for p in panes if p["pane_id"] == ME), None)
    if not me:
        return None
    # a project about to close (bin/hivemux-close-project-ui) is left out before it goes, so no screen shows it
    # 곧 닫힐 프로젝트 (bin/hivemux-close-project-ui)는 닫히기 전에 빼서, 어느 화면에도 보이지 않게 한다
    closing = me["@hivemux-closing"]
    if closing:
        panes = [p for p in panes if p["session_name"] != closing or p["pane_id"] == ME]
    mywin = [p for p in panes if p["window_id"] == me["window_id"] and p["pane_id"] != ME]
    act = next((p for p in mywin if p["pane_active"] == "1"), None) or \
        next((p for p in mywin if p["pane_last"] == "1"), None) or (mywin[0] if mywin else None)
    current = act["pane_id"] if act else ""
    visible = me["window_active"] == "1" and me["session_attached"] not in ("", "0")
    items = [p for p in panes if p["@claude_session"] and p["@claude_state"]
             and p["pane_current_command"].lstrip("-") not in SHELLS]
    # project order from the session-order file (bin/hivemux-order), then tmux order (name, window index)
    # 프로젝트 순서는 session-order 파일(bin/hivemux-order), 그다음 tmux 순서(이름, 창 번호)
    rank = {}
    try:
        with open(ORDER_FILE) as f:
            for l in f:
                rank.setdefault(l.rstrip("\n"), len(rank))
    except OSError:
        pass
    items = [p for _, p in sorted(enumerate(items), key=lambda e: (rank.get(e[1]["session_name"], len(rank)), e[0]))]
    # every project (session), also one with no Claude left (only shells): (name, windows, a pane to go to)
    # 모든 프로젝트(세션). Claude 가 없고 셸만 남은 것도: (이름, 창 수, 이동할 칸)
    work = [p for p in panes if p["pane_title"] != "hivemux-sidebar" and p["window_name"] != "·"]
    names = list(dict.fromkeys(p["session_name"] for p in panes))
    names.sort(key=lambda s: rank.get(s, len(rank)))
    sessions = [(s, len({p["window_id"] for p in work if p["session_name"] == s}),
                 next((p["pane_id"] for p in work if p["session_name"] == s and p["pane_active"] == "1"), "")
                 or next((p["pane_id"] for p in work if p["session_name"] == s), "")) for s in names]
    return items, current, visible, me["session_name"], sessions, home_cards(panes)



HOST_RE = re.compile(r"^[^@\s]+@[^:\s]+:")
LEAD_RE = re.compile(r"^[^\w가-힣]+")


def task_name(p):
    """Task name: name set in the sidebar > terminal title sent by Claude > -n name > window name. / 작업 이름: 사이드바에서 바꾼 이름 > Claude가 보낸 터미널 제목 > -n 이름 > 창 이름."""
    if p.get("@claude_name"):
        return p["@claude_name"]
    t = LEAD_RE.sub("", p.get("pane_title", "")).strip()
    host = socket.gethostname()
    if t and not HOST_RE.match(p.get("pane_title", "")) and t not in (host, host.split(".")[0]) \
            and t.lower() not in ("claude code", "claude"):
        return t
    if p.get("@claude_title"):
        return p["@claude_title"]
    win = p["window_name"]
    return win if win not in ("claude", p["session_name"]) else tr("새 대화", "new chat")


class Line:
    """Build one line cell by cell (char, bg, fg, bold) and render it to width w. / 한 줄을 (글자, 바탕, 글자색, 굵게) 칸 단위로 쌓아 폭 w에 맞춰 출력한다."""

    def __init__(self, w, bg):
        self.w, self.bg, self.cells, self.n = w, bg, [], 0   # n: columns used so far / 지금까지 쓴 칸 수

    def used(self):
        return self.n

    def put(self, text, fg=None, bg=None, bold=False, limit=None):
        fg = fg or C["text3"]
        bg = bg or self.bg
        room = (limit if limit is not None else self.w) - self.used()
        if width(text) > room:
            text = fit(text, room)
        for ch in text:
            self.cells.append((ch, bg, fg, bold))
        self.n += width(text)
        return self

    def fill(self, to, bg=None):
        n = to - self.used()
        if n > 0:
            self.put(" " * n, C["text"], bg)
        return self

    def right(self, text, fg, bg=None, bold=False, margin=0):
        self.fill(self.w - margin - width(text), bg)
        return self.put(text, fg, bg, bold)

    def glow(self, start, end, pos, base, color, radius=3.2):
        """Blend a soft glow centered at pos into the background of columns start..end. / start~end 열 바탕에 pos 중심의 부드러운 빛을 섞는다."""
        out, col = [], 0
        for ch, bg, fg, b in self.cells:
            if start <= col < end and bg == base:
                d = (col - pos) / radius
                bg = mix(base, color, 2.718 ** (-d * d))
            out.append((ch, bg, fg, b))
            col += width(ch)
        self.cells = out
        return self

    def tint(self, bg=None, fg=None):
        """Recolor the whole line (drag feedback) / 줄 전체 색 바꾸기 (끌기 표시)"""
        self.fill(self.w)
        self.cells = [(ch, bg or b_, fg or f_, bo) for ch, b_, f_, bo in self.cells]
        return self

    def render(self):
        self.fill(self.w)
        out, cur = [], None
        for ch, bg, fg, b in self.cells:
            k = (bg, fg, b)
            if k != cur:
                out.append(sgr(bg, fg, b))
                cur = k
            out.append(ch)
        return "".join(out)


def pick(spans, row, x):
    """What is under mouse column x (1-based) on row: spans is {row: [(x0, x1, value)]}
    마우스 x 열(1부터) / row 줄 아래의 대상. spans 는 {줄: [(x0, x1, 값)]}"""
    return next((v for x0, x1, v in spans.get(row, ()) if x0 <= x - 1 < x1), None)


def render(items, current, w, h, cur_sess="", sessions=(), homes=()):
    now = int(time.time())
    BG = C["bg"]
    L = lambda: Line(w, BG)
    lines, targets = [], {}
    n_wait = sum(1 for p in items if p["@claude_state"] == "wait")
    n_run = sum(1 for p in items if p["@claude_state"] == "run")

    # Header: title + count
    # 머리: 제목 + 개수
    hd = L().put("  Claude", C["text"], bold=True).put(tr("  세션", "  sessions"), C["text3"])
    # the bee office button (bin/hivemux-office), left of the count: with its name when there is room, else the bee alone
    # 벌 사무실 버튼 (bin/hivemux-office). 개수 왼쪽에, 자리가 있으면 이름까지, 없으면 벌만
    global OFFICE_BTN
    count, OFFICE_BTN = f" {len(items)} ", None
    for btn in (tr(" 🐝 사무실 ", " 🐝 office "), " 🐝 "):
        x0 = w - 1 - width(count) - 1 - width(btn)
        if x0 >= hd.used() + 1:
            hd.fill(x0).put(btn, C["wait"], C["card_hi"], True)
            OFFICE_BTN = (len(lines) + 1, x0, x0 + width(btn))
            break
    hd.right(count, C["text"], C["card_hi"], True, margin=1)
    lines += [L(), hd, L()]
    summary = L().put("  ")
    if n_run:
        summary.put(tr(f"◐ {n_run} 작업 중", f"◐ {n_run} running"), C["run"]).put("   ")
    if n_wait:
        summary.put(tr(f"● {n_wait} 입력 필요", f"● {n_wait} need input"), C["wait"], bold=True)
    if not n_run and not n_wait and items:
        summary.put(tr("모두 대기 중", "all idle"), C["text3"])
    # why the cards stand still: a screen from another Mac is looking at this window. At the right end
    # of the summary, so the list below never moves; shorter forms when the counts leave less room
    # 카드가 멈춘 이유: 다른 Mac 화면이 이 창을 보고 있다. 요약 줄 오른쪽 끝에 둬서 아래 목록이
    # 움직이지 않게 한다. 개수가 자리를 차지하면 짧게 줄인다
    if REMOTE_HERE is not None:
        mac = REMOTE_HERE or tr("원격", "remote")
        for note in (tr(f"⇄ {mac}에서 보는 중 · 멈춤", f"⇄ {mac} viewing · paused"),
                     tr(f"⇄ {mac} · 멈춤", f"⇄ {mac} · paused"), tr("⇄ 원격 · 멈춤", "⇄ remote · paused"), "⇄"):
            if summary.used() + 1 + width(note) <= w - 1:
                summary.right(note, C["remote"], margin=1)
                break
    global SHIFT_BTN
    SHIFT_BTN = None
    if clocked_out() and not items:
        # everyone went home: say so, and a click clocks in / 모두 퇴근: 그렇다고 보이고, 누르면 출근
        # (the paused note, if any, stays on the right, short) / (멈춤 표시가 있으면 오른쪽에 짧게 남긴다)
        summary = L().put("  ").put(tr("🌙 퇴근 중 · 눌러서 출근", "🌙 clocked out · click to clock in"), C["wait"], bold=True)
        if REMOTE_HERE is not None:
            summary.right("⇄", C["remote"], margin=1)
        SHIFT_BTN = len(lines)
    lines += [summary, L().put(" " + "─" * (w - 2), C["rule"])]

    # groups in project order; a project with no Claude has no members (shown as "no Claude")
    # 프로젝트 순서의 묶음. Claude 가 없는 프로젝트는 멤버 없이 ("Claude 없음") 보인다
    # cards of Claudes clocked out by themselves come after the others, without a ⌥ number
    # 혼자 퇴근한 Claude 의 카드는 나머지 뒤에, ⌥ 번호 없이
    numbered = list(enumerate(items, 1)) + [(0, p) for p in homes]
    groups = [(s, [(i, p) for i, p in numbered if p["session_name"] == s]) for s, _, _ in sessions] or \
        [(s, [(i, p) for i, p in numbered if p["session_name"] == s]) for s in dict.fromkeys(p["session_name"] for _, p in numbered)]
    info = {s: (n, pane) for s, n, pane in sessions}

    dragging = DRAG and DRAG.get("moved")
    # Project boxes in a grid: as many columns as the sidebar width holds (resize it with the grip).
    # Each box goes to the shortest column, so tall projects do not leave holes.
    # 프로젝트 상자 격자: 사이드바 폭에 들어가는 만큼 열을 둔다 (핸들로 폭을 바꾼다).
    # 상자는 가장 짧은 열에 넣어서 긴 프로젝트가 빈자리를 만들지 않는다.
    # columns 1 .. w-2: one free column on the left like the grip column on the right; between boxes
    # one column, or half a row (about as wide as a column) / 1 ~ w-2 열: 오른쪽 핸들 칸처럼 왼쪽도 한 칸
    # 비운다. 상자 사이는 한 칸, 위아래로는 반 줄 (한 칸 폭과 비슷하다)
    usable = w - 2
    ncol = max(1, (usable + COL_GAP) // (BOX_MIN + COL_GAP))
    cw = (usable - COL_GAP * (ncol - 1)) // ncol

    def box(sess, members):
        """One project box: rows of width cw, plus {row: pane} for its cards
        프로젝트 상자 하나: 폭 cw 의 줄들과 {줄: 칸} (카드 자리)"""
        hue = hue_of(sess)
        cur = sess == cur_sess
        tile = mix(C["bg"], hue, 0.20 if cur else 0.12)
        head_bg = mix(C["bg"], hue, 0.45 if cur else 0.30)
        S = lambda bg=tile: Line(cw, bg)
        rows, cards = [], {}
        hd = S(head_bg).put(" ").put(sess, C["text"], head_bg, bold=True, limit=cw - 3)
        if len(members) > 1:
            hd.right(str(len(members)), mix(C["text"], hue, 0.4), head_bg, margin=1)
        hd.fill(cw, head_bg)
        if dragging and DRAG["kind"] == "group":
            if sess == DRAG["src"]:
                hd.tint(fg=C["text3"])
            elif sess == DRAG["over"]:
                hd.tint(bg=C["drop"])
        rows.append(hd)
        if not members:
            n = info.get(sess, (0, ""))[0]
            rows.append(S().put(" ").put(tr(f"Claude 없음 · 창 {n}개", f"no Claude · {n} window" + ("s" if n != 1 else "")),
                                         C["text3"], tile, limit=cw - 1).fill(cw))
        x0, x1 = 1, cw - 1                # card columns inside the box / 상자 안 카드 가로 범위
        for mi, (i, p) in enumerate(members):
            st = p["@claude_state"] if p["@claude_state"] in STATE_TEXT else "idle"
            sel = p["pane_id"] == current
            card = C["card_sel"] if sel else C["card"]
            bar = C[st]
            icon = STATE_ICON[st]
            t_ = NOW_T
            if st == "wait":
                card = mix(C["wait_bg"], C["wait_hi"], (0.5 + 0.5 * math.sin(t_ * 2.25))) if ANIM else \
                    C["wait_bg_sel"] if sel else C["wait_hi"]
            if st == "run" and not ANIM:
                card = C["run_bg_sel"] if sel else C["run_bg"]
            if st == "run" and ANIM:
                icon = SPIN[int(t_ * 10) % len(SPIN)]
                bar = mix(C["run"], C["run_hi"], 0.5 + 0.5 * math.sin(t_ * 3.1))
            dim = st in ("idle", "home")
            t = age(p["@claude_state_at"], now) if not dim else ""
            key = f"⌥{i}" if 0 < i <= 9 else ""
            name = task_name(p)
            bar_ch = "▌" if sel else "▎"
            drag_src = drag_dst = False
            if dragging and DRAG["kind"] == "card":
                drag_src = p["pane_id"] == DRAG["src"]
                drag_dst = p["pane_id"] == DRAG["over"] and not drag_src
                if drag_dst:
                    card, bar, bar_ch = C["drop"], C["run"], "▌"

            def card_line():
                return S().put(" ", C["text"], tile).put(bar_ch, bar, card).put(" ", C["text"], card)

            r1 = card_line()
            r1.put(name, C["text"] if not dim or sel else C["text2"], card, bold=True,
                   limit=x1 - (width(key) + 2 if key else 1))
            r1.fill(x1 - 1 - width(key), card).put(key, C["text"] if sel else C["text3"], card).fill(x1, card).fill(cw)
            r2 = card_line()
            r2.put(f"{icon} {state_line(p, st)}", bar if st != "idle" else C["text3"], card, bold=st == "wait",
                   limit=x1 - width(t) - 2)
            r2.fill(x1 - 1 - width(t), card).put(t, C["text2"] if st != "wait" else C["wait"], card).fill(x1, card).fill(cw)
            lns = [r1, r2]
            if mi < len(members) - 1:       # a thin line under the card, before the next one / 다음 카드 앞에 가는 선
                r2.cells = [(ch, bg_, fg_, (b_, head_bg) if 1 <= k < len(r2.cells) - 1 else b_)
                            for k, (ch, bg_, fg_, b_) in enumerate(r2.cells)]
            if sel and not drag_dst:        # a bright line on both sides of this window's card / 이 창의 카드 양옆에 밝은 선
                for r in lns:
                    r.cells[0] = ("▐", tile, C["frame"], False)
                    r.cells[-1] = ("▌", tile, C["frame"], False)
            if drag_src:
                for r in lns:
                    r.tint(fg=C["text3"])
            if st == "run" and ANIM and not drag_src and not drag_dst:
                span = x1 - x0
                # fractional position (11 columns/s): the gaussian glow blends neighbouring
                # cells, so the band moves between cells instead of jumping a cell at a time
                # 소수점 위치(초당 11칸): 가우시안 빛이 이웃 칸에 섞여 칸 단위로 튀지 않고 사이를 지나간다
                pos = x0 + (t_ * 11.0) % (span + 12) - 6
                for r in lns:
                    r.glow(x0 + 1, x1, pos, card, C["glow"])
            for r in lns:
                cards[len(rows)] = p["pane_id"]
                rows.append(r)
        return rows, cards

    def build():
        """Lay the boxes out; returns (lines, {row: [(x0, x1, pane)]}, {row: [(x0, x1, session)]})
        상자를 배치한다. 돌려주는 값: (줄들, {줄: [(x0, x1, 칸)]}, {줄: [(x0, x1, 세션)]})"""
        cols = [[] for _ in range(ncol)]            # per column: [(rows, cards, sess)] / 열마다
        hts = [0] * ncol
        for sess, members in groups:
            rows, cards = box(sess, members)
            k = hts.index(min(hts))
            gap = 1 if cols[k] else 0
            cols[k].append((rows, cards, sess, hts[k] + gap))
            hts[k] += gap + len(rows)
        height = max(hts) if hts else 0
        out = [L().put(" ") for _ in range(height)]
        tg, hg = {}, {}
        for k, col in enumerate(cols):
            cx = 1 + k * (cw + COL_GAP)
            for i, (rows, cards, sess, top) in enumerate(col):
                for j, r in enumerate(rows):
                    ln = out[top + j]
                    ln.fill(cx)
                    ln.cells += r.cells
                    ln.n += r.n
                    if j in cards:
                        tg.setdefault(top + j, []).append((cx, cx + cw, cards[j]))
                    else:
                        hg.setdefault(top + j, []).append((cx, cx + cw, sess))
                if i < len(col) - 1:        # the gap row: its upper half is this box's bottom / 사이 줄: 위 절반은 이 상자 아래 끝
                    ln, tile = out[top + len(rows)], rows[-1].cells[0][1]
                    ln.fill(cx)
                    ln.cells += [("▀", C["bg"], tile, False)] * cw
                    ln.n += cw
        return out, tg, hg

    global SCROLL, SCROLL_TO
    avail = h - 3 - len(lines)          # rows for the list / 목록에 쓸 줄 수
    # If it does not fit, the list scrolls (cards stay two lines, projects stay apart)
    # 넘치면 목록을 스크롤한다 (카드는 두 줄, 프로젝트 사이 빈 줄은 그대로)
    body, tg, hg = build()
    if not items and not sessions and not homes:
        body = [L(), L().put(tr("  실행 중인 Claude가 없습니다", "  No Claude sessions yet"), C["text2"]), L(),
                L().put("  ", C["text3"]).put("prefix ⇧C", C["text"]).put(tr("  새 Claude", "  new Claude"), C["text3"]),
                L().put("  ", C["text3"]).put(tr("hm 폴더", "hm <dir>"), C["text"]).put(tr("    프로젝트 열기", "   open project"), C["text3"])]
        tg, hg = {}, {}
    top_max = max(0, len(body) - avail)
    if current != SCROLL_TO:            # bring this window's card into view / 이 창의 카드가 보이게
        SCROLL_TO = current
        mine = [k for k, v in tg.items() if any(pid == current for _, _, pid in v)]
        if mine:
            SCROLL = min(max(SCROLL, max(mine) - avail + 2), min(mine) - 2)
    SCROLL = max(0, min(SCROLL, top_max))
    base = len(lines) - SCROLL
    lines += body[SCROLL:SCROLL + avail]
    targets = {base + k: v for k, v in tg.items() if SCROLL <= k < SCROLL + avail}
    heads = {base + k: v for k, v in hg.items() if SCROLL <= k < SCROLL + avail}
    # more above / below: an arrow at the right end of the rule above / below the list
    # 위/아래에 더 있음: 목록 위/아래 구분선 오른쪽 끝에 화살표
    if SCROLL:
        lines[base + SCROLL - 1].cells[w - 5:w - 2] = [(c, BG, C["text2"], True) for c in " ▲ "]
    more_below = SCROLL < top_max
    lines = lines[:h - 3]
    while len(lines) < h - 3:
        lines.append(L())
    lines.append(L().put(" " + "─" * (w - 2), C["rule"]))
    if more_below:
        lines[-1].cells[w - 5:w - 2] = [(c, BG, C["text2"], True) for c in " ▼ "]
    k = L().put("  ")
    if n_wait:
        k.put(" ⌥0 ", C["bg"], C["wait"], True).put(tr("  기다리는 작업으로", "  go to waiting"), C["wait"])
    else:
        k.put(" ⌥0 ", C["text"], C["card_hi"], True).put(tr("  기다리는 작업", "  next waiting"), C["text3"])
    lines.append(k)
    if dragging:
        lines.append(L().put("  ").put(" ↕ ", C["bg"], C["run"], True).put(tr("  놓을 곳에서 떼기", "  release to drop"), C["run"]))
    else:
        lines.append(L().put("  ").put(" ⌥1-9 ", C["text"], C["card_hi"], True).put(tr("  이동 · 우클릭 메뉴", "  jump · r-click menu"), C["text3"]))
    # Rightmost column: resize grip, a 7-row pill at the vertical middle
    # 오른쪽 끝 칸: 폭 조절 핸들. 세로 가운데 7줄짜리 알약 모양 막대
    #   ▄ rounded top / lighter bar with grip dots / ▀ rounded bottom; blue while dragging
    #   ▄  둥근 위끝 / 밝은 막대 + 가운데 점무늬 / ▀ 둥근 아래끝. 끄는 중엔 파랗게
    mid = h // 2
    drag = os.path.exists(GRIP)
    pill = C["run"] if drag else (66, 72, 86)
    dots = (240, 246, 255) if drag else C["text2"]
    for y in range(h):
        ln = lines[y]
        ln.fill(w)
        ch, bg_, fg_, b_ = ln.cells[-1]
        d = y - mid
        if d == -3:
            ln.cells[-1] = ("▄", BG, pill, False)
        elif d == 3:
            ln.cells[-1] = ("▀", BG, pill, False)
        elif -2 <= d <= 2:
            ln.cells[-1] = ("⠿" if -1 <= d <= 1 else " ", pill, dots, False)
    if MENU:
        draw_menu(lines, w, h)
    return [l.render() for l in lines], (targets, heads)


def board(items, now, blink):
    """The pickup board at the right of the window list (food court style): every task, in any
    project, that needs input (amber) or finished and is not seen yet (green), as a round badge
    with its number (the sidebar's ⌥ number). Waiting first, then finished, oldest first.
    A waiting one blinks until answered, a finished one for its first BLINK_DONE seconds (blink:
    False keeps them still). Click one (MouseDown1Status, share/hivemux.tmux) to go there.
    Returns (status line text, whether something blinks).
    창 목록 오른쪽의 호출판 (푸드코트 호출판처럼): 어느 프로젝트든 입력이 필요하거나(호박색) 끝나고 아직
    안 본(초록) 작업을 번호(사이드바의 ⌥ 번호)가 든 동그란 배지로. 입력 필요가 먼저, 그다음 완료, 오래된 순.
    입력 필요는 답할 때까지, 완료는 처음 BLINK_DONE 초 동안 깜빡인다 (blink 가 False 면 멈춤).
    누르면 (MouseDown1Status, share/hivemux.tmux) 그 작업으로 간다.
    돌려주는 값: (상태줄 글, 깜빡이는 것이 있는지)."""
    num = {p["pane_id"]: i for i, p in enumerate(items, 1)}
    at = lambda p: int(p["@claude_state_at"]) if p["@claude_state_at"].isdigit() else 0
    calls = sorted((p for p in items if p["@claude_state"] in ("wait", "done")),
                   key=lambda p: (p["@claude_state"] != "wait", at(p)))
    if not calls:
        return "", False
    lit = int(now * 2) % 2 == 0                 # blink phase: 0.5 s on, 0.5 s off / 깜빡임: 0.5초 켜짐, 0.5초 꺼짐
    blinking = False
    out = []
    for p in calls:
        wait = p["@claude_state"] == "wait"
        flash = blink and (wait or now - at(p) < BLINK_DONE)
        blinking |= flash
        color = BADGE_WAIT if wait else BADGE_DONE
        n = num[p["pane_id"]]
        # a round badge: Ghostty's built-in Nerd Font half circles around the number; blinking, it
        # goes out to the bare number and back
        # 동그란 배지: Ghostty 에 들어 있는 Nerd Font 반원 두 개 사이에 번호. 깜빡일 때는 번호만 남았다가 돌아온다
        if not flash or lit:
            badge = f"#[fg={color},bg={STATUS_BG}]\ue0b6#[bg={color},fg={STATUS_BG},bold]{n}#[fg={color},bg={STATUS_BG},nobold]\ue0b4"
        else:
            badge = f"#[fg={color},bg={STATUS_BG},bold] {n} #[nobold]"
        out.append(f"#[range=user|hm{p['pane_id'].lstrip('%')}]{badge}#[norange default]")
    return " ".join(out) + "   ", blinking


BLINK_DONE = 10                    # seconds a finished one blinks / 완료가 깜빡이는 초
BADGE_WAIT, BADGE_DONE, STATUS_BG = "#f5a524", "#3ecf8e", "#16181d"


def badges(w, names):
    """The project badge at the left of the status line: a blue block as wide as the sidebar (w, with
    its border), so the window list starts above the work area, not above the sidebar. Written per
    session (@hivemux-badge), since tmux cannot pad to a width it reads from an option.
    상태줄 왼쪽의 프로젝트 이름표: 사이드바 폭(w, 경계선 포함)만큼의 파란 칸. 그래서 창 목록이 사이드바가
    아니라 작업 칸 위에서 시작한다. tmux 는 옵션에서 읽은 폭으로 채울 수 없어서 세션마다 적어 둔다
    (@hivemux-badge)."""
    changed = False
    for s in names:
        text = "  " + s
        if width(text) > w - 1:
            cut = ""
            for c in text:
                if width(cut + c) > w - 2:
                    break
                cut += c
            text = cut + "…"
        v = (text + " " * (w - width(text))).replace("#", "##").replace("%", "%%")
        if tmux("show", "-qv", "-t", f"={s}:", "@hivemux-badge").rstrip("\n") != v:
            tmux("set", "-t", f"={s}:", "@hivemux-badge", v)
            changed = True
    if changed:
        for c in tmux("list-clients", "-F", "#{client_name}").split():
            tmux("refresh-client", "-S", "-t", c)


def active_client(sess):
    """The client that last pressed a key or clicked on sess: a popup goes on the screen that asked
    for it, not the first client in the list (another Mac's screen, or this Mac's while working from
    another one over hivemux-attach)
    sess 에서 마지막으로 키를 누르거나 클릭한 화면: 팝업은 요청한 화면에 띄운다. 목록의 첫 화면이면
    다른 Mac 에서 붙어 쓰는 동안 이 Mac 화면에 떠서 보이지 않았다"""
    rows = [l.split(" ", 1) for l in tmux("list-clients", "-t", f"={sess}", "-F",
                                          "#{client_activity} #{client_name}").splitlines() if " " in l]
    return max(rows, key=lambda r: int(r[0]) if r[0].isdigit() else 0)[1] if rows else ""


def rename(pid):
    sess = tmux("display", "-p", "-t", ME, "#{session_name}").strip()
    client = active_client(sess)
    tmux("run-shell", "-b", os.path.join(os.path.dirname(os.path.realpath(__file__)), "hivemux-rename") + f" prompt {pid} '{client}'")


def office():
    """Open the bee office window (bin/hivemux-office) for the screen that asked / 요청한 화면을 위해 벌 사무실 창을 연다"""
    sess = tmux("display", "-p", "-t", ME, "#{session_name}").strip()
    bg_run(os.path.join(os.path.dirname(os.path.realpath(__file__)), "hivemux-office"), "--client", active_client(sess))


def bg_run(*argv):
    """Run a helper in the background through tmux (it outlives this call). Its output is dropped: tmux shows what
    run-shell prints over the pane in front, which may be another project's (a clock in said so there)
    tmux 로 도우미를 뒤에서 실행. 출력은 버린다: tmux 는 run-shell 이 찍은 글을 앞에 있는 칸 위에 띄우는데, 그 칸이
    다른 프로젝트의 칸일 수 있다 (출근 결과가 거기 떴다)"""
    tmux("run-shell", "-b", " ".join(shlex.quote(x) for x in argv) + " >/dev/null 2>&1")


def clock_in(pid):
    """Bring one Claude back from home in the same conversation (bin/hivemux-shift) / 집에 간 Claude 하나를 같은 대화로 출근시킨다"""
    bg_run(os.path.join(os.path.dirname(os.path.realpath(__file__)), "hivemux-shift"), "on", "--pane", pid)


def menu(y, pid=None, sess=None, items=(), homes=()):
    """Open the right-click menu under row y. pid: a card, sess: a project header.
    It is drawn by the sidebar itself, not tmux display-menu: tmux 3.7 draws a pane's Korean (wide)
    text through menus and popups over it, so a menu over a printing Claude got garbled.
    오른쪽 클릭 메뉴를 y 줄 아래에 연다. pid: 카드, sess: 프로젝트 이름 줄.
    tmux display-menu 가 아니라 사이드바가 직접 그린다: tmux 3.7 은 칸의 한글(두 칸 폭) 글자를 그 위 메뉴와
    팝업을 뚫고 그려서, 출력 중인 Claude 위의 메뉴가 깨졌다."""
    global MENU
    here = os.path.dirname(os.path.realpath(__file__))
    empty = not pid and not sess        # empty space: only "New project" / 빈 곳: "새 프로젝트" 만
    my = tmux("display", "-p", "-t", ME, "#{session_name}").strip()
    client = active_client(my)
    if pid and not sess:
        sess = next((p["session_name"] for p in list(items) + list(homes) if p["pane_id"] == pid), "")
    sess = sess or my
    # project folder: the Claude's folder of the card, else the first card of the project
    # 프로젝트 폴더: 그 카드 Claude 의 폴더, 없으면 그 프로젝트 첫 카드의 폴더
    src = pid or next((p["pane_id"] for p in items if p["session_name"] == sess), "") or ME
    d = tmux("display", "-p", "-t", src, "#{?@claude_cwd,#{@claude_cwd},#{pane_current_path}}").strip() or os.path.expanduser("~")
    rows = []
    shift = os.path.join(here, "hivemux-shift")
    home = {p["pane_id"] for p in homes}
    if pid in home:                     # a Claude at home: only back to work / 집에 간 Claude: 출근만
        rows += [(tr("출근", "Clock in"), "i", lambda: clock_in(pid)),
                 (tr("이동", "Go to"), "g", lambda: goto(pid)),
                 (tr("Claude 닫기…", "Close Claude…"), "x", lambda: bg_run(os.path.join(here, "hivemux-close-claude"), pid, client)),
                 None]
    elif pid:
        rows += [(tr("이동", "Go to"), "g", lambda: goto(pid)),
                 (tr("이름 바꾸기…", "Rename…"), "r", lambda: rename(pid)),
                 None,
                 (tr("위로 옮기기", "Move up"), "k", lambda: bg_run(os.path.join(here, "hivemux-order"), "step", "up", pid)),
                 (tr("아래로 옮기기", "Move down"), "j", lambda: bg_run(os.path.join(here, "hivemux-order"), "step", "down", pid)),
                 None]
        # this Claude alone: the rest work on / 이 Claude 만: 나머지는 계속 일한다
        if not next((p for p in items if p["pane_id"] == pid and p["@claude_offwork"]), None):
            rows[-1:-1] = [(tr("이 Claude 퇴근…", "Clock this Claude out…"), "h", lambda: bg_run(shift, "--popup", "off", client, "--pane", pid))]
        rows[-1:-1] = [(tr("Claude 닫기…", "Close Claude…"), "x", lambda: bg_run(os.path.join(here, "hivemux-close-claude"), pid, client))]
    elif not empty:                     # project name row / 프로젝트 이름 줄
        rows += [(tr("이름 바꾸기…", "Rename…"), "r", lambda: bg_run(os.path.join(here, "hivemux-rename-project"), "prompt", sess, client)),
                 (tr("프로젝트 닫기…", "Close project…"), "x", lambda: bg_run(os.path.join(here, "hivemux-close-project"), sess, client))]
        # this project's Claudes only; windows and shells stay / 이 프로젝트의 Claude 만. 창과 셸은 그대로
        if any(p["session_name"] == sess and not p["@claude_offwork"] for p in items):
            rows.append((tr("이 프로젝트 퇴근…", "Clock this project out…"), "h", lambda: bg_run(shift, "--popup", "off", client, "--project", sess)))
        if any(p["session_name"] == sess for p in homes):
            rows.append((tr("이 프로젝트 출근", "Clock this project in"), "i", lambda: bg_run(shift, "on", "--project", sess)))
        rows.append(None)
    if not empty:
        rows.append((tr("새 Claude…", "New Claude…"), "n", lambda: bg_run(os.path.join(here, "hivemux-new-claude"), d, sess, client)))
    rows.append((tr("새 프로젝트…", "New project…"), "p", lambda: bg_run(os.path.join(here, "hm"), "--ask", client, d)))
    rows += [None, (tr("경로 열기…", "Open path…"), "o", lambda: bg_run(os.path.join(here, "hivemux-open"), pid or ME, client)),
             (tr("포트 목록…", "Ports…"), "t", lambda: bg_run(os.path.join(here, "hivemux-ports"), "--pick", client)),
             (tr("벌 사무실", "Bee office"), "b", office)]
    # everyone at once: only from empty space, so it never reads as this card's or this project's
    # 모두 한꺼번에: 빈 곳에서만. 이 카드나 이 프로젝트만의 일로 읽히지 않게
    if empty and (clocked_out() or homes):
        rows.append((tr("모두 출근하기…", "Clock everyone in…"), "i", lambda: bg_run(shift, "--popup", "on", client)))
    if empty and not clocked_out() and items:
        rows.append((tr("모두 퇴근하기…", "Clock everyone out…"), "h", lambda: bg_run(shift, "--popup", "off", client)))
    rows += [(tr("Claude 업데이트…", "Update Claude…"), "u", lambda: bg_run(os.path.join(here, "hivemux-claude-update"), "--popup", client)),
             None, (tr("원격 연결…", "Connect to…"), "c", lambda: bg_run(os.path.join(here, "hivemux-connect"), "--pick", client)),
             (tr("설정…", "Settings…"), "s", lambda: bg_run(os.path.join(here, "hivemux-settings"), client))]
    # card: the task name; project name row: the project; empty space: "New"
    # 카드: 작업 이름, 프로젝트 이름 줄: 프로젝트 이름, 빈 곳: "새로 만들기"
    title = tr("새로 만들기", "New") if empty else (next((task_name(p) for p in list(items) + list(homes) if p["pane_id"] == pid), "") if pid else "") or sess
    MENU = {"rows": rows, "y": y, "sel": None, "title": title, "at": {}, "press": None}
    sys.stdout.write("\x1b[?1003h")       # hover highlight: report plain moves too / 마우스만 움직여도 받아 강조
    sys.stdout.flush()


def menu_close():
    global MENU
    MENU = None
    # tmux turns all mouse reporting off on ?1003l, so turn clicks and drags back on
    # tmux 는 ?1003l 에 마우스 보고를 모두 끄므로 클릭과 끌기를 다시 켠다
    sys.stdout.write("\x1b[?1003l\x1b[?1000h\x1b[?1002h\x1b[?1006h")
    sys.stdout.flush()


def menu_run(i):
    """Close the menu and run item i after the next frame: a popup pauses drawing and copies the
    screen, so the menu must be gone from the screen first
    메뉴를 닫고 i 번 항목은 다음 화면을 그린 뒤 실행한다: 팝업은 그리기를 멈추고 화면을 찍어 가므로
    메뉴가 먼저 화면에서 사라져야 한다"""
    global PENDING
    rows = MENU["rows"]
    menu_close()
    if 0 <= i < len(rows) and rows[i]:
        PENDING = rows[i][2]


def draw_menu(lines, w, h):
    """Draw MENU over the rendered Line objects; MENU["at"] maps screen rows to items
    렌더한 줄 위에 MENU 를 그린다. MENU["at"] 은 화면 줄 -> 항목 번호"""
    rows = MENU["rows"]
    bw = max(16, w - 3)                   # box: columns 1 .. w-3 (the last column is the grip) / 상자: 1 ~ w-3 열 (끝 칸은 핸들)
    bh = len(rows) + 2
    top = MENU["y"] + 1 if MENU["y"] + 1 + bh <= h else max(0, MENU["y"] - bh)
    edge, box, hi = (86, 94, 110), C["card_hi"], C["drop"]
    MENU["at"] = {}

    def row(y, build):
        ln = Line(w, C["bg"]).put(" ")
        build(ln)
        ln.fill(w - 1)
        if lines[y].cells:
            ln.cells.append(lines[y].cells[-1])   # keep the grip / 핸들은 그대로
            ln.n += 1
        lines[y] = ln

    title = fit(MENU["title"], bw - 6).rstrip()
    row(top, lambda ln: ln.put("╭─ ", edge, box).put(title, C["text"], box, True)
        .put(" " + "─" * max(0, bw - 5 - width(title)), edge, box).put("╮", edge, box))
    for i, r in enumerate(rows):
        y = top + 1 + i
        if r is None:
            row(y, lambda ln: ln.put("├" + "─" * (bw - 2) + "┤", edge, box))
            continue
        label, key, _ = r
        on = MENU["sel"] == i
        bgc = hi if on else box
        MENU["at"][y] = i
        row(y, lambda ln, label=label, key=key, on=on, bgc=bgc: ln.put("│", edge, box)
            .put(" " + fit(label, bw - 8).rstrip(), C["text"] if on else C["text2"], bgc, on)
            .fill(1 + bw - 5, bgc).put(f"({key}) ", C["text2"] if on else C["text3"], bgc).put("│", edge, box))
    row(top + bh - 1, lambda ln: ln.put("╰" + "─" * (bw - 2) + "╯", edge, box))


def goto(pid):
    sess = tmux("display", "-p", "-t", pid, "#{session_name}").strip()
    win = tmux("display", "-p", "-t", pid, "#{window_id}").strip()
    if not sess:
        return
    tmux("switch-client", "-t", f"={sess}")
    tmux("select-window", "-t", win)
    tmux("select-pane", "-t", pid)



DIALOG_RE = re.compile(r"(?i)\besc to cancel\b")   # footer of Claude's approval/question dialogs / Claude 승인·질문 창의 맨 아랫줄
BUSY_RE = re.compile(r"(?i)\besc to interrupt\b")  # footer while Claude is working / Claude 가 작업 중일 때의 아랫줄
# Claude's progress line ("✻ Finagling… (10s · ↓ 89 tokens)"): kept when a narrow pane cuts the footer
# Claude 의 진행 줄 ("✻ Finagling… (10s · ↓ 89 tokens)"): 좁은 칸에서 아랫줄이 잘려도 남는다
SPIN_RE = re.compile(r"(?i)^\s*[^\s\w❯⏺⎿│>]\s+\w[^…]*…\s*\((\d|esc\b)")


def clear_answered(items, waits, now):
    """Claude sends no hook between "user answered the approval" and "tool finished", so a long
    tool kept showing "input needed". While a pane waits, look for the dialog footer
    ("Esc to cancel"); once it was there and is gone (answered here or from the phone), mark the
    pane running, or done if Claude is not working (the user chose "No": no hook fires then either).
    Any other screen change (the blinking ⏺, clicks, focus) is ignored.
    승인에 답한 뒤 도구가 끝날 때까지 Claude 는 훅을 보내지 않아 오래 걸리는 도구는 계속 "입력 필요"로 보였다.
    기다리는 동안 승인 창 맨 아랫줄("Esc to cancel")을 찾고, 있다가 사라지면 (여기서든 폰에서든 답함)
    작업 중으로, Claude 가 일하지 않으면 완료로 바꾼다 ("No"를 골랐을 때도 훅이 오지 않는다).
    다른 화면 변화(깜빡이는 ⏺, 클릭, 포커스)는 무시한다."""
    for pid in [k for k in waits if not any(p["pane_id"] == k and p["@claude_state"] == "wait" for p in items)]:
        del waits[pid]
    for p in items:
        if p["@claude_state"] != "wait":
            continue
        pid, at = p["pane_id"], p["@claude_state_at"]
        tail = [ln for ln in tmux("capture-pane", "-p", "-t", pid).splitlines() if ln.strip()][-12:]
        shown = any(DIALOG_RE.search(ln) for ln in tail)
        st = waits.get(pid)
        _, seen, missing = st if st and st[0] == at else (at, False, 0)
        if shown:
            waits[pid] = (at, True, 0)
        elif seen and tail:
            missing += 1
            if missing < 2:             # gone on two polls in a row, not a redraw glitch / 두 번 연속 없을 때만 (다시 그리는 중 아님)
                waits[pid] = (at, True, missing)
                continue
            del waits[pid]
            set_state(p, "run" if any(BUSY_RE.search(ln) for ln in tail) else "done", now)
        else:
            waits[pid] = (at, False, 0)


def set_state(p, new, now):
    ts = str(int(now))
    pid = p["pane_id"]
    tmux("set", "-p", "-t", pid, "@claude_state", new)
    tmux("set", "-p", "-t", pid, "@claude_state_at", ts)
    tmux("set", "-w", "-t", pid, "@claude_state", new)
    if new != "wait":
        tmux("set", "-pu", "-t", pid, "@claude_wait")
    tmux("refresh-client", "-S")
    p["@claude_state"], p["@claude_state_at"] = new, ts


def clear_interrupted(items, runs, now):
    """Esc in Claude stops the turn without any hook (no Stop), so the pane kept showing "working".
    While a pane runs, Claude's footer ends with "esc to interrupt" (in a narrow pane, the progress
    line stays); when both are missing on three
    polls in a row (not a redraw, not the moment between the prompt and the first frame), the turn
    was stopped: mark the pane idle. The next hook (a new prompt, a tool) sets it again.
    Claude 에서 Esc 로 멈추면 훅이 오지 않아 (Stop 없음) 계속 "작업 중"으로 보였다.
    작업 중에는 Claude 맨 아랫줄 끝에 "esc to interrupt" 가 (좁은 칸에서는 진행 줄이) 있다. 세 번 연속 없으면 (다시 그리는 중이나
    입력 직후 첫 화면 전이 아님) 멈춘 것이니 대기로 바꾼다. 다음 훅(새 입력, 도구)이 다시 정한다."""
    for pid in [k for k in runs if not any(p["pane_id"] == k and p["@claude_state"] == "run" for p in items)]:
        del runs[pid]
    for p in items:
        if p["@claude_state"] != "run" or p.get("@claude_bg"):
            continue                    # background agents at work while Claude itself waits / Claude 는 쉬어도 배경 에이전트가 일한다
        pid, at = p["pane_id"], p["@claude_state_at"]
        if tmux("display", "-p", "-t", pid, "#{pane_in_mode}").strip() == "1":
            continue                    # scrolled back: the screen is not Claude's now / 스크롤 중: 지금 화면이 아니다
        tail = [ln for ln in tmux("capture-pane", "-p", "-t", pid).splitlines() if ln.strip()][-12:]
        st = runs.get(pid)
        missing = st[1] if st and st[0] == at else 0
        if not tail or any(BUSY_RE.search(ln) or SPIN_RE.match(ln) for ln in tail):
            runs[pid] = (at, 0)
            continue
        missing += 1
        if missing < 3:
            runs[pid] = (at, missing)
            continue
        del runs[pid]
        set_state(p, "idle", now)


NOTIFY_GAP = 10      # seconds before the same pane may notify the same state again / 같은 칸이 같은 상태로 다시 알리기까지 초


def clear_quit(shells):
    """Claude quit but its state is still on the pane (SessionEnd not come yet, or the process was
    killed): after three polls with a shell in front, clear it like the SessionEnd hook does
    Claude 가 끝났는데 상태가 칸에 남음 (SessionEnd 가 아직 안 왔거나 강제 종료): 셸이 세 번 연속 앞에
    있으면 SessionEnd 훅처럼 지운다"""
    panes = [l.split(" ") for l in tmux("list-panes", "-a", "-F", "#{pane_id} #{pane_current_command} #{@claude_state}").splitlines()]
    stale = {p[0] for p in panes if len(p) == 3 and p[2] and p[1].lstrip("-") in SHELLS}
    for pid in list(shells):
        if pid not in stale:
            del shells[pid]
    for pid in stale:
        shells[pid] = shells.get(pid, 0) + 1
        if shells[pid] >= 3:
            del shells[pid]
            tmux("set", "-pu", "-t", pid, "@claude_state")
            tmux("set", "-pu", "-t", pid, "@claude_state_at")
            tmux("set", "-wu", "-t", pid, "@claude_state")


def notify_changes(items, seen, sent, now, emit):
    """Desktop notification when a task starts needing input or finishes.
    Every sidebar keeps the last (state, time) of each task; only the sidebar on screen sends,
    and tmux passes it to the terminals showing that window (also over ssh). A task in the window
    you are looking at (terminal focused) is left out. The first poll only records.
    작업이 입력 필요가 되거나 끝나면 데스크톱 알림을 띄운다.
    모든 사이드바가 작업마다 마지막 (상태, 시각)을 기억하고, 화면에 보이는 사이드바만 보낸다.
    tmux 가 그 창을 보여 주는 터미널로 넘긴다 (ssh 로 붙은 터미널에도). 지금 보고 있는 창(터미널에
    초점)의 작업은 빼고, 처음 읽을 때는 기억만 한다."""
    first = not seen
    fresh = {p["pane_id"]: (p["@claude_state"], p["@claude_state_at"]) for p in items}
    new = [p for p in items if not first and seen.get(p["pane_id"]) not in (None, fresh[p["pane_id"]])
           and p["@claude_state"] in ("wait", "done")]
    seen.clear()
    seen.update(fresh)
    if not new or not emit:
        return
    looking = {l.split(" ", 1)[0] for l in tmux("list-clients", "-F", "#{window_id} #{client_flags}").splitlines()
               if "focused" in l}
    for p in new:
        pid, st = p["pane_id"], p["@claude_state"]
        if p["window_id"] in looking:
            continue
        if sent.get(pid, ("", 0))[0] == st and now - sent[pid][1] < NOTIFY_GAP:
            continue
        sent[pid] = (st, now)
        clean = lambda s: re.sub(r"[\x00-\x1f\x7f;]", " ", s).strip()
        osc = "\x1b]777;notify;%s;%s\x07" % (clean(task_name(p)), clean(f"{p['session_name']} · {STATE_TEXT[st]}"))
        # tmux passthrough: ESC doubled inside / tmux 패스스루: 안의 ESC 는 두 번
        sys.stdout.write("\x1bPtmux;" + osc.replace("\x1b", "\x1b\x1b") + "\x1b\\")
        sys.stdout.flush()


def main():
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    out = sys.stdout
    # 1002: also report motion while a button is held (drag to reorder) / 버튼을 누른 채 움직임도 받는다 (끌어서 순서 바꾸기)
    out.write("\x1b[?1049h\x1b[?25l\x1b[?7l\x1b[?1000h\x1b[?1002h\x1b[?1006h")
    # Show "getting ready" at once, until the first real frame (never an empty pane)
    # 첫 화면을 그릴 때까지 "준비 중" 을 바로 보여 준다 (빈 칸으로 두지 않는다)
    try:
        w0, h0 = os.get_terminal_size()
        ready = [Line(w0, C["bg"]) for _ in range(h0)]
        ready[1].put("  Claude", C["text"], bold=True).put(tr("  세션", "  sessions"), C["text3"])
        ready[3].put("  " + SPIN[0] + " ", C["run"]).put(tr("준비 중…", "Getting ready…"), C["text2"])
        out.write("\x1b[H" + "\r\n".join(l.render() for l in ready) + "\x1b[0m")
    except OSError:
        pass
    out.flush()
    # SIGUSR1 = re-read and redraw now (state change from a hook, grip pressed/released).
    # The handler does nothing; the wakeup fd makes select() return.
    # SIGUSR1 = 바로 다시 읽고 그리기 (훅의 상태 변경, 핸들 누름/놓음). 처리기는 비워 두고 wakeup fd 로 select() 를 깨운다.
    signal.signal(signal.SIGUSR1, lambda *_: None)
    signal.set_wakeup_fd(WAKE_W, warn_on_full_buffer=False)
    resized = [True]
    signal.signal(signal.SIGWINCH, lambda *_: resized.__setitem__(0, True))
    global FRAME, ANIM, NOW_T, TICK, PENDING, REMOTE_HERE
    prev, prev_size = None, None     # last frame, for drawing only the rows that changed / 직전 프레임(바뀐 줄만 그리기용)
    border = os.path.join(os.path.dirname(os.path.realpath(__file__)), "hivemux-border")
    targets, heads, buf = {}, {}, ""
    global DRAG, SCROLL
    quits = {}                       # pane -> polls with a shell in front (see clear_quit) / 칸 -> 셸이 앞에 있던 횟수
    runs = {}                        # pane -> (state time, polls without the busy footer) (see clear_interrupted) / 칸 -> (상태 시각, 작업 중 표시가 없던 횟수)
    seen, sent = {}, {}              # notify_changes: pane -> (state, time); pane -> (state, sent at) / 칸 -> (상태, 시각); 칸 -> (상태, 보낸 시각)
    waits = {}                       # pane -> (state time, dialog seen, polls without it) (see clear_answered) / 칸 -> (상태 시각, 승인 창 봤음, 안 보인 횟수)
    snap, last_poll, last_spin, last_board, last_badge, woke = None, 0.0, None, None, None, False
    # Scroll is shared by every sidebar (each window has its own): after the wheel stops, this one
    # stores it in @hivemux-scroll and wakes the others, so the window you go to shows the same place
    # 스크롤은 모든 사이드바가 같이 쓴다 (창마다 사이드바가 따로 있다): 휠이 멈추면 @hivemux-scroll 에
    # 적고 다른 사이드바를 깨워서, 옮겨 간 창도 같은 자리를 보여 준다
    shared = tmux("show", "-gqv", "@hivemux-scroll").strip()
    scrolled = 0.0                   # when the wheel last turned here / 여기서 휠을 마지막으로 굴린 시각
    board_blink = False
    REMOTE_ON = False
    try:
        while True:
            nowf = time.time()
            if snap is None or nowf - last_poll >= 1.0:
                snap = snapshot()
                last_poll = nowf
                if snap is None:
                    break
                v = tmux("show", "-gqv", "@hivemux-scroll").strip()
                if v != shared:
                    shared = v
                    if v.isdigit() and not scrolled:
                        SCROLL = int(v)
                ANIM = tmux("show", "-gqv", "@hivemux-anim").strip() != "off"
                # a screen attached from another Mac (bin/hivemux-attach): every animation frame and
                # status line spinner step would go over the network and make its typing lag, so keep
                # them still while it looks at this window (the spinner: while it is attached at all)
                # 다른 Mac 에서 붙은 화면 (bin/hivemux-attach): 애니메이션 프레임과 상태줄 스피너가 모두
                # 네트워크로 가서 입력이 느려지므로, 그 화면이 이 창을 보는 동안 멈춘다 (스피너는 붙어 있는 동안)
                # only screens still attached count: a detach the hook missed leaves its name behind
                # 지금 붙어 있는 화면만 센다: 훅이 놓친 분리는 이름을 남긴다
                remote = set(tmux("show", "-gqv", "@hivemux-remote-clients").split())
                clients = [l.split(" ", 1) for l in tmux("list-clients", "-F", "#{client_name} #{window_id}").splitlines() if " " in l]
                REMOTE_ON = any(c in remote for c, _ in clients)
                REMOTE_HERE = None
                if REMOTE_ON:
                    mine = tmux("display", "-p", "-t", ME, "#{window_id}").strip()
                    here = [c for c, w in clients if c in remote and w == mine]
                    if here:
                        ANIM = False
                        # the Mac's name when hivemux connect told it (bin/hivemux-attach) / hivemux connect 가 알려 줬으면 그 Mac 이름
                        macs = dict(l.split(" ", 1) for l in tmux("show", "-gqv", "@hivemux-remote-from").splitlines() if " " in l)
                        REMOTE_HERE = next((macs[c] for c in here if c in macs), "")
                        # the name it goes by there (Settings, sent by its hivemux-ports) / 그 Mac 에서 정한 이름 (설정, 그 Mac 의 hivemux-ports 가 보냄)
                        if REMOTE_HERE:
                            REMOTE_HERE = tmux("show", "-gqv", f"@hivemux-name-{REMOTE_HERE}").strip() or REMOTE_HERE
                # @hivemux-fps: animation frames per second (default 30; lower saves CPU)
                # @hivemux-fps: 초당 애니메이션 프레임 (기본 30, 낮추면 CPU 절약)
                fps = tmux("show", "-gqv", "@hivemux-fps").strip()
                TICK = 1 / max(5, min(60, int(fps))) if fps.isdigit() else 1 / 30
                if snap[2]:
                    clear_answered(snap[0], waits, nowf)
                    clear_interrupted(snap[0], runs, nowf)
                    clear_quit(quits)
                notify_changes(snap[0], seen, sent, nowf,
                               snap[2] and tmux("show", "-gqv", "@hivemux-notify").strip() != "off")
                # focus moved elsewhere (clicked another pane): close the menu / 다른 칸을 눌러 초점이 떠났으면 메뉴를 닫는다
                if MENU and tmux("display", "-p", "-t", ME, "#{pane_active}#{window_active}").strip() != "11":
                    menu_close()
            items, current, visible, cur_sess, sessions, homes = snap
            # a popup is open: do not draw (but always draw the first frame)
            # 팝업이 열려 있음: 그리지 않는다 (첫 화면은 그린다)
            if os.path.exists(PAUSE) and prev is not None:
                r, _, _ = select.select([fd, WAKE_R], [], [], 0.2)
                for f in r:
                    try:
                        os.read(f, 1024)
                    except BlockingIOError:
                        pass
                continue
            animating = visible and ANIM and any(p["@claude_state"] in ("run", "wait") for p in items)
            FRAME += 1
            NOW_T = time.time()
            if visible:
                # Spinner for running windows in the top status line (driven by the visible sidebar)
                # 맨 위 창 목록의 작업 중 스피너 (보이는 사이드바 하나가 맡는다)
                # 6 steps/s, independent of the frame rate, so tmux is not asked to redraw 30x/s
                # 프레임 수와 상관없이 초당 6번: tmux 상태줄을 초당 30번 다시 그리지 않게
                spin = SPIN[int(NOW_T * 6) % len(SPIN)] if animating and not REMOTE_ON and any(p["@claude_state"] == "run" for p in items) else ""
                if spin != last_spin:
                    if spin:
                        tmux("set", "-g", "@claude_spin", spin)
                    else:
                        tmux("set", "-gu", "@claude_spin")
                    tmux("refresh-client", "-S")
                    last_spin = spin
                # a finished task you are looking at becomes "seen": on the screen that has the keyboard
                # focus, not one that is only attached (another Ghostty window, another Mac), where it
                # used to turn idle at once while you looked elsewhere
                # 보고 있는 완료 작업은 "봤음": 키보드 초점이 있는 화면에 떠 있을 때만. 붙어만 있는 화면
                # (다른 Ghostty 창, 다른 Mac) 에서도 바로 대기로 바뀌어, 다른 곳을 보는 동안 완료가 사라졌다
                done_here = next((p for p in items if p["pane_id"] == current and p["@claude_state"] == "done"), None)
                focused = done_here and done_here["window_id"] in {
                    l.split(" ", 1)[0] for l in tmux("list-clients", "-F", "#{window_id} #{client_flags}").splitlines()
                    if "focused" in l}
                if focused:
                    tmux("set", "-p", "-t", current, "@claude_state", "idle")
                    tmux("set", "-w", "-t", current, "@claude_state", "idle")
                    done_here["@claude_state"] = "idle"
                # the pickup board (see board), redrawn on every screen only when it changes
                # 호출판 (board 참고). 바뀔 때만 모든 화면의 상태줄을 다시 그린다
                # the project badge, as wide as the sidebar (see badges) / 사이드바 폭의 프로젝트 이름표 (badges 참고)
                key = (os.get_terminal_size()[0] + 1, tuple(s for s, _, _ in sessions))
                if key != last_badge:
                    badges(*key)
                    last_badge = key
                # it blinks like the sidebar animates: not with animation off, nor while a screen from
                # another Mac is attached (every blink would go over the network)
                # 사이드바 애니메이션처럼: 애니메이션을 껐거나 다른 Mac 의 화면이 붙어 있으면 깜빡이지 않는다
                # (깜빡일 때마다 네트워크로 간다)
                b, board_blink = board(items, NOW_T, ANIM and not REMOTE_ON)
                if b != last_board:
                    if b != tmux("show", "-gqv", "@hivemux-board").rstrip("\n"):
                        tmux("set", "-g", "@hivemux-board", b)
                        for c in tmux("list-clients", "-F", "#{client_name}").split():
                            tmux("refresh-client", "-S", "-t", c)
                    last_board = b
            # draw while visible; a hidden sidebar draws its first frame too, so it is ready when shown
            # 보일 때 그린다. 숨은 사이드바도 첫 화면은 그려 두어 보일 때 바로 나오게 한다
            # hidden sidebars draw only when woken (a project closed, a state changed), so the
            # window you switch to never shows an old frame first
            # 숨은 사이드바는 깨울 때만 그린다 (프로젝트 닫힘, 상태 바뀜). 옮겨 간 창이 예전 화면을 먼저 보이지 않게
            if visible or prev is None or woke:
                woke = False
                w, h = os.get_terminal_size()
                lines, (targets, heads) = render(items, current, w, h, cur_sess, sessions, homes)
                # Draw only rows that changed since the last frame; a full redraw only on
                # the first frame or a resize. Cuts what tmux has to parse by ~10x.
                # 직전 프레임과 달라진 줄만 그린다. 첫 프레임과 크기 변경 때만 전체를 그린다.
                # NOTE: keep this separate from the input buffer `buf` (mixing them made the
                # sidebar parse its own output as keys and jump around)
                # 주의: 입력 버퍼 `buf` 와 다른 변수를 쓴다 (섞이면 자기 출력을 키로 읽어 마구 이동한다)
                if prev is None or prev_size != (w, h) or resized[0]:
                    frame = "\x1b[H" + "\r\n".join(lines)
                    resized[0] = False
                else:
                    frame = "".join(f"\x1b[{i + 1};1H{ln}" for i, ln in enumerate(lines) if i >= len(prev) or prev[i] != ln)
                if frame:
                    out.write(frame + "\x1b[0m")
                    out.flush()
                prev, prev_size = lines, (w, h)
            if PENDING:
                act, PENDING = PENDING, None
                act()
            wait_s = TICK if animating else (1.0 if visible else 3.0)
            if visible and board_blink:          # wake for the next blink step / 다음 깜빡임에 맞춰 깬다
                wait_s = min(wait_s, 0.5 - (time.time() % 0.5) + 0.01)
            if scrolled:
                if time.time() - scrolled >= 0.25:
                    scrolled, shared = 0.0, str(SCROLL)
                    tmux("set", "-g", "@hivemux-scroll", shared)
                    for l in tmux("list-panes", "-a", "-F", "#{pane_id} #{pane_pid} #{m:*hivemux-sidebar-view*,#{pane_start_command}}").splitlines():
                        pid_, ppid, ok = (l.split() + ["", "", ""])[:3]
                        if ok == "1" and pid_ != ME:
                            try:
                                os.kill(int(ppid), signal.SIGUSR1)
                            except (OSError, ValueError):
                                pass
                else:
                    wait_s = min(wait_s, 0.26 - (time.time() - scrolled))
            r, _, _ = select.select([fd, WAKE_R], [], [], wait_s)
            if WAKE_R in r:
                try:
                    os.read(WAKE_R, 512)
                except BlockingIOError:
                    pass
                last_poll, woke = 0, True
            if fd not in r:
                continue
            last_poll = 0  # re-read right after a click or key / 클릭/키 입력 뒤에는 바로 새로 읽는다
            chunk = os.read(fd, 1024).decode(errors="ignore")
            if os.environ.get("HIVEMUX_DEBUG_INPUT"):   # debug: log raw input / 디버그: 받은 입력 기록
                with open(os.environ["HIVEMUX_DEBUG_INPUT"], "a") as dbg:
                    dbg.write(f"{time.time():.3f} {ME} {chunk!r}\n")
            buf += chunk
            order = os.path.join(os.path.dirname(os.path.realpath(__file__)), "hivemux-order")
            sess_of = {p["pane_id"]: p["session_name"] for p in items + homes}
            released = False
            for m in re.finditer(r"\x1b\[<(\d+);(\d+);(\d+)([Mm])", buf):
                b, x, y, kind = int(m.group(1)), int(m.group(2)), int(m.group(3)), m.group(4)
                w_now = os.get_terminal_size()[0]
                row = y - 1
                if MENU:
                    # The menu takes the mouse: hover highlights, a left click runs an item, a click
                    # elsewhere closes it, a right click elsewhere opens it there
                    # 메뉴가 마우스를 받는다: 올리면 강조, 왼쪽 클릭은 실행, 다른 곳 클릭은 닫기, 다른 곳 오른쪽 클릭은 거기서 다시 열기
                    at = MENU["at"].get(row)
                    if b in (32, 35, 34):            # move / 움직임
                        MENU["sel"] = at
                    elif b == 0 and kind == "M":
                        MENU["press"] = at
                        if at is None:
                            menu_close()
                            released = True
                    elif b == 0 and kind == "m":
                        if at is not None and MENU["press"] == at:
                            menu_run(at)
                            released = True
                    elif b == 2 and kind == "m":
                        if at is None and x < w_now:
                            menu(row, pid=pick(targets, row, x), sess=pick(heads, row, x), items=items, homes=homes)
                    continue
                if b in (64, 65):               # wheel: scroll the list 3 rows / 휠: 목록을 3줄씩 스크롤
                    SCROLL = max(0, SCROLL + (3 if b == 65 else -3))
                    woke, scrolled = True, time.time()
                    continue
                if b == 32 and kind == "M":     # motion with the left button held / 왼쪽 버튼을 누른 채 움직임
                    if DRAG:
                        if row != DRAG["y"] or abs(x - DRAG["x"]) > 1:
                            DRAG["moved"] = True
                        if DRAG["kind"] == "card":
                            o = pick(targets, row, x)
                            DRAG["over"] = o if o and sess_of.get(o) == sess_of.get(DRAG["src"]) else None
                        else:
                            DRAG["over"] = pick(heads, row, x) or sess_of.get(pick(targets, row, x))
                    continue
                if b == 2 and kind == "m":      # right button released: open the menu now, so this release cannot close it
                    # 오른쪽 버튼 뗌: 이때 메뉴를 연다 (누를 때 열면 이 뗌이 메뉴를 바로 닫아 버린다)
                    DRAG = None
                    # on a card: task menu; on a project name or empty space: new Claude / new project
                    # (empty space: for the project shown in this window). It keeps focus for its keys
                    # 카드: 작업 메뉴, 프로젝트 이름 줄이나 빈 곳: 새 Claude / 새 프로젝트 (빈 곳은 이 창의 프로젝트).
                    # 메뉴 키를 받도록 초점을 둔다
                    if x < w_now:
                        menu(row, pid=pick(targets, row, x), sess=pick(heads, row, x), items=items, homes=homes)
                    else:
                        released = True
                    continue
                if b == 0 and kind == "m":      # left button released / 왼쪽 버튼 뗌
                    released = True
                    d, DRAG = DRAG, None
                    if not d:
                        continue
                    if d["moved"]:
                        if d["over"] and d["over"] != d["src"]:
                            subprocess.run([order, d["kind"], d["src"], d["over"]],
                                           stdin=subprocess.DEVNULL, capture_output=True)
                            last_poll = 0
                    elif d["kind"] == "group":       # click on a project name: go to it / 프로젝트 이름 클릭: 그 프로젝트로
                        tmux("switch-client", "-t", "=" + d["src"])
                    elif d["kind"] == "card" and any(p["pane_id"] == d["src"] for p in homes):
                        pass                         # a Claude at home: the menu clocks it in, not a click / 집에 간 Claude: 출근은 메뉴에서, 클릭은 아니다
                    elif d["kind"] == "card":
                        pid = d["src"]
                        # Double click: the first click may switch sessions, so remember it in a tmux global option
                        # 더블클릭: 첫 클릭이 다른 세션으로 이동시키므로 기록은 tmux 전역 옵션에 둔다
                        last = tmux("show", "-gqv", "@hivemux-lastclick").split()
                        t = time.time()
                        tmux("set", "-g", "@hivemux-lastclick", f"{pid} {t:.3f}")
                        if len(last) == 2 and last[0] == pid and t - float(last[1]) < 0.45:
                            tmux("set", "-gu", "@hivemux-lastclick")
                            rename(pid)
                        else:
                            goto(pid)
                    continue
                if kind != "M" or x >= w_now:   # grip column: tmux handles the drag (see hivemux.tmux) / 오른쪽 끝 핸들: 끌기는 tmux 가 처리한다
                    continue
                if b == 0 and SHIFT_BTN is not None and row == SHIFT_BTN:
                    DRAG, released = None, True     # clock in / 출근
                    bg_run(os.path.join(os.path.dirname(os.path.realpath(__file__)), "hivemux-shift"), "--popup", "on",
                           active_client(tmux("display", "-p", "-t", ME, "#{session_name}").strip()))
                    continue
                if b == 0 and OFFICE_BTN and row == OFFICE_BTN[0] and OFFICE_BTN[1] <= x - 1 < OFFICE_BTN[2]:
                    DRAG, released = None, True     # the bee office button / 벌 사무실 버튼
                    office()
                    continue
                if b == 0:
                    # Press: start a possible drag; it is a click if released on the same row
                    # 누름: 끌기 시작 후보. 같은 줄에서 떼면 클릭
                    DRAG = None
                    tp, hp = pick(targets, row, x), pick(heads, row, x)
                    if tp:
                        DRAG = {"kind": "card", "src": tp, "over": tp, "moved": False, "y": row, "x": x}
                    elif hp:
                        DRAG = {"kind": "group", "src": hp, "over": hp, "moved": False, "y": row, "x": x}
                    released = not tp and not hp
                # right press: nothing yet, the menu opens on release (above)
                # 오른쪽 누름: 아직 아무것도 하지 않는다. 메뉴는 뗄 때 연다 (위)
            # A click moves tmux focus to the sidebar; give it back to this window's work pane
            # 클릭하면 tmux가 초점을 사이드바로 옮긴다. 이 창의 작업 칸으로 돌려놓는다
            # (otherwise the sidebar is saved/restored as active and the window gets named Python)
            # (안 그러면 초점이 사이드바에 남은 채 저장/복원되고 창 이름도 Python이 된다)
            if released and current:
                tmux("select-pane", "-t", current)
            rest = re.sub(r"\x1b\[<\d+;\d+;\d+[Mm]", "", buf)
            buf = ""
            # Keys are honoured only when a single key arrives on its own. Anything else
            # (escape sequences, pasted or injected text) is ignored, so stray input can
            # never fire a burst of jumps.
            # 키는 한 글자가 단독으로 들어왔을 때만 처리한다. 제어 신호, 붙여넣기, 다른 곳에서
            # 들어온 글자는 무시해서 엉뚱한 입력이 연속 이동을 일으키지 못하게 한다.
            if MENU and rest:
                # menu keys: ↑↓ choose, Enter run, the letter in (x) runs that item, Esc / q close
                # 메뉴 키: ↑↓ 고르기, Enter 실행, (x) 글자는 그 항목 실행, Esc / q 닫기
                live = [i for i, r in enumerate(MENU["rows"]) if r]
                cur = MENU["sel"] if MENU["sel"] in live else None
                if rest in ("\x1b[A", "\x1bOA", "\x1b[B", "\x1bOB"):
                    step = -1 if rest in ("\x1b[A", "\x1bOA") else 1
                    k = live.index(cur) + step if cur is not None else (0 if step > 0 else len(live) - 1)
                    MENU["sel"] = live[k % len(live)]
                elif rest in ("\r", "\n"):
                    if cur is not None:
                        menu_run(cur)
                        tmux("select-pane", "-t", current) if current else None
                elif rest in ("\x1b", "q", "\x03"):
                    menu_close()
                    if current:
                        tmux("select-pane", "-t", current)
                else:
                    hit = next((i for i in live if MENU["rows"][i][1] == rest), None)
                    if hit is not None:
                        menu_run(hit)
                        if current:
                            tmux("select-pane", "-t", current)
            elif rest and len(rest) == 1:
                if "1" <= rest <= "9":
                    tmux("run-shell", "-b", os.path.join(os.path.dirname(os.path.realpath(__file__)), "hivemux-agents") + f" jump {rest}")
                elif rest in ("q", "\x1b"):
                    tmux("select-pane", "-t", "{last}")
            elif rest and os.environ.get("HIVEMUX_DEBUG_INPUT"):
                with open(os.environ["HIVEMUX_DEBUG_INPUT"], "a") as dbg:
                    dbg.write(f"{time.time():.3f} {ME} IGNORED {rest!r}\n")
    finally:
        out.write("\x1b[?1003l\x1b[?1000l\x1b[?1002l\x1b[?1006l\x1b[?7h\x1b[?25h\x1b[?1049l\x1b[0m")
        out.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


if __name__ == "__main__":
    if len(sys.argv) == 3 and sys.argv[1] == "--name":
        fmt = US.join("#{%s}" % f for f in FIELDS)
        line = tmux("display", "-p", "-t", sys.argv[2], fmt).strip("\n")
        p = dict(zip(FIELDS, line.split(US)))
        print(task_name(p) if len(p) == len(FIELDS) else "")
        sys.exit(0)
    try:
        main()
    except KeyboardInterrupt:
        pass
