#!/bin/bash
# Keep a Claude status sidebar pane on the left of every tmux window.
# 각 tmux 창 왼쪽에 Claude 상태 사이드바 칸을 유지한다.
#   hivemux-sidebar ensure [window_id]   create the sidebar in that window (default: all) if missing
#                                        그 창(기본: 모든 창)에 사이드바가 없으면 만든다
#   hivemux-sidebar fix                  reset every sidebar to @hivemux-sidebar-width
#                                        모든 사이드바 폭을 @hivemux-sidebar-width 로 되돌린다
#   hivemux-sidebar reap                 close windows that only contain a sidebar
#                                        사이드바만 남은 창을 닫는다
#   hivemux-sidebar rebuild              after restore: drop sidebars restored as shells, recreate
#                                        복원 직후: 셸로 복원된 사이드바 칸을 지우고 다시 만든다
#   hivemux-sidebar focus                move focus off sidebars to the work pane
#                                        초점이 사이드바에 있는 창은 작업 칸으로 옮긴다
#   hivemux-sidebar toggle               hide / show all (@hivemux-sidebar on|off)
#                                        모두 숨기기 / 다시 보이기 (@hivemux-sidebar on|off)
# Sidebar panes are identified by the pane title "hivemux-sidebar" (tmux-resurrect saves/restores titles).
# 사이드바 칸은 칸 제목 "hivemux-sidebar" 로 구분한다 (tmux-resurrect 가 제목을 저장/복원).
HM_BIN="$(cd "$(dirname "$(realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"
TMUX_BIN="$(command -v tmux || echo /opt/homebrew/bin/tmux)"
# UI language: HIVEMUX_LANG > tmux @hivemux-lang (set by hivemux setup) > LANG
# 화면 언어: HIVEMUX_LANG > tmux @hivemux-lang (hivemux setup 이 정함) > LANG
say() { local v="${HIVEMUX_LANG:-$("$TMUX_BIN" show -gqv @hivemux-lang 2>/dev/null)}"; if [[ "${v:-$LANG}" == ko* ]]; then printf '%s' "$1"; else printf '%s' "$2"; fi; }
t() { "$TMUX_BIN" "$@"; }
TITLE=hivemux-sidebar
W="$(t show -gqv @hivemux-sidebar-width)"; W="${W:-32}"
ON="$(t show -gqv @hivemux-sidebar)"; ON="${ON:-on}"

sidebars_in() { t list-panes -t "$1" -F '#{pane_id} #{pane_title}' 2>/dev/null | awk -v T="$TITLE" '$2==T{print $1}'; }

ensure_one() {
  local win="$1" n
  [ "$ON" = on ] || return 0
  [ -n "$(t show -gqv @hivemux-suspend)" ] && return 0          # restore in progress / 복원 중
  [ "$(t display -p -t "$win" '#{session_name}' 2>/dev/null)" = 0 ] && return 0   # hivemux-attach bootstrap session / hivemux-attach 부트스트랩 세션
  [ -n "$(sidebars_in "$win")" ] && return 0
  # Several hooks can call ensure for the same window at once (new window, window
  # change, config load). Lock per window so only one creates the sidebar.
  # 같은 창에 ensure 가 동시에 여러 번 불릴 수 있다(새 창, 창 전환, 설정 읽기).
  # 창마다 잠금을 걸어 한 번만 만든다.
  local lock="${TMPDIR:-/tmp}/hivemux-ensure-$(id -u)-$(t display -p '#{pid}')-${win#@}"
  if ! mkdir "$lock" 2>/dev/null; then
    # stale lock (crashed run) older than 10s: take it over / 10초 넘은 잠금은 비정상 종료로 보고 넘겨받는다
    [ -n "$(find "$lock" -maxdepth 0 -mtime -10s 2>/dev/null)" ] && return 0
    rmdir "$lock" 2>/dev/null; mkdir "$lock" 2>/dev/null || return 0
  fi
  if [ -z "$(sidebars_in "$win")" ]; then
    n="$(t list-panes -t "$win" 2>/dev/null | wc -l | tr -d ' ')"
    if [ "${n:-0}" -ge 1 ]; then
      local first pid; first="$(t list-panes -t "$win" -F '#{pane_id}' | head -1)"
      pid="$(t split-window -hbdf -l "$W" -t "$first" -P -F '#{pane_id}' "exec $HM_BIN/hivemux-sidebar-view")"
      if [ -n "$pid" ]; then
        t select-pane -t "$pid" -T "$TITLE"
        t set -p -t "$pid" allow-set-title off 2>/dev/null
        t set -p -t "$pid" allow-rename off 2>/dev/null
      fi
    fi
  fi
  rmdir "$lock" 2>/dev/null
}

case "$1" in
  ensure)
    if [ -n "$2" ]; then ensure_one "$2"
    else t list-windows -a -F '#{window_id}' | while read -r w; do ensure_one "$w"; done; fi ;;
  fix)
    t list-panes -a -F '#{pane_id} #{pane_title} #{pane_width}' | awk -v T="$TITLE" -v W="$W" '$2==T && $3!=W{print $1}' |
      while read -r p; do t resize-pane -t "$p" -x "$W"; done ;;
  reap)
    t list-windows -a -F '#{window_id}' | while read -r w; do
      total="$(t list-panes -t "$w" | wc -l | tr -d ' ')"; side="$(sidebars_in "$w" | wc -l | tr -d ' ')"
      [ "$total" -gt 0 ] && [ "$total" = "$side" ] && t kill-window -t "$w"
    done ;;
  rebuild)
    # Right after a restore (called after bin/hivemux-panes restore).
    # 복원 직후 (bin/hivemux-panes restore 다음에 호출).
    # tmux-resurrect brings saved sidebar panes back as plain shells, and the shell overwrites the title,
    # tmux-resurrect 는 저장 당시 사이드바 칸을 일반 셸로 되살리고, 셸이 칸 제목을 덮어쓴다.
    # so read which pane indexes were sidebars from the snapshot file instead of the title.
    # 그래서 제목이 아니라 저장본 파일에서 "사이드바였던 칸 번호"를 읽어 지운다.
    # Resolve all pane ids first, then kill, so indexes do not shift.
    # 칸 id 를 먼저 모두 구한 뒤 지워야 번호가 밀리지 않는다.
    dir="$(t show -gqv @resurrect-dir)"; dir="${dir/#\~/$HOME}"
    [ -n "$dir" ] || { [ -d "$HOME/.tmux/resurrect" ] && dir="$HOME/.tmux/resurrect" || dir="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"; }
    ghosts=""
    if [ -f "$dir/last" ]; then
      while read -r target; do
        id="$(t display -p -t "$target" '#{pane_id} #{pane_current_command}' 2>/dev/null)" || continue
        case "${id#* }" in Python|python3) continue ;; zsh|bash|fish|sh|cat) ghosts+="${id%% *} " ;; esac
      done < <(awk -F '\t' -v T="$TITLE" '$1=="pane" && ($7==T || $7=="claude-sidebar" || $10=="Python" || $10=="python3") {print $2":"$3"."$6}' "$dir/last")
    fi
    # also the ones that still have the title
    # 제목이 남아 있는 경우도 함께
    ghosts+="$(t list-panes -a -F '#{pane_id} #{pane_title} #{pane_current_command}' |
      awk -v T="$TITLE" '$2==T && $3!="Python" && $3!="python3"{printf "%s ", $1}')"
    for p in $ghosts; do t kill-pane -t "$p" 2>/dev/null; done
    "$0" ensure
    "$0" focus ;;
  focus)
    # Move focus off the sidebar to the widest work pane
    # 초점이 사이드바에 있는 창은 가장 넓은 작업 칸으로 옮긴다
    t list-windows -a -F '#{window_id} #{pane_title}' | awk -v T="$TITLE" '$2==T{print $1}' | while read -r w; do
      p="$(t list-panes -t "$w" -F '#{pane_width} #{pane_id} #{pane_title}' | awk -v T="$TITLE" '$3!=T' | sort -rn | head -1 | awk '{print $2}')"
      [ -n "$p" ] && t select-pane -t "$p"
    done ;;
  toggle)
    if [ "$ON" = on ]; then
      t set -g @hivemux-sidebar off
      t list-panes -a -F '#{pane_id} #{pane_title}' | awk -v T="$TITLE" '$2==T{print $1}' | while read -r p; do t kill-pane -t "$p"; done
      t display -d 1500 "$(say "사이드바 숨김 (prefix b 로 다시 보기)" "Sidebars hidden (prefix b to show)")"
    else
      t set -g @hivemux-sidebar on; ON=on; "$0" ensure
    fi ;;
  *) echo "usage: $0 ensure [win]|fix|reap|rebuild|toggle" >&2; exit 2 ;;
esac
exit 0
