#!/bin/bash
# Start Claude Code with the account this project uses (bin/hivemux-account): the project's own, else the one chosen
# for all. Another account is its own config dir (CLAUDE_CONFIG_DIR); the default one is ~/.claude.
# The resume paths (bin/hivemux-panes, -shift, -claude-update, -team) run this through HIVEMUX_CLAUDE.
# 이 프로젝트가 쓰는 계정으로 Claude Code 를 시작한다 (bin/hivemux-account): 프로젝트에 정한 계정, 없으면 전체 계정.
# 다른 계정은 자기 설정 폴더(CLAUDE_CONFIG_DIR)이고, 기본 계정은 ~/.claude 다.
# 재개하는 곳들(bin/hivemux-panes, -shift, -claude-update, -team)이 HIVEMUX_CLAUDE 로 이것을 부른다.
# A pane whose Claude was started through a wrapper (@claude_launch, bin/hivemux-hook) starts that instead.
# 래퍼로 시작한 Claude 의 칸 (@claude_launch, bin/hivemux-hook) 은 그 래퍼를 실행한다.
#   HIVEMUX_ACCOUNT_SESSION=<project>   the project when not run in a pane / 칸 밖에서 실행할 때 프로젝트
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/hivemux"
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin"
sess="${HIVEMUX_ACCOUNT_SESSION:-}"
[ -z "$sess" ] && [ -n "$TMUX_PANE" ] && sess="$(tmux display -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null)"
name=""
[ -n "$sess" ] && [ -f "$DATA/account-projects" ] && name="$(awk -F '\t' -v s="$sess" '$1 == s { print $2; exit }' "$DATA/account-projects")"
[ -n "$name" ] || name="$(cat "$DATA/account" 2>/dev/null)"
# at its usage limit: the API key account chosen to go on with, until the limit resets (bin/hivemux-account fallback)
# 사용 한도에 걸림: 이어 가도록 고른 API 키 계정으로, 한도가 풀릴 때까지 (bin/hivemux-account fallback)
chosen="${name:-default}"
fb=""; [ -n "$sess" ] && fb="$(awk -F '\t' -v s="$sess" '$1 == s { print $2; exit }' "$DATA/account-fallback-projects" 2>/dev/null)"
[ -n "$fb" ] || fb="$(cat "$DATA/account-fallback" 2>/dev/null)"
[ "$fb" = off ] && fb=""
if [ -n "$fb" ] && [ "$fb" != "${name:-default}" ] && [ -s "$DATA/accounts/$fb/api-key" ] &&
  awk -F '\t' -v a="${name:-default}" -v now="$(date +%s)" '$1 == a && $2 > now { f = 1 } END { exit !f }' \
    "$DATA/account-limited" 2>/dev/null; then name="$fb"; fi
if [ -n "$name" ] && [ "$name" != default ] && [ -d "$DATA/accounts/$name" ]; then export CLAUDE_CONFIG_DIR="$DATA/accounts/$name"
  # the conversations must be ~/.claude's: a projects folder of the account's own (or none yet) is merged and
  # linked first, or --resume finds nothing (bin/hivemux-account)
  # 대화는 ~/.claude 의 것이어야 한다: 계정만의 projects 폴더가 있거나 아직 없으면 먼저 합치고 링크한다.
  # 아니면 --resume 이 아무것도 찾지 못한다 (bin/hivemux-account)
  [ -L "$CLAUDE_CONFIG_DIR/projects" ] || "$(dirname "$(realpath "$0")")/hivemux-account" env >/dev/null 2>&1
  # an API key account (bin/hivemux-account add-key): the key goes before any login / API 키 계정: 키가 로그인보다 앞선다
  [ -s "$CLAUDE_CONFIG_DIR/api-key" ] && { ANTHROPIC_API_KEY="$(cat "$CLAUDE_CONFIG_DIR/api-key")"; export ANTHROPIC_API_KEY; }
  # it runs through the Agent SDK (bin/hivemux-sdk) unless set to run Claude Code on the key: some credits are
  # for the SDK only / Claude Code 로 쓰게 정하지 않았으면 Agent SDK 로 돈다 (bin/hivemux-sdk): SDK 에만 쓰이는
  # 크레딧이 있다
  if [ -n "$ANTHROPIC_API_KEY" ] && [ "$(cat "$CLAUDE_CONFIG_DIR/runner" 2>/dev/null)" != claude ]; then
    export HIVEMUX_SDK_ACCOUNT="$chosen" HIVEMUX_SDK_PROJECT="$sess"
    exec "$(dirname "$(realpath "$0")")/hivemux-sdk" "$@"
  fi
# default: forget only a dir of ours (a shell started under another account); one you set yourself stays
# 기본 계정: 우리 폴더일 때만 지운다 (다른 계정일 때 연 셸). 직접 정한 것은 그대로
elif [[ "$CLAUDE_CONFIG_DIR" == "$DATA/accounts/"* ]]; then unset CLAUDE_CONFIG_DIR; fi
via=""; [ -n "$TMUX_PANE" ] && via="$(tmux show -pqv -t "$TMUX_PANE" @claude_launch 2>/dev/null)"
if [ -n "$via" ]; then read -ra via <<< "$via"; exec "${via[@]}" "$@"; fi
exec claude "$@"
