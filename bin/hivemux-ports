#!/usr/bin/env python3
"""Forward the other Mac's dev servers to this Mac while connected (started by hivemux-connect).
연결해 있는 동안 상대 Mac 의 개발 서버를 이 Mac 으로 이어 준다 (hivemux-connect 가 띄운다).

  hivemux-ports <host> <tty>     run until hivemux-connect (the parent) ends / hivemux-connect(부모)가 끝날 때까지
  hivemux-ports --list           forwarded ports of every connection / 모든 연결의 이어 준 포트
  hivemux-ports --pick <client>  the port list popup (Option+W, sidebar menu) / 포트 목록 팝업 (Option+W, 사이드바 메뉴)
  hivemux-ports --me             this Mac's name as used in the options below / 아래 옵션에 쓰는 이 Mac 이름

Every few seconds it asks the other Mac which TCP ports are listened on by processes started
inside its tmux (a dev server Claude or a shell started: npm run dev, rails s ...), and forwards
each to the same port on this Mac's localhost over its own ssh connection, so
http://localhost:5173 here opens the server there. A port taken here goes to the next free one.
No notification: Option+W lists them (<tty> is accepted and unused).
몇 초마다 상대 Mac 의 tmux 안에서 시작된 프로세스(Claude 나 셸이 띄운 개발 서버: npm run dev,
rails s ...)가 듣는 TCP 포트를 묻고, 따로 연 ssh 연결로 이 Mac 의 localhost 같은 포트에 잇는다.
그래서 여기서 http://localhost:5173 을 열면 거기 서버가 열린다. 여기서 이미 쓰는 포트면 다음 빈
포트로 잇는다. 알림은 없다: Option+W 로 목록을 본다 (<tty> 는 받기만 하고 안 쓴다).
State: $XDG_DATA_HOME/hivemux/ports/<host> ("<local> <remote> <command>" per line).
상태: $XDG_DATA_HOME/hivemux/ports/<host> (한 줄에 "<여기 포트> <거기 포트> <명령>").
The other Mac's tmux gets the same list as @hivemux-ports-<this Mac>, so its port list popup
(bin/hivemux-ports-ui) shows it; Enter there sets @hivemux-ports-open-<this Mac> to the port and
the next poll here opens it in this Mac's browser.
상대 Mac 의 tmux 에도 같은 목록을 @hivemux-ports-<이 Mac> 으로 둔다. 그래서 거기 포트 목록 팝업
(bin/hivemux-ports-ui)에 보이고, 거기서 Enter 를 누르면 @hivemux-ports-open-<이 Mac> 에 포트를 적고,
여기서 다음에 물을 때 이 Mac 의 브라우저로 연다.
The same way, the open-path popup there (bin/hivemux-open-ui) on a screen from this Mac sets
@hivemux-edit-<this Mac> to "<editor> <line> <col> <path>", and this opens that file of the other
Mac in VS Code / Cursor here over Remote-SSH. @hivemux-seen-<this Mac> is the time of the last poll and @hivemux-name-<this Mac> the name shown for it,
so the popup knows a request will be picked up.
Ctrl+V in a Claude pane there on a screen from this Mac (bin/hivemux-paste) sets
@hivemux-paste-<this Mac> to "<id> <pane> <client>" and wakes the tmux channel hivemux-paste-<this Mac>,
which this waits on over the same ssh connection: the image on this Mac's clipboard is copied there and
its path pasted into that pane, and Claude Code turns it into [Image #N].
The bee office button there (bin/hivemux-office) on a screen from this Mac sets @hivemux-office-<this Mac>
and wakes the same channel: the window opens on this Mac, with the other Mac's sessions next door.
hivemux open there (bin/hivemux-show; Tab in the open-path popup) sets @hivemux-show-<this Mac> to
"<id> <client>" and the paths, one a line: each file is copied to /tmp/hivemux-show-<uid>/ here and opened.
같은 식으로, 이 Mac 에서 붙은 화면의 경로 열기 팝업(bin/hivemux-open-ui)은 @hivemux-edit-<이 Mac> 에
"<편집기> <줄> <칸> <경로>" 를 적고, 여기서 그 Mac 의 파일을 이 Mac 의 VS Code / Cursor 원격 SSH 로 연다.
@hivemux-seen-<이 Mac> 은 마지막으로 물은 시각이라, 팝업이 요청이 처리될지 안다.
이 Mac 에서 붙은 화면의 Claude 칸에서 Ctrl+V 를 누르면 (bin/hivemux-paste) @hivemux-paste-<이 Mac> 에
"<번호> <칸> <화면>" 을 적고 tmux 채널 hivemux-paste-<이 Mac> 을 깨운다. 여기서는 같은 ssh 연결로 그 채널을
기다리다가, 이 Mac 클립보드의 이미지를 그쪽에 복사하고 경로를 그 칸에 붙여 넣는다. Claude Code 가 그걸
[Image #N] 으로 바꾼다.
이 Mac 에서 붙은 화면의 벌 사무실 버튼(bin/hivemux-office)은 @hivemux-office-<이 Mac> 을 적고 같은 채널을
깨운다. 그러면 창이 이 Mac 에서 열리고, 상대 Mac 의 세션은 옆 사무실에 나온다.
거기서 hivemux open (bin/hivemux-show, 경로 열기 팝업의 Tab)은 @hivemux-show-<이 Mac> 에 "<번호> <화면>" 과
경로를 한 줄에 하나씩 적는다: 파일마다 여기 /tmp/hivemux-show-<uid>/ 로 복사해 연다.
"""
import os, re, shlex, signal, socket, subprocess, sys, tempfile, threading, time, urllib.parse

DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "hivemux", "ports")
POLL = 3
PATH = "PATH=/opt/homebrew/bin:/usr/local/bin:$PATH"
# HIVEMUX_SSH: another ssh command, e.g. "ssh -F <config>" (used for testing) / 다른 ssh 명령 (시험용)
SSH = shlex.split(os.environ.get("HIVEMUX_SSH") or "ssh")
SSH_OPTS = ["-o", "BatchMode=yes", "-o", "ServerAliveInterval=3", "-o", "ServerAliveCountMax=2", "-o", "ConnectTimeout=10"]

# Runs on the other Mac: "<port> <command>" for every TCP port listened on by a process of its tmux
# server (its panes and everything they started). ssh gives a plain PATH there.
# 상대 Mac 에서 실행된다: 그 tmux 서버의 프로세스(칸들과 거기서 시작된 모든 것)가 듣는 TCP 포트마다
# "<포트> <명령>". ssh 는 기본 PATH 만 준다.
# A dev server started in the background (nohup … &) leaves the tmux tree for launchd (parent 1), so
# those count too: a node, python, ruby … of this user working in a folder under home (not ~/Library or a
# dot folder) or /tmp, and not hivemux's own (the bee office server).
# 백그라운드로 띄운 개발 서버(nohup … &)는 tmux 를 벗어나 launchd(부모 1) 아래로 가서, 그것도 센다:
# 이 사용자의 node, python, ruby … 중 홈 아래 폴더(~/Library 와 점 폴더는 빼고)나 /tmp 에서 도는 것,
# 그리고 hivemux 자신(벌 사무실 서버)은 뺀다.
# Before that, "open <port>" when that Mac's port list popup asked to open one here.
# 그 앞에, 상대 Mac 의 포트 목록 팝업이 여기서 열어 달라고 했으면 "open <포트>".
REMOTE = r'''PATH=/opt/homebrew/bin:/usr/local/bin:$PATH
root=$(tmux display -p '#{pid}' 2>/dev/null) || exit 0
tmux set -g @hivemux-seen-@ME@ "$(date +%s)"
tmux set -g @hivemux-name-@ME@ @NAME@
o=$(tmux show -gqv @hivemux-ports-open-@ME@) && [ -n "$o" ] && { tmux set -gu @hivemux-ports-open-@ME@; echo "open $o"; }
e=$(tmux show -gqv @hivemux-edit-@ME@) && [ -n "$e" ] && { tmux set -gu @hivemux-edit-@ME@; echo "edit $e"; }
pids=$(ps -A -o pid= -o ppid= | awk -v r="$root" '{ p[$1] = $2 } END { for (k in p) { x = k; n = 0; while (x > 1 && n++ < 64) { if (x == r) { print k; break } x = p[x] } } }' | paste -sd, -)
cand=$(ps -A -o pid= -o ppid= -o uid= -o comm= | awk -v u="$(id -u)" '$2 == 1 && $3 == u { n = split($NF, a, "/"); c = tolower(a[n]); if (c ~ /^(node|python[0-9.]*|ruby|deno|bun|php|java|uvicorn|gunicorn)$/) print $1 }' | paste -sd, -)
orph=$([ -n "$cand" ] && lsof -a -d cwd -p "$cand" -Fpn 2>/dev/null | awk -v h="$HOME" '/^p/ { p = substr($0, 2) } /^n/ { d = substr($0, 2); if ((index(d, h "/") == 1 && index(d, h "/Library") != 1 && index(d, h "/.") != 1) || d ~ /^\/(private\/)?tmp\//) print p }' | while read -r p; do
  case "$(ps -ww -o command= -p "$p")" in (*hivemux*) ;; (*) echo "$p";; esac
done | paste -sd, -)
pids=$(printf '%s,%s' "$pids" "$orph" | sed 's/^,*//; s/,*$//')
[ -n "$pids" ] || exit 0
lsof -nP -a -iTCP -sTCP:LISTEN -p "$pids" -Fcn 2>/dev/null | awk '/^c/ { c = substr($0, 2) } /^n/ { n = split($0, a, ":"); print a[n], c }' | sort -un'''


# This Mac's clipboard image as PNG to argv 1 (screenshots are PNG; images copied from apps are often
# only TIFF, converted after). Prints png or tiff, nothing when there is no image.
# 이 Mac 클립보드의 이미지를 PNG 로 argv 1 에 (스크린샷은 PNG, 앱에서 복사한 이미지는 TIFF 만 있을 때가
# 많아 나중에 바꾼다). png 나 tiff 를 찍고, 이미지가 없으면 아무것도 안 찍는다.
CLIP = """on run argv
  repeat with k in {{«class PNGf», "png"}, {«class TIFF», "tiff"}}
    try
      set d to the clipboard as (item 1 of k)
      set f to open for access (POSIX file (item 1 of argv)) with write permission
      set eof f to 0
      write d to f
      close access f
      return item 2 of k
    end try
  end repeat
  return ""
end run"""


def clip_image():
    """PNG bytes of the image on this Mac's clipboard, or None / 이 Mac 클립보드 이미지의 PNG 바이트, 없으면 None"""
    with tempfile.TemporaryDirectory() as d:
        f = os.path.join(d, "clip")
        kind = subprocess.run(["osascript", "-e", CLIP, f], capture_output=True, text=True).stdout.strip()
        if kind == "tiff":
            subprocess.run(["sips", "-s", "format", "png", f, "--out", f + ".png"], capture_output=True)
            f += ".png"
        elif kind != "png":
            return None
        try:
            with open(f, "rb") as fh:
                return fh.read() or None
        except OSError:
            return None


def me():
    """This Mac's name, as a tmux option name part / 이 Mac 이름 (tmux 옵션 이름에 쓸 수 있게)"""
    n = subprocess.run(["scutil", "--get", "ComputerName"], capture_output=True, text=True).stdout.strip() \
        or socket.gethostname().split(".")[0]
    return re.sub(r"[^A-Za-z0-9-]+", "-", n).strip("-") or "mac"


def display_name():
    """This Mac's name as people see it (Settings, $XDG_DATA_HOME/hivemux/mac-name), else the Mac's own;
    the other Mac shows it (@hivemux-name-<this Mac>)
    이 Mac 의 보이는 이름 (설정, $XDG_DATA_HOME/hivemux/mac-name), 없으면 Mac 원래 이름. 상대 Mac 이 보인다
    (@hivemux-name-<이 Mac>)"""
    try:
        v = open(os.path.join(os.path.dirname(DATA), "mac-name")).read().strip()
    except OSError:
        v = ""
    return v or subprocess.run(["scutil", "--get", "ComputerName"], capture_output=True, text=True).stdout.strip() or me()


def ko():
    v = os.environ.get("HIVEMUX_LANG") or subprocess.run(["tmux", "show", "-gqv", "@hivemux-lang"],
                                                         capture_output=True, text=True).stdout.strip()
    return (v or os.environ.get("LANG", "")).startswith("ko")


def tr(k, e):
    return k if KO else e


def free(port):
    """Nothing listens on localhost:port here (v4 and v6) / 여기 localhost:port 를 아무도 안 쓴다 (v4, v6)"""
    for fam, addr in ((socket.AF_INET, "127.0.0.1"), (socket.AF_INET6, "::1")):
        s = socket.socket(fam, socket.SOCK_STREAM)
        try:
            s.bind((addr, port))
        except OSError:
            return False
        finally:
            s.close()
    return True


class Ports:
    def __init__(self, host, tty):
        self.host, self.tty = host, tty
        self.sock = "/tmp/hivemux-ports-%d-%d" % (os.getuid(), os.getpid())
        self.master = None
        self.fw = {}                     # remote port -> (local port, command) / 거기 포트 -> (여기 포트, 명령)
        self.state = os.path.join(DATA, host.replace("/", "_"))
        self.me = me()
        self.shared = None               # what the other Mac's tmux has / 상대 tmux 에 둔 목록

    def ssh(self, *args, timeout=15):
        try:
            return subprocess.run(SSH + ["-S", self.sock] + SSH_OPTS + list(args), capture_output=True,
                                  text=True, timeout=timeout, stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            return None

    def waiter(self):
        """Wait for Ctrl+V (bin/hivemux-paste) and bee office (bin/hivemux-office) requests from the other Mac,
        in a thread. Both wake the same channel and leave their request in their own option.
        상대 Mac 의 Ctrl+V (bin/hivemux-paste)와 벌 사무실 (bin/hivemux-office) 요청을 기다린다. 스레드에서 돈다.
        둘 다 같은 채널을 깨우고 요청은 각자의 옵션에 둔다"""
        opt, office, show = f"@hivemux-paste-{self.me}", f"@hivemux-office-{self.me}", f"@hivemux-show-{self.me}"
        chan = f"hivemux-paste-{self.me}"
        cmd = (f"{PATH}; tmux wait-for {chan} && {{ tmux show -gqv {opt} | sed 's/^/paste /'; tmux set -gu {opt}; "
               f"tmux show -gqv {office} | sed 's/^/office /'; tmux set -gu {office}; "
               f"tmux show -gqv {show} | sed 's/^/show /'; tmux set -gu {show}; }}")
        while True:
            if not (self.master and self.master.poll() is None and os.path.exists(self.sock)):
                time.sleep(1)
                continue
            r = self.ssh(self.host, cmd, timeout=None)
            if not r or r.returncode != 0:
                time.sleep(1)
                continue
            shown = []
            for ln in r.stdout.splitlines():
                kind, _, req = ln.partition(" ")
                if kind == "show" and req:
                    shown.append(req)
                parts = req.split(" ", 2)
                if kind == "paste" and len(parts) == 3:
                    self.paste(parts[1], parts[2])
                elif kind == "office" and req:
                    self.office()
            if len(shown) > 1:           # "<id> <client>", then the paths / "<번호> <화면>", 그다음 경로들
                self.show(shown[0].partition(" ")[2], shown[1:])

    def show(self, client, paths):
        """Copy files of the other Mac here and open them with the default app (bin/hivemux-show there)
        상대 Mac 의 파일을 여기로 복사해 기본 앱으로 연다 (거기 bin/hivemux-show)"""
        q = shlex.quote
        base = f"/tmp/hivemux-show-{os.getuid()}"
        # copies a day old go / 하루 지난 복사본은 지운다
        subprocess.run(["find", base, "-mindepth", "1", "-maxdepth", "1", "-mtime", "+1", "-exec", "rm", "-rf", "{}", "+"],
                       capture_output=True)
        d = os.path.join(base, time.strftime("%Y%m%d-%H%M%S") + f"-{os.getpid()}")
        os.makedirs(d, mode=0o700, exist_ok=True)
        got = []
        for path in paths:
            try:
                r = subprocess.run(SSH + ["-S", self.sock] + SSH_OPTS + [self.host, f"cat -- {q(path)}"],
                                   capture_output=True, timeout=120, stdin=subprocess.DEVNULL)
            except subprocess.TimeoutExpired:
                continue
            if r.returncode != 0:
                continue
            name = os.path.basename(path) or "file"
            f = os.path.join(d, name)
            n = 1
            while os.path.exists(f):     # the same name twice / 같은 이름이 둘
                n += 1
                f = os.path.join(d, f"{n}-{name}")
            with open(f, "wb") as out:
                out.write(r.stdout)
            got.append(f)
        if not got:
            msg = tr(f"{self.me} 로 파일을 가져오지 못했습니다", f"Could not copy the file to {self.me}")
            self.ssh(self.host, f"{PATH}; tmux display-message -c {q(client)} {q(msg)}")
            return
        if os.environ.get("HIVEMUX_DRYRUN"):    # for tests: record instead of opening / 테스트용: 열지 않고 기록만
            with open(os.environ["HIVEMUX_DRYRUN"], "a") as f:
                f.write("show " + " ".join(got) + "\n")
            return
        subprocess.run(["open", *got])

    def office(self):
        """Open the bee office window on this Mac; the other Mac's sessions show next door
        이 Mac 에서 벌 사무실 창을 연다. 상대 Mac 의 세션은 옆 사무실에 나온다"""
        if os.environ.get("HIVEMUX_DRYRUN"):    # for tests: record instead of opening / 테스트용: 열지 않고 기록만
            with open(os.environ["HIVEMUX_DRYRUN"], "a") as f:
                f.write("office\n")
            return
        subprocess.Popen([os.path.join(os.path.dirname(os.path.realpath(__file__)), "hivemux-office")],
                         start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def paste(self, pane, client):
        """Copy this Mac's clipboard image there and paste its path into pane
        이 Mac 클립보드 이미지를 그쪽에 복사하고 경로를 그 칸에 붙여 넣는다"""
        img = clip_image()
        q = shlex.quote
        if not img:
            msg = tr(f"{self.me} 클립보드에 이미지가 없습니다", f"No image on the clipboard of {self.me}")
            self.ssh(self.host, f"{PATH}; tmux display-message -c {q(client)} {q(msg)}")
            return
        # files a day old go (Claude Code has read them long before) / 하루 지난 파일은 지운다 (Claude Code 가 진작 읽었다)
        cmd = (f"{PATH}; umask 077; d=/tmp/hivemux-paste-$(id -u); mkdir -p \"$d\" && "
               f"find \"$d\" -type f -mtime +1 -delete; f=\"$d/$(date +%Y%m%d-%H%M%S)-$$.png\"; cat > \"$f\" && "
               f"tmux set-buffer -b hivemux-paste -- \"$f\" && tmux paste-buffer -p -d -b hivemux-paste -t {q(pane)}")
        try:
            subprocess.run(SSH + ["-S", self.sock] + SSH_OPTS + [self.host, cmd], input=img,
                           capture_output=True, timeout=60)
        except subprocess.TimeoutExpired:
            pass

    def up(self):
        """The ssh connection the forwards ride on, (re)opened when needed / 포트를 잇는 ssh 연결. 없으면 (다시) 연다"""
        if self.master and self.master.poll() is None:
            r = self.ssh("-O", "check", self.host, timeout=5)
            if r and r.returncode == 0:
                return True
        self.down()
        self.master = subprocess.Popen(SSH + ["-M", "-S", self.sock, "-N", "-o", "ControlPersist=no"] + SSH_OPTS + [self.host],
                                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(40):
            if self.master.poll() is not None:
                return False
            if os.path.exists(self.sock):
                return True
            time.sleep(0.25)
        return False

    def down(self):
        if self.master and self.master.poll() is None:
            self.fw = {}
            self.share()
            self.ssh(self.host, f"PATH=/opt/homebrew/bin:/usr/local/bin:$PATH; tmux set -gu @hivemux-seen-{self.me}", timeout=5)
            self.ssh("-O", "exit", self.host, timeout=5)
            try:
                self.master.wait(3)
            except subprocess.TimeoutExpired:
                self.master.kill()
        self.master = None
        self.fw = {}
        self.shared = None
        try:
            os.unlink(self.sock)
        except OSError:
            pass
        self.save()

    def listening(self):
        """({remote port: command}, [remote ports asked to open here]) / ({거기 포트: 명령}, [여기서 열어 달라는 거기 포트])
        Files asked to be edited here are opened right away / 여기서 열어 달라는 파일은 바로 연다"""
        r = self.ssh(self.host, REMOTE.replace("@ME@", self.me).replace("@NAME@", shlex.quote(display_name())))
        if not r or r.returncode != 0:
            return None, []
        out, asked = {}, []
        for ln in r.stdout.splitlines():
            port, _, cmd = ln.partition(" ")
            if port == "open":
                asked += [int(x) for x in cmd.split() if x.isdigit()]
                continue
            if port == "edit":
                self.edit(cmd)
                continue
            # not ssh: forwards someone set up there (or this one, when "there" is this Mac)
            # ssh 는 뺀다: 거기서 누가 열어 둔 포워딩 (또는 "거기"가 이 Mac 일 때 이 연결 자신)
            if port.isdigit() and int(port) >= 1024 and cmd.strip() not in ("ssh", "sshd"):
                out[int(port)] = cmd.strip() or "?"
        return out, asked

    def edit(self, req):
        """Open a file of the other Mac in VS Code / Cursor here (Remote-SSH) / 그 Mac 의 파일을 여기 VS Code / Cursor 로 (원격 SSH)"""
        editor, line, col, path = (req.split(" ", 3) + ["", "", "", ""])[:4]
        if editor not in ("vscode", "cursor") or not path.startswith("/"):
            return
        url = f"{editor}://vscode-remote/ssh-remote+{urllib.parse.quote(self.host, safe='@.-_')}{urllib.parse.quote(path)}"
        if line.isdigit() and line != "0":
            url += f":{line}" + (f":{col}" if col.isdigit() and col != "0" else "")
        self.run_open(url)

    def run_open(self, url):
        if os.environ.get("HIVEMUX_DRYRUN"):    # for tests: record instead of opening / 테스트용: 열지 않고 기록만
            with open(os.environ["HIVEMUX_DRYRUN"], "a") as f:
                f.write(f"open {url}\n")
        else:
            subprocess.run(["open", url])

    def share(self):
        """Put the list in the other Mac's tmux (for its port list popup) when it changed
        상대 Mac 의 tmux 에 목록을 둔다 (거기 포트 목록 팝업용). 바뀌었을 때만"""
        val = "\n".join(f"{lp} {rp} {cmd}" for rp, (lp, cmd) in sorted(self.fw.items()))
        if val == self.shared:
            return
        opt = f"@hivemux-ports-{self.me}"
        cmd = f"PATH=/opt/homebrew/bin:/usr/local/bin:$PATH; " + \
              (f"tmux set -g {opt} {shlex.quote(val)}" if val else f"tmux set -gu {opt}")
        r = self.ssh(self.host, cmd)
        if r and r.returncode == 0:
            self.shared = val

    def save(self):
        os.makedirs(DATA, exist_ok=True)
        if self.fw:
            with open(self.state + ".tmp", "w") as f:
                for rp, (lp, cmd) in sorted(self.fw.items()):
                    f.write(f"{lp} {rp} {cmd}\n")
            os.replace(self.state + ".tmp", self.state)
        else:
            try:
                os.unlink(self.state)
            except OSError:
                pass

    def sync(self):
        now, asked = self.listening()
        if now is None:
            return
        for rp in [p for p in self.fw if p not in now]:
            lp, _ = self.fw.pop(rp)
            self.ssh("-O", "cancel", "-L", f"{lp}:localhost:{rp}", self.host)
        for rp, cmd in now.items():
            if rp in self.fw:
                continue
            lp = next((p for p in range(rp, min(rp + 20, 65536)) if free(p)), None)
            if lp is None:
                continue
            r = self.ssh("-O", "forward", "-L", f"{lp}:localhost:{rp}", self.host)
            if not r or r.returncode != 0:
                continue
            self.fw[rp] = (lp, cmd)
        self.save()
        self.share()
        for rp in asked:                 # Enter in the other Mac's popup / 상대 Mac 팝업에서 Enter
            if rp in self.fw:
                self.run_open(f"http://localhost:{self.fw[rp][0]}")

    def run(self):
        parent = os.getppid()
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        signal.signal(signal.SIGHUP, lambda *_: sys.exit(0))
        threading.Thread(target=self.waiter, daemon=True).start()
        try:
            while os.getppid() == parent:
                if self.up():
                    self.sync()
                time.sleep(POLL)
        finally:
            self.down()


def pick(client):
    """The port list popup over a still copy of the screen (like the open-path popup)
    화면을 멈춘 사본 위의 포트 목록 팝업 (경로 열기 팝업처럼)"""
    here = os.path.dirname(os.path.realpath(__file__))
    pid = subprocess.run(["tmux", "display", "-p", "#{pid}"], capture_output=True, text=True).stdout.strip()
    pause = "/tmp/hivemux-pause-%d-%s" % (os.getuid(), pid)    # per tmux server / tmux 서버마다
    open(pause, "w").close()
    try:
        subprocess.run([os.path.join(here, "hivemux-modal"), client, "-E", "-w", "76", "-h", "18", "-b", "rounded",
                        "-T", "#[fg=#e6e9ef,bold] %s " % tr("포트 목록", "Ports"), "-S", "fg=#5aa9ff", "-s", "bg=#1e2128",
                        shlex.join([os.path.join(here, "hivemux-ports-ui"), client])], stderr=subprocess.DEVNULL)
    finally:
        os.unlink(pause)


def listing():
    if not os.path.isdir(DATA):
        return
    for name in sorted(os.listdir(DATA)):
        with open(os.path.join(DATA, name)) as f:
            for ln in f:
                lp, rp, cmd = (ln.split(" ", 2) + ["", ""])[:3]
                print(f"http://localhost:{lp}  ←  {name}:{rp}  {cmd.strip()}")


KO = ko()
if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--list":
        listing()
    elif len(sys.argv) > 1 and sys.argv[1] == "--me":
        print(me())
    elif len(sys.argv) > 1 and sys.argv[1] == "--pick":
        pick(sys.argv[2] if len(sys.argv) > 2 else "")
    elif len(sys.argv) == 3:
        Ports(sys.argv[1], sys.argv[2]).run()
    else:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        sys.exit(2)
