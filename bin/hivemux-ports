#!/usr/bin/env python3
"""Forward the other Mac's dev servers to this Mac while connected (started by hivemux-connect).
연결해 있는 동안 상대 Mac 의 개발 서버를 이 Mac 으로 이어 준다 (hivemux-connect 가 띄운다).

  hivemux-ports <host> <tty>     run until hivemux-connect (the parent) ends / hivemux-connect(부모)가 끝날 때까지
  hivemux-ports --list           forwarded ports of every connection / 모든 연결의 이어 준 포트
  hivemux-ports --pick <client>  the port list popup (Option+W, sidebar menu) / 포트 목록 팝업 (Option+W, 사이드바 메뉴)
  hivemux-ports --me             this Mac's name as used in the options below / 아래 옵션에 쓰는 이 Mac 이름

Every few seconds it asks the other Mac which TCP ports are listened on by processes started
inside its tmux (a dev server Claude or a shell started: npm run dev, rails s ...), and forwards
each to the same port on this Mac's localhost over its own ssh connection, so
http://localhost:5173 here opens the server there. A port taken here goes to the next free one.
Each new port shows a notification (OSC 777 on <tty>, the connection's terminal).
몇 초마다 상대 Mac 의 tmux 안에서 시작된 프로세스(Claude 나 셸이 띄운 개발 서버: npm run dev,
rails s ...)가 듣는 TCP 포트를 묻고, 따로 연 ssh 연결로 이 Mac 의 localhost 같은 포트에 잇는다.
그래서 여기서 http://localhost:5173 을 열면 거기 서버가 열린다. 여기서 이미 쓰는 포트면 다음 빈
포트로 잇는다. 새 포트마다 알림을 띄운다 (<tty>, 연결 터미널에 OSC 777).
State: $XDG_DATA_HOME/hivemux/ports/<host> ("<local> <remote> <command>" per line).
상태: $XDG_DATA_HOME/hivemux/ports/<host> (한 줄에 "<여기 포트> <거기 포트> <명령>").
The other Mac's tmux gets the same list as @hivemux-ports-<this Mac>, so its port list popup
(bin/hivemux-ports-ui) shows it; Enter there sets @hivemux-ports-open-<this Mac> to the port and
the next poll here opens it in this Mac's browser.
상대 Mac 의 tmux 에도 같은 목록을 @hivemux-ports-<이 Mac> 으로 둔다. 그래서 거기 포트 목록 팝업
(bin/hivemux-ports-ui)에 보이고, 거기서 Enter 를 누르면 @hivemux-ports-open-<이 Mac> 에 포트를 적고,
여기서 다음에 물을 때 이 Mac 의 브라우저로 연다.
The same way, the open-path popup there (bin/hivemux-open-ui) on a screen from this Mac sets
@hivemux-edit-<this Mac> to "<editor> <line> <col> <path>", and this opens that file of the other
Mac in VS Code / Cursor here over Remote-SSH. @hivemux-seen-<this Mac> is the time of the last poll,
so the popup knows a request will be picked up.
같은 식으로, 이 Mac 에서 붙은 화면의 경로 열기 팝업(bin/hivemux-open-ui)은 @hivemux-edit-<이 Mac> 에
"<편집기> <줄> <칸> <경로>" 를 적고, 여기서 그 Mac 의 파일을 이 Mac 의 VS Code / Cursor 원격 SSH 로 연다.
@hivemux-seen-<이 Mac> 은 마지막으로 물은 시각이라, 팝업이 요청이 처리될지 안다.
"""
import os, re, shlex, signal, socket, subprocess, sys, time, urllib.parse

DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "hivemux", "ports")
POLL = 3
# HIVEMUX_SSH: another ssh command, e.g. "ssh -F <config>" (used for testing) / 다른 ssh 명령 (시험용)
SSH = shlex.split(os.environ.get("HIVEMUX_SSH") or "ssh")
SSH_OPTS = ["-o", "BatchMode=yes", "-o", "ServerAliveInterval=10", "-o", "ServerAliveCountMax=3", "-o", "ConnectTimeout=10"]

# Runs on the other Mac: "<port> <command>" for every TCP port listened on by a process of its tmux
# server (its panes and everything they started). ssh gives a plain PATH there.
# 상대 Mac 에서 실행된다: 그 tmux 서버의 프로세스(칸들과 거기서 시작된 모든 것)가 듣는 TCP 포트마다
# "<포트> <명령>". ssh 는 기본 PATH 만 준다.
# Before that, "open <port>" when that Mac's port list popup asked to open one here.
# 그 앞에, 상대 Mac 의 포트 목록 팝업이 여기서 열어 달라고 했으면 "open <포트>".
REMOTE = r'''PATH=/opt/homebrew/bin:/usr/local/bin:$PATH
root=$(tmux display -p '#{pid}' 2>/dev/null) || exit 0
tmux set -g @hivemux-seen-@ME@ "$(date +%s)"
o=$(tmux show -gqv @hivemux-ports-open-@ME@) && [ -n "$o" ] && { tmux set -gu @hivemux-ports-open-@ME@; echo "open $o"; }
e=$(tmux show -gqv @hivemux-edit-@ME@) && [ -n "$e" ] && { tmux set -gu @hivemux-edit-@ME@; echo "edit $e"; }
pids=$(ps -A -o pid= -o ppid= | awk -v r="$root" '{ p[$1] = $2 } END { for (k in p) { x = k; n = 0; while (x > 1 && n++ < 64) { if (x == r) { print k; break } x = p[x] } } }' | paste -sd, -)
[ -n "$pids" ] || exit 0
lsof -nP -a -iTCP -sTCP:LISTEN -p "$pids" -Fcn 2>/dev/null | awk '/^c/ { c = substr($0, 2) } /^n/ { n = split($0, a, ":"); print a[n], c }' | sort -un'''


def me():
    """This Mac's name, as a tmux option name part / 이 Mac 이름 (tmux 옵션 이름에 쓸 수 있게)"""
    n = subprocess.run(["scutil", "--get", "ComputerName"], capture_output=True, text=True).stdout.strip() \
        or socket.gethostname().split(".")[0]
    return re.sub(r"[^A-Za-z0-9-]+", "-", n).strip("-") or "mac"


def ko():
    v = os.environ.get("HIVEMUX_LANG") or subprocess.run(["tmux", "show", "-gqv", "@hivemux-lang"],
                                                         capture_output=True, text=True).stdout.strip()
    return (v or os.environ.get("LANG", "")).startswith("ko")


def tr(k, e):
    return k if KO else e


def free(port):
    """Nothing listens on localhost:port here (v4 and v6) / 여기 localhost:port 를 아무도 안 쓴다 (v4, v6)"""
    for fam, addr in ((socket.AF_INET, "127.0.0.1"), (socket.AF_INET6, "::1")):
        s = socket.socket(fam, socket.SOCK_STREAM)
        try:
            s.bind((addr, port))
        except OSError:
            return False
        finally:
            s.close()
    return True


class Ports:
    def __init__(self, host, tty):
        self.host, self.tty = host, tty
        self.sock = "/tmp/hivemux-ports-%d-%d" % (os.getuid(), os.getpid())
        self.master = None
        self.fw = {}                     # remote port -> (local port, command) / 거기 포트 -> (여기 포트, 명령)
        self.state = os.path.join(DATA, host.replace("/", "_"))
        self.me = me()
        self.shared = None               # what the other Mac's tmux has / 상대 tmux 에 둔 목록

    def ssh(self, *args, timeout=15):
        try:
            return subprocess.run(SSH + ["-S", self.sock] + SSH_OPTS + list(args), capture_output=True,
                                  text=True, timeout=timeout, stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            return None

    def up(self):
        """The ssh connection the forwards ride on, (re)opened when needed / 포트를 잇는 ssh 연결. 없으면 (다시) 연다"""
        if self.master and self.master.poll() is None:
            r = self.ssh("-O", "check", self.host, timeout=5)
            if r and r.returncode == 0:
                return True
        self.down()
        self.master = subprocess.Popen(SSH + ["-M", "-S", self.sock, "-N", "-o", "ControlPersist=no"] + SSH_OPTS + [self.host],
                                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(40):
            if self.master.poll() is not None:
                return False
            if os.path.exists(self.sock):
                return True
            time.sleep(0.25)
        return False

    def down(self):
        if self.master and self.master.poll() is None:
            self.fw = {}
            self.share()
            self.ssh(self.host, f"PATH=/opt/homebrew/bin:/usr/local/bin:$PATH; tmux set -gu @hivemux-seen-{self.me}", timeout=5)
            self.ssh("-O", "exit", self.host, timeout=5)
            try:
                self.master.wait(3)
            except subprocess.TimeoutExpired:
                self.master.kill()
        self.master = None
        self.fw = {}
        self.shared = None
        try:
            os.unlink(self.sock)
        except OSError:
            pass
        self.save()

    def listening(self):
        """({remote port: command}, [remote ports asked to open here]) / ({거기 포트: 명령}, [여기서 열어 달라는 거기 포트])
        Files asked to be edited here are opened right away / 여기서 열어 달라는 파일은 바로 연다"""
        r = self.ssh(self.host, REMOTE.replace("@ME@", self.me))
        if not r or r.returncode != 0:
            return None, []
        out, asked = {}, []
        for ln in r.stdout.splitlines():
            port, _, cmd = ln.partition(" ")
            if port == "open":
                asked += [int(x) for x in cmd.split() if x.isdigit()]
                continue
            if port == "edit":
                self.edit(cmd)
                continue
            # not ssh: forwards someone set up there (or this one, when "there" is this Mac)
            # ssh 는 뺀다: 거기서 누가 열어 둔 포워딩 (또는 "거기"가 이 Mac 일 때 이 연결 자신)
            if port.isdigit() and int(port) >= 1024 and cmd.strip() not in ("ssh", "sshd"):
                out[int(port)] = cmd.strip() or "?"
        return out, asked

    def edit(self, req):
        """Open a file of the other Mac in VS Code / Cursor here (Remote-SSH) / 그 Mac 의 파일을 여기 VS Code / Cursor 로 (원격 SSH)"""
        editor, line, col, path = (req.split(" ", 3) + ["", "", "", ""])[:4]
        if editor not in ("vscode", "cursor") or not path.startswith("/"):
            return
        url = f"{editor}://vscode-remote/ssh-remote+{urllib.parse.quote(self.host, safe='@.-_')}{urllib.parse.quote(path)}"
        if line.isdigit() and line != "0":
            url += f":{line}" + (f":{col}" if col.isdigit() and col != "0" else "")
        self.run_open(url)

    def run_open(self, url):
        if os.environ.get("HIVEMUX_DRYRUN"):    # for tests: record instead of opening / 테스트용: 열지 않고 기록만
            with open(os.environ["HIVEMUX_DRYRUN"], "a") as f:
                f.write(f"open {url}\n")
        else:
            subprocess.run(["open", url])

    def share(self):
        """Put the list in the other Mac's tmux (for its port list popup) when it changed
        상대 Mac 의 tmux 에 목록을 둔다 (거기 포트 목록 팝업용). 바뀌었을 때만"""
        val = "\n".join(f"{lp} {rp} {cmd}" for rp, (lp, cmd) in sorted(self.fw.items()))
        if val == self.shared:
            return
        opt = f"@hivemux-ports-{self.me}"
        cmd = f"PATH=/opt/homebrew/bin:/usr/local/bin:$PATH; " + \
              (f"tmux set -g {opt} {shlex.quote(val)}" if val else f"tmux set -gu {opt}")
        r = self.ssh(self.host, cmd)
        if r and r.returncode == 0:
            self.shared = val

    def notify(self, title, body):
        try:
            with open(self.tty, "w") as t:
                t.write("\x1b]777;notify;%s;%s\x07" % (title.replace(";", ","), body.replace(";", ",")))
        except OSError:
            pass

    def save(self):
        os.makedirs(DATA, exist_ok=True)
        if self.fw:
            with open(self.state + ".tmp", "w") as f:
                for rp, (lp, cmd) in sorted(self.fw.items()):
                    f.write(f"{lp} {rp} {cmd}\n")
            os.replace(self.state + ".tmp", self.state)
        else:
            try:
                os.unlink(self.state)
            except OSError:
                pass

    def sync(self):
        now, asked = self.listening()
        if now is None:
            return
        for rp in [p for p in self.fw if p not in now]:
            lp, _ = self.fw.pop(rp)
            self.ssh("-O", "cancel", "-L", f"{lp}:localhost:{rp}", self.host)
        for rp, cmd in now.items():
            if rp in self.fw:
                continue
            lp = next((p for p in range(rp, min(rp + 20, 65536)) if free(p)), None)
            if lp is None:
                continue
            r = self.ssh("-O", "forward", "-L", f"{lp}:localhost:{rp}", self.host)
            if not r or r.returncode != 0:
                continue
            self.fw[rp] = (lp, cmd)
            where = f"localhost:{lp}" + ("" if lp == rp else tr(f" (거기 {rp})", f" (there {rp})"))
            self.notify(tr(f"{self.host} 포트 연결", f"Port from {self.host}"),
                        f"{cmd} · {where}")
        self.save()
        self.share()
        for rp in asked:                 # Enter in the other Mac's popup / 상대 Mac 팝업에서 Enter
            if rp in self.fw:
                self.run_open(f"http://localhost:{self.fw[rp][0]}")

    def run(self):
        parent = os.getppid()
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        signal.signal(signal.SIGHUP, lambda *_: sys.exit(0))
        try:
            while os.getppid() == parent:
                if self.up():
                    self.sync()
                time.sleep(POLL)
        finally:
            self.down()


def pick(client):
    """The port list popup over a still copy of the screen (like the open-path popup)
    화면을 멈춘 사본 위의 포트 목록 팝업 (경로 열기 팝업처럼)"""
    here = os.path.dirname(os.path.realpath(__file__))
    pid = subprocess.run(["tmux", "display", "-p", "#{pid}"], capture_output=True, text=True).stdout.strip()
    pause = "/tmp/hivemux-pause-%d-%s" % (os.getuid(), pid)    # per tmux server / tmux 서버마다
    open(pause, "w").close()
    try:
        subprocess.run([os.path.join(here, "hivemux-modal"), client, "-E", "-w", "76", "-h", "18", "-b", "rounded",
                        "-T", "#[fg=#e6e9ef,bold] %s " % tr("포트 목록", "Ports"), "-S", "fg=#5aa9ff", "-s", "bg=#1e2128",
                        shlex.join([os.path.join(here, "hivemux-ports-ui"), client])], stderr=subprocess.DEVNULL)
    finally:
        os.unlink(pause)


def listing():
    if not os.path.isdir(DATA):
        return
    for name in sorted(os.listdir(DATA)):
        with open(os.path.join(DATA, name)) as f:
            for ln in f:
                lp, rp, cmd = (ln.split(" ", 2) + ["", ""])[:3]
                print(f"http://localhost:{lp}  ←  {name}:{rp}  {cmd.strip()}")


KO = ko()
if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--list":
        listing()
    elif len(sys.argv) > 1 and sys.argv[1] == "--me":
        print(me())
    elif len(sys.argv) > 1 and sys.argv[1] == "--pick":
        pick(sys.argv[2] if len(sys.argv) > 2 else "")
    elif len(sys.argv) == 3:
        Ports(sys.argv[1], sys.argv[2]).run()
    else:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        sys.exit(2)
