#!/bin/bash
# Ghostty entry point: every window/tab attaches to tmux, so closing Ghostty
# never kills work.
# - No tmux server: start one, restore the last tmux-resurrect snapshot
#   (which also resumes Claude sessions via bin/hivemux-panes), then attach.
# - Server running: attach the most recently used detached session,
#   otherwise create a new session.
# Skip restore once: touch ~/tmux_no_auto_restore

# tmux server inherits this env; make sure claude/brew are on PATH
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
TMUX_BIN="$(command -v tmux)" || { echo "hivemux: tmux not found (brew install tmux)" >&2; exec "${SHELL:-/bin/zsh}" -l; }
HM_BIN="$(cd "$(dirname "$(realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"
# HIVEMUX_SOCKET=name selects a separate tmux socket (used for testing)
t() { "$TMUX_BIN" ${HIVEMUX_SOCKET:+-L "$HIVEMUX_SOCKET"} ${HIVEMUX_CONF:+-f "$HIVEMUX_CONF"} "$@"; }

if ! t has-session 2>/dev/null; then
  # Bootstrap session "0": tmux-resurrect deletes it after a from-scratch restore.
  if t new-session -d -s 0 2>/dev/null; then
    RESTORE="$(t show -gqv @resurrect-restore-script-path)"   # set once hivemux.tmux has loaded resurrect / hivemux.tmux 가 resurrect 를 불러오면 생긴다
    if [ -n "$RESTORE" ] && [ -x "$RESTORE" ] && [ ! -f "$HOME/tmux_no_auto_restore" ]; then
      t run-shell "$RESTORE"
      last_file="$(t show -gqv @resurrect-dir)"; last_file="${last_file:-${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect}/last"
      st="$(awk -F '\t' '$1=="state"{print $2; exit}' "$last_file" 2>/dev/null)"
      [ -n "$st" ] && t set -g @hivemux-last-session "$st"
    fi
    if t has-session -t '=0' 2>/dev/null; then
      t has-session -t '=main' 2>/dev/null || t rename-session -t '=0' main
    fi
    t set -g @hivemux-ready 1
    t run-shell -b "$HM_BIN/hivemux-sidebar ensure"
  fi
fi

# Another window may be restoring right now (bootstrap "0" still there,
# not ready yet): wait for it, max ~20s.
for _ in $(seq 1 40); do
  t has-session -t '=0' 2>/dev/null || break
  [ "$(t show -gqv @hivemux-ready 2>/dev/null)" = 1 ] && break
  sleep 0.5
done

# Session to attach: the most recently used one not shown in another tab.
# 붙을 세션: 아무 탭에도 안 붙은 세션 중 마지막으로 보던 것.
# Right after a restore, prefer the last session recorded in the snapshot.
# 방금 복원했다면 저장본의 "마지막으로 보던 세션"을 먼저 쓴다.
detached="$(t list-sessions -F '#{session_attached} #{session_last_attached} #{session_name}' 2>/dev/null |
  awk '$1==0' | sort -k2,2nr | cut -d' ' -f3-)"
# From another Mac (ssh, or hivemux connect): mark this terminal as remote (status line shows the host)
# 다른 Mac 에서 (ssh, hivemux connect): 이 터미널을 원격으로 표시한다 (상태줄에 호스트 이름)
if [ -n "$HIVEMUX_REMOTE" ] || [ -n "$SSH_CONNECTION" ]; then
  me="$(tty 2>/dev/null)"
  [ -n "$me" ] && t set -g @hivemux-remote-clients "$(t show -gqv @hivemux-remote-clients | tr ' ' '\n' | grep -vxF "$me" | tr '\n' ' ') $me "
fi
# Every session is already on a screen (Ghostty restoring several windows, a second window):
# share the last used one instead of opening an empty numbered session ("8") that piles up
# 모든 세션이 이미 화면에 붙어 있음 (Ghostty 가 창 여러 개를 되살림, 창을 하나 더 엶):
# 빈 번호 세션("8")을 새로 만들어 쌓지 않고 마지막으로 쓴 세션을 같이 본다
[ -z "$detached" ] && detached="$(t list-sessions -F '#{session_last_attached} #{session_name}' 2>/dev/null | sort -k1,1nr | head -1 | cut -d' ' -f2-)"
pick=""
want="$(t show -gqv @hivemux-last-session 2>/dev/null)"
if [ -n "$want" ] && printf '%s\n' "$detached" | grep -qxF "$want"; then
  pick="$want"; t set -gu @hivemux-last-session
fi
[ -z "$pick" ] && pick="$(printf '%s\n' "$detached" | head -1)"
[ -n "$pick" ] && exec "$TMUX_BIN" ${HIVEMUX_SOCKET:+-L "$HIVEMUX_SOCKET"} attach-session -t "=$pick"
exec "$TMUX_BIN" ${HIVEMUX_SOCKET:+-L "$HIVEMUX_SOCKET"} new-session
