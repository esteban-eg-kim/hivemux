#!/bin/bash
# Called by tmux-resurrect hooks.
#   hivemux-panes save     snapshot "pane -> Claude session id" (after every save)
#   hivemux-panes restore  run `claude --resume <id>` in each restored pane
#   hivemux-panes list     show the current snapshot
# Set HIVEMUX_NO_RESUME=1 (tmux global env or shell) to skip auto-resume.

TMUX_BIN="$(command -v tmux || echo /opt/homebrew/bin/tmux)"
STATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/hivemux"
MAP="$STATE_DIR/panes.tsv"
LOG="$STATE_DIR/panes.log"
mkdir -p "$STATE_DIR"
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; }

save() {
  local tmp="$MAP.tmp.$$"
  # a server that started without restoring keeps the last map (see bin/hivemux-attach)
  # 복원 없이 뜬 서버는 마지막 대응표를 그대로 둔다 (bin/hivemux-attach 참고)
  if [ -n "$("$TMUX_BIN" show -gqv @hivemux-nosave 2>/dev/null)" ]; then
    log "save skipped (server started without restoring)"; return
  fi
  "$TMUX_BIN" list-panes -a -F \
    '#{session_name}:#{window_index}.#{pane_index}	#{@claude_session}	#{@claude_cwd}' 2>/dev/null |
    awk -F '\t' '$2 != ""' > "$tmp"
  mv -f "$tmp" "$MAP"
}

restore() {
  [ -f "$MAP" ] || exit 0
  if [ -n "$HIVEMUX_NO_RESUME" ] || "$TMUX_BIN" show-environment -g HIVEMUX_NO_RESUME >/dev/null 2>&1; then
    log "restore skipped (HIVEMUX_NO_RESUME)"; exit 0
  fi
  # clocked out (bin/hivemux-shift): they come back when you clock in / 퇴근 중 (bin/hivemux-shift): 출근할 때 돌아온다
  if [ "$(cut -d' ' -f1 "$STATE_DIR/shift" 2>/dev/null)" = off ]; then
    "$TMUX_BIN" set -g @hivemux-shift off; log "restore skipped (clocked out)"; exit 0
  fi
  local claude_cmd="${HIVEMUX_CLAUDE:-$("$TMUX_BIN" show-environment -g HIVEMUX_CLAUDE 2>/dev/null | sed -n 's/^HIVEMUX_CLAUDE=//p')}"
  claude_cmd="${claude_cmd:-claude}"
  local target sid cwd cmd
  while IFS=$'\t' read -r target sid cwd; do
    [ -n "$target" ] && [ -n "$sid" ] || continue
    cmd="$("$TMUX_BIN" display-message -p -t "$target" '#{pane_current_command}' 2>/dev/null)" || {
      log "skip $target: pane missing"; continue; }
    case "$cmd" in
      zsh|bash|fish|sh|-zsh|-bash|login|cat) ;;
      *) log "skip $target: busy ($cmd)"; continue ;;
    esac
    [ -d "$cwd" ] || cwd=""
    if [ -n "$cwd" ]; then
      "$TMUX_BIN" send-keys -t "$target" "cd $(printf '%q' "$cwd") && $claude_cmd --resume $sid" Enter
    else
      "$TMUX_BIN" send-keys -t "$target" "$claude_cmd --resume $sid" Enter
    fi
    log "resume $target -> $sid ($cwd)"
  done < "$MAP"
}

case "$1" in
  save) save ;;
  restore) restore ;;
  list) column -t -s $'\t' "$MAP" 2>/dev/null || cat "$MAP" ;;
  *) echo "usage: $0 save|restore|list" >&2; exit 2 ;;
esac
