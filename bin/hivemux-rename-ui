#!/bin/zsh
# hivemux-rename 팝업 화면. tmux display-popup 안에서 실행된다.
#   hivemux-rename-ui <pane_num> <지금 이름> <프로젝트> <상태>
# 저장하면 @hivemux-name-input-<num> 에 넣고 hivemux-rename apply 를 부른다.
num="$1"; cur="$2"; proj="$3"; st="$4"
HM_BIN="${0:A:h}"
TMUX_BIN="$(command -v tmux || echo /opt/homebrew/bin/tmux)"
# 화면 언어: HIVEMUX_LANG > tmux @hivemux-lang > LANG
say() { local v="${HIVEMUX_LANG:-$("$TMUX_BIN" show -gqv @hivemux-lang 2>/dev/null)}"; if [[ "${v:-$LANG}" == ko* ]]; then print -rn -- "$1"; else print -rn -- "$2"; fi; }

c()  { printf '\e[38;2;%sm' "$1"; }
b()  { printf '\e[1m'; }
r()  { printf '\e[0m'; }
TEXT='230;233;239'; T2='154;163;178'; T3='98;106;120'; ACC='90;169;255'; WAIT='245;165;36'

case "$st" in
  run|wait) note="$(c $WAIT)$(say "Claude가 작업 중이라 응답이 끝나면 이름이 적용됩니다" "Claude is busy; the name is sent when it finishes")$(r)" ;;
  *)        note="$(c $T3)$(say "Claude에 /rename 으로 전달되어 폰 앱에도 반영됩니다" "Sent to Claude as /rename, so the phone app shows it too")$(r)" ;;
esac

printf '\e[?25h'
print
print "  $(c $T3)$(say "프로젝트 " "Project  ")$(r)  $(c $T2)$proj$(r)"
print "  $(c $T3)$(say "지금 이름" "Current  ")$(r)  $(c $TEXT)$cur$(r)"
print
print "  $note"
print "  $(c $T2)$(b)Enter$(r)$(c $T3) $(say 저장 save)    $(c $T2)$(b)Esc$(r)$(c $T3) $(say 취소 cancel)$(r)"
print
# 입력 줄은 맨 아래 (편집기가 커서 아래를 지우기 때문)
KEYTIMEOUT=1
bindkey -e
bindkey '\e' send-break
name="$cur"
if vared -p "  $(c $ACC)$(b)›$(r) " name 2>/dev/null; then
  name="${name## }"; name="${name%% }"
  [ -n "$name" ] && [ "$name" != "$cur" ] || exit 0
  "$TMUX_BIN" set -g "@hivemux-name-input-$num" "$name"
  "$HM_BIN/hivemux-rename" apply "$num"
fi
exit 0
