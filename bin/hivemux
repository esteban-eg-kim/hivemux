#!/bin/bash
# hivemux — Claude Code session board for tmux + Ghostty
set -uo pipefail
VERSION="0.1.49"
HM_BIN="$(cd "$(dirname "$(realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"
HM_ROOT="$(cd "$HM_BIN/.." && pwd)"
# Homebrew: use the version-independent opt path so upgrades keep working
case "$HM_ROOT" in */Cellar/hivemux/*/libexec) HM_ROOT="${HM_ROOT%%/Cellar/*}/opt/hivemux/libexec"; HM_BIN="$HM_ROOT/bin" ;; esac
SHARE="$HM_ROOT/share"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/hivemux"
TMUX_CONF="${HIVEMUX_TMUX_CONF:-$HOME/.tmux.conf}"
GHOSTTY_CONF="${HIVEMUX_GHOSTTY_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/config}"
CLAUDE_SETTINGS="${HIVEMUX_CLAUDE_SETTINGS:-$HOME/.claude/settings.json}"
BEGIN="# >>> hivemux >>>"; END="# <<< hivemux <<<"
HOOK_EVENTS='["SessionStart","UserPromptSubmit","PreToolUse","PermissionRequest","PostToolUse","PostToolUseFailure","PermissionDenied","Notification","Stop","StopFailure","SessionEnd"]'

if [ -t 1 ]; then B=$'\e[1m'; D=$'\e[2m'; G=$'\e[32m'; Y=$'\e[33m'; RD=$'\e[31m'; X=$'\e[0m'; else B= D= G= Y= RD= X=; fi
ok()   { echo "  ${G}✓${X} $*"; }
warn() { echo "  ${Y}!${X} $*"; }
bad()  { echo "  ${RD}✗${X} $*"; }
step() { echo; echo "${B}$*${X}"; }

usage() {
  cat <<U
hivemux $VERSION — see every Claude Code session in one tmux sidebar

Usage:
  hivemux setup [--yes] [--no-keys] [--no-ghostty] [--no-remote] [--lang=en|ko]
                       install plugins and add hivemux to tmux, Ghostty and Claude Code
  hivemux terminal <ghostty|iterm|wezterm|kitty|alacritty|terminal> [--off]
                       make that terminal open every window in hivemux (--off: stop)
  hivemux uninstall    remove everything setup added (your own config stays)
  hivemux doctor       check dependencies and wiring
  hivemux connect <host>         work on another computer's hivemux over ssh (reconnects)
  hivemux connect --add <host>   check and remember a host (--mosh to use mosh)
  hivemux office       open the bee office: every Claude session as a bee in a window of its own
  hivemux open <file>  open files with the default app of the computer you look from (on a hivemux connect
                       screen: copied to that computer and opened there)
  hivemux update-claude [--yes]  check for a new Claude Code, ask, update, then restart each pane's Claude on it (same conversation;
                       busy ones once they are done)
  hivemux version
  hm [dir] [name]      open (or jump to) a project: one tmux session per folder

Keys inside tmux: Option+1..9 jump · Option+0 oldest waiting · Option+O open path
                  prefix C new named Claude · prefix b hide sidebar · prefix H last remote host
                  prefix B bee office (or the 🐝 button at the top of the sidebar)
U
}

ask() { # ask "question" default(y|n) -> 0 yes
  local q="$1" def="$2" a
  if [ "$YES" = 1 ] || [ ! -t 0 ]; then [ "$def" = y ]; return; fi
  read -r -p "  $q [$( [ "$def" = y ] && echo Y/n || echo y/N )] " a
  a="${a:-$def}"; [[ "$a" =~ ^[Yy] ]]
}

backup() { [ -e "$1" ] || return 0; mkdir -p "$DATA/backups"; cp -P "$1" "$DATA/backups/$(basename "$1").$(date +%Y%m%d-%H%M%S)"; }

remove_block() { # remove_block file
  [ -f "$1" ] || return 0
  awk -v b="$BEGIN" -v e="$END" '$0==b{skip=1;next} $0==e{skip=0;next} !skip' "$1" > "$1.hivemux.tmp" && mv "$1.hivemux.tmp" "$1"
}

put_block() { # put_block file "content"
  local f="$1" content="$2"
  mkdir -p "$(dirname "$f")"
  if [ -L "$f" ]; then backup "$f"; cp "$(realpath "$f")" "$f.hivemux.tmp" 2>/dev/null || : > "$f.hivemux.tmp"; rm -f "$f"; mv "$f.hivemux.tmp" "$f"; fi
  [ -f "$f" ] || : > "$f"
  backup "$f"; remove_block "$f"
  { [ -s "$f" ] && [ -n "$(tail -c1 "$f")" ] && echo; printf '%s\n%s\n%s\n' "$BEGIN" "$content" "$END"; } >> "$f"
}

need() { command -v "$1" >/dev/null 2>&1; }

# macOS or Linux, and on Linux the package manager / macOS 인지 Linux 인지, Linux 면 패키지 관리자
OS="$([ "$(uname -s)" = Darwin ] && echo mac || echo linux)"
pkg_mgr() { local m; for m in apt-get dnf pacman zypper apk; do need "$m" && { echo "$m"; return; }; done; }
pkg_install_cmd() { # the command that installs packages "$@" / 패키지 "$@" 를 설치하는 명령
  case "$(pkg_mgr)" in
    apt-get) echo "sudo apt-get install -y $*" ;; dnf) echo "sudo dnf install -y $*" ;;
    pacman) echo "sudo pacman -S --needed --noconfirm $*" ;; zypper) echo "sudo zypper install -y $*" ;;
    apk) echo "sudo apk add $*" ;; esac
}
# a desktop to open windows on (not an ssh session to a server) / 창을 띄울 데스크톱 (서버에 ssh 로 들어온 것이 아니다)
desktop() { [ "$OS" = mac ] || [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; }
have_ghostty() { { [ "$OS" = mac ] && [ -d /Applications/Ghostty.app ]; } || need ghostty; }
# Linux: install Ghostty with a distribution's own package when it has one, else the snap (community built,
# https://ghostty.org/docs/install/binary) / Linux: 배포판에 자체 패키지가 있으면 그것으로, 없으면 snap (커뮤니티 빌드)
ghostty_install_cmd() {
  case "$(pkg_mgr)" in
    pacman) echo "sudo pacman -S --needed ghostty"; return ;; zypper) echo "sudo zypper install ghostty"; return ;;
    apk) echo "sudo apk add ghostty"; return ;;
    apt-get) apt-cache policy ghostty 2>/dev/null | grep -q 'Candidate: [0-9]' && { echo "sudo apt-get install -y ghostty"; return; } ;;
  esac
  need snap && echo "sudo snap install ghostty --classic"
}

# Terminals: make a terminal open every window inside tmux (bin/hivemux-attach), or stop it.
# 터미널: 창을 열 때마다 tmux 안으로 들어가게 한다 (bin/hivemux-attach). 또는 그만둔다.
#   hivemux terminal [ghostty|iterm|wezterm|kitty|alacritty|terminal] [--off]
# Each keeps to its own block or file, so --off and uninstall take out only what was added.
# 저마다 자기 블록이나 파일만 쓴다. 그래서 --off 와 uninstall 은 넣은 것만 뺀다.
KITTY_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/kitty/kitty.conf"
ALACRITTY_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/alacritty/alacritty.toml"
ITERM_PROFILE="$HOME/Library/Application Support/iTerm2/DynamicProfiles/hivemux.json"
TERMS="ghostty iterm wezterm kitty alacritty terminal"
[ "$(uname -s)" = Darwin ] || TERMS="ghostty wezterm kitty alacritty"   # iTerm2 and Terminal.app are macOS apps / macOS 앱

term_name() { case "$1" in ghostty) echo Ghostty ;; iterm) echo iTerm2 ;; wezterm) echo WezTerm ;; kitty) echo kitty ;;
  alacritty) echo Alacritty ;; terminal) echo Terminal ;; *) echo "$1" ;; esac; }

# the terminal this runs in (not inside tmux) / 지금 실행 중인 터미널 (tmux 안이 아닐 때)
term_here() {
  [ -n "${TMUX:-}" ] && return
  case "${TERM_PROGRAM:-}" in ghostty) echo ghostty; return ;; iTerm.app) echo iterm; return ;; WezTerm) echo wezterm; return ;;
    Apple_Terminal) echo terminal; return ;; esac
  [ -n "${KITTY_WINDOW_ID:-}" ] && { echo kitty; return; }
  [ -n "${ALACRITTY_WINDOW_ID:-}" ] && echo alacritty
}

wezterm_conf() { # the config WezTerm reads; a new one when there is none / WezTerm 이 읽는 설정. 없으면 새 것
  local f; for f in "${WEZTERM_CONFIG_FILE:-}" "$HOME/.wezterm.lua" "${XDG_CONFIG_HOME:-$HOME/.config}/wezterm/wezterm.lua"; do
    [ -n "$f" ] && [ -f "$f" ] && { echo "$f"; return; }; done
  echo "${XDG_CONFIG_HOME:-$HOME/.config}/wezterm/wezterm.lua"
}

# Remove one block between "<c> >>> hivemux <tag>>>>" markers (c is the file's comment, # or --)
# "<c> >>> hivemux <tag>>>>" 표시 사이 블록 하나를 지운다 (c 는 그 파일의 주석, # 또는 --)
remove_tagged() { # remove_tagged file comment tag
  [ -f "$1" ] || return 1
  grep -qxF -e "$2 >>> hivemux $3>>>" "$1" || return 1
  awk -v b="$2 >>> hivemux $3>>>" -v e="$2 <<< hivemux $3<<<" '$0==b{skip=1;next} $0==e{skip=0;next} !skip' "$1" > "$1.hivemux.tmp" && mv "$1.hivemux.tmp" "$1"
}

term_on() {
  local a="$HM_BIN/hivemux-attach" f
  case "$1" in
    ghostty)
      put_block "$GHOSTTY_CONF" "command = $a
macos-option-as-alt = true
window-save-state = always
confirm-close-surface = false"
      ok "Ghostty windows open hivemux ($GHOSTTY_CONF)" ;;
    kitty)
      put_block "$KITTY_CONF" "shell $a
macos_option_as_alt yes"
      ok "kitty windows open hivemux ($KITTY_CONF)" ;;
    alacritty)
      f="$ALACRITTY_CONF"
      # TOML allows a table once: leave tables the file already has to you
      # TOML 은 표를 한 번만 허용한다: 이미 있는 표는 직접 고치게 둔다
      local rest; rest="$(awk -v b="$BEGIN" -v e="$END" '$0==b{skip=1;next} $0==e{skip=0;next} !skip' "$f" 2>/dev/null)"   # without ours / 우리 블록 빼고
      if grep -qE '^\[terminal(\.shell)?\]|^shell *=' <<<"$rest"; then
        bad "$f already sets the shell: set program = \"$a\" under [terminal.shell] yourself"; return 1
      fi
      local body="[terminal.shell]
program = \"$a\""
      if grep -qE '^\[window\]' <<<"$rest"; then
        warn "$f has [window]: add option_as_alt = \"Both\" there for the Option keys"
      else body="$body

[window]
option_as_alt = \"Both\""; fi
      put_block "$f" "$body"
      ok "Alacritty windows open hivemux ($f)" ;;
    wezterm)
      f="$(wezterm_conf)"
      local body="config.default_prog = { '$a' }
config.send_composed_key_when_left_alt_is_pressed = false
config.send_composed_key_when_right_alt_is_pressed = false"
      remove_tagged "$f" "--" "" || true
      if [ ! -f "$f" ]; then
        mkdir -p "$(dirname "$f")"
        printf '%s\n' "local wezterm = require 'wezterm'" "local config = wezterm.config_builder()" "-- >>> hivemux >>>" "$body" "-- <<< hivemux <<<" "return config" > "$f"
      else
        # put it before the last "return <table>", using that table's name / 마지막 "return <표>" 앞에, 그 표 이름으로
        local v; v="$(grep -E '^return +[A-Za-z_][A-Za-z0-9_]* *$' "$f" | tail -1 | awk '{print $2}')"
        [ -n "$v" ] || { bad "$f does not end in \"return config\": add config.default_prog = { '$a' } yourself"; return 1; }
        backup "$f"
        HM_BODY="${body//config./$v.}" awk -v n="$(grep -nE '^return +[A-Za-z_][A-Za-z0-9_]* *$' "$f" | tail -1 | cut -d: -f1)" \
          'NR==n{print "-- >>> hivemux >>>"; print ENVIRON["HM_BODY"]; print "-- <<< hivemux <<<"} {print}' "$f" > "$f.hivemux.tmp" && mv "$f.hivemux.tmp" "$f"
      fi
      ok "WezTerm windows open hivemux ($f)" ;;
    iterm)
      # a profile of its own (Dynamic Profiles), made the default: the user's profiles stay as they are
      # 따로 된 프로필 (Dynamic Profiles) 을 기본으로: 쓰던 프로필은 그대로 둔다
      mkdir -p "$(dirname "$ITERM_PROFILE")"
      jq -n --arg c "$a" '{Profiles: [{Name: "hivemux", Guid: "hivemux-attach", "Custom Command": "Yes", Command: $c,
        "Option Key Sends": 2, "Right Option Key Sends": 2}]}' > "$ITERM_PROFILE"
      local was; was="$(defaults read com.googlecode.iterm2 "Default Bookmark Guid" 2>/dev/null)"
      [ -n "$was" ] && [ "$was" != hivemux-attach ] && echo "$was" > "$DATA/iterm-default"
      defaults write com.googlecode.iterm2 "Default Bookmark Guid" -string hivemux-attach
      ok "iTerm2 profile \"hivemux\" is the default (new windows after iTerm2 restarts)" ;;
    terminal)
      # Terminal.app cannot run a program in place of the shell for every window: the shell starts it
      # Terminal.app 은 창마다 셸 대신 프로그램을 띄우지 못한다: 셸이 띄운다
      local zrc="$HOME/.zshrc"
      remove_tagged "$zrc" "#" "terminal " || true
      { [ -s "$zrc" ] && [ -n "$(tail -c1 "$zrc")" ] && echo
        printf '%s\n' "# >>> hivemux terminal >>>" \
          "# Terminal windows open hivemux (hivemux terminal terminal --off to stop)" \
          "if [[ -o interactive && -z \"\$TMUX\" && -z \"\$HIVEMUX_TRIED\" && \"\$TERM_PROGRAM\" = Apple_Terminal ]]; then" \
          "  export HIVEMUX_TRIED=1; exec \"$a\"" \
          "fi" "# <<< hivemux terminal <<<"; } >> "$zrc"
      ok "Terminal windows open hivemux (~/.zshrc)"
      warn "for the Option keys: Terminal → Settings → Profiles → Keyboard → Use Option as Meta key" ;;
    *) bad "unknown terminal: $1 (one of: $TERMS)"; return 2 ;;
  esac
}

term_off() {
  local f
  case "$1" in
    ghostty) remove_block "$GHOSTTY_CONF" ;;
    kitty) remove_block "$KITTY_CONF" ;;
    alacritty) remove_block "$ALACRITTY_CONF" ;;
    wezterm) f="$(wezterm_conf)"; remove_tagged "$f" "--" "" || true ;;
    iterm)
      rm -f "$ITERM_PROFILE"
      if [ "$(defaults read com.googlecode.iterm2 "Default Bookmark Guid" 2>/dev/null)" = hivemux-attach ]; then
        if [ -s "$DATA/iterm-default" ]; then defaults write com.googlecode.iterm2 "Default Bookmark Guid" -string "$(cat "$DATA/iterm-default")"
        else defaults delete com.googlecode.iterm2 "Default Bookmark Guid" 2>/dev/null; fi
      fi
      rm -f "$DATA/iterm-default" ;;
    terminal) remove_tagged "$HOME/.zshrc" "#" "terminal " || true ;;
    *) bad "unknown terminal: $1 (one of: $TERMS)"; return 2 ;;
  esac
  ok "$(term_name "$1") windows no longer open hivemux"
}

terminal() {
  local name="" off=0 a
  for a in "$@"; do case "$a" in --off) off=1 ;; -h|--help) name=help ;; -*) echo "unknown option: $a" >&2; exit 2 ;; *) name="$a" ;; esac; done
  [ -n "$name" ] || name="$(term_here)"
  if [ -z "$name" ] || [ "$name" = help ]; then
    echo "usage: hivemux terminal <$(echo "$TERMS" | tr ' ' '|')> [--off]"
    echo "  makes that terminal open every window inside tmux with the sidebar (--off: stop)"
    exit 2
  fi
  case " $TERMS " in *" $name "*) ;; *) bad "$(term_name "$name") is not available here (one of: $TERMS)"; exit 2 ;; esac
  mkdir -p "$DATA"
  if [ "$off" = 1 ]; then term_off "$name"; else term_on "$name"; fi
}

setup() {
  YES=0; KEYS=ask; GHOSTTY=ask; REMOTE=ask; HLANG=""
  for a in "$@"; do case "$a" in
    --yes|-y) YES=1 ;; --lang=*) HLANG="${a#--lang=}" ;; --no-keys) KEYS=no ;; --no-ghostty) GHOSTTY=no ;; --no-remote) REMOTE=no ;;
    *) echo "unknown option: $a" >&2; exit 2 ;; esac; done
  mkdir -p "$DATA"

  step "1/5 Dependencies"
  local missing=0
  local c lack=""
  for c in tmux jq python3 git perl; do if need "$c"; then ok "$c"; else bad "$c not found"; missing=1; lack="$lack $c"; fi; done
  if [ $missing = 1 ] && [ "$OS" = linux ]; then
    # Linux: offer the distribution's packages (asked: it runs sudo) / Linux: 배포판 패키지를 권한다 (sudo 라서 묻는다)
    local inst; inst="$(pkg_install_cmd $lack)"
    if [ -n "$inst" ] && [ "$YES" != 1 ] && [ -t 0 ] && ask "Install them ($inst)?" y; then
      $inst && missing=0
      for c in $lack; do need "$c" || missing=1; done
    fi
    [ $missing = 0 ] || { echo "  install with: ${inst:-your package manager:$lack}"; exit 1; }
  fi
  [ $missing = 0 ] || { echo "  install with: brew install tmux jq git (python3 and perl come with Xcode Command Line Tools)"; exit 1; }
  local tv; tv="$(tmux -V | sed 's/[^0-9.]//g')"
  awk -v v="$tv" 'BEGIN{split(v,a,"."); exit !((a[1]>3)||(a[1]==3&&a[2]>=3))}' && ok "tmux $tv" || {
    bad "tmux $tv: need 3.3 or newer"
    [ "$OS" = linux ] && echo "  (Ubuntu 22.04 has 3.2: Ubuntu 24.04, Debian 12, Fedora and Arch have a newer one)"
    exit 1; }
  need claude && ok "claude $(claude --version 2>/dev/null | head -1)" || warn "claude not found (install Claude Code first)"

  step "2/5 tmux plugins (resurrect + continuum)"
  "$HM_BIN/hivemux-plugins" install || { bad "could not download plugins"; exit 1; }

  step "3/5 tmux ($TMUX_CONF)"
  [ -n "$HLANG" ] || { case "${LC_ALL:-${LANG:-}}" in ko*) HLANG=ko ;; *) HLANG=en ;; esac; }
  local block="set -g @hivemux-lang $HLANG
source-file \"$SHARE/hivemux.tmux\""
  if [ "$KEYS" = ask ] && ask "Use recommended keys? (prefix Ctrl+A, since Claude Code uses Ctrl+B; | and - splits)" y; then KEYS=yes; fi
  [ "$KEYS" = yes ] && block="$block
source-file \"$SHARE/keys.tmux\""
  put_block "$TMUX_CONF" "$block"; ok "added hivemux block (language: $HLANG)"

  step "4/5 Claude Code hooks ($CLAUDE_SETTINGS)"
  mkdir -p "$(dirname "$CLAUDE_SETTINGS")"; [ -f "$CLAUDE_SETTINGS" ] || echo '{}' > "$CLAUDE_SETTINGS"
  backup "$CLAUDE_SETTINGS"
  local remote=false
  if [ "$REMOTE" = ask ] && ask "Enable Remote Control for every session? (continue from the Claude phone app)" y; then remote=true; fi
  local tmp; tmp="$(mktemp)"
  jq --arg h "$HM_BIN/hivemux-hook" --argjson evs "$HOOK_EVENTS" --argjson remote "$remote" '
    def mine: (.command // "") | (contains("hivemux-hook") or contains("claude-tmux-hook"));
    .hooks = (.hooks // {})
    | reduce $evs[] as $ev (.;
        .hooks[$ev] = (((.hooks[$ev] // []) | map(.hooks = ((.hooks // []) | map(select(mine | not)))) | map(select((.hooks|length) > 0)))
                       + [{hooks: [{type: "command", command: ($h + " " + $ev), timeout: 5}]}]))
    | if $remote then .remoteControlAtStartup = true else . end
  ' "$CLAUDE_SETTINGS" > "$tmp" && jq empty "$tmp" && mv "$tmp" "$CLAUDE_SETTINGS" || { bad "could not update settings"; exit 1; }
  ok "hooks for ${HOOK_EVENTS//\"/}"
  [ "$remote" = true ] && ok "Remote Control for all sessions" && { grep -qx remote "$DATA/setup-flags" 2>/dev/null || echo "remote" >> "$DATA/setup-flags"; }

  step "5/5 Ghostty ($GHOSTTY_CONF)"
  # No Ghostty yet: offer to install it (asked, never with --yes: it is an app of its own)
  # Ghostty 가 없으면 설치를 권한다 (묻고 한다. --yes 로는 하지 않는다: 따로 된 앱이다)
  if [ "$GHOSTTY" != no ] && ! have_ghostty && ! desktop; then
    # a server reached over ssh: no windows to open here / ssh 로 들어온 서버: 여기서 띄울 창이 없다
    warn "no desktop here: skipped (connect to this machine with hivemux connect, or run tmux)"; GHOSTTY=no
  elif [ "$GHOSTTY" != no ] && ! have_ghostty && [ "$YES" != 1 ] && [ -t 0 ] && [ "$OS" = linux ]; then
    local gi; gi="$(ghostty_install_cmd)"
    if [ -n "$gi" ]; then
      if ask "Ghostty is not installed. Install it ($gi)? Every Ghostty window then opens hivemux" y; then
        $gi && ok "Ghostty installed" || bad "could not install Ghostty"
      fi
    else
      warn "Ghostty is not installed: see https://ghostty.org/docs/install/binary, then run hivemux setup again"
    fi
  elif [ "$GHOSTTY" != no ] && ! have_ghostty && [ "$YES" != 1 ] && [ -t 0 ]; then
    if need brew; then
      if ask "Ghostty is not installed. Install it (brew install --cask ghostty)? Every Ghostty window then opens hivemux" y; then
        brew install --cask ghostty && ok "Ghostty installed" || bad "could not install Ghostty"
      fi
    else
      warn "Ghostty is not installed: get it from https://ghostty.org/download, then run hivemux setup again"
      open https://ghostty.org/download 2>/dev/null || true
    fi
  fi
  if have_ghostty; then
    if [ "$GHOSTTY" = ask ] && ask "Make every Ghostty window open inside tmux (hivemux-attach)?" y; then GHOSTTY=yes; fi
    if [ "$GHOSTTY" = yes ]; then term_on ghostty
    else warn "skipped"; fi
  elif [ "$GHOSTTY" != no ]; then warn "Ghostty not installed, skipped (run tmux and it still works)"; fi
  # Run from another terminal: offer that one too (it is the user's own, so the default is no)
  # 다른 터미널에서 실행: 그 터미널도 권한다 (사용자가 쓰던 것이므로 기본은 "아니오")
  local here; here="$(term_here)"
  if [ -n "$here" ] && [ "$here" != ghostty ]; then
    if ask "Make $(term_name "$here") open hivemux in every window too?" n; then term_on "$here" || true
    else echo "  ${D}later: hivemux terminal $here${X}"; fi
  fi

  # PATH for git installs (Homebrew already links bin/)
  # (decided by install location, not the current PATH, which may be stale)
  # zsh (the macOS shell) always; bash too when it is the login shell or has a ~/.bashrc (Linux)
  # zsh (macOS 의 셸) 는 늘. bash 도 로그인 셸이거나 ~/.bashrc 가 있으면 (Linux)
  case "$HM_BIN" in /opt/homebrew/*|/usr/local/*|/home/linuxbrew/*|*/opt/hivemux/libexec/bin) ;; *)
    local rc
    for rc in .zshrc .bashrc; do
      case "$rc" in .zshrc) [ "$OS" = mac ] || [ -e "$HOME/.zshrc" ] || [ "${SHELL##*/}" = zsh ] || continue ;;
                    .bashrc) [ -e "$HOME/.bashrc" ] || [ "${SHELL##*/}" = bash ] || continue ;; esac
      put_block "$HOME/$rc" "export PATH=\"$HM_BIN:\$PATH\""; ok "added $HM_BIN to PATH in ~/$rc"
    done ;; esac

  # an update: reload tmux and restart the sidebars so they run the new code
  # 업데이트: tmux 설정을 다시 읽고, 사이드바도 새 코드로 다시 띄운다
  if tmux has-session 2>/dev/null; then
    tmux source-file "$TMUX_CONF" && ok "reloaded running tmux"
    "$HM_BIN/hivemux-sidebar" respawn >/dev/null 2>&1 && ok "restarted the sidebars"
    "$HM_BIN/hivemux-sidebar" ensure >/dev/null 2>&1      # windows that had none / 사이드바가 없던 창에도
  fi
  # build the bee office window now, in the background, so opening it later is instant (hivemux office)
  # 벌 사무실 창을 지금 뒤에서 빌드해 둔다. 나중에 열 때 바로 뜨게 (hivemux office)
  [ "$OS" = mac ] && ( nohup "$HM_BIN/hivemux-office" --build >/dev/null 2>&1 & )
  # A first install (no tmux server, no saved work): the first window asks for a project folder
  # (bin/hivemux-attach), so nobody has to know hm
  # 처음 설치 (tmux 서버도 저장본도 없음): 첫 창이 프로젝트 폴더를 묻는다 (bin/hivemux-attach). hm 을 몰라도 된다
  local snap="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect/last"
  tmux has-session 2>/dev/null || [ -e "$snap" ] || : > "$DATA/welcome"
  echo
  if [ "$GHOSTTY" = yes ] && [ "${TERM_PROGRAM:-}" != ghostty ] && [ "$YES" != 1 ] && [ -t 0 ] && desktop; then
    echo "${B}Done.${X} Opening Ghostty: pick a project folder there and Claude starts in it."
    { if [ "$OS" = mac ]; then open -a Ghostty; else setsid -f ghostty >/dev/null 2>&1 </dev/null; fi; } 2>/dev/null ||
      echo "  open Ghostty yourself (or run ${B}tmux${X}), then ${B}hm ~/your/project${X}."
  elif [ "$GHOSTTY" = yes ]; then
    echo "${B}Done.${X} Open Ghostty ($([ "$OS" = mac ] && echo ⌘N || echo Ctrl+Shift+N) for a new window): pick a project folder there and Claude starts in it."
  else
    echo "${B}Done.${X} Run ${B}tmux${X}, then ${B}hm ~/your/project${X}."
  fi
  echo "${D}Phone push for approvals: in Claude Code run /config → Push when actions required.${X}"
}

uninstall() {
  step "Removing hivemux"
  remove_block "$TMUX_CONF" && ok "tmux block removed"
  remove_block "$GHOSTTY_CONF" && ok "Ghostty block removed"
  local tm; for tm in kitty alacritty wezterm iterm terminal; do term_off "$tm" >/dev/null 2>&1; done
  ok "other terminals' settings removed"
  remove_block "$HOME/.zshrc" && remove_block "$HOME/.bashrc" && ok "PATH block removed"
  if [ -f "$CLAUDE_SETTINGS" ]; then
    backup "$CLAUDE_SETTINGS"; local tmp; tmp="$(mktemp)"
    local rm_remote=false; grep -qx remote "$DATA/setup-flags" 2>/dev/null && rm_remote=true
    jq --argjson rr "$rm_remote" '
      def mine: (.command // "") | (contains("hivemux-hook") or contains("claude-tmux-hook"));
      if .hooks then .hooks |= (with_entries(.value |= (map(.hooks = ((.hooks // []) | map(select(mine | not)))) | map(select((.hooks|length) > 0))))
                              | with_entries(select(.value|length > 0))) else . end
      | if $rr then del(.remoteControlAtStartup) else . end
    ' "$CLAUDE_SETTINGS" > "$tmp" && mv "$tmp" "$CLAUDE_SETTINGS" && ok "Claude Code hooks removed"
  fi
  if tmux has-session 2>/dev/null; then
    tmux list-panes -a -F '#{pane_id} #{pane_title}' | awk '$2=="hivemux-sidebar"{print $1}' | while read -r p; do tmux kill-pane -t "$p"; done
    ok "closed sidebars (restart tmux to drop the remaining bindings)"
  fi
  echo "  ${D}kept: $DATA (saved layouts, plugins, backups). Delete it to remove everything.${X}"
}

doctor() {
  step "hivemux $VERSION ($HM_ROOT)"
  for c in tmux jq python3 git claude; do need "$c" && ok "$c: $(command -v "$c")" || bad "$c not found"; done
  [ -n "$("$HM_BIN/hivemux-plugins" dir 2>/dev/null)" ] && ok "plugins: $("$HM_BIN/hivemux-plugins" dir)" || bad "plugins missing (hivemux setup)"
  if [ -n "$(tmux show -gqv @hivemux-nosave 2>/dev/null)" ]; then
    warn "autosave paused: this tmux server started without restoring (restore: prefix Ctrl-r, or tmux kill-server and reopen Ghostty)"
  fi
  grep -qF "$BEGIN" "$TMUX_CONF" 2>/dev/null && ok "tmux: $TMUX_CONF" || bad "tmux: block missing in $TMUX_CONF"
  if grep -qF "hivemux-attach" "$GHOSTTY_CONF" 2>/dev/null; then ok "Ghostty: $GHOSTTY_CONF"
  elif have_ghostty; then warn "Ghostty: not attached to tmux (hivemux terminal ghostty)"; fi
  grep -qF "hivemux-attach" "$KITTY_CONF" 2>/dev/null && ok "kitty: $KITTY_CONF"
  grep -qF "hivemux-attach" "$ALACRITTY_CONF" 2>/dev/null && ok "Alacritty: $ALACRITTY_CONF"
  grep -qF "hivemux-attach" "$(wezterm_conf)" 2>/dev/null && ok "WezTerm: $(wezterm_conf)"
  [ -f "$ITERM_PROFILE" ] && ok "iTerm2: profile hivemux"
  grep -qF "hivemux terminal >>>" "$HOME/.zshrc" 2>/dev/null && ok "Terminal: ~/.zshrc"
  local n; n="$(jq '[.hooks[]?[]?.hooks[]? | select(.command|contains("hivemux-hook"))] | length' "$CLAUDE_SETTINGS" 2>/dev/null || echo 0)"
  [ "$n" -ge 11 ] && ok "Claude hooks: $n" || bad "Claude hooks: $n of 11 (hivemux setup)"
  if tmux has-session 2>/dev/null; then
    [ -n "$(tmux show -gqv @hivemux-bin)" ] && ok "tmux server: hivemux loaded" || warn "tmux server running without hivemux (tmux source-file ~/.tmux.conf)"
    ok "sidebars: $(tmux list-panes -a -F '#{pane_title}' | grep -c hivemux-sidebar)  claude sessions: $(tmux list-panes -a -F '#{@claude_session}' | grep -c .)"
  else warn "tmux server not running"; fi

  # Remote: this Mac as the one you connect to, and the hosts you connect to from here
  # 원격: 다른 Mac 이 붙는 쪽으로서의 이 Mac, 그리고 여기서 붙는 호스트들
  step "remote (hivemux connect)"
  # sshd answering here (bash's /dev/tcp: nc differs between macOS and Linux) / 여기서 sshd 가 받는지
  if perl -e 'alarm 2; exec @ARGV' bash -c 'exec 3<>/dev/tcp/127.0.0.1/22' 2>/dev/null; then
    ok "ssh on: other computers can connect here"
    case "$(pmset -g 2>/dev/null | awk '$1=="sleep"{print $2; exit}')" in
      0) ok "never sleeps on its own" ;;
      "") ;;
      *) warn "this Mac sleeps when idle; others cannot connect while it sleeps (System Settings → Energy: prevent sleeping)" ;;
    esac
  else
    if [ "$OS" = mac ]; then warn "Remote Login off: to connect here from another computer, turn on System Settings → General → Sharing → Remote Login"
    else warn "ssh off: to connect here from another computer, install and start the ssh server (package openssh-server or openssh, then sudo systemctl enable --now ssh or sshd)"; fi
  fi
  command -v mosh >/dev/null && ok "mosh: $(command -v mosh)"
  local h how hosts="$DATA/remote-hosts"
  if [ -s "$hosts" ]; then
    while read -r h how; do
      [ -n "$h" ] || continue
      if ssh -o BatchMode=yes -o ConnectTimeout=4 "$h" true </dev/null >/dev/null 2>&1; then ok "host $h: reachable${how:+ ($how)}"
      else warn "host $h: not reachable now (asleep, offline, or ssh key)"; fi
    done < "$hosts"
  else
    ok "no remote hosts (hivemux connect --add <host>)"
  fi
}

case "${1:-help}" in
  setup) shift; setup "$@" ;;
  uninstall) uninstall ;;
  terminal) shift; terminal "$@" ;;
  doctor) doctor ;;
  connect) shift; exec "$HM_BIN/hivemux-connect" "$@" ;;
  open) shift; exec "$HM_BIN/hivemux-show" "$@" ;;
  office) shift; exec "$HM_BIN/hivemux-office" "$@" ;;
  update-claude) shift; exec "$HM_BIN/hivemux-claude-update" "$@" ;;
  version|-v|--version) echo "hivemux $VERSION" ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
