#!/usr/bin/env python3
"""The bee office: every Claude session as a bee in a small office, in a window of its own.
벌 사무실: Claude 세션마다 벌 한 마리가 작은 사무실에서 일하는 모습을 별도 창으로 보여 준다.

  hivemux-office                 open the window (starts the server below if needed)
                               창 열기 (필요하면 아래 서버를 띄운다)
  hivemux-office serve           the local web server the window shows (exits a while after the window closes)
                               창이 보여 주는 로컬 웹 서버 (창을 닫고 잠시 뒤 끝난다)
  hivemux-office --json          this Mac's sessions as JSON (the server, and the other Mac over ssh, read it)
                               이 Mac 의 세션을 JSON 으로 (서버와, ssh 로 상대 Mac 이 읽는다)
  hivemux-office --goto <pane> [--from <mac>]
                               show that pane on a screen of this Mac (or on the screen attached from <mac>)
                               그 칸을 이 Mac 화면에 (또는 <mac> 에서 붙은 화면에) 띄운다
  hivemux-office --client <client>
                               open it from tmux (sidebar button and menu, prefix B); a first build shows
                               its progress in a popup on <client>
                               tmux 에서 열기 (사이드바 버튼과 메뉴, prefix B). 처음 빌드는 <client> 의 팝업에 진행을 보인다
  hivemux-office --build       build the window app now, quietly (hivemux setup runs it in the background)
                               창 앱을 지금 조용히 빌드 (hivemux setup 이 뒤에서 실행)

The page (share/office/index.html) polls /state every second: this Mac's sessions, plus those of every
Mac this one is connected to with hivemux connect (asked over the ssh connection hivemux-ports keeps).
A bee works at its desk (run), runs to the question window in the boss room (wait), holds up a jar of
honey (done, not seen), takes it to the honeycomb once seen, then rests in the lounge (idle). A task
in plan mode (@claude_plan, from bin/hivemux-hook) plans in the meeting room; subagents
(@claude_agents) stand by the desk as small helper bees.
페이지(share/office/index.html)는 1초마다 /state 를 읽는다: 이 Mac 의 세션, 그리고 hivemux connect 로 붙어
있는 Mac 마다의 세션 (hivemux-ports 가 유지하는 ssh 연결로 묻는다). 벌은 자리에서 일하고 (run), 사장실
질문 창구로 뛰어가고 (wait), 꿀단지를 들고 있다가 (done, 안 봄) 보고 나면 벌집에 꿀을 채우고, 라운지에서
쉰다 (idle). 계획 모드 (@claude_plan, bin/hivemux-hook 이 표시)면 회의실에서 계획을 세우고,
서브에이전트 (@claude_agents)는 책상 옆의 작은 부사수 벌이 된다.

The window is a small native app (share/office/OfficeWindow.swift) built once with swiftc into
$XDG_DATA_HOME/hivemux/hive/; without swiftc the page opens in the browser.
창은 작은 네이티브 앱 (share/office/OfficeWindow.swift)으로, swiftc 로 한 번 빌드해
$XDG_DATA_HOME/hivemux/hive/ 에 둔다. swiftc 가 없으면 브라우저로 연다.
"""
import functools, glob, hashlib, http.server, json, os, shlex, shutil, signal, socket, subprocess, sys, threading, time, urllib.request

TMUX = shutil.which("tmux") or "/opt/homebrew/bin/tmux"
HERE = os.path.dirname(os.path.realpath(__file__))
SHARE = os.path.join(os.path.dirname(HERE), "share", "office")
LOGO = os.path.join(os.path.dirname(HERE), "docs", "logo", "hivemux-logo-512.png")
DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "hivemux")
OFFICE_DIR = os.path.join(DATA, "office")
PORT_FILE = os.path.join(OFFICE_DIR, "port")
WINDOW_PID = os.path.join(OFFICE_DIR, "window.pid")
APP_NAME = "hivemux office"   # the window app's file name, shown in the menu bar and the Dock / 창 앱 파일 이름. 메뉴 막대와 Dock 에 보인다
ORDER_FILE = os.path.join(DATA, "session-order")
PORT = int(os.environ.get("HIVEMUX_OFFICE_PORT") or 47380)   # fixed, so the page keeps its settings / 고정: 페이지 설정이 유지되게
IDLE_EXIT = 90               # seconds without a page asking before the server quits / 페이지가 묻지 않은 채 이만큼 지나면 서버 종료
US = "\x1f"
FIELDS = ["pane_id", "session_name", "window_index", "window_name", "pane_title", "@claude_state", "@claude_state_at",
          "@claude_session", "@claude_title", "@claude_name", "@claude_agents", "@claude_plan", "pane_current_command"]
SHELLS = {"zsh", "bash", "fish", "sh", "dash", "tcsh", "ksh", "login"}
SSH = shlex.split(os.environ.get("HIVEMUX_SSH") or "ssh")
PATH = "PATH=/opt/homebrew/bin:/usr/local/bin:$PATH"
# Runs on the other Mac: its hivemux-office, wherever it got installed / 상대 Mac 에서 실행: 설치된 곳의 hivemux-office
# (HIVEMUX_OFFICE: another path there, used for testing / 거기 다른 경로, 시험용)
REMOTE = ('for p in ${HIVEMUX_OFFICE:-} /opt/homebrew/bin/hivemux-office /usr/local/bin/hivemux-office "$HOME/.local/share/hivemux/src/bin/hivemux-office"; '
          'do [ -x "$p" ] && exec "$p" %s; done; echo \'{"missing": true}\'')


def tmux(*a):
    return subprocess.run([TMUX, *a], capture_output=True, text=True).stdout


def lang():
    v = os.environ.get("HIVEMUX_LANG") or tmux("show", "-gqv", "@hivemux-lang").strip()
    return "ko" if (v or os.environ.get("LANG", "")).startswith("ko") else "en"


@functools.lru_cache(maxsize=1)
def me():
    """This Mac's name, as hivemux-ports uses it / hivemux-ports 가 쓰는 이 Mac 이름"""
    r = subprocess.run([os.path.join(HERE, "hivemux-ports"), "--me"], capture_output=True, text=True)
    return r.stdout.strip() or socket.gethostname().split(".")[0]


def task_name(p):
    """Like the sidebar card (bin/hivemux-sidebar-view task_name) / 사이드바 카드와 같게"""
    if p["@claude_name"]:
        return p["@claude_name"]
    t = p["pane_title"].lstrip("✳⠂⠐·*✶✻✽✢ ").strip()
    host = socket.gethostname()
    if t and "@" not in t.split(":")[0] and t not in (host, host.split(".")[0]) and t.lower() not in ("claude code", "claude"):
        return t
    if p["@claude_title"]:
        return p["@claude_title"]
    w = p["window_name"]
    return w if w not in ("claude", p["session_name"]) else ""


def snapshot():
    """This Mac's Claude sessions in sidebar order (its ⌥ numbers) / 이 Mac 의 Claude 세션, 사이드바 순서 (⌥ 번호)"""
    fmt = US.join("#{%s}" % f for f in FIELDS)
    panes = [dict(zip(FIELDS, l.split(US))) for l in tmux("list-panes", "-a", "-F", fmt).splitlines()]
    items = [p for p in panes if len(p) == len(FIELDS) and p["@claude_session"] and p["@claude_state"]
             and p["pane_current_command"].lstrip("-") not in SHELLS]
    rank = {}
    try:
        with open(ORDER_FILE) as f:
            for l in f:
                rank.setdefault(l.rstrip("\n"), len(rank))
    except OSError:
        pass
    items = [p for _, p in sorted(enumerate(items), key=lambda e: (rank.get(e[1]["session_name"], len(rank)), e[0]))]
    honey = tmux("show", "-gqv", "@hivemux-honey").split()
    today = time.strftime("%Y-%m-%d")
    return {
        "host": me(), "lang": lang(), "now": int(time.time()),
        "honey": int(honey[1]) if len(honey) == 2 and honey[0] == today and honey[1].isdigit() else 0,
        "sessions": [{
            "pane": p["pane_id"], "idx": i, "project": p["session_name"], "name": task_name(p),
            "state": p["@claude_state"], "at": int(p["@claude_state_at"]) if p["@claude_state_at"].isdigit() else 0,
            "agents": int(p["@claude_agents"]) if p["@claude_agents"].isdigit() else 0,
            "plan": bool(p["@claude_plan"]),
        } for i, p in enumerate(items, 1)],
    }


def goto(pane, frm=None):
    """Show pane on a screen: the one attached from Mac <frm>, else the most recently used one of this Mac
    칸을 화면에 띄운다: <frm> Mac 에서 붙은 화면, 아니면 이 Mac 에서 가장 최근에 쓴 화면"""
    sess = tmux("display", "-p", "-t", pane, "#{session_name}").strip()
    win = tmux("display", "-p", "-t", pane, "#{window_id}").strip()
    if not sess:
        return False
    remote = set(tmux("show", "-gqv", "@hivemux-remote-clients").split())
    if frm:
        clients = [l.split(" ", 1)[0] for l in tmux("show", "-gqv", "@hivemux-remote-from").splitlines()
                   if l.split(" ", 1)[1:] == [frm]]
    else:
        rows = [l.split(" ") for l in tmux("list-clients", "-F", "#{client_activity} #{client_name}").splitlines()]
        clients = [c for _, c in sorted((r for r in rows if len(r) == 2 and r[1] not in remote), reverse=True)]
    if not clients:
        return False
    tmux("switch-client", "-c", clients[0], "-t", f"={sess}")
    tmux("select-window", "-t", win)
    tmux("select-pane", "-t", pane)
    return True


def front_terminal():
    subprocess.run(["open", "-a", "Ghostty"], capture_output=True)


# ── the other Macs / 상대 Mac ──────────────────────────────────────────

def connections():
    """(host, ssh control socket) of every running hivemux-ports (one per hivemux connect)
    돌고 있는 hivemux-ports 마다 (호스트, ssh 제어 소켓) (hivemux connect 하나에 하나)"""
    out = []
    for sock in glob.glob(f"/tmp/hivemux-ports-{os.getuid()}-*"):
        pid = sock.rsplit("-", 1)[1]
        args = subprocess.run(["ps", "-o", "args=", "-p", pid], capture_output=True, text=True).stdout.split()
        i = next((i for i, a in enumerate(args) if a.endswith("hivemux-ports")), None)
        if i is not None and i + 1 < len(args) and not args[i + 1].startswith("-"):
            out.append((args[i + 1], sock))
    return out


def remote_run(sock, host, args, timeout=8):
    cmd = f"{PATH}; " + REMOTE % " ".join(shlex.quote(a) for a in args)
    try:
        return subprocess.run(SSH + ["-S", sock, "-o", "ControlMaster=no", "-o", "BatchMode=yes", host, cmd],
                              capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return None


class Remotes(threading.Thread):
    """Asks each connected Mac for its sessions every 1.5 s / 붙어 있는 Mac 마다 1.5초에 한 번 세션을 묻는다"""

    def __init__(self):
        super().__init__(daemon=True)
        self.offices, self.lock = {}, threading.Lock()

    def run(self):
        while True:
            conns = connections()
            got = {}
            for host, sock in conns:
                r = remote_run(sock, host, ["--json"])
                try:
                    o = json.loads(r.stdout) if r and r.returncode == 0 else None
                except ValueError:
                    o = None
                if o is None:
                    with self.lock:
                        o = self.offices.get(host)      # keep the last answer through a hiccup / 잠깐 끊겨도 마지막 답을 둔다
                if o is not None:
                    o["ssh"] = host
                    got[host] = o
            with self.lock:
                self.offices = got
            time.sleep(1.5)

    def list(self):
        with self.lock:
            return list(self.offices.values())


# ── server / 서버 ────────────────────────────────────────────────────

class Handler(http.server.BaseHTTPRequestHandler):
    remotes = None
    last = time.time()

    def log_message(self, *a):
        pass

    def send(self, code, body, ctype="application/json"):
        b = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(b)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(b)

    def local(self):
        """Asked for by name 127.0.0.1 or localhost, so another site cannot reach it by DNS rebinding
        127.0.0.1 이나 localhost 라는 이름으로 왔다: 다른 사이트가 DNS 리바인딩으로 닿지 못하게"""
        port = self.server.server_port
        return self.headers.get("Host") in (f"127.0.0.1:{port}", f"localhost:{port}")

    def do_GET(self):
        if not self.local():
            return self.send(403, "{}")
        path = self.path.split("?", 1)[0]
        if path == "/ping":
            return self.send(200, "hivemux-office", "text/plain")
        if path == "/state":
            Handler.last = time.time()
            local = snapshot()
            return self.send(200, json.dumps({"lang": local["lang"], "offices": [local] + Handler.remotes.list()}))
        # the office seen at an angle, or the flat plan seen from above (the page switches between them)
        # 비스듬히 본 사무실, 또는 위에서 본 평면도 (페이지에서 서로 바꾼다)
        page = {"/": "index.html", "/index.html": "index.html", "/2d": "index-2d.html"}.get(path)
        if page:
            with open(os.path.join(SHARE, page), "rb") as f:
                return self.send(200, f.read(), "text/html; charset=utf-8")
        if path == "/logo.svg":
            with open(os.path.join(os.path.dirname(LOGO), "hivemux-logo.svg"), "rb") as f:
                return self.send(200, f.read(), "image/svg+xml")
        self.send(404, "{}")

    def do_POST(self):
        # only the page itself may ask (a browser tab of another site would send its own Origin)
        # 이 페이지만 요청할 수 있다 (다른 사이트의 브라우저 탭이면 다른 Origin 을 보낸다)
        origin = self.headers.get("Origin")
        if not self.local():
            return self.send(403, "{}")
        if origin and origin not in (f"http://127.0.0.1:{self.server.server_port}", f"http://localhost:{self.server.server_port}"):
            return self.send(403, "{}")
        if self.path != "/goto":
            return self.send(404, "{}")
        try:
            req = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}")
        except ValueError:
            return self.send(400, "{}")
        pane, ssh = str(req.get("pane", "")), req.get("ssh")
        if not pane.startswith("%"):
            return self.send(400, "{}")
        if ssh:
            sock = next((s for h, s in connections() if h == ssh), None)
            r = remote_run(sock, ssh, ["--goto", pane, "--from", me()]) if sock else None
            ok = bool(r and r.returncode == 0)
        else:
            ok = goto(pane)
        if ok:
            front_terminal()
        self.send(200, json.dumps({"ok": ok}))


def ping(port):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/ping", timeout=1) as r:
            return r.read() == b"hivemux-office"
    except OSError:
        return False


def running_port():
    try:
        port = int(open(PORT_FILE).read())
    except (OSError, ValueError):
        return None
    return port if ping(port) else None


def serve():
    os.makedirs(OFFICE_DIR, exist_ok=True)
    srv = None
    for port in range(PORT, PORT + 20):
        try:
            srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
            break
        except OSError:
            if ping(port):          # another server of ours already runs / 이미 우리 서버가 있다
                return
    if not srv:
        sys.exit("hivemux-office: no free port")
    with open(PORT_FILE, "w") as f:
        f.write(str(srv.server_port))
    Handler.remotes = Remotes()
    Handler.remotes.start()

    def reaper():
        while time.time() - Handler.last < IDLE_EXIT:
            time.sleep(5)
        os._exit(0)
    threading.Thread(target=reaper, daemon=True).start()
    srv.serve_forever()


def start_server():
    port = running_port()
    if port:
        return port
    subprocess.Popen([sys.executable, os.path.realpath(__file__), "serve"], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(50):
        time.sleep(.1)
        port = running_port()
        if port:
            return port
    sys.exit("hivemux-office: the server did not start")


def app_state():
    """(app path, source hash, built and current?) of the window app. Its file name stays the same
    across builds, so macOS keeps its window place and settings.
    창 앱의 (경로, 소스 해시, 최신으로 빌드돼 있나). 파일 이름은 빌드해도 그대로라 macOS 가 창 위치와 설정을 기억한다."""
    with open(os.path.join(SHARE, "OfficeWindow.swift"), "rb") as f:
        tag = hashlib.sha1(f.read()).hexdigest()
    app = os.path.join(OFFICE_DIR, APP_NAME)
    try:
        ready = os.path.exists(app) and open(os.path.join(OFFICE_DIR, "app.sha1")).read() == tag
    except OSError:
        ready = False
    return app, tag, ready


def swiftc():
    return subprocess.run(["xcrun", "--find", "swiftc"], capture_output=True, text=True).stdout.strip()


def build(progress=None):
    """Build the window app from share/office/OfficeWindow.swift; progress(seconds) is called while it runs.
    Returns the app path, or None (no swiftc, or the build failed).
    share/office/OfficeWindow.swift 로 창 앱을 빌드한다. 도는 동안 progress(초)를 부른다. 앱 경로나 None 을 돌려준다."""
    app, tag, ready = app_state()
    if ready:
        return app
    sc = swiftc()
    if not sc:
        return None
    os.makedirs(OFFICE_DIR, exist_ok=True)
    tmp = f"{app}.{os.getpid()}.tmp"
    proc = subprocess.Popen([sc, "-O", "-o", tmp, os.path.join(SHARE, "OfficeWindow.swift")],
                            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    start = time.time()
    while proc.poll() is None:
        if progress:
            progress(time.time() - start)
        time.sleep(.1)
    if proc.returncode != 0:
        err = proc.stderr.read()
        with open(os.path.join(OFFICE_DIR, "build.log"), "w") as f:
            f.write(err)
        return None
    os.replace(tmp, app)
    with open(os.path.join(OFFICE_DIR, "app.sha1"), "w") as f:
        f.write(tag)
    return app


SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"


def build_screen(popup):
    """The first build, shown while it runs (in a tmux popup, or in the terminal that ran hivemux office)
    처음 빌드하는 동안 보여 주는 화면 (tmux 팝업, 또는 hivemux office 를 실행한 터미널)"""
    ko = lang() == "ko"
    t = lambda k, e: k if ko else e
    out = sys.stdout if popup else sys.stderr
    lines = [t("🐝 벌 사무실 창을 준비하고 있어요", "🐝 Getting the bee office window ready"), "",
             t("처음 한 번만 창을 만들어요. 30초쯤 걸려요.", "The window is built once, the first time. It takes about 30 seconds."),
             t("Mac 에 있는 Swift 컴파일러(Xcode Command Line Tools)로", "It is built with the Swift compiler of this Mac"),
             t("빌드합니다. 컴파일러가 없으면 브라우저로 열어요.", "(Xcode Command Line Tools); without it, it opens in the browser."), ""]
    if popup:
        out.write("\x1b[?25l\x1b[2J\x1b[H")
    out.write("".join(f"  {l}\n" for l in lines))
    tty = popup or out.isatty()

    def progress(sec):
        if tty:
            out.write(f"\r  \x1b[33m{SPIN[int(sec * 10) % len(SPIN)]}\x1b[0m {t('만드는 중', 'building')}… {int(sec)}{t('초', 's')}  ")
            out.flush()
    app = build(progress)
    if app:
        out.write(f"\r  \x1b[32m✓\x1b[0m {t('다 됐어요. 창을 엽니다', 'Done. Opening the window')}          \n")
    else:
        out.write(f"\r  \x1b[31m!\x1b[0m {t('창을 만들지 못해 브라우저로 엽니다', 'Could not build the window; opening the browser')}   \n")
    out.flush()
    if popup:
        time.sleep(1.2)
    return app


def open_window(popup=False):
    port = start_server()
    url = f"http://127.0.0.1:{port}/"
    try:                                        # already open: bring it to the front / 이미 열려 있으면 앞으로
        pid = int(open(WINDOW_PID).read())
        if APP_NAME in subprocess.run(["ps", "-o", "args=", "-p", str(pid)], capture_output=True, text=True).stdout:
            os.kill(pid, signal.SIGUSR1)
            return
    except (OSError, ValueError):
        pass
    app, _, ready = app_state()
    if not ready:
        app = build_screen(popup) if (popup or swiftc()) else None
    if not app:
        subprocess.run(["open", url])
        return
    subprocess.Popen([app, url, LOGO, WINDOW_PID], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def from_tmux(client):
    """Open it for a tmux screen: the first build shows its progress in a popup there. A screen attached
    from another Mac would get the window on this Mac's display, so that Mac opens it (open_there).
    tmux 화면에서 열기: 처음 빌드는 그 화면의 팝업에 진행을 보인다. 다른 Mac 에서 붙은 화면이면 창이 이 Mac
    화면에 뜨므로, 그 Mac 이 연다 (open_there)."""
    if client and f" {client} " in f" {tmux('show', '-gqv', '@hivemux-remote-clients')} ":
        open_there(client)
        return
    if app_state()[2] or not swiftc() or not client or running_window():
        open_window()
        return
    # pause the sidebar animation under the popup, like the other popups (bin/hivemux-settings)
    # 다른 팝업처럼 팝업 아래 사이드바 애니메이션을 멈춘다 (bin/hivemux-settings)
    pause = "/tmp/hivemux-pause-%d-%s" % (os.getuid(), tmux("display", "-p", "#{pid}").strip())
    open(pause, "w").close()
    try:
        subprocess.run([os.path.join(HERE, "hivemux-modal"), client, "-E", "-w", "66", "-h", "11", "-b", "rounded",
                        "-T", "#[fg=#e6e9ef,bold] hivemux office ", "-S", "fg=#f5a524", "-s", "bg=#1e2128",
                        f"{shlex.quote(os.path.realpath(__file__))} --popup"], stdin=subprocess.DEVNULL)
    finally:
        os.remove(pause)


def open_there(client):
    """Ask the Mac the screen is attached from to open the window: its hivemux-ports waits on the channel
    hivemux-paste-<Mac> over the ssh connection it keeps (bin/hivemux-ports) and takes the request from
    @hivemux-office-<Mac>. This Mac's sessions show there next door.
    화면이 붙어 온 Mac 에 창을 열어 달라고 한다: 그 Mac 의 hivemux-ports 가 유지하는 ssh 연결로 채널
    hivemux-paste-<Mac> 을 기다리다가 @hivemux-office-<Mac> 에서 요청을 가져간다. 이 Mac 의 세션은 거기 옆 사무실에 나온다."""
    ko = lang() == "ko"
    mac = next((l.split(" ", 1)[1] for l in tmux("show", "-gqv", "@hivemux-remote-from").splitlines()
                if l.split(" ", 1)[0] == client and " " in l), "")
    seen = tmux("show", "-gqv", f"@hivemux-seen-{mac}").strip() if mac else ""
    if seen.isdigit() and time.time() - int(seen) <= 20:
        opt, tag = f"@hivemux-office-{mac}", str(os.getpid())
        tmux("set", "-g", opt, tag)
        tmux("wait-for", "-S", f"hivemux-paste-{mac}")
        for _ in range(20):          # hivemux-ports clears it when it takes it / 가져가면 지운다
            time.sleep(0.25)
            if tmux("show", "-gqv", opt).strip() != tag:
                tmux("display", "-c", client, "-d", "3000",
                     f"🐝 {mac} 에서 벌 사무실을 엽니다" if ko else f"🐝 Opening the bee office on {mac}")
                return
        tmux("set", "-gu", opt)      # no answer: an older hivemux there / 대답이 없음: 거기 hivemux 가 예전 것
        msg = (f"{mac} 에서 벌 사무실을 열지 못했습니다. 그 Mac 의 hivemux 를 업데이트하세요" if ko
               else f"Could not open the bee office on {mac}. Update hivemux there")
    else:
        msg = ("다른 Mac 에서 붙은 화면입니다. 벌 사무실은 그 Mac 에서 여세요 (사이드바 🐝, prefix B)" if ko
               else "This screen is attached from another Mac. Open the bee office on that Mac (sidebar 🐝, prefix B)")
    tmux("display", "-c", client, "-d", "5000", msg)


def running_window():
    try:
        pid = int(open(WINDOW_PID).read())
    except (OSError, ValueError):
        return False
    return APP_NAME in subprocess.run(["ps", "-o", "args=", "-p", str(pid)], capture_output=True, text=True).stdout


def main(argv):
    if argv[:1] == ["--json"]:
        print(json.dumps(snapshot()))
    elif argv[:1] == ["--goto"] and len(argv) >= 2:
        frm = argv[3] if argv[2:3] == ["--from"] and len(argv) >= 4 else None
        sys.exit(0 if goto(argv[1], frm) else 1)
    elif argv[:1] == ["serve"]:
        serve()
    elif argv[:1] == ["--client"]:
        from_tmux(argv[1] if len(argv) > 1 else "")
    elif argv[:1] == ["--popup"]:
        open_window(popup=True)
    elif argv[:1] == ["--build"]:
        sys.exit(0 if build() else 1)
    elif not argv:
        open_window()
    else:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
