#!/usr/bin/env python3
"""The bee office: every Claude session as a bee in a small office, in a window of its own.
벌 사무실: Claude 세션마다 벌 한 마리가 작은 사무실에서 일하는 모습을 별도 창으로 보여 준다.

  hivemux-office                 open the window (starts the server below if needed)
                               창 열기 (필요하면 아래 서버를 띄운다)
  hivemux-office serve           the local web server the window shows (exits a while after the window closes)
                               창이 보여 주는 로컬 웹 서버 (창을 닫고 잠시 뒤 끝난다)
  hivemux-office --json          this computer's sessions as JSON (the server, and the other computer over ssh, read it)
                               이 컴퓨터의 세션을 JSON 으로 (서버와, ssh 로 상대 컴퓨터가 읽는다)
  hivemux-office --goto <pane> [--from <mac>]
                               show that pane on a screen of this computer (or on the screen attached from <mac>)
                               그 칸을 이 컴퓨터 화면에 (또는 <mac> 에서 붙은 화면에) 띄운다
  hivemux-office --client <client>
                               open it from tmux (sidebar button and menu, prefix B); a first build shows
                               its progress in a popup on <client>
                               tmux 에서 열기 (사이드바 버튼과 메뉴, prefix B). 처음 빌드는 <client> 의 팝업에 진행을 보인다
  hivemux-office --build       build the window app now, quietly (hivemux setup runs it in the background)
                               창 앱을 지금 조용히 빌드 (hivemux setup 이 뒤에서 실행)

The page (share/office/index.html) polls /state every second: this Mac's sessions, plus those of every
Mac this one is connected to with hivemux connect (asked over the ssh connection hivemux-ports keeps).
A bee works at its desk (run), runs to the question window in the boss room (wait), holds up a jar of
honey (done, not seen), takes it to the honeycomb once seen, then rests in the lounge (idle). A task
in plan mode (@claude_plan, from bin/hivemux-hook) plans in the meeting room; subagents
(@claude_agents) stand by the desk as small helper bees.
페이지(share/office/index.html)는 1초마다 /state 를 읽는다: 이 Mac 의 세션, 그리고 hivemux connect 로 붙어
있는 Mac 마다의 세션 (hivemux-ports 가 유지하는 ssh 연결로 묻는다). 벌은 자리에서 일하고 (run), 사장실
질문 창구로 뛰어가고 (wait), 꿀단지를 들고 있다가 (done, 안 봄) 보고 나면 벌집에 꿀을 채우고, 라운지에서
쉰다 (idle). 계획 모드 (@claude_plan, bin/hivemux-hook 이 표시)면 회의실에서 계획을 세우고,
서브에이전트 (@claude_agents)는 책상 옆의 작은 부사수 벌이 된다.

The window is a small native app (share/office/OfficeWindow.swift) built once with swiftc into
$XDG_DATA_HOME/hivemux/hive/; without swiftc the page opens in the browser.
창은 작은 네이티브 앱 (share/office/OfficeWindow.swift)으로, swiftc 로 한 번 빌드해
$XDG_DATA_HOME/hivemux/hive/ 에 둔다. swiftc 가 없으면 브라우저로 연다.
"""
import functools, glob, hashlib, http.server, json, os, re, shlex, shutil, signal, socket, stat, subprocess, sys, threading, time, urllib.request

TMUX = shutil.which("tmux") or "/opt/homebrew/bin/tmux"
HERE = os.path.dirname(os.path.realpath(__file__))
SHARE = os.path.join(os.path.dirname(HERE), "share", "office")
LOGO = os.path.join(os.path.dirname(HERE), "share", "logo", "hivemux-logo-512.png")
DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "hivemux")
OFFICE_DIR = os.path.join(DATA, "office")
PORT_FILE = os.path.join(OFFICE_DIR, "port")
WINDOW_PID = os.path.join(OFFICE_DIR, "window.pid")
APP_NAME = "hivemux office"   # the window app's file name, shown in the menu bar and the Dock / 창 앱 파일 이름. 메뉴 막대와 Dock 에 보인다
ORDER_FILE = os.path.join(DATA, "session-order")
PORT = int(os.environ.get("HIVEMUX_OFFICE_PORT") or 47380)   # fixed, so the page keeps its settings / 고정: 페이지 설정이 유지되게
IDLE_EXIT = 90               # seconds without a page asking before the server quits / 페이지가 묻지 않은 채 이만큼 지나면 서버 종료
US = "\x1f"
FIELDS = ["pane_id", "session_name", "window_index", "window_name", "pane_title", "@claude_state", "@claude_state_at",
          "@claude_session", "@claude_title", "@claude_name", "@claude_agents", "@claude_plan", "pane_current_command",
          "pane_index", "@claude_wait", "@claude_touched"]
SHELLS = {"zsh", "bash", "fish", "sh", "dash", "tcsh", "ksh", "login"}
SSH = shlex.split(os.environ.get("HIVEMUX_SSH") or "ssh")
PATH = "PATH=/opt/homebrew/bin:/usr/local/bin:$PATH"
# Runs on the other Mac: its hivemux-office, wherever it got installed / 상대 Mac 에서 실행: 설치된 곳의 hivemux-office
# (HIVEMUX_OFFICE: another path there, used for testing / 거기 다른 경로, 시험용)
REMOTE = ('for p in ${HIVEMUX_OFFICE:-} /opt/homebrew/bin/hivemux-office /usr/local/bin/hivemux-office "$HOME/.local/share/hivemux/src/bin/hivemux-office"; '
          'do [ -x "$p" ] && exec "$p" %s; done; echo \'{"missing": true}\'')


def tmux(*a):
    out = subprocess.run([TMUX, *a], capture_output=True, text=True).stdout
    # some tmux versions (3.4) print a control character in a format as an escape ("\037"): put it back
    # 어떤 tmux (3.4) 는 형식 안의 제어 문자를 이스케이프("\037")로 내보낸다: 되돌린다
    return out.replace("\\037", "\x1f") if any("\x1f" in x for x in a) else out


def lang():
    v = os.environ.get("HIVEMUX_LANG") or tmux("show", "-gqv", "@hivemux-lang").strip()
    return "ko" if (v or os.environ.get("LANG", "")).startswith("ko") else "en"


@functools.lru_cache(maxsize=1)
def me():
    """This Mac's name, as hivemux-ports uses it / hivemux-ports 가 쓰는 이 Mac 이름"""
    r = subprocess.run([os.path.join(HERE, "hivemux-ports"), "--me"], capture_output=True, text=True)
    return r.stdout.strip() or socket.gethostname().split(".")[0]


def computer_name():
    """The Mac's name (scutil); empty on Linux, whose callers fall back to the host name
    Mac 의 이름 (scutil). Linux 에서는 비어 있고, 부르는 쪽이 호스트 이름을 쓴다"""
    return subprocess.run(["scutil", "--get", "ComputerName"], capture_output=True, text=True).stdout.strip() \
        if shutil.which("scutil") else ""


def display_name():
    """This Mac's name as people see it: the one set in Settings (@hivemux-mac-name), else the Mac's own
    이 Mac 의 보이는 이름: 설정에서 정한 이름 (@hivemux-mac-name), 없으면 Mac 원래 이름"""
    v = tmux("show", "-gqv", "@hivemux-mac-name").strip()
    if not v:
        try:
            v = open(os.path.join(DATA, "mac-name")).read().strip()
        except OSError:
            v = ""
    return v or computer_name() or me()


def task_name(p):
    """Like the sidebar card (bin/hivemux-sidebar-view task_name) / 사이드바 카드와 같게"""
    if p["@claude_name"]:
        return p["@claude_name"]
    t = p["pane_title"].lstrip("✳⠂⠐·*✶✻✽✢ ").strip()
    host = socket.gethostname()
    if t and "@" not in t.split(":")[0] and t not in (host, host.split(".")[0]) and t.lower() not in ("claude code", "claude"):
        return t
    if p["@claude_title"]:
        return p["@claude_title"]
    w = p["window_name"]
    return w if w not in ("claude", p["session_name"]) else ""


# the roster and the honey ledger (bin/hivemux-bees) / 명부와 꿀 장부 (bin/hivemux-bees)
import importlib.machinery, importlib.util
_spec = importlib.util.spec_from_loader("hivemux_bees", importlib.machinery.SourceFileLoader("hivemux_bees", os.path.join(HERE, "hivemux-bees")))
bees = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(bees)
_ranks = {"size": -1, "day": "", "value": None}


def ranks():
    """The honey ranking, counted again only when the ledger grew or the day changed / 꿀 순위. 장부가 늘거나 날이 바뀔 때만 다시 센다"""
    try:
        size = os.path.getsize(bees.LEDGER)
    except OSError:
        size = 0
    day = time.strftime("%Y-%m-%d")
    if size != _ranks["size"] or day != _ranks["day"]:
        _ranks.update(size=size, day=day, value=bees.ranks())
    return _ranks["value"]


_gone = {}   # bee -> when its Claude's pane was first found missing / 벌 -> 그 Claude 칸이 처음 안 보인 때
GONE_AFTER = 600


def roster(ids, kept=None, projects=None):
    """Hire the bees seen at work for the first time (or back after leaving); let go a bee whose Claude was
    closed (no pane keeps its session, or its project is gone) for ten minutes; the roster for the page.
    kept: bees with a pane that still has their session (running, or stopped by clocking out, an update or a
    reboot to come back); projects: the open projects (none yet: tmux is still starting, let no one go)
    처음 일하는 (또는 퇴사 뒤 돌아온) 벌을 입사시키고, Claude 가 닫힌 (세션을 가진 칸이 없거나 프로젝트가 없어진)
    채 10분이 지난 벌은 퇴사시킨다. 페이지에 줄 명부. kept: 세션을 가진 칸이 있는 벌 (실행 중, 또는 퇴근·업데이트·
    재부팅으로 멈춰 돌아올 벌), projects: 열린 프로젝트 (없으면 tmux 가 아직 뜨는 중이라 아무도 내보내지 않는다)"""
    now = int(time.time())
    with bees.Roster() as r:
        for i in ids:      # does nothing for one already on the payroll / 이미 일하는 벌에는 아무것도 안 한다
            r.seen(i, now)
        if kept is not None and projects:
            for i, b in r.bees.items():
                # a project closed or renamed some other way (not through the sidebar) counts too
                # 사이드바가 아닌 다른 길로 닫거나 이름을 바꾼 프로젝트도 마찬가지
                if b.get("left") or i in kept:
                    _gone.pop(i, None); continue
                if now - _gone.setdefault(i, now) >= GONE_AFTER:
                    r.quit(i, now); _gone.pop(i, None)
        cut = time.time() - 30 * 86400   # who left over a month ago is out of sight / 한 달 넘게 전에 떠난 벌은 안 보인다
        return {i: dict({k: b.get(k) for k in ("name", "project", "hired", "left", "rehires", "house")},
                        since=(b.get("history") or [[b.get("hired")]])[-1][0])   # when it last came in / 마지막으로 들어온 때
                for i, b in r.bees.items() if not b.get("left") or b["left"] > cut}


def snapshot():
    """This Mac's Claude sessions in sidebar order (its ⌥ numbers) / 이 Mac 의 Claude 세션, 사이드바 순서 (⌥ 번호)"""
    fmt = US.join("#{%s}" % f for f in FIELDS)
    panes = [dict(zip(FIELDS, l.split(US))) for l in tmux("list-panes", "-a", "-F", fmt).splitlines()]
    items = [p for p in panes if len(p) == len(FIELDS) and p["@claude_session"] and p["@claude_state"]
             and p["pane_current_command"].lstrip("-") not in SHELLS]
    rank = {}
    try:
        with open(ORDER_FILE) as f:
            for l in f:
                rank.setdefault(l.rstrip("\n"), len(rank))
    except OSError:
        pass
    items = [p for _, p in sorted(enumerate(items), key=lambda e: (rank.get(e[1]["session_name"], len(rank)), e[0]))]
    home = bees.home_panes()          # clocked out, they keep their names / 퇴근해도 이름은 그대로
    ids = bees.bee_ids([(p["pane_id"], p["session_name"], p["window_index"], p["pane_index"], p["window_name"], p["@claude_name"])
                        for p in panes if len(p) == len(FIELDS) and (p["@claude_session"] or p["pane_id"] in home)])
    for p in items:
        p["bee"] = ids.get(p["pane_id"], p["session_name"] + "/claude")
    honey = tmux("show", "-gqv", "@hivemux-honey").split()
    today = time.strftime("%Y-%m-%d")
    out = {
        "host": display_name(), "lang": lang(), "now": int(time.time()),
        "honey": int(honey[1]) if len(honey) == 2 and honey[0] == today and honey[1].isdigit() else 0,
        "sessions": [{
            "pane": p["pane_id"], "idx": i, "project": p["session_name"], "name": task_name(p),
            "state": p["@claude_state"], "at": int(p["@claude_state_at"]) if p["@claude_state_at"].isdigit() else 0,
            "agents": int(p["@claude_agents"]) if p["@claude_agents"].isdigit() else 0,
            "plan": bool(p["@claude_plan"]), "bee": p["bee"],
            "files": len([f for f in p["@claude_touched"].split(RS) if f]),
            **(waiting(p) if p["@claude_state"] == "wait" else {}),
        } for i, p in enumerate(items, 1)],
        # clocked out (or rebooted while clocked out), the bees sent home keep their place
        # 퇴근 중 (또는 퇴근 중 재부팅): 집에 보낸 벌은 자리를 지킨다
        "bees": roster({p["bee"] for p in items}, set(ids.values()) | set(offwork()),
                       {p["session_name"] for p in panes if len(p) == len(FIELDS)}), "ranks": ranks(),
    }
    # clocked out: overtime is only a Claude still working or waiting for you; the rest are going home even
    # while their Claude is being stopped (one by one, a few seconds each), so they leave the session list
    # 퇴근: 야근은 아직 일하거나 나를 기다리는 Claude 뿐. 나머지는 Claude 를 끄는 중이어도 (하나씩, 몇 초씩) 집에
    # 가는 중이라 세션 목록에서 뺀다
    # (also one Claude or one project clocked out by itself, while the rest work on)
    # (혼자 퇴근한 Claude 하나나 프로젝트 하나도. 나머지는 계속 일한다)
    out["shift"] = sh = shift({p["bee"] for p in items if p["@claude_state"] in ("run", "wait")})
    home = set(sh["home"])
    out["sessions"] = [x for x in out["sessions"] if x["bee"] not in home]
    return out


def shift_file():
    try:
        with open(os.path.join(DATA, "shift")) as f:
            return f.read().split()
    except OSError:
        return []


def offwork():
    """the bees sent home: everyone while clocked out, or each one clocked out by itself
    집에 보낸 벌: 퇴근 중이면 모두, 아니면 혼자 퇴근한 벌"""
    try:
        with open(os.path.join(DATA, "offwork.tsv"), errors="replace") as f:
            return [b for b in (line.rstrip("\n").split("\t")[-1] for line in f) if b and b != "-"]
    except OSError:
        return []


def shift(busy):
    """Clocked in or out (bin/hivemux-shift), who is home and who is still on overtime (everyone clocked out,
    or one clocked out by itself) / 출근 또는 퇴근 (bin/hivemux-shift), 집에 간 벌과 아직 야근 중인 벌 (모두 퇴근,
    또는 혼자 퇴근)"""
    st = shift_file()
    home, overtime = [], []
    for bee in offwork():
        (overtime if bee in busy else home).append(bee)
    return {"state": "off" if st[:1] == ["off"] else "on", "since": int(st[1]) if len(st) > 1 and st[1].isdigit() else 0,
            "home": home, "overtime": overtime}


# ── answering from the office / 사무실에서 답하기 ──────────────────────────────

RS = "\t"     # (bin/hivemux-hook) not \x1e: splitlines() breaks there / \x1e 은 안 된다: splitlines() 가 나눈다
OPTION_RE = re.compile(r"^\s*(❯\s*)?(\d{1,2})\.\s+(?:\[([ ✔✓x×])\]\s*)?(.*\S)\s*$")
RULE_RE = re.compile(r"^\s*[─━╌▔]{8,}")
TEXT_RE = re.compile(r"(?i)^(type something|tell claude|no, and tell claude)")
FOOT_RE = re.compile(r"(?i)esc to cancel|enter to select|ctrl\+g to edit")   # the last lines of a dialog / 창의 맨 아랫줄


def waiting(p):
    """Why a waiting pane waits (@claude_wait from bin/hivemux-hook) and the choices on its screen
    기다리는 칸의 이유 (bin/hivemux-hook 의 @claude_wait) 와 화면의 선택지"""
    kind, tool, text = (p["@claude_wait"].split(RS) + ["", "", ""])[:3]
    out = {"why": {"kind": kind, "tool": tool, "text": text}} if kind else {}
    m = menu(p["pane_id"])
    if m:
        out["menu"] = m
    return out


def menu(pane):
    """The choices Claude shows in a pane (an approval, a plan to approve, a question), read off its screen:
    {"title", "options": [{"n", "label", "desc", "checked" (a multiple choice), "text" (takes typed words)}],
    "tabs" (several questions: move on with →)}; None when no dialog is open
    칸에 Claude 가 띄운 선택지 (승인, 계획 승인, 질문) 를 화면에서 읽는다. 창이 없으면 None"""
    lines = tmux("capture-pane", "-p", "-t", pane).splitlines()
    while lines and not lines[-1].strip():
        lines.pop()
    lines = lines[-60:]
    cur = next((i for i in range(len(lines) - 1, -1, -1) if re.match(r"^\s*❯\s*\d{1,2}\.\s", lines[i])), None)
    # a dialog's footer under it, or the options at the very bottom (the review of several answers has no footer)
    # 아래에 창의 맨 아랫줄, 또는 선택지가 맨 아래 (여러 답을 확인하는 화면에는 맨 아랫줄이 없다)
    if cur is None or not (any(FOOT_RE.search(l) for l in lines[-8:]) or cur >= len(lines) - 6):
        return None
    top = cur                     # the options run between rules around the cursor / 커서를 둘러싼 선 사이가 선택지
    while top > 0 and not RULE_RE.match(lines[top - 1]):
        top -= 1
    bottom = cur
    while bottom + 1 < len(lines) and not RULE_RE.match(lines[bottom + 1]) and not FOOT_RE.search(lines[bottom + 1]):
        bottom += 1
    opts, title = [], []
    for l in lines[top:bottom + 1]:
        m = OPTION_RE.match(l)
        if m:
            label = m.group(4)
            opts.append({"n": int(m.group(2)), "label": label, "desc": "", "checked": None if m.group(3) is None else m.group(3) != " ",
                         "text": bool(TEXT_RE.match(label))})
        elif opts and l.strip():
            opts[-1]["desc"] = (opts[-1]["desc"] + " " + l.strip()).strip()
        elif not opts and l.strip() and not l.strip().startswith(("←", "☐", "☒")):
            title.append(l.strip())
    if not opts or [o["n"] for o in opts] != list(range(1, len(opts) + 1)):
        return None
    tabs = any(l.strip().startswith("←") and l.rstrip().endswith("→") for l in lines[max(0, top - 4):top + 1])
    return {"title": "\n".join(title)[-400:], "options": opts, "tabs": tabs}


def answer(pane, req):
    """Press an option (its number; typed words after it for one that takes them) or → for the next question,
    only if the same dialog is still on the screen. True when sent
    선택지를 누른다 (번호. 글을 받는 선택지면 이어서 그 글) 또는 다음 질문으로 →. 같은 창이 아직 화면에 있을 때만"""
    m = menu(pane)
    if not m:
        return False
    if req.get("key") == "next":
        tmux("send-keys", "-t", pane, "Right")
        return True
    n, label = req.get("n"), str(req.get("label") or "")
    o = next((o for o in m["options"] if o["n"] == n), None)
    if not o or o["label"] != label:
        return False
    tmux("send-keys", "-t", pane, str(n))
    words = str(req.get("text") or "").replace("\n", " ").strip()[:2000]
    if o["text"] and words:
        time.sleep(.25)
        tmux("send-keys", "-t", pane, "-l", words)
        time.sleep(.1)
        tmux("send-keys", "-t", pane, "Enter")
    return True


def goto(pane, frm=None):
    """Show pane on a screen: the one attached from Mac <frm>, else the most recently used one of this Mac
    칸을 화면에 띄운다: <frm> Mac 에서 붙은 화면, 아니면 이 Mac 에서 가장 최근에 쓴 화면"""
    sess = tmux("display", "-p", "-t", pane, "#{session_name}").strip()
    win = tmux("display", "-p", "-t", pane, "#{window_id}").strip()
    if not sess:
        return False
    remote = set(tmux("show", "-gqv", "@hivemux-remote-clients").split())
    # screens attached now, most recently used first: @hivemux-remote-from keeps screens long gone (a detach
    # it missed), and switching one of those does nothing
    # 지금 붙어 있는 화면, 최근에 쓴 것부터: @hivemux-remote-from 에는 오래전에 떨어진 화면도 남는다 (분리를
    # 놓침). 그런 화면을 바꾸면 아무 일도 안 일어난다
    rows = [l.split(" ") for l in tmux("list-clients", "-F", "#{client_activity} #{client_name}").splitlines()]
    live = [c for _, c in sorted((r for r in rows if len(r) == 2), reverse=True)]
    if frm:
        mine = {l.split(" ", 1)[0] for l in tmux("show", "-gqv", "@hivemux-remote-from").splitlines()
                if l.split(" ", 1)[1:] == [frm]}
        clients = [c for c in live if c in mine]
    else:
        clients = [c for c in live if c not in remote]
    if not clients:
        return False
    tmux("switch-client", "-c", clients[0], "-t", f"={sess}")
    tmux("select-window", "-t", win)
    tmux("select-pane", "-t", pane)
    return True


def front_terminal():
    if sys.platform == "darwin":
        subprocess.run(["open", "-a", "Ghostty"], capture_output=True)
    elif shutil.which("wmctrl"):         # Linux: only with a window tool / Linux: 창 도구가 있을 때만
        subprocess.run(["wmctrl", "-x", "-a", "ghostty"], capture_output=True)


# ── the other Macs / 상대 Mac ──────────────────────────────────────────

def connections():
    """(host, ssh control socket) of every running hivemux-ports (one per hivemux connect)
    돌고 있는 hivemux-ports 마다 (호스트, ssh 제어 소켓) (hivemux connect 하나에 하나)"""
    out = []
    for sock in glob.glob(f"/tmp/hivemux-ports-{os.getuid()}-*"):
        try:    # ours, and a socket: /tmp is shared / 우리 것이고 소켓이어야: /tmp 는 모두가 쓴다
            st = os.lstat(sock)
        except OSError:
            continue
        if st.st_uid != os.getuid() or not stat.S_ISSOCK(st.st_mode):
            continue
        pid = sock.rsplit("-", 1)[1]
        args = subprocess.run(["ps", "-o", "args=", "-p", pid], capture_output=True, text=True).stdout.split()
        i = next((i for i, a in enumerate(args) if a.endswith("hivemux-ports")), None)
        if i is not None and i + 1 < len(args) and not args[i + 1].startswith("-"):
            out.append((args[i + 1], sock))
    return out


def remote_run(sock, host, args, timeout=8):
    cmd = f"{PATH}; " + REMOTE % " ".join(shlex.quote(a) for a in args)
    try:
        return subprocess.run(SSH + ["-S", sock, "-o", "ControlMaster=no", "-o", "BatchMode=yes", host, cmd],
                              capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return None


class Remotes(threading.Thread):
    """Asks each connected Mac for its sessions every 1.5 s / 붙어 있는 Mac 마다 1.5초에 한 번 세션을 묻는다"""

    def __init__(self):
        super().__init__(daemon=True)
        self.offices, self.lock, self.fresh = {}, threading.Lock(), {}

    def run(self):
        while True:
            try:
                self.poll()
            except Exception as e:      # keep asking / 계속 묻는다
                print(f"remotes: {e!r}", file=sys.stderr)
            time.sleep(1.5)

    def poll(self):
        got = {}
        for host, sock in connections():
            r = remote_run(sock, host, ["--json"])
            try:
                o = json.loads(r.stdout) if r and r.returncode == 0 else None
            except ValueError:
                o = None
            if isinstance(o, dict):
                self.fresh[host] = time.time()
            else:
                # keep the last answer through a hiccup, not for good / 잠깐 끊겨도 마지막 답을 두되, 계속은 아니다
                with self.lock:
                    o = self.offices.get(host) if time.time() - self.fresh.get(host, 0) < 30 else None
            if o is not None:
                o["ssh"] = host
                got[host] = o
        with self.lock:
            self.offices = got

    def list(self):
        with self.lock:
            return list(self.offices.values())


# ── server / 서버 ────────────────────────────────────────────────────

class Handler(http.server.BaseHTTPRequestHandler):
    remotes = None
    last = time.time()

    def log_message(self, *a):
        pass

    def send(self, code, body, ctype="application/json"):
        b = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(b)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(b)

    def local(self):
        """Asked for by name 127.0.0.1 or localhost, so another site cannot reach it by DNS rebinding
        127.0.0.1 이나 localhost 라는 이름으로 왔다: 다른 사이트가 DNS 리바인딩으로 닿지 못하게"""
        port = self.server.server_port
        return self.headers.get("Host") in (f"127.0.0.1:{port}", f"localhost:{port}")

    def do_GET(self):
        if not self.local():
            return self.send(403, "{}")
        path = self.path.split("?", 1)[0]
        if path == "/ping":       # with where its files are: a server left from before an upgrade has none
            return self.send(200, f"hivemux-office {SHARE}", "text/plain")   # 파일 위치와 함께: 업그레이드 전 서버는 파일이 없다
        if path == "/state":
            Handler.last = time.time()
            local = snapshot()
            return self.send(200, json.dumps({"lang": local["lang"], "offices": [local] + Handler.remotes.list()}))
        # one page: the office at an angle, or seen from above (/2d opens it that way; the page switches)
        # 한 페이지: 비스듬히 본 사무실, 또는 위에서 본 모습 (/2d 는 그렇게 연다. 페이지에서 서로 바꾼다)
        page = {"/": "index.html", "/index.html": "index.html", "/2d": "index.html"}.get(path)
        if page:
            with open(os.path.join(SHARE, page), "rb") as f:
                return self.send(200, f.read(), "text/html; charset=utf-8")
        if path == "/logo.svg":
            with open(os.path.join(os.path.dirname(LOGO), "hivemux-logo.svg"), "rb") as f:
                return self.send(200, f.read(), "image/svg+xml")
        self.send(404, "{}")

    def do_POST(self):
        # only the page itself may ask (a browser tab of another site would send its own Origin)
        # 이 페이지만 요청할 수 있다 (다른 사이트의 브라우저 탭이면 다른 Origin 을 보낸다)
        origin = self.headers.get("Origin")
        if not self.local():
            return self.send(403, "{}")
        if origin and origin not in (f"http://127.0.0.1:{self.server.server_port}", f"http://localhost:{self.server.server_port}"):
            return self.send(403, "{}")
        if self.path not in ("/goto", "/shift", "/answer"):
            return self.send(404, "{}")
        try:
            n = int(self.headers.get("Content-Length") or 0)
            req = json.loads(self.rfile.read(n) or b"{}") if 0 <= n <= 65536 else None
        except ValueError:
            req = None
        if not isinstance(req, dict):
            return self.send(400, "{}")
        if self.path == "/shift":   # clock out or in (bin/hivemux-shift), here or on a connected Mac / 퇴근 또는 출근, 여기 또는 붙어 있는 Mac
            what, ssh = req.get("to"), req.get("ssh")
            if what not in ("on", "off"):
                return self.send(400, "{}")
            if ssh:
                sock = next((s for h, s in connections() if h == ssh), None)
                r = remote_run(sock, ssh, ["--shift", what], timeout=20) if sock else None
                if not r or r.returncode != 0:
                    return self.send(200, json.dumps({"ok": False, "say": ""}))
            else:
                r = subprocess.run([os.path.join(HERE, "hivemux-shift"), what], capture_output=True, text=True, stdin=subprocess.DEVNULL)
            return self.send(200, json.dumps({"ok": r.returncode == 0, "say": r.stdout.strip()}))
        pane, ssh = str(req.get("pane", "")), req.get("ssh")
        if not pane.startswith("%"):
            return self.send(400, "{}")
        if self.path == "/answer":  # an option chosen in the office / 사무실에서 고른 선택지
            ans = {k: req.get(k) for k in ("n", "label", "text", "key")}
            if ssh:
                sock = next((s for h, s in connections() if h == ssh), None)
                r = remote_run(sock, ssh, ["--answer", pane, json.dumps(ans)]) if sock else None
                ok = bool(r and r.returncode == 0)
            else:
                ok = answer(pane, ans)
            return self.send(200, json.dumps({"ok": ok}))
        if ssh:
            sock = next((s for h, s in connections() if h == ssh), None)
            r = remote_run(sock, ssh, ["--goto", pane, "--from", me()]) if sock else None
            ok = bool(r and r.returncode == 0)
        else:
            ok = goto(pane)
        if ok:
            front_terminal()
        self.send(200, json.dumps({"ok": ok}))


def ping(port):
    """"ours" when our server answers on port, "old" when one of another install (one left running from
    before an upgrade: brew removed its files, so its page no longer loads), else None
    port 에서 우리 서버가 답하면 "ours", 다른 설치본 서버면 (업그레이드 전부터 돌던 것: brew 가 파일을 지워
    페이지가 안 열린다) "old", 아니면 None"""
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/ping", timeout=1) as r:
            body = r.read().decode(errors="replace")
    except OSError:
        return None
    if not body.startswith("hivemux-office"):
        return None
    return "ours" if body == f"hivemux-office {SHARE}" else "old"


def stop_old(port):
    """Stop the server of another install listening on port / port 에서 듣는 다른 설치본 서버를 끈다"""
    if shutil.which("lsof"):
        pids = subprocess.run(["lsof", "-t", "-a", f"-iTCP:{port}", "-sTCP:LISTEN"], capture_output=True, text=True).stdout.split()
    else:                                # Linux without lsof: users:(("python3",pid=918,fd=3)) / lsof 없는 Linux
        pids = re.findall(r"pid=(\d+)", subprocess.run(["ss", "-ltnpH", f"sport = :{port}"], capture_output=True, text=True).stdout)
    for pid in pids:
        try:
            os.kill(int(pid), signal.SIGTERM)
        except (OSError, ValueError):
            pass
    for _ in range(20):
        if not ping(port):
            return
        time.sleep(.1)


def running_port():
    try:
        port = int(open(PORT_FILE).read())
    except (OSError, ValueError):
        return None
    state = ping(port)
    if state == "old":
        stop_old(port)
    return port if state == "ours" else None


def serve():
    os.makedirs(OFFICE_DIR, exist_ok=True)
    srv = None
    for port in range(PORT, PORT + 20):
        try:
            srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
            break
        except OSError:
            state = ping(port)
            if state == "ours":     # another server of ours already runs / 이미 우리 서버가 있다
                return
            if state == "old":      # left from before an upgrade: take its place / 업그레이드 전 서버: 자리를 넘겨받는다
                stop_old(port)
                try:
                    srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
                    break
                except OSError:
                    pass
    if not srv:
        sys.exit("hivemux-office: no free port")
    with open(PORT_FILE, "w") as f:
        f.write(str(srv.server_port))
    Handler.remotes = Remotes()
    Handler.remotes.start()

    # quits once no page has asked for a while, but not while the office window is open: a window that is
    # minimized or hidden stops asking (macOS pauses its page) and expects the server when it comes back
    # 한동안 묻는 페이지가 없으면 끝난다. 단 사무실 창이 열려 있으면 그대로: 내리거나 가려진 창은 묻지 않다가
    # (macOS 가 페이지를 멈춘다) 돌아오면 서버가 있기를 기대한다
    def reaper():
        while time.time() - Handler.last < IDLE_EXIT or running_window():
            time.sleep(5)
        os._exit(0)
    threading.Thread(target=reaper, daemon=True).start()
    srv.serve_forever()


def start_server():
    port = running_port()
    if port:
        return port
    subprocess.Popen([sys.executable, os.path.realpath(__file__), "serve"], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(50):
        time.sleep(.1)
        port = running_port()
        if port:
            return port
    sys.exit("hivemux-office: the server did not start")


def app_state():
    """(app path, source hash, built and current?) of the window app. Its file name stays the same
    across builds, so macOS keeps its window place and settings.
    창 앱의 (경로, 소스 해시, 최신으로 빌드돼 있나). 파일 이름은 빌드해도 그대로라 macOS 가 창 위치와 설정을 기억한다."""
    with open(os.path.join(SHARE, "OfficeWindow.swift"), "rb") as f:
        tag = hashlib.sha1(f.read()).hexdigest()
    app = os.path.join(OFFICE_DIR, APP_NAME)
    try:
        ready = os.path.exists(app) and open(os.path.join(OFFICE_DIR, "app.sha1")).read() == tag
    except OSError:
        ready = False
    return app, tag, ready


def swiftc():
    """The Swift compiler that builds the window app; none on Linux (the page opens in a browser there)
    창 앱을 빌드하는 Swift 컴파일러. Linux 에는 없다 (거기서는 페이지를 브라우저로 연다)"""
    if sys.platform != "darwin" or not shutil.which("xcrun"):
        return ""
    return subprocess.run(["xcrun", "--find", "swiftc"], capture_output=True, text=True).stdout.strip()


def build(progress=None):
    """Build the window app from share/office/OfficeWindow.swift; progress(seconds) is called while it runs.
    Returns the app path, or None (no swiftc, or the build failed).
    share/office/OfficeWindow.swift 로 창 앱을 빌드한다. 도는 동안 progress(초)를 부른다. 앱 경로나 None 을 돌려준다."""
    app, tag, ready = app_state()
    if ready:
        return app
    sc = swiftc()
    if not sc:
        return None
    os.makedirs(OFFICE_DIR, exist_ok=True)
    tmp = f"{app}.{os.getpid()}.tmp"
    # errors go straight to the log: a pipe nobody reads until the end could fill up and stall swiftc
    # 오류는 바로 로그로: 끝날 때까지 아무도 읽지 않는 파이프는 차서 swiftc 를 멈출 수 있다
    with open(os.path.join(OFFICE_DIR, "build.log"), "w") as log:
        proc = subprocess.Popen([sc, "-O", "-o", tmp, os.path.join(SHARE, "OfficeWindow.swift")],
                                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=log)
        start = time.time()
        while proc.poll() is None:
            if progress:
                progress(time.time() - start)
            time.sleep(.1)
    if proc.returncode != 0:
        try:
            os.remove(tmp)
        except OSError:
            pass
        return None
    os.replace(tmp, app)
    with open(os.path.join(OFFICE_DIR, "app.sha1"), "w") as f:
        f.write(tag)
    return app


SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"


def build_screen(popup):
    """The first build, shown while it runs (in a tmux popup, or in the terminal that ran hivemux office)
    처음 빌드하는 동안 보여 주는 화면 (tmux 팝업, 또는 hivemux office 를 실행한 터미널)"""
    ko = lang() == "ko"
    t = lambda k, e: k if ko else e
    out = sys.stdout if popup else sys.stderr
    lines = [t("🐝 벌 사무실 창을 준비하고 있어요", "🐝 Getting the bee office window ready"), "",
             t("처음 한 번만 창을 만들어요. 30초쯤 걸려요.", "The window is built once, the first time. It takes about 30 seconds."),
             t("Mac 에 있는 Swift 컴파일러(Xcode Command Line Tools)로", "It is built with the Swift compiler of this Mac"),
             t("빌드합니다. 컴파일러가 없으면 웹 앱으로 열어요.", "(Xcode Command Line Tools); without it, it opens as a web app."), ""]
    if popup:
        out.write("\x1b[?25l\x1b[2J\x1b[H")
    out.write("".join(f"  {l}\n" for l in lines))
    tty = popup or out.isatty()

    def progress(sec):
        if tty:
            out.write(f"\r  \x1b[33m{SPIN[int(sec * 10) % len(SPIN)]}\x1b[0m {t('만드는 중', 'building')}… {int(sec)}{t('초', 's')}  ")
            out.flush()
    app = build(progress)
    if app:
        out.write(f"\r  \x1b[32m✓\x1b[0m {t('다 됐어요. 창을 엽니다', 'Done. Opening the window')}          \n")
    else:
        out.write(f"\r  \x1b[31m!\x1b[0m {t('창을 만들지 못해 브라우저로 엽니다', 'Could not build the window; opening the browser')}   \n")
        try:
            why = open(os.path.join(OFFICE_DIR, "build.log")).read().strip().splitlines()[0][:120]
        except (OSError, IndexError):
            why = ""
        if why:
            out.write(f"    {why}\n")
            if "standard library" in why or "SDK" in why:
                out.write("    " + t("Xcode Command Line Tools 가 망가진 것 같아요. 다시 설치하세요:",
                                     "The Xcode Command Line Tools look broken. Reinstall them:") + "\n"
                          "      sudo rm -rf /Library/Developer/CommandLineTools && xcode-select --install\n")
    out.flush()
    if popup:
        time.sleep(1.2)
    return app


def open_window(popup=False):
    port = start_server()
    url = f"http://127.0.0.1:{port}/"
    try:                                        # already open: bring it to the front / 이미 열려 있으면 앞으로
        pid = int(open(WINDOW_PID).read())
        if APP_NAME in subprocess.run(["ps", "-o", "args=", "-p", str(pid)], capture_output=True, text=True).stdout:
            os.kill(pid, signal.SIGUSR1)
            return
    except (OSError, ValueError):
        pass
    app, _, ready = app_state()
    if not ready:
        app = build_screen(popup) if (popup or swiftc()) else None
    if not app:
        app_browser(url) or subprocess.run([os.path.join(HERE, "hivemux-os"), "open", url])
        return
    # the last two: how the window starts a server again if this one is gone / 마지막 둘: 서버가 없어졌을 때 창이 다시 띄우는 법
    subprocess.Popen([app, url, LOGO, WINDOW_PID, sys.executable, os.path.realpath(__file__)], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# Chromium browsers that open a page as an app: its own window with no tabs or address bar
# 페이지를 앱처럼 여는 Chromium 브라우저: 탭도 주소 창도 없는 단독 창
APP_BROWSERS = ("Google Chrome", "Microsoft Edge", "Brave Browser", "Naver Whale", "Vivaldi", "Chromium")
# the same on Linux, by command / Linux 에서는 명령 이름으로
APP_BROWSER_CMDS = ("google-chrome", "google-chrome-stable", "microsoft-edge", "brave-browser", "naver-whale",
                    "vivaldi", "chromium", "chromium-browser")


def app_browser(url):
    """No window app (no swiftc to build it): open the page as a web app in a Chromium browser if there is one
    창 앱이 없을 때 (빌드할 swiftc 가 없음): Chromium 브라우저가 있으면 페이지를 웹 앱으로 연다"""
    if sys.platform != "darwin":
        for cmd in APP_BROWSER_CMDS:
            if shutil.which(cmd):
                subprocess.Popen([cmd, f"--app={url}", "--window-size=1100,760"], start_new_session=True,
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return True
        return False
    for name in APP_BROWSERS:
        if any(os.path.isdir(os.path.join(d, name + ".app")) for d in ("/Applications", os.path.expanduser("~/Applications"))):
            r = subprocess.run(["open", "-na", name, "--args", f"--app={url}", "--window-size=1100,760"], capture_output=True)
            if r.returncode == 0:
                return True
    return False


def from_tmux(client):
    """Open it for a tmux screen: the first build shows its progress in a popup there. A screen attached
    from another Mac would get the window on this Mac's display, so that Mac opens it (open_there).
    tmux 화면에서 열기: 처음 빌드는 그 화면의 팝업에 진행을 보인다. 다른 Mac 에서 붙은 화면이면 창이 이 Mac
    화면에 뜨므로, 그 Mac 이 연다 (open_there)."""
    if client and f" {client} " in f" {tmux('show', '-gqv', '@hivemux-remote-clients')} ":
        open_there(client)
        return
    if sys.platform != "darwin" and not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        # a Linux server with no desktop: nowhere to open a window / 데스크톱 없는 Linux 서버: 창을 띄울 곳이 없다
        port = start_server()
        if client:
            tmux("display", "-c", client, "-d", "6000",
                 f"🐝 이 컴퓨터에는 화면이 없습니다. hivemux connect 로 붙으면 그쪽에서 열립니다 (http://127.0.0.1:{port}/)"
                 if lang() == "ko" else
                 f"🐝 No desktop here. Connect with hivemux connect and it opens there (http://127.0.0.1:{port}/)")
        return
    if app_state()[2] or not swiftc() or not client or running_window():
        open_window()
        return
    # pause the sidebar animation under the popup, like the other popups (bin/hivemux-settings)
    # 다른 팝업처럼 팝업 아래 사이드바 애니메이션을 멈춘다 (bin/hivemux-settings)
    pause = "/tmp/hivemux-pause-%d-%s" % (os.getuid(), tmux("display", "-p", "#{pid}").strip())
    open(pause, "w").close()
    try:
        subprocess.run([os.path.join(HERE, "hivemux-modal"), client, "-E", "-w", "66", "-h", "11", "-b", "rounded",
                        "-T", "#[fg=#e6e9ef,bold] hivemux office ", "-S", "fg=#f5a524", "-s", "bg=#1e2128",
                        f"{shlex.quote(os.path.realpath(__file__))} --popup"], stdin=subprocess.DEVNULL)
    finally:
        os.remove(pause)


def open_there(client):
    """Ask the Mac the screen is attached from to open the window: its hivemux-ports waits on the channel
    hivemux-paste-<Mac> over the ssh connection it keeps (bin/hivemux-ports) and takes the request from
    @hivemux-office-<Mac>. This Mac's sessions show there next door.
    화면이 붙어 온 Mac 에 창을 열어 달라고 한다: 그 Mac 의 hivemux-ports 가 유지하는 ssh 연결로 채널
    hivemux-paste-<Mac> 을 기다리다가 @hivemux-office-<Mac> 에서 요청을 가져간다. 이 Mac 의 세션은 거기 옆 사무실에 나온다."""
    ko = lang() == "ko"
    mac = next((l.split(" ", 1)[1] for l in tmux("show", "-gqv", "@hivemux-remote-from").splitlines()
                if l.split(" ", 1)[0] == client and " " in l), "")
    seen = tmux("show", "-gqv", f"@hivemux-seen-{mac}").strip() if mac else ""
    name = (tmux("show", "-gqv", f"@hivemux-name-{mac}").strip() or mac) if mac else ""
    if seen.isdigit() and time.time() - int(seen) <= 20:
        opt, tag = f"@hivemux-office-{mac}", str(os.getpid())
        tmux("set", "-g", opt, tag)
        tmux("wait-for", "-S", f"hivemux-paste-{mac}")
        for _ in range(20):          # hivemux-ports clears it when it takes it / 가져가면 지운다
            time.sleep(0.25)
            if tmux("show", "-gqv", opt).strip() != tag:
                tmux("display", "-c", client, "-d", "3000",
                     f"🐝 {name} 에서 벌 사무실을 엽니다" if ko else f"🐝 Opening the bee office on {name}")
                return
        tmux("set", "-gu", opt)      # no answer: an older hivemux there / 대답이 없음: 거기 hivemux 가 예전 것
        msg = (f"{name} 에서 벌 사무실을 열지 못했습니다. 그 컴퓨터의 hivemux 를 업데이트하세요" if ko
               else f"Could not open the bee office on {name}. Update hivemux there")
    else:
        msg = ("다른 컴퓨터에서 붙은 화면입니다. 벌 사무실은 그 컴퓨터에서 여세요 (사이드바 🐝, prefix B)" if ko
               else "This screen is attached from another computer. Open the bee office on that computer (sidebar 🐝, prefix B)")
    tmux("display", "-c", client, "-d", "5000", msg)


def running_window():
    try:
        pid = int(open(WINDOW_PID).read())
    except (OSError, ValueError):
        return False
    return APP_NAME in subprocess.run(["ps", "-o", "args=", "-p", str(pid)], capture_output=True, text=True).stdout


def main(argv):
    if argv[:1] == ["--json"]:
        print(json.dumps(snapshot()))
    elif argv[:1] == ["--goto"] and len(argv) >= 2:
        frm = argv[3] if argv[2:3] == ["--from"] and len(argv) >= 4 else None
        sys.exit(0 if goto(argv[1], frm) else 1)
    elif argv[:1] == ["--answer"] and len(argv) == 3:   # the other Mac's office answers here / 상대 Mac 의 사무실이 여기 답한다
        try:
            ans = json.loads(argv[2])
        except ValueError:
            sys.exit(2)
        sys.exit(0 if argv[1].startswith("%") and isinstance(ans, dict) and answer(argv[1], ans) else 1)
    elif argv[:1] == ["--shift"] and argv[1:2] in (["on"], ["off"]):   # the other Mac's office asks / 상대 Mac 의 사무실이 묻는다
        r = subprocess.run([os.path.join(HERE, "hivemux-shift"), argv[1]], capture_output=True, text=True, stdin=subprocess.DEVNULL)
        print(r.stdout.strip()); sys.exit(r.returncode)
    elif argv[:1] == ["serve"]:
        serve()
    elif argv[:1] == ["--client"]:
        from_tmux(argv[1] if len(argv) > 1 else "")
    elif argv[:1] == ["--popup"]:
        open_window(popup=True)
    elif argv[:1] == ["--build"]:
        sys.exit(0 if build() else 1)
    elif not argv:
        open_window()
    else:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
