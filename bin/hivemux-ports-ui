#!/usr/bin/env python3
"""Port list popup (runs inside tmux display-popup, see hivemux-ports --pick).
포트 목록 팝업 (tmux display-popup 안에서 실행, hivemux-ports --pick 참고).

  hivemux-ports-ui <client>

Dev server ports forwarded from another Mac (bin/hivemux-ports):
- this Mac connected to another one: its ports, forwarded here ($XDG_DATA_HOME/hivemux/ports)
- another Mac connected to this one: this Mac's ports, forwarded there (@hivemux-ports-<Mac>)
다른 Mac 에서 이어 준 개발 서버 포트 (bin/hivemux-ports):
- 이 Mac 이 다른 Mac 에 붙어 있으면: 그 Mac 의 포트, 여기로 이어짐 ($XDG_DATA_HOME/hivemux/ports)
- 다른 Mac 이 이 Mac 에 붙어 있으면: 이 Mac 의 포트, 거기로 이어짐 (@hivemux-ports-<Mac>)
  ↑↓ / Ctrl+P N   select / 고르기
  Enter           open in the browser of the Mac it is forwarded to / 이어진 Mac 의 브라우저로 열기
  p               open it to that Mac's Wi-Fi too, for a phone on the same network: its address and a QR code
                  (with qrencode); p again closes it / 같은 Wi-Fi 의 휴대폰용으로 그 Mac 의 네트워크에도 연다: 주소와
                  QR 코드 (qrencode 가 있으면). 다시 p 는 닫는다
  Ctrl+Y          copy the address / 주소 복사      Esc   close / 닫기
"""
import os, select, shutil, subprocess, sys, termios, time, tty, unicodedata

TMUX = shutil.which("tmux") or "/opt/homebrew/bin/tmux"
OS = os.path.join(os.path.dirname(os.path.realpath(__file__)), "hivemux-os")   # open, copy on macOS or Linux / macOS 나 Linux 에서 열기, 복사
DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "hivemux", "ports")
LAN = DATA + "-lan"                  # bin/hivemux-ports: ports opened for a phone / 휴대폰용으로 연 포트


def tmux(*a):
    return subprocess.run([TMUX, *a], capture_output=True, text=True).stdout


def _is_ko():
    """UI language: HIVEMUX_LANG > tmux @hivemux-lang (set by hivemux setup) > LANG / 화면 언어: HIVEMUX_LANG > tmux @hivemux-lang (hivemux setup 이 정함) > LANG"""
    v = os.environ.get("HIVEMUX_LANG") or tmux("show", "-gqv", "@hivemux-lang").strip()
    return (v or os.environ.get("LANG", "")).startswith("ko")


KO = _is_ko()


def tr(ko, en):
    return ko if KO else en
CLIENT = sys.argv[1] if len(sys.argv) > 1 else ""

TEXT, T2, T3 = (230, 233, 239), (154, 163, 178), (98, 106, 120)
ACC, SEL_BG, BG = (90, 169, 255), (42, 47, 58), (30, 33, 40)


def fg(c): return "\x1b[38;2;%d;%d;%dm" % c
def bg(c): return "\x1b[48;2;%d;%d;%dm" % c
RST, BOLD = "\x1b[0m", "\x1b[1m"


def width(s):
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def run(cmd, **kw):
    dry = os.environ.get("HIVEMUX_DRYRUN")
    if dry:  # for tests: record instead of running / 테스트용: 실행하지 않고 기록만
        with open(dry, "a") as f:
            f.write(" ".join(cmd) + "\n")
        return
    subprocess.run(cmd, **kw)


def ports():
    """[{url, where, cmd, mac (None: forwarded to this Mac), rp}] / mac 이 None 이면 이 Mac 으로 이어진 것"""
    out = []
    # another Mac looks at this one: its forwards of this Mac's ports / 다른 Mac 이 이 Mac 에 붙음: 이 Mac 포트를 그 Mac 으로
    for ln in tmux("show", "-g").splitlines():
        name = ln.split(" ", 1)[0]
        if not name.startswith("@hivemux-ports-") or name.startswith("@hivemux-ports-open-"):
            continue
        mac = name[len("@hivemux-ports-"):]
        # a connection that stopped asking (it polls every 3 s): its list is old, so it goes. A Mac that came back
        # under another name left one for days, and Enter there asked a computer that no longer listened
        # 묻지 않게 된 연결 (3초마다 묻는다): 목록이 낡았으니 지운다. 다른 이름으로 다시 붙은 Mac 이 며칠씩 남겼고,
        # 거기서 Enter 를 누르면 이제 듣지 않는 컴퓨터에 부탁했다
        seen = tmux("show", "-gqv", f"@hivemux-seen-{mac}").strip()
        if not seen.isdigit() or time.time() - int(seen) > 60:
            for o in (name, f"@hivemux-ports-open-{mac}"):
                tmux("set", "-gu", o)
            continue
        for row in tmux("show", "-gqv", name).splitlines():
            lp, rp, cmd = (row.split(" ", 2) + ["", "", ""])[:3]
            if lp.isdigit() and rp.isdigit():
                ip, *wide = tmux("show", "-gqv", f"@hivemux-lanip-{mac}").split() or [""]
                out.append(dict(url=f"http://localhost:{lp}", cmd=cmd, mac=mac, rp=rp,
                                phone=f"http://{ip}:{lp}" if ip and rp in wide else "",
                                where=tr(f"{mac} 에서 열기 · 여기 {rp}", f"opens on {mac} · here {rp}")))
    # this Mac connected to another one: its ports here / 이 Mac 이 다른 Mac 에 붙음: 그 Mac 포트를 여기로
    if os.path.isdir(DATA):
        for host in sorted(os.listdir(DATA)):
            path = os.path.join(DATA, host)
            if not alive(path):          # its forwards ended without clearing it: an old list / 포워딩이 끝났는데 남은 목록
                try:
                    os.unlink(path)
                except OSError:
                    pass
                continue
            with open(path) as f:
                for row in f:
                    lp, rp, cmd = (row.rstrip("\n").split(" ", 2) + ["", "", ""])[:3]
                    if lp.isdigit():
                        wide = lan_ports(host)
                        out.append(dict(url=f"http://localhost:{lp}", cmd=cmd, mac=None, rp=rp, host=host,
                                        phone=f"http://{lan_ip()}:{lp}" if rp in wide and lan_ip() else "",
                                        where=tr(f"{host} 의 {rp}", f"{host}:{rp}")))
    return out


def alive(path):
    """The process that keeps this list's forwards (its first line "# <pid>") is still there. A list from an older
    version, without the line: a hivemux-ports for its host is running
    이 목록의 포워딩을 쥔 프로세스 (첫 줄 "# <pid>") 가 아직 있다. 그 줄이 없는 예전 목록은 그 호스트의
    hivemux-ports 가 돌고 있으면 있는 것으로 친다"""
    try:
        first = open(path).readline().split()
    except OSError:
        return False
    if first[:1] != ["#"] or not first[1:2] or not first[1].isdigit():
        host = os.path.basename(path)
        return subprocess.run(["pgrep", "-f", f"hivemux-ports {host} "], capture_output=True).returncode == 0
    try:
        os.kill(int(first[1]), 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def lan_ports(host):
    try:
        return open(os.path.join(LAN, host)).read().split()
    except OSError:
        return []


def lan_ip():
    import socket
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("192.0.2.1", 9))
        ip = s.getsockname()[0]
        s.close()
        return "" if ip.startswith("127.") else ip
    except OSError:
        return ""


def phone(it):
    """Ask the Mac it is forwarded to to open it on its Wi-Fi too (or close it): picked up within a few seconds
    이어진 Mac 에 그 네트워크에도 열어 달라고 (또는 닫아 달라고) 한다: 몇 초 안에 받는다"""
    if it["mac"]:
        run([TMUX, "set", "-g", f"@hivemux-lan-{it['mac']}", it["rp"]])
    else:
        on = set(lan_ports(it["host"])) ^ {it["rp"]}
        os.makedirs(LAN, exist_ok=True)
        with open(os.path.join(LAN, it["host"]), "w") as f:
            f.write("".join(f"{x}\n" for x in sorted(on)))


def qr(text):
    """The QR code as text (qrencode), else none / QR 코드 글자 그림 (qrencode), 없으면 빈 목록"""
    q = shutil.which("qrencode") or next((p for p in ("/opt/homebrew/bin/qrencode", "/usr/local/bin/qrencode") if os.path.exists(p)), None)
    if not q:
        return []
    r = subprocess.run([q, "-t", "UTF8", "-m", "1", text], capture_output=True, text=True)
    return r.stdout.splitlines() if r.returncode == 0 else []


def brew():
    return shutil.which("brew") or next((p for p in ("/opt/homebrew/bin/brew", "/usr/local/bin/brew") if os.path.exists(p)), None)


def install_qr(fd, old):
    """brew install qrencode right in the popup, its output on screen; True when it is there after
    팝업 안에서 brew install qrencode. 출력은 화면에. 끝나고 있으면 True"""
    termios.tcsetattr(fd, termios.TCSADRAIN, old)       # a normal terminal while brew runs / brew 가 도는 동안 보통 터미널
    sys.stdout.write(RST + "\x1b[H\x1b[2J" + tr("qrencode 를 설치합니다…", "Installing qrencode…") + "\n\n")
    sys.stdout.flush()
    # no update of Homebrew itself or of what is installed: only this one and what it needs
    # Homebrew 자체나 설치된 것은 업데이트하지 않는다: 이것과 이것에 필요한 것만
    env = dict(os.environ, HOMEBREW_NO_AUTO_UPDATE="1", HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK="1", HOMEBREW_NO_INSTALL_CLEANUP="1")
    subprocess.run([brew(), "install", "qrencode"], env=env)
    tty.setraw(fd)
    return bool(qr("x"))


def is_remote(client):
    """The popup's screen is attached from another Mac / 팝업이 뜬 화면이 다른 Mac 에서 붙은 것"""
    return f" {client} " in f" {tmux('show', '-gqv', '@hivemux-remote-clients')} "


def open_it(it):
    if it["mac"]:
        # that Mac's hivemux-ports opens it on its next poll / 그 Mac 의 hivemux-ports 가 다음에 물을 때 연다
        run([TMUX, "set", "-g", f"@hivemux-ports-open-{it['mac']}", it["rp"]])
    else:
        run([OS, "open", it["url"]])


def copy(it):
    if is_remote(CLIENT):       # to the clipboard of the Mac this screen is on (OSC 52) / 이 화면이 있는 Mac 의 클립보드로
        run([TMUX, "set-buffer", "-w", "--", it["url"]])
    else:
        run([OS, "copy"], input=it["url"].encode())


def main():
    items = ports()
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setraw(fd)
    out = sys.stdout
    sel, top, msg = 0, 0, ""
    show, waiting = None, 0.0           # the phone view of one port, waiting for it to open / 한 포트의 휴대폰 화면, 열리길 기다림
    try:
        while True:
            cols, rows = os.get_terminal_size()
            sel = max(0, min(sel, len(items) - 1))
            list_h = max(1, (rows - 4) // 2)
            top = min(max(top, sel - list_h + 1), sel)
            buf = ["\x1b[H\x1b[2J", bg(BG), "\r\n"]
            it = next((x for x in items if show and x["url"] == show), None)
            if it is not None:
                # the phone view: the address on that Mac's network and its QR code / 휴대폰 화면: 그 네트워크의 주소와 QR 코드
                if it["phone"]:
                    buf.append(f"  {fg(T2)}{tr('같은 Wi-Fi 의 휴대폰에서 여세요', 'Open on a phone on the same Wi-Fi')}\r\n")
                    buf.append(f"  {fg(TEXT)}{BOLD}{it['phone']}{RST}{bg(BG)}\r\n")
                    code = qr(it["phone"])
                    for ln in code[:max(0, rows - 6)]:
                        buf.append(f"  {fg(TEXT)}{ln}\r\n")
                    if not code and brew():
                        buf.append(f"\r\n  {fg(T2)}{tr('QR 코드를 그리려면 qrencode 가 필요합니다.', 'A QR code needs qrencode.')}\r\n")
                        buf.append(f"  {fg(TEXT)}i{fg(T2)} {tr('를 누르면 지금 설치하고 바로 보여 줍니다 (brew install qrencode)', 'installs it now and shows the code (brew install qrencode)')}\r\n")
                    elif not code:
                        buf.append(f"\r\n  {fg(T3)}{tr('QR 코드는 qrencode 를 설치하면 보입니다', 'Install qrencode for a QR code')}\r\n")
                else:
                    buf.append(f"  {fg(T2)}{tr('휴대폰에서 열 수 있게 여는 중…', 'Opening it for the phone…')}\r\n")
                    if time.time() - waiting > 15:
                        buf.append(f"\r\n  {fg(T3)}{tr('열리지 않으면 그 Mac 의 hivemux 를 업데이트하세요', 'If it does not open, update hivemux on that Mac')}\r\n")
                hint = (f"{fg(TEXT)}p{fg(T3)} {tr('휴대폰에서 닫기', 'stop for the phone')}   "
                        f"{fg(TEXT)}Esc{fg(T3)} {tr('목록', 'back')}")
                buf.append(f"\x1b[{rows - 1};1H{fg((44, 48, 57))}  " + "─" * (cols - 4) + "\r\n  " + hint + RST)
                out.write("".join(buf))
                out.flush()
                r, _, _ = select.select([fd], [], [], 1.0 if not it["phone"] else 3.0)
                if not r:
                    items = ports()
                    continue
                ch = os.read(fd, 32).decode(errors="ignore")
                if ch == "i" and it["phone"] and not qr("x") and brew():
                    if not install_qr(fd, old):
                        msg = f"{fg(T2)}{tr('설치하지 못했습니다. 터미널에서 brew install qrencode 를 실행하세요', 'Could not install it: run brew install qrencode in a terminal')}"
                        show = None
                    continue
                if ch == "p":
                    phone(it); show = None; items = ports()
                    msg = f"{fg(ACC)}{tr('휴대폰에서 닫는 중', 'Closing it for the phone')}  {fg(T2)}{it['url']}"
                elif ch in ("\x1b", "q", "\r", "\n"):
                    show = None
                elif ch == "\x03":
                    return
                continue
            if not items:
                buf.append(f"  {fg(T2)}{tr('이어진 포트가 없습니다', 'No forwarded ports')}\r\n\r\n")
                buf.append(f"  {fg(T3)}{tr('원격으로 붙어 있는 동안 상대 컴퓨터의 tmux 에서 띄운', 'While connected, dev servers started in the other')}\r\n")
                buf.append(f"  {fg(T3)}{tr('개발 서버(npm run dev 등)가 여기에 나옵니다', 'computer’s tmux (npm run dev...) show up here')}\r\n")
            for i in range(top, min(len(items), top + list_h)):
                it = items[i]
                where = it["where"] + (tr(f" · 휴대폰 {it['phone']}", f" · phone {it['phone']}") if it["phone"] else "")
                if i == sel:            # the selection is a tinted row, no bar on its left / 고른 줄은 바탕색만, 왼쪽 막대 없이
                    l1 = f"{bg(SEL_BG)}{fg(TEXT)}{BOLD}   {it['url']}{RST}{bg(SEL_BG)}  {fg(T2)}{it['cmd']}"
                    l2 = f"{bg(SEL_BG)}{fg(T3)}   {where}"
                    pad = lambda s, raw: s + " " * max(0, cols - 2 - width(raw)) + RST + bg(BG)
                    buf.append(pad(l1, f"   {it['url']}  {it['cmd']}") + "\r\n")
                    buf.append(pad(l2, f"   {where}") + "\r\n")
                else:
                    buf.append(f"{bg(BG)}   {fg(TEXT)}{it['url']}  {fg(T3)}{it['cmd']}\r\n")
                    buf.append(f"{bg(BG)}   {fg(T3)}{where}\r\n")
            buf.append(f"\x1b[{rows - 1};1H{fg((44, 48, 57))}  " + "─" * (cols - 4) + "\r\n")
            hint = msg or (f"{fg(TEXT)}Enter{fg(T3)} {tr('브라우저로 열기', 'open in browser')}   "
                           f"{fg(TEXT)}p{fg(T3)} {tr('휴대폰', 'phone')}   "
                           f"{fg(TEXT)}^Y{fg(T3)} {tr('주소 복사', 'copy address')}   {fg(TEXT)}Esc{fg(T3)} {tr('닫기', 'close')}")
            buf.append("  " + hint + RST)
            out.write("".join(buf))
            out.flush()
            msg = ""
            ch = os.read(fd, 32).decode(errors="ignore")
            if ch in ("\x1b", "\x03", "q"):
                return
            if ch in ("\x1b[A", "\x10", "\x1bOA", "k"):
                sel -= 1
            elif ch in ("\x1b[B", "\x0e", "\x1bOB", "j"):
                sel += 1
            elif ch in ("\r", "\n") and items:
                open_it(items[sel]); return
            elif ch == "p" and items:
                it = items[sel]
                if it["phone"]:          # already open for the phone: show it / 이미 열려 있다: 보여 준다
                    show = it["url"]
                else:
                    phone(it); show, waiting = it["url"], time.time()
            elif ch == "\x19" and items:
                copy(items[sel])
                msg = f"{fg(ACC)}{tr('복사했습니다', 'Copied')}  {fg(T2)}{items[sel]['url']}"
    finally:
        out.write(RST + "\x1b[2J")
        out.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


if __name__ == "__main__":
    if len(sys.argv) > 2 and sys.argv[2] == "--list":
        for it in ports():
            print(it["url"], it["cmd"], "|", it["where"])
        sys.exit(0)
    main()
