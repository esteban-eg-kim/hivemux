#!/bin/bash
# Update Claude Code, then restart the Claude in each pane on the new version, back in the same conversation.
# Claude Code 를 업데이트하고, 칸마다 Claude 를 새 버전으로 다시 시작한다 (같은 대화로).
#   hivemux-claude-update [--yes]      check, ask, update and restart (hivemux update-claude)
#   hivemux-claude-update --popup <client>   the same in a popup (sidebar menu → Update Claude)
#   hivemux-claude-update watch        (in the background) restart the marked panes as they become free
# A running Claude keeps its old version until it starts again, so after the update every pane whose Claude
# still runs an older binary is marked (@claude_restart_pending) and restarted when it is free: idle or done,
# and its window on no screen (you might be typing there). It is stopped (SIGTERM) and the pane's shell gets
# `claude --resume <id>`, as after a reboot (bin/hivemux-panes). A finished task stays finished and unseen
# (@claude_restore, read by the SessionStart hook in bin/hivemux-hook). A Claude working or waiting for you
# is left alone until it is done. Homebrew installs update with brew, the others with `claude update`.
# 실행 중인 Claude 는 다시 시작하기 전까지 예전 버전이다. 그래서 업데이트한 뒤 예전 실행 파일로 도는 칸을
# 표시하고(@claude_restart_pending) 한가해지면 다시 시작한다: 쉬거나 끝났고, 그 창이 어느 화면에도 없을 때
# (거기서 입력 중일 수 있다). 멈추고(SIGTERM) 칸의 셸에 `claude --resume <id>` 를 보낸다. 재부팅 뒤와 같다
# (bin/hivemux-panes). 끝난 작업은 끝났고 안 본 채로 남는다 (@claude_restore, bin/hivemux-hook 의
# SessionStart 가 읽는다). 일하거나 나를 기다리는 Claude 는 끝날 때까지 둔다.
# Homebrew 로 설치했으면 brew 로, 아니면 `claude update` 로 업데이트한다.
# It first checks the newest version (the cask's for Homebrew, else npm's) and asks before updating; up to date,
# it only offers to restart Claudes still on an older version.
# 먼저 최신 버전(Homebrew 면 cask, 아니면 npm)을 보고, 업데이트 전에 묻는다. 이미 최신이면 예전 버전으로 도는
# Claude 를 다시 시작할지만 묻는다.
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin"
TMUX_BIN="$(command -v tmux || echo /opt/homebrew/bin/tmux)"
say() { local v="${HIVEMUX_LANG:-$("$TMUX_BIN" show -gqv @hivemux-lang 2>/dev/null)}"; if [[ "${v:-$LANG}" == ko* ]]; then printf '%s' "$1"; else printf '%s' "$2"; fi; }
t() { "$TMUX_BIN" "$@" 2>/dev/null; }
STATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/hivemux"
LOG="$STATE_DIR/claude-update.log"
mkdir -p "$STATE_DIR"
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; }
SHELLS='^-?(zsh|bash|fish|sh|dash|tcsh|ksh|login)$'

claude_cmd="${HIVEMUX_CLAUDE:-$(t show-environment -g HIVEMUX_CLAUDE | sed -n 's/^HIVEMUX_CLAUDE=//p')}"
claude_cmd="${claude_cmd:-claude}"
real() { local p; p="$(command -v "$1")" && { readlink -f "$p" 2>/dev/null || echo "$p"; }; }
version() { "$1" --version 2>/dev/null | awk '{print $1; exit}'; }

# The Claude process in a pane: a child of the pane's shell / 칸의 Claude 프로세스: 칸 셸의 자식
claude_pid() {
  ps -ax -o pid=,ppid=,comm= | awk -v p="$1" '$2 == p && $3 ~ /(^|\/)(claude|node)$/ { print $1; exit }'
}
# The binary a process runs / 프로세스가 실행 중인 파일
exe() { lsof -a -p "$1" -d txt -Fn 2>/dev/null | sed -n 's/^n//p' | head -1; }

# Still on an old version: its binary is not the one `claude` is now (a node install can't tell: only after an update)
# 아직 예전 버전: 실행 파일이 지금의 `claude` 가 아니다 (node 설치는 알 수 없어 업데이트했을 때만)
outdated() { # outdated <pid> <current binary> <updated 0|1>
  local e; e="$(exe "$1")"
  case "${e##*/}" in
    node) [ "$3" = 1 ] ;;
    "") return 1 ;;
    *) [ "$(readlink -f "$e" 2>/dev/null || echo "$e")" != "$2" ] ;;
  esac
}

# Restart one marked pane if it is free now; 0 = done with it (restarted or nothing to do), 1 = later
# 표시한 칸 하나를 지금 한가하면 다시 시작한다. 0 = 끝 (다시 시작했거나 할 일 없음), 1 = 나중에
restart() {
  local pane="$1" pp pid st at sid cwd cmd i
  pp="$(t display -p -t "$pane" '#{pane_pid}')" || return 0
  [ -n "$pp" ] || return 0
  pid="$(claude_pid "$pp")"
  sid="$(t show -pqv -t "$pane" @claude_session)"; cwd="$(t show -pqv -t "$pane" @claude_cwd)"
  [ -n "$sid" ] || { t set -pu -t "$pane" @claude_restart_pending; return 0; }
  # clocked out (bin/hivemux-shift): clocking in starts it again, on the new version
  # 퇴근 중 (bin/hivemux-shift): 출근하면 새 버전으로 다시 시작한다
  [ -n "$(t show -pqv -t "$pane" @claude_offwork)" ] && { t set -pu -t "$pane" @claude_restart_pending; return 0; }
  if [ -z "$pid" ]; then
    # stopped but not started again (the restart was cut short): start it now; a shell in front and the
    # session id still there (a deliberate exit forgets it, bin/hivemux-hook)
    # 멈췄는데 다시 시작하지 못함 (다시 시작이 중간에 끊김): 지금 시작. 앞에 셸이 있고 세션 id 가 남아 있을 때
    # (직접 종료하면 id 를 지운다, bin/hivemux-hook)
    cmd="$(t display -p -t "$pane" '#{pane_current_command}')"
    [[ "$cmd" =~ $SHELLS ]] || { t set -pu -t "$pane" @claude_restart_pending; return 0; }
    resume "$pane" "$sid" "$cwd"; log "resume $pane -> $sid (was stopped)"; return 0
  fi
  st="$(t show -pqv -t "$pane" @claude_state)"; at="$(t show -pqv -t "$pane" @claude_state_at)"
  case "$st" in run|wait) return 1 ;; esac
  t list-clients -F '#{window_id}' | grep -qxF "$(t display -p -t "$pane" '#{window_id}')" && return 1
  [ "$st" = done ] && t set -p -t "$pane" @claude_restore "$st $at"
  kill -TERM "$pid" 2>/dev/null
  for i in $(seq 50); do
    cmd="$(t display -p -t "$pane" '#{pane_current_command}')"
    [[ "$cmd" =~ $SHELLS ]] && break
    sleep 0.2
  done
  if ! [[ "$cmd" =~ $SHELLS ]]; then
    log "skip $pane: Claude did not stop ($cmd)"; t set -pu -t "$pane" @claude_restore; return 1
  fi
  resume "$pane" "$sid" "$cwd"
  log "restart $pane -> $sid ($st)"
  return 0
}

resume() { # resume <pane> <session id> <cwd>
  local cwd="$3"
  t set -pu -t "$1" @claude_restart_pending
  [ -d "$cwd" ] || cwd=""
  if [ -n "$cwd" ]; then t send-keys -t "$1" "cd $(printf '%q' "$cwd") && $claude_cmd --resume $2" Enter
  else t send-keys -t "$1" "$claude_cmd --resume $2" Enter; fi
}

pending() { t list-panes -a -F '#{pane_id} #{@claude_restart_pending}' | awk '$2 != "" { print $1 }'; }

# Go over the marked panes; prints how many are left / 표시한 칸을 한 번 훑고 남은 수를 출력
pass() {
  local p left=0
  for p in $(pending); do restart "$p" || left=$((left + 1)); done
  echo "$left"
}

# Only this restarts panes, in the background on its own: Ctrl+C or closing the popup can't stop it halfway
# (a Claude stopped and not started again)
# 칸을 다시 시작하는 것은 이것뿐이고, 뒤에서 혼자 돈다: Ctrl+C 나 팝업을 닫아도 중간에 멈추지 않는다
# (멈췄는데 다시 시작 못 한 Claude 가 남지 않게)
watch() {
  trap '' INT HUP
  local lock="/tmp/hivemux-claude-update-$(id -u)-$(t display -p '#{pid}')" i
  # held by a live watcher, or one just starting (no pid yet) / 살아 있는 watch, 또는 막 시작한 watch (pid 아직 없음)
  mkdir "$lock" 2>/dev/null || { i="$(cat "$lock/pid" 2>/dev/null)"; [ -z "$i" ] || kill -0 "$i" 2>/dev/null && exit 0; }
  echo $$ > "$lock/pid"; trap 'rm -rf "$lock"' EXIT
  for i in $(seq 14400); do          # 12 hours at most / 최대 12시간
    [ "$(pass)" = 0 ] && exit 0
    sleep 3
  done
}

# The newest version this install can get: the Homebrew cask's, else the npm package's (empty when offline)
# 이 설치가 받을 수 있는 최신 버전: Homebrew cask 의 것, 아니면 npm 패키지의 것 (인터넷이 없으면 빈 값)
latest() { # latest <binary>
  local cask
  case "$1" in
    */Caskroom/*/*) cask="${1#*/Caskroom/}"; cask="${cask%%/*}"
      curl -fsS -m 8 "https://formulae.brew.sh/api/cask/$cask.json" 2>/dev/null | sed -n 's/.*"version":"\([^"]*\)".*/\1/p' | head -1 ;;
    *) curl -fsS -m 8 https://registry.npmjs.org/@anthropic-ai/claude-code/latest 2>/dev/null | sed -n 's/.*"version":"\([^"]*\)".*/\1/p' | head -1 ;;
  esac
}
newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }   # newer <a> <b>: a > b

# y/n on the terminal; --yes answers yes, and without a terminal the answer is no
# 터미널에서 y/n. --yes 면 예, 터미널이 없으면 아니요
ask() {
  [ "$YES" = 1 ] && return 0
  [ -t 0 ] || return 1
  local a; printf '%s ' "$1 [y/N]"; read -rsn1 a; echo "$a"
  [[ "$a" == [yY] ]]
}

# Claude panes: all that run one, and those still on an older binary than <current binary>
# Claude 칸: 실행 중인 전부, 그리고 <지금 실행 파일> 보다 예전 것으로 도는 칸
claudes() { # claudes <current binary> <updated 0|1> -> "<pane> <old 0|1>" per line
  local p pp pid
  while read -r p pp; do
    [ -n "$(t show -pqv -t "$p" @claude_session)" ] || continue
    pid="$(claude_pid "$pp")"; [ -n "$pid" ] || continue
    if outdated "$pid" "$1" "$2"; then echo "$p 1"; else echo "$p 0"; fi
  done < <(t list-panes -a -F '#{pane_id} #{pane_pid}')
}

update() { # update <binary>
  case "$1" in
    */Caskroom/*/*) local cask="${1#*/Caskroom/}"; cask="${cask%%/*}"; brew upgrade --cask "$cask" 2>&1 | grep -v '^$' ;;
    */Cellar/*) brew upgrade "$(echo "$1" | sed 's#.*/Cellar/\([^/]*\)/.*#\1#')" 2>&1 | grep -v '^$' ;;
    *) claude update 2>&1 | grep -v '^$' ;;
  esac
}

# Mark the panes and let the background watcher restart them; show progress for a while
# 칸을 표시하고 뒤에서 도는 watch 가 다시 시작한다. 잠깐 진행을 보여 준다
restart_all() { # restart_all <panes...>
  local p i n=-1 left
  for p in "$@"; do t set -p -t "$p" @claude_restart_pending 1; done
  nohup "$0" watch </dev/null >/dev/null 2>&1 &
  echo "$(say "Claude $#개를 다시 시작합니다 (대화 그대로). 창을 닫아도 계속됩니다." \
              "Restarting $# Claude(s) (same conversation). Closing this keeps it going.")"
  for i in $(seq 40); do
    left="$(pending | wc -l | tr -d ' ')"
    [ "$left" != "$n" ] && { n="$left"; printf '\r  %s ' "$(say "남은 칸 $left" "$left left")"; }
    [ "$left" = 0 ] && break
    sleep 0.5
  done
  echo
  if [ "$left" = 0 ]; then echo "$(say "✓ 모두 다시 시작했습니다." "✓ All restarted.")"
  else echo "$(say "나머지 ${left}개는 일이 끝나고 화면에서 벗어나면 다시 시작합니다." "The other ${left} restart once done and off screen.")"; fi
}

main() {
  local bin cur new all old
  bin="$(real claude)"
  if [ -z "$bin" ]; then echo "$(say "claude 를 찾지 못했습니다" "claude not found")"; return 1; fi
  cur="$(version "$bin")"
  echo "$(say "최신 버전 확인 중…" "Checking for a new version…")"
  new="$(latest "$bin")"
  all=($(claudes "$bin" 0 | awk '{print $1}')); old=($(claudes "$bin" 0 | awk '$2 == 1 {print $1}'))
  echo "$(say "설치된 버전 $cur · 최신 ${new:-?}" "Installed $cur · latest ${new:-?}")"
  if [ -z "$new" ]; then
    echo "$(say "최신 버전을 확인하지 못했습니다 (인터넷 연결을 확인하세요)." "Could not check the latest version (check the network).")"
    ask "$(say "그래도 업데이트를 시도할까요?" "Try updating anyway?")" || return 0
  elif ! newer "$new" "$cur"; then
    echo "$(say "✓ 최신 버전입니다." "✓ Up to date.")"
    [ "${#old[@]}" = 0 ] && return 0
    echo
    ask "$(say "예전 버전으로 도는 Claude ${#old[@]}개를 $cur 로 다시 시작할까요? (대화 그대로, 일하는 중이면 끝난 뒤)" \
               "Restart the ${#old[@]} Claude(s) still on an older version on $cur? (same conversation; busy ones once done)")" || return 0
    restart_all "${old[@]}"; return 0
  else
    echo
    ask "$(say "$cur → $new 로 업데이트할까요? 업데이트하면 Claude ${#all[@]}개가 새 버전으로 다시 시작됩니다 (대화 그대로, 일하는 중이면 끝난 뒤)." \
               "Update $cur → $new? Then ${#all[@]} Claude(s) restart on it (same conversation; busy ones once done).")" || return 0
  fi
  echo
  update "$bin"
  bin="$(real claude)"; new="$(version "$bin")"
  echo
  if [ "$new" = "$cur" ]; then echo "$(say "버전이 그대로입니다 ($cur). 위 메시지를 확인하세요." "Still $cur; see the messages above.")"; return 1; fi
  echo "$(say "✓ $cur → $new" "✓ $cur → $new")"
  old=($(claudes "$bin" 1 | awk '$2 == 1 {print $1}'))
  [ "${#old[@]}" = 0 ] && { echo "$(say "다시 시작할 Claude 가 없습니다." "No Claude needs a restart.")"; return 0; }
  restart_all "${old[@]}"
}

case "${1:-}" in
  watch) watch ;;
  --popup)                          # from the sidebar menu: in a popup on that screen / 사이드바 메뉴: 그 화면의 팝업에서
    HM_BIN="$(cd "$(dirname "$(realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"
    "$HM_BIN/hivemux-modal" "${2:-}" -E -w 76 -h 20 -b rounded \
      -T "#[fg=#e6e9ef,bold] $(say "Claude 업데이트" "Update Claude") " -S "fg=#5aa9ff" -s "bg=#1e2128" \
      "$(printf '%q ' "$HM_BIN/hivemux-claude-update" --ui)" ;;
  --ui) main; echo; printf '%s' "$(say "아무 키나 누르면 닫힙니다" "Press any key to close")"; read -rsn1 ;;
  -h|--help) sed -n '4,6p' "$0" ;;
  --yes|-y) YES=1 main ;;
  *) main ;;
esac
