#!/usr/bin/env python3
"""Hand a pane's Claude something to run inside Claude Code, through hivemux's mod (share/claude-mod).
hivemux mod (share/claude-mod) 를 거쳐 칸의 Claude 가 Claude Code 안에서 실행할 것을 넘긴다.

  hivemux-mod send <pane> <text>    a slash command runs as one, anything else goes as the person's prompt;
                                    exit 0 once the mod took it, 1 when the pane has no mod or it did not take it
                                    within four seconds (the caller types it then)
                                    슬래시 명령은 명령으로, 나머지는 사람의 프롬프트로. mod 가 가져가면 0, 칸에 mod 가
                                    없거나 4초 안에 가져가지 않으면 1 (그러면 부른 쪽이 쳐 넣는다)

The mod reads <data>/mod/<pane>.do every second and runs it once the Claude is free: what the person is typing
stays, and nothing typed lands in a dialog as an answer. A prompt's @file mentions are not attached that way.
mod 가 <data>/mod/<pane>.do 를 매초 읽고 Claude 가 한가할 때 실행한다: 사람이 쓰던 글은 그대로이고, 친 것이 대화창의
대답으로 들어가지 않는다. 그렇게 보낸 프롬프트의 @파일 언급은 붙지 않는다.
"""
import json, os, subprocess, sys, time

TMUX = "tmux"


def has_mod(pane):
    out = subprocess.run([TMUX, "show", "-pqv", "-t", pane, "@hivemux-mod"], capture_output=True, text=True, errors="replace")
    return out.stdout.strip() == "1"


def send(pane, text):
    if not has_mod(pane):
        return False
    box = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "hivemux", "mod")
    path = os.path.join(box, pane.lstrip("%") + ".do")
    os.makedirs(box, exist_ok=True)
    for _ in range(40):             # one still waiting goes first / 아직 기다리는 것이 먼저
        if not os.path.exists(path):
            break
        time.sleep(0.1)
    else:
        return False
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump({"text": text}, f, ensure_ascii=False)
    os.replace(tmp, path)
    for _ in range(40):
        time.sleep(0.1)
        if not os.path.exists(path):
            return True
    try:
        os.unlink(path)             # not taken / 가져가지 않았다
    except FileNotFoundError:
        return True
    return False


if __name__ == "__main__":
    if len(sys.argv) == 4 and sys.argv[1] == "send":
        sys.exit(0 if send("%" + sys.argv[2].lstrip("%"), sys.argv[3]) else 1)
    sys.exit(__doc__)
