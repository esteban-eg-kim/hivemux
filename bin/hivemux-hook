#!/bin/bash
# Claude Code hook -> tmux bridge.
# Usage (from ~/.claude/settings.json hooks): hivemux-hook <EventName>
# - records the Claude session id on the pane (@claude_session, @claude_cwd) for resume after reboot
# - 칸(pane)에 Claude 세션 id 기록 (@claude_session, @claude_cwd) -> 재부팅 후 재개용
# - records state on the pane and window (@claude_state: run | wait | done | idle, @claude_state_at)
# - 칸과 창에 상태 기록 (@claude_state: run | wait | done | idle, @claude_state_at)
#   -> status-line window icons and the sidebar board
#   -> 상태줄 창 목록 아이콘, 사이드바 상태판
# - counts subagents Claude is running on the pane (@claude_agents) and tasks finished today on the
#   server (@hivemux-honey "<date> <count>") for the bee office (bin/hivemux-office)
# - 칸에서 Claude 가 돌리는 서브에이전트 수(@claude_agents)와 오늘 이 서버에서 끝난 작업 수
#   (@hivemux-honey "<날짜> <개수>")를 센다 -> 벌 사무실 (bin/hivemux-office)
# - marks a pane whose Claude is in plan mode (@claude_plan) -> it plans in the bee office's meeting room
# - 계획 모드인 Claude 의 칸을 표시 (@claude_plan) -> 벌 사무실 회의실에서 계획을 세운다
# - records the folder Claude is working in now (@claude_pwd; a Bash cd moves it off @claude_cwd)
#   so Option+O can find relative paths (bin/hivemux-open-ui)
# - Claude 가 지금 일하는 폴더를 기록 (@claude_pwd; Bash 에서 cd 하면 @claude_cwd 와 달라진다)
#   -> Option+O 가 상대 경로를 찾는다 (bin/hivemux-open-ui)
# Never blocks Claude: always exits 0 and prints nothing.

event="$1"
input="$(cat)"
[ -n "$TMUX" ] && [ -n "$TMUX_PANE" ] || exit 0
TMUX_BIN="$(command -v tmux || echo /opt/homebrew/bin/tmux)"
JQ="$(command -v jq || echo /usr/bin/jq)"
t() { "$TMUX_BIN" "$@" </dev/null >/dev/null 2>&1; }
field() { printf '%s' "$input" | "$JQ" -r --arg k "$1" '.[$k] // empty' 2>/dev/null; }

state() { # state <run|wait|done|idle>
  local cur; cur="$("$TMUX_BIN" show -pqv -t "$TMUX_PANE" @claude_state 2>/dev/null)"
  [ "$cur" = "$1" ] && return   # same state: keep the timestamp (do not reset on every tool call) / 같은 상태면 시각 유지 (도구 호출마다 갱신 방지)
  t set -p -t "$TMUX_PANE" @claude_state "$1"
  t set -p -t "$TMUX_PANE" @claude_state_at "$(date +%s)"
  t set -w -t "$TMUX_PANE" @claude_state "$1"
  [ "$1" = done ] && honey
  "$TMUX_BIN" list-clients -F '#{client_name}' 2>/dev/null | while read -r c; do t refresh-client -t "$c" -S; done
  wake
}

# One more task finished today (a new day starts again from 1)
# 오늘 끝난 작업 하나 더 (날이 바뀌면 1부터)
honey() {
  local today cur
  today="$(date +%F)"; cur="$("$TMUX_BIN" show -gqv @hivemux-honey 2>/dev/null)"
  if [ "${cur%% *}" = "$today" ]; then t set -g @hivemux-honey "$today $(( ${cur##* } + 1 ))"
  else t set -g @hivemux-honey "$today 1"; fi
}

# Subagents running on this pane: +1 when Claude starts one (the Agent tool, Task before), -1 when it returns
# 이 칸에서 도는 서브에이전트 수: Claude 가 하나 띄우면 (Agent 도구, 예전 이름 Task) +1, 돌아오면 -1
agents() { # agents <+1|-1|0>
  local n
  case "$1" in
    0) n=0 ;;
    *) n="$("$TMUX_BIN" show -pqv -t "$TMUX_PANE" @claude_agents 2>/dev/null)"; n=$(( ${n:-0} $1 )); [ "$n" -lt 0 ] && n=0 ;;
  esac
  if [ "$n" = 0 ]; then t set -pu -t "$TMUX_PANE" @claude_agents; else t set -p -t "$TMUX_PANE" @claude_agents "$n"; fi
}

# Plan mode (permission_mode "plan" on the events that carry it); shift+tab is seen at the next event
# 계획 모드 (이벤트에 실려 오는 permission_mode 가 "plan"). shift+tab 은 다음 이벤트에 반영된다
mode_() {
  local m cur; m="$(field permission_mode)"
  [ -n "$m" ] || return
  cur="$("$TMUX_BIN" show -pqv -t "$TMUX_PANE" @claude_plan 2>/dev/null)"
  if [ "$m" = plan ]; then [ -n "$cur" ] || t set -p -t "$TMUX_PANE" @claude_plan 1
  else [ -z "$cur" ] || t set -pu -t "$TMUX_PANE" @claude_plan; fi
}

# Where Claude works now: kept apart from @claude_cwd, which is where resume must start
# Claude 가 지금 일하는 폴더: 재개 위치인 @claude_cwd 와 따로 둔다
pwd_() {
  local d; d="$(field cwd)"
  [ -n "$d" ] && [ "$d" != "$("$TMUX_BIN" show -pqv -t "$TMUX_PANE" @claude_pwd 2>/dev/null)" ] &&
    t set -p -t "$TMUX_PANE" @claude_pwd "$d"
}

# Tell this server's sidebars to re-read now instead of on their next 1s poll
# 이 서버의 사이드바에 바로 다시 읽으라고 알린다 (1초 주기를 기다리지 않게)
wake() {
  "$TMUX_BIN" list-panes -a -F '#{pane_pid} #{pane_title} #{m:*hivemux-sidebar-view*,#{pane_start_command}}' 2>/dev/null | awk '$2=="hivemux-sidebar" && $3==1{print $1}' |
    while read -r p; do kill -USR1 "$p" 2>/dev/null; done
}

case "$event" in
  SessionStart)
    sid="$(field session_id)"; cwd="$(field cwd)"
    [ -n "$sid" ] && t set -p -t "$TMUX_PANE" @claude_session "$sid"
    [ -n "$cwd" ] && t set -p -t "$TMUX_PANE" @claude_pwd "$cwd"
    # Where resume starts: where Claude was started. After a compact or /clear the cwd is wherever a Bash cd left it
    # (a worktree deep inside), so keep the one we have
    # 재개할 위치: Claude 를 시작한 곳. 압축이나 /clear 뒤의 cwd 는 Bash cd 로 옮겨 간 곳(안쪽 워크트리)이라 있던 값을 둔다
    case "$(field source)" in
      compact|clear) [ -n "$cwd" ] && [ -z "$("$TMUX_BIN" show -pqv -t "$TMUX_PANE" @claude_cwd 2>/dev/null)" ] && t set -p -t "$TMUX_PANE" @claude_cwd "$cwd" ;;
      *) [ -n "$cwd" ] && t set -p -t "$TMUX_PANE" @claude_cwd "$cwd" ;;
    esac
    title="$(field session_title)"; [ -n "$title" ] && t set -p -t "$TMUX_PANE" @claude_title "$title"
    # Restarted on a new version (bin/hivemux-claude-update): a finished task stays finished, at the same time (still unseen)
    # 새 버전으로 다시 시작 (bin/hivemux-claude-update): 끝난 작업은 같은 시각으로 끝난 채 (아직 안 본 채)
    keep="$("$TMUX_BIN" show -pqv -t "$TMUX_PANE" @claude_restore 2>/dev/null)"
    if [ -n "$keep" ]; then
      t set -pu -t "$TMUX_PANE" @claude_restore
      t set -p -t "$TMUX_PANE" @claude_state "${keep%% *}"
      t set -p -t "$TMUX_PANE" @claude_state_at "${keep#* }"
      t set -w -t "$TMUX_PANE" @claude_state "${keep%% *}"
      wake
    else
      state idle
    fi
    ;;
  UserPromptSubmit|PermissionDenied)
    mode_
    state run
    ;;
  PostToolUse|PostToolUseFailure)
    case "$(field tool_name)" in Agent|Task) agents -1 ;; Bash) pwd_ ;; esac
    mode_
    state run
    ;;
  PreToolUse)
    mode_
    # Tools that only ask the user something wait right away; others are running
    # 사용자에게 묻기만 하는 도구는 바로 입력 필요, 나머지는 작업 중
    case "$(field tool_name)" in
      AskUserQuestion|ExitPlanMode) state wait ;;
      Agent|Task) agents +1; state run ;;
      *) state run ;;
    esac
    ;;
  PermissionRequest)
    # Fires when the approval dialog opens (the Notification below comes later)
    # 승인 창이 뜨는 순간 호출된다 (아래 Notification 은 몇 초 늦게 온다)
    state wait
    ;;
  Notification)
    case "$(field notification_type)" in
      permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input) state wait ;;
    esac
    ;;
  Stop)
    agents 0
    pwd_
    mode_
    state done
    # If a sidebar rename is pending, send it now that the turn has ended
    # 사이드바에서 바꾼 이름이 보류 중이면 응답이 끝난 지금 보낸다
    [ -n "$("$TMUX_BIN" show -pqv -t "$TMUX_PANE" @claude_rename_pending 2>/dev/null)" ] &&
      ( "$(dirname "$0")/hivemux-rename" flush "$TMUX_PANE" >/dev/null 2>&1 & )
    ;;
  StopFailure)
    # The turn ended on an API error (rate limit, overload, auth...): no Stop comes, so ask the user to look
    # API 오류(요청 한도, 과부하, 인증 등)로 응답이 끊김: Stop 이 오지 않으니 확인하도록 입력 필요로 표시
    state wait
    ;;
  SessionEnd)
    t set -pu -t "$TMUX_PANE" @claude_state
    t set -pu -t "$TMUX_PANE" @claude_state_at
    t set -wu -t "$TMUX_PANE" @claude_state
    t set -pu -t "$TMUX_PANE" @claude_agents
    t set -pu -t "$TMUX_PANE" @claude_pwd
    t set -pu -t "$TMUX_PANE" @claude_plan
    # Forget the mapping only on a deliberate exit; reboots and kills still resume
    # 직접 종료했을 때만 매핑 삭제 -> 재부팅/강제 종료는 재개된다
    case "$(field reason)" in
      prompt_input_exit|logout)
        t set -pu -t "$TMUX_PANE" @claude_session
        t set -pu -t "$TMUX_PANE" @claude_cwd ;;
    esac
    "$TMUX_BIN" list-clients -F '#{client_name}' 2>/dev/null | while read -r c; do t refresh-client -t "$c" -S; done
    wake
    ;;
esac
exit 0
