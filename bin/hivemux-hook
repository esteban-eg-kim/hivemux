#!/bin/bash
# Claude Code hook -> tmux bridge.
# Usage (from ~/.claude/settings.json hooks): hivemux-hook <EventName>
# - records the Claude session id on the pane (@claude_session, @claude_cwd) for resume after reboot
# - 칸(pane)에 Claude 세션 id 기록 (@claude_session, @claude_cwd) -> 재부팅 후 재개용
# - records state on the pane and window (@claude_state: run | wait | done | idle, @claude_state_at)
# - 칸과 창에 상태 기록 (@claude_state: run | wait | done | idle, @claude_state_at)
#   -> status-line window icons and the sidebar board
#   -> 상태줄 창 목록 아이콘, 사이드바 상태판
# Never blocks Claude: always exits 0 and prints nothing.

event="$1"
input="$(cat)"
[ -n "$TMUX" ] && [ -n "$TMUX_PANE" ] || exit 0
TMUX_BIN="$(command -v tmux || echo /opt/homebrew/bin/tmux)"
JQ="$(command -v jq || echo /usr/bin/jq)"
t() { "$TMUX_BIN" "$@" </dev/null >/dev/null 2>&1; }
field() { printf '%s' "$input" | "$JQ" -r --arg k "$1" '.[$k] // empty' 2>/dev/null; }

state() { # state <run|wait|done|idle>
  local cur; cur="$("$TMUX_BIN" show -pqv -t "$TMUX_PANE" @claude_state 2>/dev/null)"
  [ "$cur" = "$1" ] && return   # same state: keep the timestamp (do not reset on every tool call) / 같은 상태면 시각 유지 (도구 호출마다 갱신 방지)
  t set -p -t "$TMUX_PANE" @claude_state "$1"
  t set -p -t "$TMUX_PANE" @claude_state_at "$(date +%s)"
  t set -w -t "$TMUX_PANE" @claude_state "$1"
  "$TMUX_BIN" list-clients -F '#{client_name}' 2>/dev/null | while read -r c; do t refresh-client -t "$c" -S; done
  wake
}

# Tell this server's sidebars to re-read now instead of on their next 1s poll
# 이 서버의 사이드바에 바로 다시 읽으라고 알린다 (1초 주기를 기다리지 않게)
wake() {
  "$TMUX_BIN" list-panes -a -F '#{pane_pid} #{pane_title}' 2>/dev/null | awk '$2=="hivemux-sidebar"{print $1}' |
    while read -r p; do kill -USR1 "$p" 2>/dev/null; done
}

case "$event" in
  SessionStart)
    sid="$(field session_id)"; cwd="$(field cwd)"
    [ -n "$sid" ] && t set -p -t "$TMUX_PANE" @claude_session "$sid"
    [ -n "$cwd" ] && t set -p -t "$TMUX_PANE" @claude_cwd "$cwd"
    title="$(field session_title)"; [ -n "$title" ] && t set -p -t "$TMUX_PANE" @claude_title "$title"
    state idle
    ;;
  UserPromptSubmit|PostToolUse|PostToolUseFailure|PermissionDenied)
    state run
    ;;
  PreToolUse)
    # Tools that only ask the user something wait right away; others are running
    # 사용자에게 묻기만 하는 도구는 바로 입력 필요, 나머지는 작업 중
    case "$(field tool_name)" in
      AskUserQuestion|ExitPlanMode) state wait ;;
      *) state run ;;
    esac
    ;;
  PermissionRequest)
    # Fires when the approval dialog opens (the Notification below comes later)
    # 승인 창이 뜨는 순간 호출된다 (아래 Notification 은 몇 초 늦게 온다)
    state wait
    ;;
  Notification)
    case "$(field notification_type)" in
      permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input) state wait ;;
    esac
    ;;
  Stop)
    state done
    # If a sidebar rename is pending, send it now that the turn has ended
    # 사이드바에서 바꾼 이름이 보류 중이면 응답이 끝난 지금 보낸다
    [ -n "$("$TMUX_BIN" show -pqv -t "$TMUX_PANE" @claude_rename_pending 2>/dev/null)" ] &&
      ( "$(dirname "$0")/hivemux-rename" flush "$TMUX_PANE" >/dev/null 2>&1 & )
    ;;
  StopFailure)
    # The turn ended on an API error (rate limit, overload, auth...): no Stop comes, so ask the user to look
    # API 오류(요청 한도, 과부하, 인증 등)로 응답이 끊김: Stop 이 오지 않으니 확인하도록 입력 필요로 표시
    state wait
    ;;
  SessionEnd)
    t set -pu -t "$TMUX_PANE" @claude_state
    t set -pu -t "$TMUX_PANE" @claude_state_at
    t set -wu -t "$TMUX_PANE" @claude_state
    # Forget the mapping only on a deliberate exit; reboots and kills still resume
    # 직접 종료했을 때만 매핑 삭제 -> 재부팅/강제 종료는 재개된다
    case "$(field reason)" in
      prompt_input_exit|logout)
        t set -pu -t "$TMUX_PANE" @claude_session
        t set -pu -t "$TMUX_PANE" @claude_cwd ;;
    esac
    "$TMUX_BIN" list-clients -F '#{client_name}' 2>/dev/null | while read -r c; do t refresh-client -t "$c" -S; done
    ;;
esac
exit 0
