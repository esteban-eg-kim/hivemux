#!/usr/bin/env python3
"""Go on with a Claude Code conversation through the Claude Agent SDK while its subscription cannot be used.
구독을 쓸 수 없는 동안 Claude Code 대화를 Claude Agent SDK 로 이어 간다.

  hivemux-sdk [claude's arguments]     (bin/hivemux-claude, for an API key account) / (API 키 계정일 때)
  hivemux-sdk install                  prepare its Python (claude-agent-sdk, prompt_toolkit) / 쓸 파이썬을 준비

Some API credits (promotion credits) are for the Agent SDK and not for Claude Code itself, so Claude Code on the
key stops at "Credit balance too low". This is a small Claude Code of its own made with the Agent SDK: it runs in the
pane, takes the same arguments (--resume, --model, --effort, --append-system-prompt-file of a team role), works in
the same folder with the same tools, settings, CLAUDE.md and hooks (so the sidebar still shows its state).
The conversations pass as documents, as a diet does: it does not resume the Claude Code conversation (that would
send all of it every turn) but starts from a handoff written from its end ($XDG_DATA_HOME/hivemux/handoff/<id>.in.md:
the last requests and answers, files changed, the role's notes, the path of the whole conversation), and writes
what it does to <id>.back.md after each turn. When the subscription can be used again (the limit reset, or you chose
that account again), it waits for a quiet moment and turns back into Claude Code on the same conversation, which is
asked to read <id>.back.md first. Set the project to another API key account meanwhile and it starts again on that
key, resuming its own SDK conversation (<id>.sdk) as it was; so does a restart on the API (a reboot).
API 크레딧 중에는 (프로모션 크레딧) Claude Code 가 아니라 Agent SDK 에만 쓰이는 것이 있어서, 그 키로 Claude Code 를
쓰면 "Credit balance too low" 에서 멈춘다. 이것은 Agent SDK 로 만든 작은 Claude Code 다: 칸에서 돌고, 같은 인수
(--resume, --model, --effort, 팀 역할의 --append-system-prompt-file) 를 받고, 같은 폴더에서 같은 도구, 설정, CLAUDE.md,
훅으로 일한다 (그래서 사이드바에 상태가 그대로 보인다).
대화는 다이어트처럼 문서로 넘긴다: Claude Code 대화를 재개하지 않고 (매 턴 전체를 보내게 된다) 그 끝에서 쓴 넘김 문서
($XDG_DATA_HOME/hivemux/handoff/<id>.in.md: 최근 요청과 답, 바뀐 파일, 역할 노트, 전체 대화의 경로) 에서 시작하고, 한
일을 턴마다 <id>.back.md 에 적는다. 구독을 다시 쓸 수 있게 되면 (한도가 풀렸거나 그 계정을 다시 골랐다) 조용한 때를
기다렸다가 같은 대화의 Claude Code 로 돌아가고, Claude Code 에게 먼저 <id>.back.md 를 읽게 한다.

Environment (from bin/hivemux-claude) / 환경 (bin/hivemux-claude 가 준다):
  HIVEMUX_SDK_ACCOUNT   the account chosen for the project, at its limit now / 프로젝트에 정한 계정. 지금 한도에 걸림
  HIVEMUX_SDK_PROJECT   the project (tmux session) / 프로젝트 (tmux 세션)
"""
import base64, glob, json, os, re, shutil, subprocess, sys, time

HERE = os.path.dirname(os.path.realpath(__file__))
DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "hivemux")
VENV = os.path.join(DATA, "sdk", "venv")
HANDOFF = os.path.join(DATA, "handoff")
PKGS = ["claude-agent-sdk", "prompt_toolkit"]
os.environ["PATH"] = os.environ.get("PATH", "") + ":/opt/homebrew/bin:/usr/local/bin:" + os.path.expanduser("~/.local/bin")


LANG = []


def tr(ko, en):
    # asked of tmux once: the prompt draws on every key and every tick, and a tmux call each time made typing stutter
    # tmux 에는 한 번만 묻는다: 입력창은 키마다, 틱마다 그리는데 매번 tmux 를 불러 입력이 버벅였다
    if not LANG:
        v = os.environ.get("HIVEMUX_LANG") or tmux("show", "-gqv", "@hivemux-lang").strip()
        LANG.append((v or os.environ.get("LANG", "")).startswith("ko"))
    return ko if LANG[0] else en


def tmux(*a):
    try:
        return subprocess.run(["tmux", *a], capture_output=True, text=True, stdin=subprocess.DEVNULL).stdout
    except OSError:
        return ""


# ── its Python / 쓸 파이썬 ──

def python_for_venv():
    """A Python 3.10+ to make the venv with (the SDK needs it; macOS's own is 3.9)
    venv 를 만들 파이썬 3.10 이상 (SDK 가 요구한다. macOS 기본은 3.9)"""
    if shutil.which("uv"):
        out = subprocess.run(["uv", "python", "find", ">=3.10"], capture_output=True, text=True).stdout.strip()
        if out:
            return out
    for v in ("3.13", "3.12", "3.11", "3.10"):
        p = shutil.which(f"python{v}")
        if p:
            return p
    return None


def install():
    py = os.path.join(VENV, "bin", "python")
    if os.path.exists(py) and subprocess.run([py, "-c", "import claude_agent_sdk, prompt_toolkit"],
                                             capture_output=True).returncode == 0:
        return py
    base = python_for_venv()
    if not base:
        raise SystemExit(tr("파이썬 3.10 이상이 필요합니다: brew install python", "Needs Python 3.10 or newer: brew install python"))
    print(tr("Agent SDK 를 준비합니다 (처음 한 번)…", "Preparing the Agent SDK (once)…"), flush=True)
    os.makedirs(os.path.dirname(VENV), exist_ok=True)
    if shutil.which("uv"):
        subprocess.run(["uv", "venv", "-q", "-p", base, VENV], check=True)
        subprocess.run(["uv", "pip", "install", "-q", "-p", py, *PKGS], check=True)
    else:
        subprocess.run([base, "-m", "venv", VENV], check=True)
        subprocess.run([py, "-m", "pip", "install", "-q", *PKGS], check=True)
    return py


# ── the arguments Claude got / Claude 가 받은 인수 ──

VALUE_FLAGS = {"--resume", "-r", "--model", "--effort", "--append-system-prompt-file", "--append-system-prompt",
               "--permission-mode", "--settings", "--session-id", "--allowed-tools", "--allowedTools",
               "--disallowed-tools", "--disallowedTools", "--add-dir", "--mcp-config", "--name", "-n", "--agent",
               "--fallback-model", "--plugin-dir", "--system-prompt", "--system-prompt-file"}


def parse(argv):
    """({flag: value}, [boolean flags], prompt or None) / ({플래그: 값}, [값 없는 플래그], 프롬프트 또는 None)"""
    vals, bools, rest, i = {}, [], [], 0
    while i < len(argv):
        a = argv[i]
        if "=" in a and a.split("=", 1)[0] in VALUE_FLAGS:
            k, v = a.split("=", 1)
            vals[k] = v
        elif a in VALUE_FLAGS and i + 1 < len(argv):
            vals[a] = argv[i + 1]
            i += 1
        elif a.startswith("-"):
            bools.append(a)
        else:
            rest.append(a)
        i += 1
    return vals, bools, (rest[-1] if rest else None)


# ── documents / 문서 ──

def transcript_of(sid):
    for base in {os.path.expanduser("~/.claude"), os.environ.get("CLAUDE_CONFIG_DIR") or ""}:
        if base:
            hits = glob.glob(os.path.join(base, "projects", "*", f"{sid}.jsonl"))
            if hits:
                return hits[0]
    return ""


def clip(s, n):
    s = s.strip()
    return s if len(s) <= n else s[:n] + " …"


def texts(content):
    if isinstance(content, str):
        return [content]
    return [b.get("text", "") for b in content or [] if isinstance(b, dict) and b.get("type") == "text"]


def handoff_in(sid, cwd, pane):
    """Write the handoff from the end of the Claude Code conversation; returns its path
    Claude Code 대화의 끝에서 넘김 문서를 쓴다. 그 경로를 돌려준다"""
    path = transcript_of(sid) if sid else ""
    asks, answers, files, cmds, summary = [], [], [], [], ""
    if path:
        with open(path, errors="ignore") as f:
            for ln in f:
                try:
                    e = json.loads(ln)
                except ValueError:
                    continue
                m = e.get("message") or {}
                if e.get("isCompactSummary"):
                    summary = " ".join(texts(m.get("content")))
                    continue
                if e.get("type") == "user" and not e.get("isMeta"):
                    t = " ".join(texts(m.get("content"))).strip()
                    if t and not t.startswith("<"):
                        asks.append(t)
                elif e.get("type") == "assistant" and not e.get("isApiErrorMessage"):
                    for b in m.get("content") or []:
                        if not isinstance(b, dict):
                            continue
                        if b.get("type") == "text" and b.get("text", "").strip():
                            answers.append(b["text"])
                        elif b.get("type") == "tool_use":
                            inp = b.get("input") or {}
                            if b.get("name") in ("Edit", "Write", "MultiEdit", "NotebookEdit") and inp.get("file_path"):
                                files.append(inp["file_path"])
                            elif b.get("name") == "Bash" and inp.get("command"):
                                cmds.append(inp["command"])
    out = [f"# Handoff from Claude Code ({sid or 'new'})", "",
           f"- Folder: {cwd}", f"- Written: {time.strftime('%Y-%m-%d %H:%M')}"]
    if path:
        out.append(f"- The whole conversation: {path} (JSONL, one event a line; read its end with tail or grep when "
                   "you need more detail than this)")
    tdir = tmux("show", "-pqv", "-t", pane, "@hivemux-teamdir").strip() if pane else ""
    role = tmux("show", "-pqv", "-t", pane, "@hivemux-role").strip() if pane else ""
    if tdir and role and os.path.exists(os.path.join(tdir, "notes", f"{role}.md")):
        out.append(f"- This is the team role '{role}'; its notes: {os.path.join(tdir, 'notes', role + '.md')}")
    back = os.path.join(HANDOFF, f"{sid}.back.md")
    if sid and os.path.exists(back):
        out.append(f"- Work already done through the API since the stop: {back}")
    if summary:
        out += ["", "## The summary at its last compaction", "", clip(summary, 6000)]
    if asks:
        out += ["", "## The last requests (oldest first)", ""] + [f"- {clip(a, 1500)}" for a in asks[-10:]]
    if answers:
        out += ["", "## The last answers (oldest first)", ""] + [clip(a, 2500) + "\n\n---" for a in answers[-6:]]
    if files:
        seen = list(dict.fromkeys(reversed(files)))[:30]
        out += ["", "## Files it changed lately (newest first)", ""] + [f"- {p}" for p in seen]
    if cmds:
        out += ["", "## Its last commands", ""] + [f"- `{clip(c.splitlines()[0], 200)}`" for c in cmds[-8:]]
    os.makedirs(HANDOFF, exist_ok=True)
    doc = os.path.join(HANDOFF, f"{sid or 'new-' + str(int(time.time()))}.in.md")
    with open(doc, "w") as f:
        f.write("\n".join(out) + "\n")
    return doc


def title_of(sid, pane):
    """The conversation's name: its last /rename, else the title Claude Code gave it (bin/hivemux-hook)
    대화 이름: 마지막 /rename, 없으면 Claude Code 가 붙인 제목 (bin/hivemux-hook)"""
    path, name = transcript_of(sid) if sid else "", ""
    if path:
        with open(path, errors="ignore") as f:
            for ln in f:
                if '"custom-title"' in ln:
                    try:
                        name = json.loads(ln).get("customTitle") or name
                    except ValueError:
                        pass
    return name or (tmux("show", "-pqv", "-t", pane, "@claude_title").strip() if pane else "")


def set_title(name):
    """The pane's title, as Claude Code keeps it: the sidebar names the card by it, and the shell left the command
    line there / Claude Code 처럼 칸 제목을 둔다: 사이드바가 그것으로 카드 이름을 정하고, 셸은 명령 줄을 남겨 두었다"""
    if name:
        sys.stdout.write(f"\x1b]2;{name}\x07")
        sys.stdout.flush()


def note_back(sid, ask, answer, cost):
    """After each turn: what was asked and what came of it / 턴마다: 무엇을 부탁받았고 어떻게 됐는지"""
    if not sid:
        return
    os.makedirs(HANDOFF, exist_ok=True)
    path = os.path.join(HANDOFF, f"{sid}.back.md")
    new = not os.path.exists(path)
    with open(path, "a") as f:
        if new:
            f.write(f"# Work done through the API (Agent SDK) while Claude Code was stopped ({sid})\n")
        f.write(f"\n## {time.strftime('%Y-%m-%d %H:%M')}\n\n**Asked:** {clip(ask, 3000)}\n\n"
                f"**Result:** {clip(answer, 6000) or '(no text)'}\n")


# ── back to Claude Code / Claude Code 로 돌아가기 ──

def account_module():
    import importlib.machinery, importlib.util
    loader = importlib.machinery.SourceFileLoader("hivemux_account", os.path.join(HERE, "hivemux-account"))
    spec = importlib.util.spec_from_loader("hivemux_account", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def can_go_back():
    """The subscription chosen for this project can be used again: not at its limit, or no fallback any more
    이 프로젝트에 정한 구독을 다시 쓸 수 있다: 한도가 풀렸거나, 이어 갈 계정 설정이 없어졌다"""
    acc, proj = os.environ.get("HIVEMUX_SDK_ACCOUNT", ""), os.environ.get("HIVEMUX_SDK_PROJECT") or None
    try:
        a = account_module()
    except Exception:
        return False
    if not acc or a.api_key(acc):          # chosen as the account itself: nowhere to go back / 이 계정 자체를 골랐다
        return False
    return a.effective(acc, None, proj) == acc


def sdk_file(sid):
    """<id>.sdk: the SDK conversation going on for the Claude Code conversation <id>. A restart on an API key (another
    key, a reboot) resumes it instead of a new handoff, so nothing of it is lost; going back to Claude Code ends it
    <id>.sdk: Claude Code 대화 <id> 를 이어 가는 SDK 대화. API 키로 다시 시작하면 (다른 키, 재부팅) 새 넘김 문서 대신
    그것을 재개해 아무것도 잃지 않는다. Claude Code 로 돌아가면 끝난다"""
    return os.path.join(HANDOFF, f"{sid}.sdk")


def sdk_session(sid):
    try:
        v = open(sdk_file(sid)).read().strip()
    except OSError:
        return ""
    return v if v and transcript_of(v) else ""


def wanted_key():
    """The API key account this project should go on with now ("" = none) / 이 프로젝트가 지금 이어 갈 API 키 계정"""
    acc, proj = os.environ.get("HIVEMUX_SDK_ACCOUNT", ""), os.environ.get("HIVEMUX_SDK_PROJECT") or None
    try:
        a = account_module()
    except Exception:
        return ""
    w = a.effective(acc, None, proj) if acc else ""
    return w if w and a.api_key(w) else ""


def clean_env():
    for k in ("HIVEMUX_SDK", "HIVEMUX_SDK_ACCOUNT", "HIVEMUX_SDK_PROJECT", "HIVEMUX_SDK_FOR", "HIVEMUX_SDK_IN_VENV",
              "HIVEMUX_SDK_KEY_ACCOUNT", "ANTHROPIC_API_KEY"):
        os.environ.pop(k, None)


def switch(argv):
    """Start again through bin/hivemux-claude on the key the project goes on with now; the SDK conversation is
    resumed there (sdk_file) / 프로젝트가 지금 이어 갈 키로 bin/hivemux-claude 를 거쳐 다시 시작한다. 거기서 SDK 대화를
    재개한다 (sdk_file)"""
    clean_env()
    hc = os.path.join(HERE, "hivemux-claude")
    os.execv(hc, [hc, *argv])


def go_back(sid, argv):
    """exec Claude Code on the conversation, asked to read what was done meanwhile
    그 대화의 Claude Code 를 exec 한다. 그 사이 한 일을 먼저 읽게 한다"""
    vals, bools, _ = parse(argv)
    args = []
    for k, v in vals.items():
        if k not in ("--resume", "-r"):
            args += [k, v]
    args += [b for b in bools if b not in ("--continue", "-c")]
    if sid:
        args += ["--resume", sid]
        # still running in Claude Code's daemon, the resume would be refused (bin/hivemux-claude-update resume)
        # Claude Code 데몬에서 아직 돌면 재개가 거절된다 (bin/hivemux-claude-update resume)
        subprocess.run(["pkill", "-TERM", "-f", "--", f"--session-id {sid} "], capture_output=True)
        back = os.path.join(HANDOFF, f"{sid}.back.md")
        if os.path.exists(back):
            kept = os.path.join(HANDOFF, f"{sid}.back-{time.strftime('%Y%m%d-%H%M%S')}.md")
            os.replace(back, kept)
            args.append(tr(f"이 대화가 구독을 쓸 수 없어 멈춘 동안 API (Agent SDK) 로 일을 이어 했습니다. 한 일은 {kept} 에 있습니다. "
                           "먼저 읽고 지금 상태를 짧게 알려 준 뒤 이어 가 주세요.",
                           f"While this conversation was stopped (its subscription could not be used), the work went on "
                           f"through the API (Agent SDK). What was done is in {kept}. Read it first, tell me briefly where "
                           "things stand, then go on."))
        try:
            os.unlink(sdk_file(sid))
        except OSError:
            pass
    clean_env()
    hc = os.path.join(HERE, "hivemux-claude")
    os.execv(hc, [hc, *args])


# ── diet / 다이어트 ──
# Through the API every turn sends the whole conversation again and is paid for, so a large one costs more each
# turn. As a team role's diet (bin/hivemux-team), done here without typing into a prompt: past the line, once the
# user has seen the answer, it brings its notes up to date and starts a fresh SDK conversation from them. A team
# role keeps its team's line, notes and diet.log; another Claude has a line of its own (@hivemux-sdk-diet, thousands
# of tokens, 150 by default, off to turn it off), notes in handoff/<id>.notes.md and the log sdk/diet.log
# API 로는 턴마다 대화 전체를 다시 보내고 그만큼 돈을 내서, 대화가 크면 턴마다 더 든다. 팀 역할의 다이어트
# (bin/hivemux-team) 처럼 하되, 입력창에 치지 않고 여기서 한다: 기준을 넘고 사용자가 답을 본 뒤, 노트를 최신으로
# 정리하고 그 노트로 새 SDK 대화를 시작한다. 팀 역할은 팀의 기준, 노트, diet.log 를 쓴다. 다른 Claude 는 따로
# 기준 (@hivemux-sdk-diet, 천 토큰, 기본 150, off 로 끔), 노트 handoff/<id>.notes.md, 기록 sdk/diet.log 를 쓴다

SDK_DIET_AT = 150
TEAM = []


def team_module():
    if not TEAM:
        import importlib.machinery, importlib.util
        loader = importlib.machinery.SourceFileLoader("hivemux_team", os.path.join(HERE, "hivemux-team"))
        spec = importlib.util.spec_from_loader("hivemux_team", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        TEAM.append(mod)
    return TEAM[0]


def diet_plan(pane, sid):
    """{line, notes, log(before, after)}, or None when off / 기준, 노트, 기록. 끄면 None"""
    try:
        t = team_module()
        found = t.role_of(pane) if pane else None
    except Exception:
        t, found = None, None
    if found:
        session, folder, team, role = found
        if role["diet"]["how"] == "off":
            return None
        return {"line": t.diet_line(folder, role), "notes": t.notes_path(folder, role["id"]),
                "log": lambda b, a: t.diet_log(folder, role["id"], "sdk", b, a)}
    at = tmux("show", "-gqv", "@hivemux-sdk-diet").strip() or str(SDK_DIET_AT)
    if not at.isdigit():
        return None
    line, log = int(at) * 1000, os.path.join(DATA, "sdk", "diet.log")
    # right after a diet the line moves up, as a team role's (bin/hivemux-team diet_line)
    # 다이어트 직후에는 팀 역할처럼 기준을 올린다 (bin/hivemux-team diet_line)
    try:
        last = [l.rstrip("\n").split("\t") for l in open(log) if l.split("\t")[1:2] == [sid]][-1]
        if time.time() - int(last[0]) < 3 * 3600:
            line = max(line, int(last[4]) + 50_000)
        if time.time() - int(last[0]) < 20 * 60:
            line = max(line, int(at) * 1500)
    except (OSError, IndexError, ValueError):
        pass

    def write(b, a):
        os.makedirs(os.path.dirname(log), exist_ok=True)
        with open(log, "a") as f:
            f.write(f"{int(time.time())}\t{sid}\tsdk\t{b}\t{a}\n")

    return {"line": line, "notes": os.path.join(HANDOFF, f"{sid or 'new'}.notes.md"), "log": write}


def usage_tokens(u):
    """Context at an answer: what the next request reads again / 답할 때의 컨텍스트: 다음 요청이 다시 읽는 양"""
    if not isinstance(u, dict):
        return 0
    return sum(int(u.get(k) or 0) for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens", "output_tokens"))


# ── images / 이미지 ──

IMAGES = os.path.join(DATA, "sdk", "images")
IMAGE_EXT = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif", ".webp": "image/webp"}


def clipboard_image():
    """The clipboard's image saved as a PNG (at most 2000 px a side), or "" / 클립보드 이미지를 PNG 로 저장 (긴 변 2000px 이하)"""
    os.makedirs(IMAGES, exist_ok=True)
    path = os.path.join(IMAGES, time.strftime("%Y%m%d-%H%M%S-") + str(os.getpid()) + ".png")
    script = ['try', 'set d to the clipboard as «class PNGf»',
              f'set f to open for access POSIX file "{path}" with write permission', 'set eof f to 0', 'write d to f',
              'close access f', 'on error', 'return "none"', 'end try']
    r = subprocess.run(["osascript"] + sum([["-e", x] for x in script], []), capture_output=True, text=True)
    if r.stdout.strip() == "none" or not os.path.exists(path) or os.path.getsize(path) == 0:
        try:
            os.unlink(path)
        except OSError:
            pass
        return ""
    subprocess.run(["sips", "--resampleHeightWidthMax", "2000", path], capture_output=True)
    return path


def image_paths(text):
    """Image files named in the text (dragged into the terminal, or pasted paths) / 글에 적힌 이미지 파일 (끌어다 놓았거나 붙여 넣은 경로)"""
    out = []
    for tok in re.findall(r"'[^']+'|\"[^\"]+\"|(?:\\ |\S)+", text):
        p = tok.strip("'\"").replace("\\ ", " ")
        p = os.path.expanduser(p)
        if os.path.splitext(p)[1].lower() in IMAGE_EXT and os.path.isfile(p):
            out.append(p)
    return out


def with_images(text, pasted):
    """The message: the text alone, or content blocks with the images it names ([Image #n] pasted, or file paths)
    메시지: 글만, 또는 글이 가리키는 이미지 ([Image #n] 으로 붙인 것, 또는 파일 경로) 를 담은 블록"""
    files = [pasted[n] for n in sorted(pasted) if f"[Image #{n}]" in text] + image_paths(text)
    if not files:
        return text
    blocks = [{"type": "text", "text": text}]
    for f in files:
        try:
            data = base64.b64encode(open(f, "rb").read()).decode()
        except OSError:
            continue
        blocks.append({"type": "image", "source": {"type": "base64", "media_type": IMAGE_EXT.get(
            os.path.splitext(f)[1].lower(), "image/png"), "data": data}})

    async def one():
        yield {"type": "user", "message": {"role": "user", "content": blocks}, "parent_tool_use_id": None}

    return one()


# ── the session / 세션 ──

DIM, BOLD, RST, GREEN, BLUE, RED, GRAY = "\x1b[2m", "\x1b[1m", "\x1b[0m", "\x1b[32m", "\x1b[34m", "\x1b[31m", "\x1b[90m"
SPIN = "✻✶✳✢·✢✳✶"


def short(inp):
    for k in ("command", "file_path", "pattern", "path", "url", "query", "description", "prompt"):
        if isinstance(inp, dict) and inp.get(k):
            return clip(str(inp[k]).splitlines()[0], 100)
    return ""


def commands():
    """The slash commands it answers itself; others go to the SDK as they are (/compact...)
    스스로 답하는 슬래시 명령. 나머지는 그대로 SDK 로 간다 (/compact...)"""
    return {
        "/help": tr("명령 보기", "show the commands"),
        "/clear": tr("새 대화로 (넘김 문서 없이)", "a new conversation (without the handoff)"),
        "/model": tr("모델 바꾸기: /model opus|sonnet|haiku", "change the model: /model opus|sonnet|haiku"),
        "/effort": tr("생각하는 정도: /effort low|medium|high|xhigh|max", "how hard it thinks: /effort low|medium|high|xhigh|max"),
        "/cost": tr("이 화면에서 쓴 비용", "what this screen has cost"),
        "/back": tr("지금 Claude Code 로 돌아가기", "go back to Claude Code now"),
        "/compact": tr("대화를 줄이기 (SDK 가 한다)", "compact the conversation (the SDK does it)"),
        "/exit": tr("끝내기 (칸은 셸로)", "quit (the pane goes back to its shell)"),
    }


class Pinned:
    """The prompt pinned to the bottom rows, as in Claude Code: the rows above are the terminal's scroll region, and
    the answer is written at its bottom so it scrolls there (into tmux's history as well), with the cursor saved and
    put back, so the prompt is never erased and drawn again. Printing above the prompt redrew it on every line, and
    the prompt shook while the answer came
    입력창을 Claude Code 처럼 아래 줄에 고정한다: 위쪽 줄은 터미널의 스크롤 영역이고, 답은 그 맨 아래에 써서 거기서
    올라간다 (tmux 기록에도 남는다). 커서는 저장했다 되돌려서 입력창은 지웠다 다시 그리지 않는다. 입력창 위에 찍으면
    줄마다 입력창을 다시 그려, 답이 오는 동안 입력창이 흔들렸다"""
    N = 7            # spinner, rule, three lines of input, rule, status / 스피너, 선, 입력 세 줄, 선, 상태줄

    def __init__(self):
        self.rows, self.on = 0, False

    @staticmethod
    def lines():
        return shutil.get_terminal_size((100, 30)).lines

    def place(self):
        """The region above the pinned rows, and the cursor where the prompt starts / 고정한 줄 위의 영역과 입력창 시작 위치"""
        self.rows = self.lines()
        sys.__stdout__.write(f"\x1b[1;{self.rows - self.N}r\x1b[{self.rows - self.N + 1};1H\x1b[J")
        sys.__stdout__.flush()

    def __enter__(self):
        if sys.__stdout__.isatty():
            # extended keys (modifyOtherKeys 1), as Claude Code asks for: tmux then tells Shift+Enter from Enter
            # 확장 키 (modifyOtherKeys 1). Claude Code 처럼 요청한다: 그래야 tmux 가 Shift+Enter 를 Enter 와 구별해 보낸다
            sys.__stdout__.write("\x1b[>4;1m")
            sys.__stdout__.write("\n" * self.N)        # room under what is on the screen / 화면에 있는 것 아래 자리
            self.place()
            self.on = True
        return self

    def __exit__(self, *exc):
        if self.on:
            self.on = False
            sys.__stdout__.write(f"\x1b[>4m\x1b[r\x1b[{self.lines()};1H\r\n")
            sys.__stdout__.flush()

    def out(self, text=""):
        if not self.on:
            print(text, flush=True)
            return
        rows = "".join("\r\n" + ln + RST for ln in str(text).split("\n"))
        sys.__stdout__.write(f"\x1b7\x1b[{self.rows - self.N};1H{rows}\x1b8")
        sys.__stdout__.flush()

    def follow(self, app):
        """A resize: erase the prompt, place the region and the prompt again, draw it there
        크기가 바뀜: 입력창을 지우고 영역과 입력창을 다시 놓고 거기에 그린다"""
        orig = app._on_resize

        def on_resize():
            if not self.on:
                return orig()
            app.renderer.erase(leave_alternate_screen=False)
            self.place()
            app.renderer.reset()
            app._redraw()

        app._on_resize = on_resize


async def run(argv):
    import anyio, asyncio
    from claude_agent_sdk import (ClaudeAgentOptions, ClaudeSDKClient, AssistantMessage, ResultMessage, TextBlock,
                                  ToolUseBlock, UserMessage, ToolResultBlock)
    from prompt_toolkit import PromptSession
    from prompt_toolkit.completion import WordCompleter
    from prompt_toolkit.formatted_text import ANSI
    from prompt_toolkit.history import FileHistory
    from prompt_toolkit.key_binding import KeyBindings

    vals, bools, prompt = parse(argv)
    sid = vals.get("--resume") or vals.get("-r") or ""
    pane = os.environ.get("TMUX_PANE", "")
    cwd = os.getcwd()
    model = [vals.get("--model") or ""]
    effort = [vals.get("--effort") or ""]
    append = vals.get("--append-system-prompt", "")
    if vals.get("--append-system-prompt-file"):
        try:
            append = (append + "\n\n" + open(vals["--append-system-prompt-file"]).read()).strip()
        except OSError:
            pass
    # the hooks keep the Claude Code conversation on the pane, so a resume and the way back find it (bin/hivemux-hook)
    # 훅이 칸에 Claude Code 대화를 그대로 둔다. 재개와 돌아가기가 그것을 찾는다 (bin/hivemux-hook)
    os.environ["HIVEMUX_SDK"], os.environ["HIVEMUX_SDK_FOR"] = "1", sid

    key = os.environ.get("HIVEMUX_SDK_KEY_ACCOUNT", "")
    resume = [sdk_session(sid) if sid else ""]

    # the name other sessions message it by: a team role's "<project>-<role>" (its teammates use it), else the
    # conversation's; without it the SDK session took a made-up one ("ohmyhome-d1") and the team lost each other
    # 다른 세션이 메시지를 보낼 이름: 팀 역할은 "<프로젝트>-<역할>" (팀원이 그 이름을 쓴다), 아니면 대화 이름. 없으면
    # SDK 세션이 지어낸 이름 ("ohmyhome-d1") 을 받아 팀원끼리 서로 찾지 못했다
    role = tmux("show", "-pqv", "-t", pane, "@hivemux-role").strip() if pane else ""
    proj = tmux("display", "-p", "-t", pane, "#{session_name}").strip() if pane else ""
    peer = f"{proj}-{role}" if role and proj else title_of(sid, pane)

    def options():
        r, resume[0] = resume[0], ""
        return ClaudeAgentOptions(resume=r or None, extra_args={"name": peer} if peer else {},
            cwd=cwd, model=model[0] or None, effort=effort[0] or None,
            permission_mode=vals.get("--permission-mode") or "auto",
            system_prompt={"type": "preset", "preset": "claude_code", **({"append": append} if append else {})},
            setting_sources=["user", "project", "local"],
            env={"HIVEMUX_SDK": "1", "HIVEMUX_SDK_FOR": sid},
            # a big tool result (a file, an image) is one JSON line over the 1MB default
            # 큰 도구 결과 (파일, 이미지) 는 한 줄이 기본 1MB 를 넘는다
            max_buffer_size=256 * 1024 * 1024,
            # its notices go above the prompt, not over it / 알림은 입력창 위로. 입력창 위에 덮어쓰지 않게
            stderr=lambda line: pin.out(f"{GRAY}{line.rstrip()}{RST}"),
        )

    doc = handoff_in(sid, cwd, pane) if sid and not resume[0] else ""
    # the one the limit cut off goes on at once; the others wait for you (bin/hivemux-account at_limit)
    # 한도로 끊긴 것은 바로 이어 가고, 나머지는 입력을 기다린다 (bin/hivemux-account at_limit)
    go_on = bool(pane and tmux("show", "-pqv", "-t", pane, "@hivemux-continue").strip())
    if go_on:
        tmux("set", "-pu", "-t", pane, "@hivemux-continue")
    intro = (f"This session goes on with a Claude Code conversation that stopped because its subscription could not be "
             f"used (a usage limit or a billing problem). First read the handoff {doc}: it has the recent requests and "
             f"answers, the files changed and the path of the whole conversation. Then work as that conversation did, "
             f"in the user's language.") if doc else ""
    title = title_of(sid, pane)
    set_title(title)
    print(f"{BOLD}hivemux{RST} {GRAY}· API (Agent SDK) · "
          + tr("구독을 다시 쓸 수 있으면 Claude Code 로 돌아갑니다", "goes back to Claude Code when the subscription can be used")
          + RST)
    if resume[0]:
        print(GRAY + tr(f"API 로 하던 대화를 이어 갑니다{f' (키: {key})' if key else ''}",
                        f"Going on with the API conversation{f' (key: {key})' if key else ''}") + RST)
    elif doc:
        print(GRAY + tr(f"넘김 문서: {doc}", f"Handoff: {doc}") + RST)

    os.makedirs(os.path.join(DATA, "sdk"), exist_ok=True)
    # the prompt stays while it works, as in Claude Code: what you send then goes into the work under way (the SDK
    # takes it in at its next step); the answer prints above the prompt
    # 일하는 동안에도 입력창이 있다 (Claude Code 처럼): 그때 보낸 것은 하던 일에 들어간다 (SDK 가 다음 걸음에 받는다).
    # 답은 입력창 위에 찍힌다
    st = {"total": 0.0, "first": bool(intro), "busy": False, "t0": 0.0, "doing": "", "back": False, "done": False,
          "switch": False, "img": 0, "pasted": {}, "ctx": 0, "ctx_first": 0, "diet": "", "diet_before": 0,
          "diet_start": False, "next": None,
          "clear": False, "asked": [], "shown": [], "i": 0, "client": None}

    keys = KeyBindings()

    @keys.add("enter")
    def _(event):
        # Enter sends; a line ending in \ goes on to the next, as in Claude Code. With the completion menu open it
        # takes the command picked ("/eff" went to Claude as it was)
        # Enter 는 보낸다. \ 로 끝나면 줄바꿈. 자동완성 메뉴가 열려 있으면 고른 명령을 넣는다 ("/eff" 가 그대로 Claude 에게 갔다)
        b = event.current_buffer
        if b.complete_state:
            c = b.complete_state.current_completion or (b.complete_state.completions or [None])[0]
            if c:
                b.apply_completion(c)
                return
        if b.document.text_before_cursor.endswith("\\"):
            b.delete_before_cursor(1)
            b.insert_text("\n")
        else:
            b.validate_and_handle()

    @keys.add("c-v")
    def _(event):
        # Ctrl+V pastes the clipboard's image as [Image #n], as in Claude Code (Cmd+V still pastes text)
        # Ctrl+V 는 클립보드 이미지를 [Image #n] 으로 붙인다 (Claude Code 처럼. Cmd+V 는 글을 붙인다)
        path = clipboard_image()
        if not path:
            out(GRAY + tr("  클립보드에 이미지가 없습니다 (글은 Cmd+V)", "  No image on the clipboard (text: Cmd+V)") + RST)
            return
        st["img"] += 1
        st["pasted"][st["img"]] = path
        event.current_buffer.insert_text(f"[Image #{st['img']}]")

    @keys.add("backspace")
    def _(event):
        # an [Image #n] goes in one press, as in Claude Code / [Image #n] 은 Claude Code 처럼 한 번에 지운다
        b = event.current_buffer
        m = re.search(r"\[Image #\d+\]$", b.document.text_before_cursor)
        b.delete_before_cursor(len(m.group(0)) if m else 1)

    @keys.add("delete")
    def _(event):
        b = event.current_buffer
        m = re.match(r"\[Image #\d+\]", b.document.text_after_cursor)
        b.delete(len(m.group(0)) if m else 1)

    # Shift+Enter as tmux sends it with extended keys (xterm's and the CSI u form) is a new line
    # 확장 키로 tmux 가 보내는 Shift+Enter (xterm 형식과 CSI u 형식) 는 줄바꿈
    from prompt_toolkit.input.ansi_escape_sequences import ANSI_SEQUENCES
    from prompt_toolkit.keys import Keys
    for seq in ("\x1b[27;2;13~", "\x1b[13;2u"):
        ANSI_SEQUENCES[seq] = Keys.ControlJ

    @keys.add("escape", "enter")
    @keys.add("c-j")
    def _(event):
        event.current_buffer.insert_text("\n")

    @keys.add("escape")
    def _(event):
        # Esc stops the work under way; with nothing under way it clears the line / Esc 는 하던 일을 멈춘다. 없으면 줄을 지운다
        if st["busy"] and st["client"]:
            asyncio.ensure_future(st["client"].interrupt())
            out(f"{GRAY}  ⎿ {tr('멈췄습니다', 'Stopped')}{RST}")
        else:
            event.current_buffer.reset()

    @keys.add("c-c")
    def _(event):
        if st["busy"] and st["client"] and not event.current_buffer.text:
            asyncio.ensure_future(st["client"].interrupt())
            out(f"{GRAY}  ⎿ {tr('멈췄습니다', 'Stopped')}{RST}")
        else:
            event.current_buffer.reset()

    def toolbar():
        st_ = (f" API · Agent SDK · {model[0] or tr('기본 모델', 'default model')} · effort {effort[0] or tr('기본', 'default')}"
               f" · {st['ctx'] // 1000}K · ${st['total']:.2f} · auto")
        w = shutil.get_terminal_size((100, 20)).columns
        return ANSI(f"{GRAY}{'─' * w}\n{st_}   " + tr("Shift+Enter 줄바꿈 · Ctrl+V 이미지 · / 명령 · Esc 멈추기",
                                                       "Shift+Enter new line · Ctrl+V image · / commands · Esc stop") + RST)

    def message():
        w = shutil.get_terminal_size((100, 20)).columns
        # the prompt fills the pinned rows: blank lines on top for what the input does not take
        # 입력창이 고정한 줄을 채운다: 입력이 쓰지 않는 만큼 위에 빈 줄
        n = min(session.default_buffer.document.line_count, Pinned.N - 4)
        top = "\n" * max(0, Pinned.N - 4 - n)
        if not st["busy"]:
            top += "\n"
        else:
            st["i"] += 1
            secs = int(time.time() - st["t0"])
            top += (f"{GREEN}{SPIN[st['i'] % len(SPIN)]}{RST} {st['doing'] or tr('일하는 중…', 'Working…')}{GRAY} ({secs}s · "
                   + tr("Esc 멈추기 · 입력하면 하던 일에 더합니다", "Esc to stop · what you type joins the work") + f"){RST}\n")
        return ANSI(f"{top}{GRAY}{'─' * w}{RST}\n{BOLD}❯{RST} ")

    # erased when sent: the line is printed once above, without the spinner and the rules of the prompt
    # 보내면 지운다: 그 줄은 위에 한 번만 찍는다. 입력창의 스피너와 선 없이
    # ours, then the SDK's own (its slash commands, skills, the project's commands), read when it connects
    # 우리 것, 그다음 SDK 의 것 (슬래시 명령, 스킬, 프로젝트 명령). 연결할 때 읽는다
    words, sdk_cmds = [list(commands())], set()
    pin = Pinned()
    out = pin.out
    session = PromptSession(multiline=True, key_bindings=keys, bottom_toolbar=toolbar, refresh_interval=0.3,
                            erase_when_done=True,
                            history=FileHistory(os.path.join(DATA, "sdk", "history")),
                            completer=WordCompleter(lambda: words[0], sentence=True), complete_while_typing=True,
                            prompt_continuation=lambda width, n, soft: "  ")

    def wrap(text):
        if st["first"]:
            st["first"] = False
            return f"{intro}\n\n{text}"
        return text

    async def send(client, text):
        if st["busy"]:
            out(f"{GRAY}  ⎿ {tr('하던 일에 더했습니다', 'Added to the work under way')}{RST}")
        else:
            st["busy"], st["t0"], st["doing"] = True, time.time(), ""
        st["asked"].append(text)
        await client.query(with_images(wrap(text), st["pasted"]))

    async def reader(client):
        try:
            await read_all(client)
        except Exception as e:
            # the stream broke: connect again on the same conversation, not die
            # 흐름이 끊겼다: 죽지 않고 같은 대화로 다시 연결한다
            out(RED + tr(f"  연결이 끊겼습니다 ({clip(str(e), 120)}). 같은 대화로 다시 연결합니다…",
                         f"  The connection broke ({clip(str(e), 120)}). Connecting again on the same conversation…") + RST)
            resume[0] = st.get("sdk_sid") or sdk_session(sid)
            if st["busy"] and not st["next"]:
                st["next"] = tr("연결이 끊겨 마지막 답을 받지 못했습니다. 하던 일이 남았으면 이어서 하고, 끝났으면 그 답을 짧게 다시 알려 주세요.",
                                  "The connection broke before your last answer reached me. Go on if work is left; if it was done, give that answer again in short.")
            st["clear"] = True
            if session.app.is_running:
                session.app.exit(result="")

    async def read_all(client):
        async for m in client.receive_messages():
            # keep the conversation from its first message, so a break mid-turn still resumes it
            # 첫 메시지부터 대화를 잡아 둔다. 턴 중간에 끊겨도 이어 간다
            st["sdk_sid"] = getattr(m, "session_id", None) or (getattr(m, "data", None) or {}).get("session_id") or st.get("sdk_sid", "")
            if isinstance(m, AssistantMessage) and not st["busy"]:
                # what was sent during the last turn (after Esc, say) runs as a turn of its own
                # 지난 턴 동안 보낸 것 (Esc 뒤 등) 은 따로 한 턴으로 돈다
                st["busy"], st["t0"], st["doing"] = True, time.time(), ""
            if isinstance(m, AssistantMessage) and not getattr(m, "parent_tool_use_id", None):
                n = usage_tokens(getattr(m, "usage", None))
                if n:
                    st["ctx"] = n
                    st["ctx_first"] = st["ctx_first"] or n
            if isinstance(m, AssistantMessage):
                for b in m.content:
                    if isinstance(b, TextBlock) and b.text.strip():
                        out(f"\n{GREEN}⏺{RST} {b.text.strip()}")
                        st["shown"].append(b.text.strip())
                    elif isinstance(b, ToolUseBlock):
                        out(f"{BLUE}⏺{RST} {BOLD}{b.name}{RST}{GRAY}({short(b.input)}){RST}")
                        st["doing"] = tr(f"{b.name} 실행 중…", f"Running {b.name}…")
            elif isinstance(m, UserMessage) and isinstance(m.content, list):
                for b in m.content:
                    if isinstance(b, ToolResultBlock):
                        body = b.content if isinstance(b.content, str) else json.dumps(b.content, ensure_ascii=False)
                        line = (body or "").strip().splitlines()[0] if (body or "").strip() else ""
                        out(f"  {RED if b.is_error else GRAY}⎿ {clip(line, 160)}{RST}")
                st["doing"] = ""
            elif isinstance(m, ResultMessage):
                cost = m.total_cost_usd or 0.0
                st["total"] += cost
                out(f"{GRAY}✻ {tr('끝', 'done')} · {int(time.time() - st['t0'])}s · ${cost:.3f}{RST}")
                note_back(sid, "\n\n".join(st["asked"]), "\n\n".join(st["shown"][-2:]), cost)
                st["sdk_sid"] = m.session_id or st.get("sdk_sid", "")
                if sid and m.session_id:
                    with open(sdk_file(sid), "w") as f:
                        f.write(m.session_id + "\n")
                last = st["shown"][-1] if st["shown"] else ""
                st["busy"], st["asked"], st["shown"] = False, [], []
                set_title(title)            # a tool may have set another / 도구가 다른 것으로 바꿨을 수 있다
                after_turn(last)

    def after_turn(last):
        """The context size on the pane (the sidebar's bar) and the diet's next step / 칸에 컨텍스트 크기, 다이어트 다음 걸음"""
        if pane and st["ctx"]:
            tmux("set", "-p", "-t", pane, "@claude_ctx", str(st["ctx"]))
            tmux("set", "-p", "-t", pane, "@claude_ctx_at", str(int(time.time())))
        if st["diet"] == "notes":       # notes written: start fresh / 노트를 썼다: 새로 시작
            st["diet"], st["clear"] = "fresh", True
            if session.app.is_running:
                session.app.exit(result="")
            return
        if st["diet"] == "after":       # the first answer after it: how small it got / 그 뒤 첫 답: 얼마나 줄었나
            plan = diet_plan(pane, sid)
            if plan:
                plan["log"](st["diet_before"], st["ctx_first"] or st["ctx"])
            try:
                os.unlink(os.path.join(HANDOFF, f"{sid or 'new'}.last.md"))
            except OSError:
                pass
            st["diet"] = ""
            return
        plan = diet_plan(pane, sid)
        if st["diet"] or not plan or st["ctx"] < plan["line"]:
            return
        try:
            t = team_module()
            asks, held = t.asks_user(last), t.watched(pane) if pane else False
        except Exception:
            asks, held = False, False
        # an answer that asks the user something waits for the answer; a window being read waits until they look
        # away, unless past half again the line: then the last answer is shown again after the fresh start
        # 사용자에게 묻는 답은 답을 기다린다. 읽는 중인 창은 다른 데를 볼 때까지 기다린다. 기준의 1.5배를 넘으면
        # 그래도 하고, 마지막 답은 새로 시작한 뒤 다시 보여 준다
        if asks:
            return
        if held and st["ctx"] >= plan["line"] * 1.5:
            os.makedirs(HANDOFF, exist_ok=True)
            with open(os.path.join(HANDOFF, f"{sid or 'new'}.last.md"), "w") as f:
                f.write(last)
            held = False
        st["diet"] = "pending" if held else "go"

    async def watch_back():
        tick = 0
        while True:
            await anyio.sleep(5)
            tick += 1
            if st["busy"] or session.app.current_buffer.text:
                continue
            if st["diet"] in ("pending", "go"):
                try:
                    held = st["diet"] == "pending" and pane and team_module().watched(pane)
                except Exception:
                    held = False
                if not held:
                    st["diet_start"] = True
                    if session.app.is_running:
                        session.app.exit(result="")
                    continue
            if tick % 4:
                continue
            # the subscription back: Claude Code. The project set to another API key: start again on it
            # 구독이 돌아옴: Claude Code 로. 프로젝트가 다른 API 키로 바뀜: 그 키로 다시 시작
            w = wanted_key()
            if can_go_back() or (key and w and w != key):
                st["back" if can_go_back() else "switch"] = True
                if session.app.is_running:
                    session.app.exit(result="")
                return

    async def diet_notes(client):
        st["diet_start"] = False
        plan = diet_plan(pane, sid)
        if not plan:
            st["diet"] = ""
            return
        st["diet"], st["diet_before"] = "notes", st["ctx"]
        out(GRAY + tr(f"  ⎿ 다이어트: 대화가 {st['ctx'] // 1000}K 토큰이라 노트를 정리하고 새로 시작합니다",
                      f"  ⎿ Diet: the conversation is {st['ctx'] // 1000}K tokens; bringing the notes up to date, then a fresh start") + RST)
        await send(client, tr(f"(hivemux 다이어트) 대화가 커져서 곧 새로 시작한다. {plan['notes']} 를 지금 상태, 결정한 것, 남은 일, 중요한 파일, "
                              "사용자에게 물었는데 아직 답이 없는 질문(원문 그대로)으로 최신으로 정리해라. 정리만 하고 다른 일은 하지 마라.",
                              f"(hivemux diet) The conversation is large, so it starts fresh soon. Bring {plan['notes']} up to date: state, "
                              "decisions, what is left, key files, and questions to the user still unanswered (word for word). Only that, nothing else."))

    def diet_fresh():
        """A new SDK conversation that reads the notes (and shows again the answer being read) / 노트를 읽는 새 SDK 대화"""
        plan = diet_plan(pane, sid) or {"notes": os.path.join(HANDOFF, f"{sid or 'new'}.notes.md")}
        last = os.path.join(HANDOFF, f"{sid or 'new'}.last.md")
        again = ""
        if os.path.isfile(last):
            again = tr(f" 먼저 {last} 를 읽고, 그 내용을 사용자에게 고치지 말고 그대로 다시 보여 줘라 (다이어트 직전에 사용자가 읽던 답이다).",
                       f" First read {last} and show it to the user again exactly as written (the answer they were reading right before the diet).")
        try:
            os.unlink(sdk_file(sid))
        except OSError:
            pass
        resume[0], st["first"], st["ctx_first"], st["diet"] = "", False, 0, "after"
        st["next"] = tr(f"(hivemux 다이어트 뒤 새로 시작){again} {plan['notes']} 를 읽고 하던 일을 이어서 해라. 사용자의 답을 기다리는 질문이 있으면 "
                        "그 질문을 원문 그대로 다시 보여 줘라. 이어서 할 일이 없으면 기다려라.",
                        f"(hivemux: fresh start after a diet){again} Read {plan['notes']} and carry on with your work. If questions to the "
                        "user are still unanswered, show them again word for word. If nothing is left, wait.")
        out(GRAY + tr("  ⎿ 새 대화로 시작합니다", "  ⎿ Starting a fresh conversation") + RST)

    async def slash(client, text):
        """True when handled here / 여기서 처리했으면 True"""
        cmd, _, arg = text.strip().partition(" ")
        if cmd == "/help":
            for k, v in commands().items():
                out(f"  {BOLD}{k}{RST}  {GRAY}{v}{RST}")
        elif cmd == "/cost":
            out(f"  ${st['total']:.3f}")
        elif cmd == "/model":
            if arg.strip():
                model[0] = arg.strip()
                await client.set_model(model[0])
                out(GRAY + tr(f"  모델: {model[0]}", f"  Model: {model[0]}") + RST)
            else:
                out(GRAY + tr(f"  지금 모델: {model[0] or '기본'} · /model opus|sonnet|haiku",
                                f"  Model: {model[0] or 'default'} · /model opus|sonnet|haiku") + RST)
        elif cmd == "/effort":
            levels = ("low", "medium", "high", "xhigh", "max")
            if arg.strip() in levels and st["busy"]:
                out(GRAY + tr("  일하는 중에는 바꿀 수 없습니다 (Esc 로 멈춘 뒤)", "  Not while it works (Esc first)") + RST)
            elif arg.strip() in levels:
                # the SDK takes the effort at the start only: connect again on the same conversation
                # SDK 는 effort 를 시작할 때만 받는다: 같은 대화로 다시 연결한다
                effort[0] = arg.strip()
                resume[0] = st.get("sdk_sid", "")
                st["clear"] = True
                out(GRAY + tr(f"  effort: {effort[0]} (같은 대화로 다시 연결합니다)", f"  Effort: {effort[0]} (connecting again on the same conversation)") + RST)
            else:
                out(GRAY + tr(f"  지금 effort: {effort[0] or '기본'} · /effort low|medium|high|xhigh|max",
                                f"  Effort: {effort[0] or 'default'} · /effort low|medium|high|xhigh|max") + RST)
        elif cmd == "/back":
            st["back"] = True
        elif cmd in ("/exit", "/quit"):
            st["done"] = True
        elif cmd == "/clear":
            if st["busy"]:
                out(GRAY + tr("  일하는 중에는 새 대화로 바꿀 수 없습니다 (Esc 로 멈춘 뒤)", "  Not while it works (Esc first)") + RST)
            else:
                st["clear"], st["first"] = True, False
                try:
                    os.unlink(sdk_file(sid))
                except OSError:
                    pass
                out(GRAY + tr("  새 대화를 시작합니다.", "  Starting a new conversation.") + RST)
        else:
            return False
        return True

    # the input takes at most the pinned rows left for it, and scrolls inside them
    # 입력은 고정한 줄 중 남은 만큼만 쓰고 그 안에서 스크롤한다
    from prompt_toolkit.layout.dimension import Dimension
    for win in session.app.layout.find_all_windows():
        if getattr(win.content, "buffer", None) is session.default_buffer:
            win.height = lambda: Dimension(min=1, max=Pinned.N - 4,
                                           preferred=min(session.default_buffer.document.line_count, Pinned.N - 4))
    with pin:
        pin.follow(session.app)
        while not st["back"] and not st["done"] and not st["switch"]:
            st["clear"] = False
            async with ClaudeSDKClient(options=options()) as client:
                st["client"] = client
                try:
                    info = await client.get_server_info() or {}
                    sdk_cmds.update("/" + (c.get("name") if isinstance(c, dict) else str(c)) for c in info.get("commands") or [])
                    words[0] = list(commands()) + sorted(sdk_cmds - set(commands()))
                except Exception:
                    pass
                async with anyio.create_task_group() as tg:
                    tg.start_soon(reader, client)
                    tg.start_soon(watch_back)
                    if st["next"]:
                        text, st["next"] = st["next"], None
                        await send(client, text)
                    elif go_on or prompt:
                        text = prompt or tr("구독을 쓸 수 없어 끊겼던 일을 이어서 해 주세요.", "Please go on with the work that was cut off.")
                        go_on, prompt = False, None
                        out(f"\n{BOLD}❯{RST} {text}")
                        await send(client, text)
                    while not st["back"] and not st["done"] and not st["clear"] and not st["switch"]:
                        if st["diet_start"]:
                            await diet_notes(client)
                        if pin.on:
                            # each prompt starts on the pinned rows, wherever a break or a reconnect left the cursor
                            # 입력창은 늘 고정한 줄에서 시작한다. 끊김이나 다시 연결이 커서를 어디에 두었든
                            pin.place()
                        try:
                            text = await session.prompt_async(message)
                        except EOFError:
                            st["done"] = True
                            break
                        except KeyboardInterrupt:
                            continue
                        if not text or not text.strip():
                            continue
                        out(f"{BOLD}❯{RST} {text}")
                        # a command is one word after the slash; "/Users/…/a.png" is a path / 명령은 / 뒤 한 단어. 경로는 아니다
                        is_cmd = bool(re.match(r"/[\w:.-]+(\s|$)", text.strip()))
                        if is_cmd and await slash(client, text):
                            continue
                        if is_cmd and sdk_cmds and text.split()[0] not in sdk_cmds:
                            out(GRAY + tr(f"  없는 명령입니다: {text.split()[0]} (/help)", f"  No such command: {text.split()[0]} (/help)") + RST)
                            continue
                        await send(client, text)
                    tg.cancel_scope.cancel()
            st["client"], st["busy"] = None, False
            if st["diet"] == "fresh":
                diet_fresh()
    if st["back"]:
        print("\n" + tr("Claude Code 로 돌아갑니다…", "Going back to Claude Code…"), flush=True)
        go_back(sid, argv)
    if st["switch"]:
        print("\n" + tr(f"이어 갈 API 키가 {wanted_key()} 로 바뀌었습니다. 그 키로 대화를 이어 갑니다…",
                         f"The API key to go on with is now {wanted_key()}. Going on with the conversation on it…"), flush=True)
        switch(argv)


def main(argv):
    if argv[:1] == ["install"]:
        install()
        return
    if argv[:1] == ["back"]:        # from bin/hivemux-claude / bin/hivemux-claude 에서
        vals, _, _ = parse(argv[1:])
        go_back(vals.get("--resume") or vals.get("-r") or "", argv[1:])
    py = install()
    if os.path.realpath(sys.executable) != os.path.realpath(py) and os.environ.get("HIVEMUX_SDK_IN_VENV") != "1":
        os.environ["HIVEMUX_SDK_IN_VENV"] = "1"
        os.execv(py, [py, os.path.realpath(__file__), *argv])
    import anyio
    try:
        anyio.run(run, argv)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main(sys.argv[1:])
