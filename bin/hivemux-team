#!/usr/bin/env python3
"""A team: Claudes with roles in one project (planner, dev, QA...), each in its own window, passing work to each
other by name with Claude Code's messages between sessions.
팀: 한 프로젝트 안의 역할이 다른 Claude 들 (기획, 개발, QA...). 역할마다 자기 창에서 돌고, Claude Code 의
세션 간 메시지로 서로 이름을 불러 일을 넘긴다.

  hivemux-team templates [--json]             the templates: built in (share/teams) and yours / 기본 템플릿과 내 템플릿
  hivemux-team use <template> [-s S] [--force]  copy a template into the project's .hivemux/ / 템플릿을 프로젝트 .hivemux/ 로
  hivemux-team up [-s S] [--role R]           open the roles not running yet / 아직 안 도는 역할을 연다
  hivemux-team down [-s S] [--role R]         stop the roles' Claudes; the conversations stay (like clocking out)
                                              역할의 Claude 를 끈다. 대화는 남는다 (퇴근처럼)
  hivemux-team status [-s S]                  the team and each role's pane and state, as JSON / 팀과 역할별 칸, 상태 (JSON)
  hivemux-team prompt <role> [-s S]           the role's full prompt (its file + the team block) / 역할의 최종 지시문
  hivemux-team save <id> [-s S]               keep this project's team as your template / 이 프로젝트의 팀을 내 템플릿으로
  hivemux-team resume-args <target> <sid> <cwd>   (resume paths) the role flags for that conversation, if it is a role
                                              (재개하는 곳에서) 그 대화가 역할이면 역할 실행 옵션
  hivemux-team handoff <pane> <to> <summary>  (bin/hivemux-hook, a role's SendMessage) log a hand-off / 넘김을 남긴다
  hivemux-team rename <name> [-s S]           rename the team / 팀 이름 바꾸기
  hivemux-team goal <text> [-s S]             give the lead the team's goal (it plans and hands work out) / 리드에게 팀 목표
  hivemux-team trust [-s S]                   answer yes to the folder trust question in the roles waiting on it / 폴더 신뢰 질문에 예
  hivemux-team report [<date>] [-s S]         the team's day as JSON (states, hand-offs, diets, files, tokens) / 팀의 하루 (JSON)
  hivemux-team summarize [<date>] [-s S]      a small model writes the day's story to .hivemux/reports/<date>.md / 하루 이야기
  hivemux-team diet <role> [-s S]             put a role on a diet now (or at its next rest) / 역할을 지금 (또는 다음 쉴 때) 다이어트
  hivemux-team stop <pane> <transcript>       (bin/hivemux-hook, Stop) note the context size; diet a role past its line
                                              (Stop) 컨텍스트 크기를 적고, 기준을 넘은 역할은 다이어트
  hivemux-team start <pane> <sid> <source>    (bin/hivemux-hook, SessionStart) remember the conversation; go on after a diet
                                              (SessionStart) 대화를 적고, 다이어트 뒤 이어 가게 한다
-s S: the project (tmux session); default the current one / 프로젝트 (tmux 세션). 기본은 지금 것

A template is one folder, team.toml + roles/<role>.md (<role>.en.md in English), so it can be shared as is.
In a project it is copied to <project>/.hivemux/, which also keeps:
템플릿은 폴더 하나 (team.toml + roles/<역할>.md, 영어는 <역할>.en.md) 라 그대로 나눌 수 있다. 프로젝트에서는
<프로젝트>/.hivemux/ 로 복사되고, 거기 이것도 둔다:
  notes/<role>.md     the role's notes: state, decisions, what is left (it keeps them; read after a fresh start)
                      역할 노트: 상태, 결정, 남은 일 (역할이 직접 쓴다. 새로 시작하면 먼저 읽는다)
  run/<role>.md       the prompt it was started with (role file + team block) / 시작할 때 쓴 지시문 (역할 파일 + 팀 블록)
  sessions.tsv        "<role> <session id>" as conversations start / 대화가 시작될 때마다
  worktrees/<role>/   a role with worktree = true works there, on branch team/<role> / worktree = true 인 역할의 작업 위치
A role's Claude is `claude -n <project>-<role> --model … --effort … --append-system-prompt-file run/<role>.md`
(readonly: without Edit and Write), in a window named after the role. Its conversation is named <project>-<role>,
the name the others message it by. After a reboot or an update hivemux resumes it with the same flags
(resume-args), since `claude --resume` alone would drop them.
역할의 Claude 는 역할 이름의 창에서 위 명령으로 돈다 (readonly: Edit, Write 없이). 대화 이름 <프로젝트>-<역할> 이
다른 역할이 메시지를 보내는 이름이다. 재부팅이나 업데이트 뒤에도 같은 옵션으로 재개한다 (resume-args).
`claude --resume` 만으로는 옵션이 빠지기 때문이다.
"""
import json, os, re, shlex, shutil, subprocess, sys, time

HERE = os.path.dirname(os.path.realpath(__file__))
TMUX = shutil.which("tmux") or "/opt/homebrew/bin/tmux"
BUILTIN = os.path.join(os.path.dirname(HERE), "share", "teams")
MINE = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "hivemux", "teams")
SHELLS = re.compile(r"^-?(zsh|bash|fish|sh|dash|tcsh|ksh|login)$")
MODELS = ("opus", "sonnet", "haiku")
EFFORTS = ("low", "medium", "high", "xhigh", "max")
READONLY_TOOLS = "Edit,Write,NotebookEdit"


def tmux(*a):
    return subprocess.run([TMUX, *a], capture_output=True, text=True, stdin=subprocess.DEVNULL).stdout


_LANG = [0.0, ""]


def lang():
    # asked many times while one page is built: tmux once every few seconds is enough / 화면 하나 만드는 동안 여러 번 묻는다: 몇 초에 한 번이면 된다
    if time.time() - _LANG[0] > 3:
        v = os.environ.get("HIVEMUX_LANG") or tmux("show", "-gqv", "@hivemux-lang").strip()
        _LANG[:] = [time.time(), "ko" if (v or os.environ.get("LANG", "")).startswith("ko") else "en"]
    return _LANG[1]


def tr(ko, en):
    return ko if lang() == "ko" else en


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


# ── team.toml: the subset templates use (Python 3.9 on macOS has no tomllib) ─────────────────────────────
# ── team.toml: 템플릿이 쓰는 부분만 (macOS 의 Python 3.9 에는 tomllib 이 없다) ────────────────────────────
def _value(s, i):
    """Parse one value at s[i:]: "string", number, true/false, [array], {inline table}. Returns (value, next i)."""
    while s[i] in " \t\n":
        i += 1
    c = s[i]
    if c == '"':
        out, i = [], i + 1
        while s[i] != '"':
            if s[i] == "\\":
                i += 1
                out.append({"n": "\n", "t": "\t", '"': '"', "\\": "\\"}.get(s[i], s[i]))
            else:
                out.append(s[i])
            i += 1
        return "".join(out), i + 1
    if c in "[{":
        close, items, i = "]" if c == "[" else "}", [] if c == "[" else {}, i + 1
        while True:
            while s[i] in " \t\n,":
                i += 1
            if s[i] == close:
                return items, i + 1
            if c == "[":
                v, i = _value(s, i)
                items.append(v)
            else:
                m = re.compile(r"\s*([A-Za-z0-9_-]+)\s*=").match(s, i)
                v, i = _value(s, m.end())
                items[m.group(1)] = v
    m = re.compile(r"true|false|-?\d+(\.\d+)?").match(s, i)
    if not m:
        raise ValueError("bad value near: " + s[i:i + 20])
    t = m.group(0)
    return (t == "true") if t in ("true", "false") else (float(t) if "." in t else int(t)), m.end()


def _strip_comment(line):
    q = False
    for i, ch in enumerate(line):
        if ch == '"' and (i == 0 or line[i - 1] != "\\"):
            q = not q
        elif ch == "#" and not q:
            return line[:i]
    return line


def toml_loads(text):
    try:
        import tomllib
        return tomllib.loads(text)
    except ImportError:
        pass
    root, cur = {}, None
    cur = root
    lines = [_strip_comment(l) for l in text.splitlines()]
    k = 0
    while k < len(lines):
        line = lines[k].strip()
        k += 1
        if not line:
            continue
        if line.startswith("[["):
            name = line.strip("[] ")
            cur = {}
            root.setdefault(name, []).append(cur)
        elif line.startswith("["):
            name = line.strip("[] ")
            cur = root.setdefault(name, {})
        else:
            key, _, rest = line.partition("=")
            # an array or table may go on over lines / 배열이나 표는 여러 줄에 걸칠 수 있다
            while rest.count("[") > rest.count("]") or rest.count("{") > rest.count("}"):
                rest += "\n" + lines[k]
                k += 1
            cur[key.strip()], _ = _value(rest + "\n", 0)
    return root


def _toml_value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return str(v)
    if isinstance(v, list):
        return "[" + ", ".join(_toml_value(x) for x in v) + "]"
    if isinstance(v, dict):
        return "{ " + ", ".join(f"{k} = {_toml_value(x)}" for k, x in v.items()) + " }"
    return json.dumps(str(v), ensure_ascii=False)


def toml_dumps(d):
    out = []
    for k, v in d.items():
        if not isinstance(v, dict) and not (isinstance(v, list) and v and isinstance(v[0], dict)):
            out.append(f"{k} = {_toml_value(v)}")
    for k, v in d.items():
        if isinstance(v, dict):
            out += ["", f"[{k}]"] + [f"{a} = {_toml_value(b)}" for a, b in v.items()]
    for k, v in d.items():
        if isinstance(v, list) and v and isinstance(v[0], dict):
            for t in v:
                out += ["", f"[[{k}]]"] + [f"{a} = {_toml_value(b)}" for a, b in t.items()]
    return "\n".join(out) + "\n"


# ── teams ──────────────────────────────────────────────────────────────────────────────────────────────
def load(folder):
    """team.toml of a template or a project's .hivemux/, with each role's defaults filled in
    템플릿이나 프로젝트 .hivemux/ 의 team.toml. 역할마다 기본값을 채운다"""
    with open(os.path.join(folder, "team.toml"), encoding="utf-8") as f:
        team = toml_loads(f.read())
    # diet.at: thousands of tokens of context (every request reads them again) / 컨텍스트 천 토큰 단위 (매 요청이 다시 읽는다)
    diet = {"at": 120, "how": "renew", **(team.get("diet") or {})}
    roles = []
    for r in team.get("role") or []:
        if not re.fullmatch(r"[a-z][a-z0-9_-]{0,23}", str(r.get("id", ""))):
            continue
        r = {"model": "sonnet", "effort": "medium", "prompt": f"roles/{r['id']}.md", "lead": False, "readonly": False,
             "worktree": False, "owns": "", **r}
        r["diet"] = {**diet, **(r.get("diet") or {})}
        roles.append(r)
    team["role"] = roles
    team["diet"] = diet
    team["folder"] = folder
    return team


def label(obj, key="name"):
    """The Korean or English field (name / name_en) / 한국어 또는 영어 칸"""
    return (lang() == "en" and obj.get(key + "_en")) or obj.get(key) or obj.get("id", "")


def templates():
    out = []
    for base, builtin in ((BUILTIN, True), (MINE, False)):
        if not os.path.isdir(base):
            continue
        for d in sorted(os.listdir(base)):
            if os.path.isfile(os.path.join(base, d, "team.toml")):
                try:
                    t = load(os.path.join(base, d))
                except (OSError, ValueError, KeyError, AttributeError) as e:
                    print(f"hivemux-team: {d}: {e}", file=sys.stderr)
                    continue
                out.append({"id": t.get("id") or d, "name": label(t), "description": label(t, "description"),
                            "builtin": builtin, "path": t["folder"], "flow": t.get("flow") or [r["id"] for r in t["role"]],
                            "roles": [{"id": r["id"], "name": label(r), "model": r["model"], "effort": r["effort"]} for r in t["role"]]})
    return out


def project(session):
    """(session, folder) of the project: the tmux session and its folder / 프로젝트의 tmux 세션과 폴더"""
    if not session:
        session = os.environ.get("TMUX") and tmux("display", "-p", "#{session_name}").strip()
    if not session:
        die(tr("프로젝트를 정하세요: -s <세션> (tmux 안에서는 지금 세션)", "Name the project: -s <session> (inside tmux: the current one)"))
    folder = folder_of(session)
    if not folder:
        die(tr(f"프로젝트가 없습니다: {session}", f"No such project: {session}"))
    return session, folder


FOLDER_FMT = "\t".join(["#{session_name}", "#{@hivemux-folder}", "#{session_path}", "#{window_index}", "#{pane_index}", "#{pane_title}",
                         "#{@hivemux-role}", "#{@claude_cwd}", "#{pane_current_path}"])


def folder_of(session, rows=None):
    """The project's folder. Not tmux's session_path: a restored session can keep another folder there (a
    team landed in another project's folder that way). Pinned once a team is made (@hivemux-folder), else
    where its Claudes started (@claude_cwd) or its shells are, the first window first. rows: its panes in
    FOLDER_FMT, when already read (folders()).
    프로젝트 폴더. tmux 의 session_path 가 아니다: 복원된 세션은 거기 다른 폴더를 갖고 있을 수 있다 (그래서
    팀이 다른 프로젝트 폴더에 만들어졌다). 팀을 만들면 고정하고 (@hivemux-folder), 아니면 Claude 가 시작한
    곳 (@claude_cwd) 이나 셸이 있는 곳, 첫 창부터. rows: 이미 읽은 그 칸들 (FOLDER_FMT, folders())."""
    if rows is None:
        rows = [(l.split("\t") + [""] * 9)[:9] for l in tmux("list-panes", "-s", "-t", f"={session}", "-F", FOLDER_FMT).splitlines()]
    if not rows:
        return ""
    pinned = rows[0][1]
    if pinned and os.path.isdir(pinned):
        return pinned
    home, best = os.path.expanduser("~"), None
    for _, _, _, w, pi, title, role, ccwd, cur in rows:
        if title == "hivemux-sidebar" or role or not (w.isdigit() and pi.isdigit()):
            continue
        d = ccwd or cur
        if d and d != home and os.path.isdir(d):
            key = (0 if ccwd else 1, int(w), int(pi))
            if best is None or key < best[0]:
                best = (key, d)
    return best[1] if best else rows[0][2]


def folders():
    """Every project's folder, from one tmux call / 모든 프로젝트의 폴더, tmux 한 번으로"""
    by = {}
    for l in tmux("list-panes", "-a", "-F", FOLDER_FMT).splitlines():
        r = (l.split("\t") + [""] * 9)[:9]
        by.setdefault(r[0], []).append(r)
    return {name: folder_of(name, rows) for name, rows in by.items()}


def team_dir(folder):
    return os.path.join(folder, ".hivemux")


def role_text(team, role):
    """The role's own prompt file, in English when there is one and the screen is English
    역할 지시문 파일. 화면이 영어이고 영어 파일이 있으면 그것"""
    path = os.path.join(team["folder"], role["prompt"])
    en = re.sub(r"\.md$", ".en.md", path)
    if lang() == "en" and os.path.isfile(en):
        path = en
    try:
        with open(path, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def mark(pane, folder, team, role):
    """What a role pane carries for hivemux (the hook's logs, the sidebar's group and name)
    역할 칸이 hivemux 를 위해 지니는 것 (훅의 기록, 사이드바의 묶음과 이름)"""
    tmux("set", "-p", "-t", pane, "@hivemux-role", role["id"])
    tmux("set", "-p", "-t", pane, "@hivemux-teamdir", team_dir(folder))
    tmux("set", "-p", "-t", pane, "@hivemux-rolename", ("★ " if role["lead"] else "") + label(role))
    tmux("set", "-p", "-t", pane, "@hivemux-team", label(team))
    tmux("set", "-p", "-t", pane, "@hivemux-roleorder", str(role_rank(team, role)))


def role_rank(team, role):
    """Where a role is listed: the lead first, then the flow / 역할을 보이는 순서: 리드 먼저, 그다음 흐름"""
    flow = team.get("flow") or [r["id"] for r in team["role"]]
    return 0 if role["lead"] else 1 + (flow.index(role["id"]) if role["id"] in flow else len(flow))


def ranked(team):
    return sorted(team["role"], key=lambda r: role_rank(team, r))


def remark(session):
    """After an edit (a name, the lead): the running roles' marks again / 편집 뒤 (이름, 리드): 도는 역할의 표시를 다시"""
    session, folder = project(session)
    team = load(team_dir(folder))
    by = {r["id"]: r for r in team["role"]}
    for p in panes(session):
        if p["role"] in by:
            mark(p["pane"], folder, team, by[p["role"]])


def worktree_of(folder, role):
    return os.path.join(team_dir(folder), "worktrees", role["id"])


def build_prompt(session, folder, team, role):
    """The role file plus the team block: who the others are, the names to message, how to hand off, the notes
    역할 파일과 팀 블록: 다른 역할, 메시지를 보낼 이름, 넘기는 방법, 노트"""
    ko = lang() == "ko"
    lead = next((r for r in team["role"] if r["lead"]), None)
    me = f"{session}-{role['id']}"
    lines = [role_text(team, role), "", "## 팀 (hivemux)" if ko else "## Team (hivemux)"]
    lines.append((f"프로젝트: {session} ({folder})" if ko else f"Project: {session} ({folder})"))
    lines.append((f"너: {me} ({label(role)}" if ko else f"You: {me} ({label(role)}") + (", 리드)" if ko and role["lead"] else ", lead)" if role["lead"] else ")"))
    lines.append("팀원 (세션 간 메시지 SendMessage 로 이 이름에 보낸다):" if ko else "Teammates (message them by these names with SendMessage):")
    for r in team["role"]:
        if r["id"] == role["id"]:
            continue
        bits = [label(r)] + (["리드" if ko else "lead"] if r["lead"] else [])
        owns = r["owns"] if not r["worktree"] else ("자기 워크트리" if ko else "its own worktree")
        lines.append(f"- {session}-{r['id']}: {', '.join(bits)}" + (f" · {'맡는 곳' if ko else 'owns'}: {owns}" if owns else ""))
    if ko:
        lines.append("넘길 때는 짧게: 무엇을 했는지 한 줄, 결과 파일 경로, 상대에게 바라는 것, 확인하는 방법.")
        if lead and lead["id"] != role["id"]:
            lines.append(f"막히거나 판단이 필요하면 리드({session}-{lead['id']})에게 보낸다.")
        lines.append("다른 역할이 맡은 곳의 파일은 고치지 않는다.")
        lines.append(f"사용자에게 물을 것은 {os.path.join(team_dir(folder), 'questions.md')} 에 번호를 붙여 적고 (누가, 언제, 원문 그대로) 답변에도 보여라. "
                     "답이 오면 그 질문 아래에 답을 적는다. 대화가 비워져도 질문을 잃지 않게 하려는 것이다.")
        if role["readonly"]:
            lines.append("너는 읽기 전용 역할이다. 파일을 고치지 않고, 고칠 것은 맡은 역할에게 넘긴다.")
        if role["worktree"]:
            lines.append(f"너는 자기 워크트리 {worktree_of(folder, role)} 에서 브랜치 team/{role['id']} 로 일한다.")
        lines += ["", "## 노트",
                  f"{os.path.join(team_dir(folder), 'notes', role['id'] + '.md')} 를 최신으로 둔다: 지금 상태, 결정한 것, 남은 일, 중요한 파일.",
                  "일을 한 차례 끝낼 때마다 고친다. 대화가 비워지면(새로 시작) 이 노트를 먼저 읽고 이어 간다."]
    else:
        lines.append("Hand off briefly: what you did in one line, the result's file path, what you want from them, how to check it.")
        if lead and lead["id"] != role["id"]:
            lines.append(f"When blocked or a decision is needed, message the lead ({session}-{lead['id']}).")
        lines.append("Do not change files another role owns.")
        lines.append(f"Questions for the user go to {os.path.join(team_dir(folder), 'questions.md')}, numbered (who, when, the exact words), and in your answer too. "
                     "Write the answer under the question when it comes, so a cleared conversation never loses a question.")
        if role["readonly"]:
            lines.append("You are a read-only role: do not change files; hand what needs fixing to the role that owns it.")
        if role["worktree"]:
            lines.append(f"You work in your own worktree {worktree_of(folder, role)}, on branch team/{role['id']}.")
        lines += ["", "## Notes",
                  f"Keep {os.path.join(team_dir(folder), 'notes', role['id'] + '.md')} current: state, decisions, what is left, key files.",
                  "Update it after each piece of work. When the conversation is cleared (a fresh start), read it first and go on."]
    return "\n".join(lines) + "\n"


def flags(session, folder, team, role):
    """Write run/<role>.md and return the role's claude flags / run/<역할>.md 를 쓰고 역할의 claude 옵션을 돌려준다"""
    run = os.path.join(team_dir(folder), "run")
    os.makedirs(run, exist_ok=True)
    os.makedirs(os.path.join(team_dir(folder), "notes"), exist_ok=True)
    path = os.path.join(run, role["id"] + ".md")
    with open(path, "w", encoding="utf-8") as f:
        f.write(build_prompt(session, folder, team, role))
    out = []
    if role["model"] in MODELS or role["model"].startswith("claude-"):
        out += ["--model", role["model"]]
    if role["effort"] in EFFORTS:
        out += ["--effort", role["effort"]]
    out += ["--append-system-prompt-file", path]
    if role["readonly"]:
        out += ["--disallowedTools", READONLY_TOOLS]
    return out


def ensure_worktree(folder, role):
    """<project>/.hivemux/worktrees/<role> on branch team/<role>; the project folder when it is not a git repo
    git 저장소가 아니면 프로젝트 폴더"""
    path = worktree_of(folder, role)
    if os.path.isdir(path):
        return path
    if subprocess.run(["git", "-C", folder, "rev-parse", "--is-inside-work-tree"], capture_output=True).returncode != 0:
        print(tr(f"  {role['id']}: git 저장소가 아니라 프로젝트 폴더에서 일합니다", f"  {role['id']}: not a git repo, so it works in the project folder"))
        return folder
    branch = f"team/{role['id']}"
    has = subprocess.run(["git", "-C", folder, "rev-parse", "--verify", "--quiet", branch], capture_output=True).returncode == 0
    r = subprocess.run(["git", "-C", folder, "worktree", "add", "-q", path] + ([branch] if has else ["-b", branch]),
                       capture_output=True, text=True)
    if r.returncode != 0:
        print(tr(f"  {role['id']}: 워크트리를 만들지 못해 프로젝트 폴더에서 일합니다 ({r.stderr.strip()})",
                 f"  {role['id']}: could not make its worktree, so it works in the project folder ({r.stderr.strip()})"))
        return folder
    return path


def exclude(folder):
    """Keep hivemux's own files out of git (team.toml, roles/ and notes/ may be committed)
    hivemux 자체 파일은 git 에서 뺀다 (team.toml, roles/, notes/ 는 커밋해도 된다)"""
    r = subprocess.run(["git", "-C", folder, "rev-parse", "--git-path", "info/exclude"], capture_output=True, text=True)
    if r.returncode != 0:
        return
    path = os.path.join(folder, r.stdout.strip()) if not os.path.isabs(r.stdout.strip()) else r.stdout.strip()
    want = [".hivemux/run/", ".hivemux/worktrees/", ".hivemux/sessions.tsv"]
    try:
        have = open(path).read().splitlines()
    except OSError:
        have = []
    missing = [w for w in want if w not in have]
    if missing:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "a") as f:
            f.write("".join(w + "\n" for w in missing))


def sessions(folder):
    """{role: session id}, the last one for each / 역할마다 마지막 대화"""
    out = {}
    try:
        with open(os.path.join(team_dir(folder), "sessions.tsv")) as f:
            for line in f:
                p = line.rstrip("\n").split("\t")
                if len(p) >= 2:
                    out[p[0]] = p[1]
    except OSError:
        pass
    return out


def panes(session):
    """The project's panes / 프로젝트의 칸"""
    fmt = "\t".join(["#{pane_id}", "#{window_name}", "#{@hivemux-role}", "#{@claude_session}", "#{pane_current_command}",
                     "#{@claude_state}", "#{window_index}", "#{@hivemux-role-at}", "#{@claude_ctx}", "#{@hivemux-diet}"])
    out = []
    for line in tmux("list-panes", "-s", "-t", f"={session}", "-F", fmt).splitlines():
        p = line.split("\t")
        if len(p) == 10:
            out.append(dict(zip(("pane", "window", "role", "sid", "cmd", "state", "index", "at", "ctx", "diet"), p)))
    return out


def claude_cmd():
    v = os.environ.get("HIVEMUX_CLAUDE") or tmux("show-environment", "-g", "HIVEMUX_CLAUDE").strip().partition("=")[2]
    return v or "claude"


def offwork(pane):
    """Clocked out by itself (bin/hivemux-shift)? / 혼자 퇴근했나"""
    path = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "hivemux", "offwork.tsv")
    try:
        return any(l.split("\t")[0] == pane for l in open(path))
    except OSError:
        return False


def up(session, only=None):
    session, folder = project(session)
    if not os.path.isfile(os.path.join(team_dir(folder), "team.toml")):
        die(tr(f"{session} 에는 팀이 없습니다. 먼저: hivemux team use web-app -s {session}",
               f"{session} has no team. First: hivemux team use web-app -s {session}"))
    team = load(team_dir(folder))
    known = sessions(folder)
    have = {p["role"]: p for p in panes(session) if p["role"]}
    started = 0
    for role in team["role"]:
        if only and role["id"] != only:
            continue
        p = have.get(role["id"])
        if p and not SHELLS.match(p["cmd"]):
            print(f"  {label(role)}: " + tr("이미 도는 중", "already running"))
            continue
        # sent a moment ago and its shell has not run it yet: do not send it twice / 방금 보냈고 셸이 아직 실행 전: 두 번 보내지 않는다
        if p and p["at"].isdigit() and time.time() - int(p["at"]) < 20:
            print(f"  {label(role)}: " + tr("시작하는 중", "starting"))
            continue
        cwd = ensure_worktree(folder, role) if role["worktree"] else folder
        if p is None:
            pane = tmux("new-window", "-d", "-t", f"={session}:", "-c", cwd, "-n", label(role), "-P", "-F", "#{pane_id}").strip()
            if not pane:
                print(f"  {label(role)}: " + tr("창을 열지 못했습니다", "could not open a window"))
                continue
            mark(pane, folder, team, role)
        else:
            pane = p["pane"]
        if p and offwork(pane):
            # clocked out with `team down`: clocking in resumes it with the role flags (resume-args)
            # `team down` 으로 퇴근함: 출근하면 역할 옵션으로 재개된다 (resume-args)
            subprocess.run([os.path.join(HERE, "hivemux-shift"), "on", "--pane", pane], capture_output=True)
            print(f"  {label(role)}: " + tr("출근", "back to work"))
            started += 1
            continue
        args = flags(session, folder, team, role)
        sid = known.get(role["id"])
        if p and sid:
            cmd = f" cd {shlex.quote(cwd)} && {claude_cmd()} --resume {shlex.quote(sid)} {shlex.join(args)}"
            what = tr("이어서 시작", "resumed")
        else:
            cmd = f" cd {shlex.quote(cwd)} && {claude_cmd()} -n {shlex.quote(session + '-' + role['id'])} {shlex.join(args)}"
            what = tr("시작", "started")
        tmux("send-keys", "-t", pane, cmd, "Enter")
        tmux("set", "-p", "-t", pane, "@hivemux-role-at", str(int(time.time())))
        print(f"  {label(role)}: {what} ({role['model']} · {role['effort']})")
        started += 1
    exclude(folder)
    if started:
        lead = next((r for r in team["role"] if r["lead"]), None) or team["role"][0]
        print(tr(f"다음: 팀 화면(사이드바 프로젝트 메뉴 \"팀…\")에서 목표를 보내거나, hivemux team goal \"…\" -s {session}. "
                 f"리드({label(lead)})가 계획을 세우고 일을 나눠요. 처음 여는 폴더면 역할마다 폴더 신뢰 확인이 떠요",
                 f"Next: send the goal from the team page (\"Team…\" in the sidebar's project menu) or hivemux team goal \"…\" -s {session}. "
                 f"The lead ({label(lead)}) plans and splits the work. A folder opened for the first time asks each role to trust it"))
    return started


def down(session, only=None):
    session, folder = project(session)
    for p in panes(session):
        if p["role"] and (not only or p["role"] == only) and not SHELLS.match(p["cmd"]):
            subprocess.run([os.path.join(HERE, "hivemux-shift"), "off", "--pane", p["pane"]], capture_output=True)
            print(f"  {p['window']}: " + tr("퇴근", "clocked out"))


def status(session):
    session, folder = project(session)
    path = team_dir(folder)
    if not os.path.isfile(os.path.join(path, "team.toml")):
        return {"project": session, "folder": folder, "team": None}
    team = load(path)
    have = {p["role"]: p for p in panes(session) if p["role"]}
    roles = []
    for r in ranked(team):
        p = have.get(r["id"]) or {}
        running = bool(p) and not SHELLS.match(p.get("cmd", ""))
        roles.append({**{k: r[k] for k in ("id", "model", "effort", "lead", "readonly", "worktree", "owns", "diet", "prompt")},
                      "name": label(r), "session": f"{session}-{r['id']}", "pane": p.get("pane", ""),
                      "running": running, "state": p.get("state", "") if running else ("off" if p else ""),
                      "ctx": int(p["ctx"]) if p.get("ctx", "").isdigit() else 0, "dieting": p.get("diet", "") if running else "",
                      "trust": bool(running and needs_trust(p["pane"]))})
    return {"project": session, "folder": folder,
            "team": {"id": team.get("id", ""), "name": label(team), "description": label(team, "description"),
                     "flow": team.get("flow") or [r["id"] for r in team["role"]], "diet": team["diet"], "roles": roles,
                     "handoffs": handoffs(folder, team),
                     "questions": _read(os.path.join(team_dir(folder), "questions.md"))[:8000],
                     "starters": (lang() == "en" and team.get("starters_en")) or team.get("starters") or []}}


def _read(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return ""


def find_team(cwd):
    """The project folder above cwd that has a team / cwd 위로 팀이 있는 프로젝트 폴더"""
    d = os.path.abspath(cwd or "/")
    while True:
        if os.path.isfile(os.path.join(d, ".hivemux", "team.toml")):
            return d
        up_ = os.path.dirname(d)
        if up_ == d:
            return None
        d = up_


def resume_args(target, sid, cwd):
    folder = find_team(cwd)
    if not folder:
        return ""
    role_id = next((r for r, s in sessions(folder).items() if s == sid), None)
    if not role_id:
        return ""
    team = load(team_dir(folder))
    role = next((r for r in team["role"] if r["id"] == role_id), None)
    if not role:
        return ""
    session = tmux("display", "-p", "-t", target, "#{session_name}").strip() or os.path.basename(folder)
    mark(target, folder, team, role)
    return shlex.join(flags(session, folder, team, role))


def record(pane, sid):
    role = tmux("show", "-pqv", "-t", pane, "@hivemux-role").strip()
    tmux("set", "-pu", "-t", pane, "@hivemux-role-at")      # it started (see up) / 시작했다 (up 참고)
    folder = find_team(folder_of(tmux("display", "-p", "-t", pane, "#{session_name}").strip()))
    if role and folder:
        team = load(team_dir(folder))
        r = next((x for x in team["role"] if x["id"] == role), None)
        if r:
            mark(pane, folder, team, r)
    if role and sid and folder and sessions(folder).get(role) != sid:
        with open(os.path.join(team_dir(folder), "sessions.tsv"), "a") as f:
            f.write(f"{role}\t{sid}\n")


def use(name, session, force):
    session, folder = project(session)
    if name == "empty":
        if os.path.isfile(os.path.join(team_dir(folder), "team.toml")) and not force:
            die(tr(f"{session} 에는 이미 팀이 있습니다 (바꾸려면 --force)", f"{session} already has a team (--force replaces it)"))
        use_empty(session)
        return
    src = next((t["path"] for t in templates() if t["id"] == name), None)
    if not src:
        die(tr(f"템플릿이 없습니다: {name} (hivemux team templates)", f"No such template: {name} (hivemux team templates)"))
    dst = team_dir(folder)
    if os.path.isfile(os.path.join(dst, "team.toml")) and not force:
        die(tr(f"{session} 에는 이미 팀이 있습니다 (바꾸려면 --force)", f"{session} already has a team (--force replaces it)"))
    os.makedirs(dst, exist_ok=True)
    shutil.copy(os.path.join(src, "team.toml"), os.path.join(dst, "team.toml"))
    if os.path.isdir(os.path.join(dst, "roles")):
        shutil.rmtree(os.path.join(dst, "roles"))
    shutil.copytree(os.path.join(src, "roles"), os.path.join(dst, "roles"))
    os.makedirs(os.path.join(dst, "notes"), exist_ok=True)
    exclude(folder)
    tmux("set", "-t", f"={session}:", "@hivemux-folder", folder)
    print(tr(f"{session} 에 팀을 만들었습니다: {dst}", f"Made the team in {session}: {dst}"))


def save(name, session):
    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,39}", name):
        die(tr("이름은 영문 소문자, 숫자, - 로", "Use lowercase letters, digits and -"))
    session, folder = project(session)
    src = team_dir(folder)
    dst = os.path.join(MINE, name)
    os.makedirs(MINE, exist_ok=True)
    if os.path.isdir(dst):
        shutil.rmtree(dst)
    os.makedirs(dst)
    with open(os.path.join(src, "team.toml"), encoding="utf-8") as f:
        team = toml_loads(f.read())
    team["id"] = name
    with open(os.path.join(dst, "team.toml"), "w", encoding="utf-8") as f:
        f.write(toml_dumps(team))
    shutil.copytree(os.path.join(src, "roles"), os.path.join(dst, "roles"))
    print(tr(f"내 템플릿으로 저장했습니다: {dst}", f"Saved as your template: {dst}"))


# ── editing, for the team page (bin/hivemux-office) / 편집: 팀 화면용 (bin/hivemux-office) ─────────────────
# team.toml is rewritten as data, so comments in a project's copy do not survive an edit there
# team.toml 을 데이터로 다시 쓰므로, 프로젝트 복사본에서 고치면 주석은 남지 않는다
def _raw(folder):
    with open(os.path.join(team_dir(folder), "team.toml"), encoding="utf-8") as f:
        return toml_loads(f.read())


def _write(folder, raw):
    path = os.path.join(team_dir(folder), "team.toml")
    with open(path + ".tmp", "w", encoding="utf-8") as f:
        f.write(toml_dumps(raw))
    os.replace(path + ".tmp", path)


def prompt_path(folder, role):
    """The prompt file the editor shows and writes: the English one on an English screen when there is one
    편집 화면이 보이고 쓰는 지시문 파일: 영어 화면이고 영어 파일이 있으면 그것"""
    base = os.path.join(team_dir(folder), role.get("prompt") or f"roles/{role['id']}.md")
    en = re.sub(r"\.md$", ".en.md", base)
    return en if lang() == "en" and os.path.isfile(en) else base


def set_role(session, rid, fields, prompt=None):
    """Change a role's fields and, when given, its prompt file / 역할의 칸과 (주어지면) 지시문 파일을 바꾼다"""
    session, folder = project(session)
    raw = _raw(folder)
    roles = raw.get("role") or []
    r = next((x for x in roles if x.get("id") == rid), None)
    if r is None:
        raise KeyError(rid)
    en = lang() == "en"
    for k, v in (fields or {}).items():
        if k == "name" and str(v).strip():
            r["name_en" if en and "name_en" in r else "name"] = str(v).strip()[:40]
        elif k == "model" and v in MODELS:
            r[k] = v
        elif k == "effort" and v in EFFORTS:
            r[k] = v
        elif k in ("lead", "readonly", "worktree"):
            if v:
                r[k] = True
            else:
                r.pop(k, None)
        elif k == "owns":
            r[k] = str(v).strip()[:200]
        elif k == "diet" and isinstance(v, dict):
            d = dict(r.get("diet") or {})
            if v.get("how") in ("renew", "compact", "off"):
                d["how"] = v["how"]
            if isinstance(v.get("at"), int) and 40 <= v["at"] <= 800:
                d["at"] = v["at"]
            r["diet"] = d
    if (fields or {}).get("lead"):          # one lead / 리드는 하나
        for x in roles:
            if x is not r:
                x.pop("lead", None)
    _write(folder, raw)
    if prompt is not None:
        path = prompt_path(folder, {**r, "prompt": r.get("prompt") or f"roles/{rid}.md"})
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(str(prompt).rstrip() + "\n")


NEW_PROMPT = {"ko": "너는 이 팀의 {name} 역할이다. 무엇을 하는지 여기에 적는다.\n\n- 결과는 어디에 남기는지\n- 끝나면 누구에게 넘기는지\n",
              "en": "You are the team's {name}. Describe what you do here.\n\n- Where results go\n- Who you hand off to when done\n"}


def add_role(session, name, rid=None, fields=None, prompt=None):
    """A new role with a starter prompt; its id comes from the name when that is ASCII, else role<n>
    새 역할과 기본 지시문. id 는 이름이 영문이면 이름에서, 아니면 role<n>"""
    session, folder = project(session)
    raw = _raw(folder)
    roles = raw.setdefault("role", [])
    ids = {x.get("id") for x in roles}
    slug = rid or re.sub(r"[^a-z0-9]+", "-", str(name).lower()).strip("-")[:20]
    if not re.fullmatch(r"[a-z][a-z0-9_-]{0,23}", slug or "") or slug in ids:
        n = 1
        while f"role{n}" in ids:
            n += 1
        slug = f"role{n}"
    r = {"id": slug, "name": str(name).strip()[:40] or slug, "model": "sonnet", "effort": "medium", "prompt": f"roles/{slug}.md"}
    roles.append(r)
    if isinstance(raw.get("flow"), list):
        raw["flow"].append(slug)
    _write(folder, raw)
    path = os.path.join(team_dir(folder), "roles", slug + ".md")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(prompt or NEW_PROMPT[lang()].format(name=r["name"]))
    if fields:
        set_role(session, slug, fields)
    return slug


def delete_role(session, rid):
    """Take a role out of the team (its notes stay) / 역할을 팀에서 뺀다 (노트는 남는다)"""
    session, folder = project(session)
    raw = _raw(folder)
    raw["role"] = [x for x in raw.get("role") or [] if x.get("id") != rid]
    if isinstance(raw.get("flow"), list):
        raw["flow"] = [x for x in raw["flow"] if x != rid]
    _write(folder, raw)
    for suffix in (".md", ".en.md"):
        try:
            os.remove(os.path.join(team_dir(folder), "roles", rid + suffix))
        except OSError:
            pass


def rename_team(session, name):
    """The team's name (the sidebar's group, the office's carpet and board) / 팀 이름 (사이드바 묶음, 사무실 카펫과 보드)"""
    name = " ".join(str(name).split())[:40]
    if not name:
        die(tr("이름을 적어 주세요", "Write a name"))
    session, folder = project(session)
    raw = _raw(folder)
    raw["name"] = name
    raw.pop("name_en", None)
    _write(folder, raw)
    remark(session)
    print(tr(f"팀 이름을 바꿨습니다: {name}", f"Renamed the team: {name}"))


def set_order(session, ids):
    """The flow: the order the roles hand work on / 흐름: 역할이 일을 넘기는 순서"""
    session, folder = project(session)
    raw = _raw(folder)
    have = [x.get("id") for x in raw.get("role") or []]
    raw["flow"] = [i for i in ids if i in have] + [i for i in have if i not in ids]
    raw["role"] = sorted(raw.get("role") or [], key=lambda x: raw["flow"].index(x.get("id")))
    _write(folder, raw)


def use_empty(session):
    session, folder = project(session)
    dst = team_dir(folder)
    os.makedirs(os.path.join(dst, "roles"), exist_ok=True)
    os.makedirs(os.path.join(dst, "notes"), exist_ok=True)
    _write(folder, {"id": "custom", "name": tr("내 팀", "My team"), "version": 1, "flow": [], "diet": {"at": 120, "how": "renew"}})
    exclude(folder)
    tmux("set", "-t", f"={session}:", "@hivemux-folder", folder)


def apply_plan(session, plan):
    """The team wizard's pick on top of a template just copied: drop roles, set models, add new ones
    방금 복사한 템플릿 위에 팀 추천 위저드가 고른 것을 얹는다: 역할 빼기, 모델 정하기, 새 역할 더하기"""
    keep = {r.get("id") for r in plan.get("roles") or []}
    _, folder = project(session)
    for r in load(team_dir(folder))["role"]:
        if r["id"] not in keep:
            delete_role(session, r["id"])
    have = {r["id"] for r in load(team_dir(folder))["role"]}
    for r in plan.get("roles") or []:
        fields = {k: r[k] for k in ("model", "effort", "readonly", "worktree", "lead") if k in r}
        if r.get("id") in have:
            set_role(session, r["id"], fields)
        else:
            add_role(session, r.get("name") or r.get("id"), r.get("id"), fields, r.get("prompt"))
    at, starters = plan.get("diet_at"), plan.get("starters")
    raw = _raw(folder)
    if isinstance(at, int) and 40 <= at <= 800:
        raw["diet"] = {**(raw.get("diet") or {}), "at": at}
    for k in ("name", "description"):       # the team it made may not be the template's / 만든 팀이 템플릿과 다를 수 있다
        if isinstance(plan.get(k), str) and plan[k].strip():
            raw[k] = plan[k].strip()[:80]
            raw.pop(k + "_en", None)
    if isinstance(starters, list):          # goals that fit the team it made / 만든 팀에 맞는 목표 예시
        raw["starters"] = [str(x)[:200] for x in starters][:5]
        raw.pop("starters_en", None)
    _write(folder, raw)


def detail(session):
    """status() plus each role's prompt text, for the editor / status() 에 역할 지시문을 더한 것 (편집 화면용)"""
    st = status(session)
    if st.get("team"):
        team = load(team_dir(st["folder"]))
        by = {r["id"]: r for r in team["role"]}
        for r in st["team"]["roles"]:
            path = prompt_path(st["folder"], by[r["id"]])
            try:
                r["text"] = open(path, encoding="utf-8").read()
            except OSError:
                r["text"] = ""
            r["file"] = os.path.relpath(path, st["folder"])
    return st


def final_prompt(session, rid):
    session, folder = project(session)
    team = load(team_dir(folder))
    role = next((r for r in team["role"] if r["id"] == rid), None)
    return build_prompt(session, folder, team, role) if role else ""


# ── context and diet / 컨텍스트와 다이어트 ─────────────────────────────────────────────────────────────
# A team runs for days, so a role's conversation keeps growing and every request reads all of it again. Past
# its line (diet.at, thousands of tokens) and at rest, a role goes on a diet (bin/hivemux-hook calls stop/start):
#   renew:   it updates its notes, then /clear, then it reads the notes and carries on; its name stays, so the
#            others keep messaging it (@hivemux-diet: notes -> clear -> after)
#   compact: /compact, told what to keep (@hivemux-diet: compacting -> after)
# Nothing is typed while someone is typing in its prompt: it waits for the next rest. Each diet goes to
# .hivemux/diet.log ("<epoch> <role> <how> <tokens before> <tokens after>").
# 팀은 며칠씩 돌아서 역할의 대화가 계속 커지고, 매 요청이 그걸 다시 읽는다. 기준(diet.at, 천 토큰)을 넘고
# 쉬면 다이어트한다 (bin/hivemux-hook 이 stop/start 를 부른다):
#   renew:   노트를 최신으로 정리하고, /clear 하고, 노트를 읽고 이어 간다. 이름이 남아 다른 역할이 계속 보낸다
#   compact: 무엇을 남길지 알려 주고 /compact
# 누가 입력창에 쓰는 중이면 아무것도 치지 않고 다음 쉴 때를 기다린다. 다이어트마다 .hivemux/diet.log 에 남긴다.
def ctx_tokens(transcript):
    """Tokens of context at the last answer: what the next request reads again (input, cache and output)
    마지막 응답 때의 컨텍스트 토큰: 다음 요청이 다시 읽는 양 (입력, 캐시, 출력)"""
    try:
        with open(transcript, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 600_000))
            lines = f.read().decode(errors="replace").splitlines()
    except OSError:
        return 0
    for line in reversed(lines):
        if '"usage"' not in line:
            continue
        try:
            o = json.loads(line)
        except ValueError:
            continue
        m = o.get("message") if isinstance(o, dict) else None
        if o.get("isSidechain") or not isinstance(m, dict) or m.get("role") != "assistant" or not isinstance(m.get("usage"), dict):
            continue
        u = m["usage"]
        return sum(int(u.get(k) or 0) for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens", "output_tokens"))
    return 0


def prompt_free(pane):
    """Claude's prompt is empty (or shows its placeholder): typing there clobbers nothing
    Claude 입력창이 비었다 (또는 안내 문구만): 거기 쳐도 덮어쓰는 것이 없다"""
    lines = [l for l in tmux("capture-pane", "-p", "-t", pane).splitlines() if l.strip()]
    for line in reversed(lines[-12:]):
        t = line.strip()
        if t.startswith("❯"):
            rest = t[1:].strip()
            return not rest or rest.startswith('Try "')
    return False


def type_in(pane, text):
    tmux("send-keys", "-t", pane, "-l", text)
    tmux("send-keys", "-t", pane, "Enter")


def notes_path(folder, rid):
    return os.path.join(team_dir(folder), "notes", rid + ".md")


def role_of(pane):
    """(session, folder, team, role) of a role pane, else None / 역할 칸이면 (세션, 폴더, 팀, 역할)"""
    rid = tmux("show", "-pqv", "-t", pane, "@hivemux-role").strip()
    if not rid:
        return None
    session = tmux("display", "-p", "-t", pane, "#{session_name}").strip()
    folder = find_team(folder_of(tmux("display", "-p", "-t", pane, "#{session_name}").strip()))
    if not folder:
        return None
    team = load(team_dir(folder))
    role = next((r for r in team["role"] if r["id"] == rid), None)
    return (session, folder, team, role) if role else None


def diet_log(folder, rid, how, before, after):
    with open(os.path.join(team_dir(folder), "diet.log"), "a") as f:
        f.write(f"{int(time.time())}\t{rid}\t{how}\t{before}\t{after}\n")


def diet_begin(pane, folder, role, n):
    """Start a diet now, if the prompt is free / 입력창이 비었으면 지금 다이어트를 시작한다"""
    if not prompt_free(pane):
        tmux("set", "-p", "-t", pane, "@hivemux-diet", "pending")     # at the next rest / 다음 쉴 때
        return False
    ko = lang() == "ko"
    tmux("set", "-p", "-t", pane, "@hivemux-diet-before", str(n))
    if role["diet"]["how"] == "compact":
        tmux("set", "-p", "-t", pane, "@hivemux-diet", "compacting")
        type_in(pane, "/compact " + ("역할 노트에 적을 것(지금 상태, 결정, 남은 일, 중요한 파일 경로)과 팀원과 주고받은 요청을 남겨라" if ko
                                    else "keep what the role notes hold (state, decisions, what is left, key file paths) and the requests to and from teammates"))
    else:
        tmux("set", "-p", "-t", pane, "@hivemux-diet", "notes")
        path = notes_path(folder, role["id"])
        type_in(pane, (f"(hivemux 다이어트) 대화가 커져서 곧 새로 시작한다. {path} 를 지금 상태, 결정한 것, 남은 일, 중요한 파일, 사용자에게 물었는데 아직 답이 없는 질문(원문 그대로)으로 최신으로 정리해라. 정리만 하고 다른 일은 하지 마라."
                       if ko else f"(hivemux diet) The conversation is large, so it starts fresh soon. Bring {path} up to date: state, decisions, what is left, key files, and questions to the user still unanswered (word for word). Only that, nothing else."))
    return True


def on_stop(pane, transcript):
    """bin/hivemux-hook, Stop: note the context size; a role past its line goes on a diet
    Stop: 컨텍스트 크기를 적는다. 기준을 넘은 역할은 다이어트한다"""
    n = ctx_tokens(transcript)
    if n:
        tmux("set", "-p", "-t", pane, "@claude_ctx", str(n))
    found = role_of(pane)
    if not found:
        return
    session, folder, team, role = found
    st = tmux("show", "-pqv", "-t", pane, "@hivemux-diet").strip()
    time.sleep(1.5)                     # the prompt comes back after the turn / 응답이 끝나고 입력창이 돌아온다
    if tmux("show", "-pqv", "-t", pane, "@claude_state").strip() not in ("done", "idle"):
        return                          # background work goes on / 배경 일이 이어진다
    if st == "notes":                   # notes written: clear / 노트를 썼다: 비운다
        if prompt_free(pane):
            tmux("set", "-p", "-t", pane, "@hivemux-diet", "clear")
            type_in(pane, "/clear")
        return
    if st == "after":                   # the first answer after it: how small it got / 그 뒤 첫 응답: 얼마나 줄었나
        before = tmux("show", "-pqv", "-t", pane, "@hivemux-diet-before").strip()
        diet_log(folder, role["id"], role["diet"]["how"], before or "0", n)
        tmux("set", "-pu", "-t", pane, "@hivemux-diet")
        tmux("set", "-pu", "-t", pane, "@hivemux-diet-before")
        return
    # an answer that asks the user something stays on screen until the user has answered: a diet then cleared a
    # question before anyone read it / 사용자에게 묻는 답변은 사용자가 답할 때까지 화면에 둔다: 다이어트가 아무도
    # 읽기 전에 질문을 지운 적이 있다
    if not st and asks_user(last_answer(transcript)):
        return
    if st == "pending" or (not st and role["diet"]["how"] != "off" and n >= diet_line(folder, role)):
        diet_begin(pane, folder, role, n)


def last_answer(transcript):
    """The text of the last answer in a conversation / 대화의 마지막 답변 글"""
    try:
        with open(transcript, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 400_000))
            lines = f.read().decode(errors="replace").splitlines()
    except OSError:
        return ""
    for line in reversed(lines):
        if '"assistant"' not in line or '"text"' not in line:
            continue
        try:
            m = json.loads(line).get("message") or {}
        except ValueError:
            continue
        if m.get("role") == "assistant":
            t = "\n".join(c.get("text", "") for c in m.get("content") or [] if isinstance(c, dict) and c.get("type") == "text")
            if t.strip():
                return t
    return ""


def asks_user(text):
    """Does the answer ask the user something? / 답변이 사용자에게 무언가 묻나"""
    t = text[-3000:]
    return bool(re.search(r"\?\s*($|\n)|질문|답해 주|알려 주|정해 주|골라 주|확인해 주|답을 받|답변.*기다|would you|should I|do you want|let me know|please (confirm|choose|tell)", t, re.I))


def diet_line(folder, role):
    """Tokens past which the role diets. A fresh start comes back at 45-70K (prompt, CLAUDE.md, notes, files read
    again), so right after a diet the line moves up: 50K above where it came back to, and for 20 minutes half
    as much again. Without this a role with a low line dieted every two minutes.
    역할이 다이어트하는 토큰 기준. 새로 시작해도 45~70K 로 돌아오므로 (지시문, CLAUDE.md, 노트, 다시 읽은 파일)
    다이어트 직후에는 기준을 올린다: 돌아온 크기보다 50K 위, 20분 동안은 1.5배. 이것 없이는 기준이 낮은
    역할이 2분마다 다이어트했다."""
    line = int(role["diet"]["at"]) * 1000
    try:
        last = [l.rstrip("\n").split("\t") for l in open(os.path.join(team_dir(folder), "diet.log")) if l.split("\t")[1:2] == [role["id"]]][-1]
    except (OSError, IndexError):
        return line
    if len(last) == 5 and last[0].isdigit() and last[4].isdigit():
        ago = time.time() - int(last[0])
        if ago < 3 * 3600:
            line = max(line, int(last[4]) + 50_000)
        if ago < 20 * 60:
            line = max(line, int(role["diet"]["at"]) * 1500)
    return line


def on_start(pane, sid, source):
    """bin/hivemux-hook, SessionStart: remember the conversation; after a diet's /clear, carry on from the notes
    SessionStart: 대화를 적는다. 다이어트의 /clear 뒤에는 노트로 이어 간다"""
    record(pane, sid)
    st = tmux("show", "-pqv", "-t", pane, "@hivemux-diet").strip()
    found = role_of(pane)
    if not found:
        return
    session, folder, team, role = found
    if st == "clear" and source == "clear":
        time.sleep(1.0)
        tmux("set", "-p", "-t", pane, "@hivemux-diet", "after")
        path = notes_path(folder, role["id"])
        type_in(pane, (f"(hivemux 다이어트 뒤 새로 시작) {path} 를 읽고 하던 일을 이어서 해라. 사용자의 답을 기다리는 질문이 있으면 그 질문을 원문 그대로 다시 보여 줘라. 이어서 할 일이 없으면 기다려라."
                       if lang() == "ko" else f"(hivemux: fresh start after a diet) Read {path} and carry on with your work. If questions to the user are still unanswered, show them again word for word. If nothing is left, wait."))
    elif st == "compacting" and source == "compact":
        tmux("set", "-p", "-t", pane, "@hivemux-diet", "after")


# ── hand-offs / 넘김 ───────────────────────────────────────────────────────────────────────────────────
# A role messaging a teammate (SendMessage, seen by bin/hivemux-hook) is a hand-off: it goes to
# .hivemux/handoffs.log ("<epoch> <from> <to> <summary>"), to the project's @hivemux-handoff (the sidebar's line)
# and to @hivemux-letters (the bee office flies a letter from one desk to the other).
# 역할이 팀원에게 메시지를 보내면 (SendMessage, bin/hivemux-hook 이 본다) 넘김이다: handoffs.log, 프로젝트의
# @hivemux-handoff (사이드바 한 줄), @hivemux-letters (벌 사무실이 편지를 이 책상에서 저 책상으로 날린다) 에 남긴다.
def role_by_address(session, team, to):
    """The role a message went to: by its session name, or (a reply) by the address of its Claude,
    uds:/…/<pid>.sock, whose parent is the role's pane / 메시지를 받은 역할: 세션 이름으로, 또는 (답장) 그 Claude 의
    주소 uds:/…/<pid>.sock 로. 그 부모가 역할 칸이다"""
    r = next((r for r in team["role"] if f"{session}-{r['id']}" == to or r["id"] == to), None)
    m = re.search(r"/(\d+)\.sock$", to or "")
    if r or not m:
        return r
    out = subprocess.run(["ps", "-o", "ppid=", "-p", m.group(1)], capture_output=True, text=True).stdout.strip()
    pp = {l.split()[0]: l.split()[1] for l in tmux("list-panes", "-s", "-t", f"={session}", "-F", "#{pane_pid} #{@hivemux-role}").splitlines() if len(l.split()) == 2}
    rid = pp.get(out)
    return next((r for r in team["role"] if r["id"] == rid), None)


def handoff(pane, to, summary):
    found = role_of(pane)
    if not found:
        return
    session, folder, team, role = found
    dest = role_by_address(session, team, to)
    dest_pane = next((p["pane"] for p in panes(session) if dest and p["role"] == dest["id"]), "")
    text = " ".join(str(summary).split())[:160]
    now = int(time.time())
    with open(os.path.join(team_dir(folder), "handoffs.log"), "a") as f:
        f.write(f"{now}\t{role['id']}\t{dest['id'] if dest else to}\t{text}\n")
    to_name = label(dest) if dest else to
    tmux("set", "-t", f"={session}:", "@hivemux-handoff", f"{now}\t{label(role)}\t{to_name}\t{text}")
    old = [l for l in tmux("show", "-gqv", "@hivemux-letters").split("\n") if l.count("\t") == 5]
    letters = (old + [f"{now}\t{pane}\t{dest_pane}\t{label(role)}\t{to_name}\t{text}"])[-8:]
    tmux("set", "-g", "@hivemux-letters", "\n".join(letters))


def handoffs(folder, team, n=30):
    """The last hand-offs of a project, newest first, with the roles' names / 프로젝트의 최근 넘김, 최신부터"""
    names = {r["id"]: label(r) for r in team["role"]}
    try:
        lines = open(os.path.join(team_dir(folder), "handoffs.log"), encoding="utf-8").read().splitlines()[-n:]
    except OSError:
        return []
    out = []
    for line in reversed(lines):
        p = line.split("\t", 3)
        if len(p) == 4 and p[0].isdigit():
            out.append({"at": int(p[0]), "from": p[1], "to": p[2], "fromName": names.get(p[1], p[1]),
                        "toName": names.get(p[2], p[2]), "text": p[3]})
    return out


# ── getting started: the folder trust question and the team's goal / 시작하기: 폴더 신뢰 질문과 팀 목표 ──────
def needs_trust(pane):
    """Claude asks whether to trust the folder (a folder it never opened) / Claude 가 폴더를 믿을지 묻는다"""
    screen = tmux("capture-pane", "-p", "-t", pane)
    return "trust this folder" in screen and "Enter to confirm" in screen


def trust(session):
    """Answer yes to the trust question in each role waiting on it (the team page's button, which shows the
    folder first) / 신뢰 질문에서 멈춘 역할마다 예로 답한다 (팀 화면 버튼. 폴더를 먼저 보여 준다)"""
    session, folder = project(session)
    n = 0
    for p in panes(session):
        if p["role"] and not SHELLS.match(p["cmd"]) and needs_trust(p["pane"]):
            for _ in range(3):              # move the choice to "Yes", check, then confirm / "Yes" 로 옮기고 확인한 뒤 누른다
                sel = next((l for l in tmux("capture-pane", "-p", "-t", p["pane"]).splitlines() if l.strip().startswith("❯")), "")
                if "Yes" in sel:
                    tmux("send-keys", "-t", p["pane"], "Enter")
                    n += 1
                    break
                tmux("send-keys", "-t", p["pane"], "Down")
                time.sleep(0.2)
    print(tr(f"{n}개 역할이 {folder} 를 믿고 시작합니다", f"{n} role(s) trust {folder} and start"))


def kickoff(session, goal):
    """Give the lead the team's goal, worded so it plans and hands the work out
    리드에게 팀 목표를 준다. 계획을 세우고 일을 나눠 맡기도록 다듬어서"""
    session, folder = project(session)
    goal = " ".join(str(goal).split())[:600]
    if not goal:
        die(tr("목표를 적어 주세요", "Write the goal"))
    team = load(team_dir(folder))
    lead = next((r for r in team["role"] if r["lead"]), None) or (team["role"] or [None])[0]
    p = lead and next((p for p in panes(session) if p["role"] == lead["id"] and not SHELLS.match(p["cmd"])), None)
    if not p:
        die(tr("리드가 아직 돌고 있지 않습니다. 먼저 팀을 시작하세요", "The lead is not running. Start the team first"))
    if needs_trust(p["pane"]):
        die(tr("리드가 폴더 신뢰 확인을 기다립니다. 먼저 폴더를 확인하세요", "The lead waits on the folder trust question. Answer it first"))
    if not prompt_free(p["pane"]):
        die(tr(f"{label(lead)} 의 입력창에 쓰던 글이 있습니다. 비운 뒤 다시 보내세요", f"{label(lead)} has text in its prompt. Clear it, then send again"))
    # the bee office gathers the team in the meeting room for a while / 벌 사무실이 팀을 잠시 회의실에 모은다
    tmux("set", "-t", f"={session}:", "@hivemux-kickoff", f"{int(time.time())}\t{goal[:80]}")
    type_in(p["pane"], tr(f"팀 목표: {goal} — 너는 리드다. 이 목표로 계획을 세우고, 일을 작게 나눠 팀원에게 메시지로 맡겨라. "
                          "시작 전에 내가 정해야 할 것이 있으면 한 번에 모아 먼저 물어라.",
                          f"Team goal: {goal} — You are the lead. Plan for this goal, split the work into small pieces and hand them "
                          "to teammates by message. If anything needs my decision before starting, ask me first, all at once."))
    print(tr(f"{label(lead)}에게 보냈습니다", f"Sent to {label(lead)}"))


# ── the day's report / 하루 리포트 ─────────────────────────────────────────────────────────────────────
# Read from the team's logs: states.log and files.log (bin/hivemux-hook), handoffs.log, diet.log, the honey
# ledger, the roles' conversations (tokens) and their branches (commits). The team page draws it (/report).
# 팀 기록에서 읽는다: states.log 와 files.log (bin/hivemux-hook), handoffs.log, diet.log, 꿀 장부, 역할 대화 (토큰),
# 역할 브랜치 (커밋). 팀 화면이 그린다 (/report).
def _log(folder, name, start, end, parts):
    out = []
    try:
        for line in open(os.path.join(team_dir(folder), name), encoding="utf-8", errors="replace"):
            p = line.rstrip("\n").split("\t", parts - 1)
            if len(p) == parts and p[0].isdigit() and start <= int(p[0]) < end:
                out.append(p)
    except OSError:
        pass
    return out


def _transcript(sid):
    import glob
    hits = glob.glob(os.path.join(os.path.expanduser("~/.claude/projects"), "*", sid + ".jsonl"))
    return hits[0] if hits else None


def _tokens(sids, start, end):
    """Tokens the role's requests read and wrote that day, and by which model / 그날 역할의 요청이 읽고 쓴 토큰과 모델"""
    import datetime
    total, models, seen = 0, {}, set()
    for sid in sids:
        path = _transcript(sid)
        if not path:
            continue
        try:
            f = open(path, encoding="utf-8", errors="replace")
        except OSError:
            continue
        with f:
            for line in f:
                if '"usage"' not in line:
                    continue
                try:
                    o = json.loads(line)
                except ValueError:
                    continue
                m = o.get("message") if isinstance(o, dict) else None
                if not isinstance(m, dict) or m.get("role") != "assistant" or not isinstance(m.get("usage"), dict):
                    continue
                if m.get("id") in seen:
                    continue
                try:
                    at = datetime.datetime.fromisoformat(str(o.get("timestamp", "")).replace("Z", "+00:00")).timestamp()
                except ValueError:
                    continue
                if not start <= at < end:
                    continue
                seen.add(m.get("id"))
                u = m["usage"]
                n = sum(int(u.get(k) or 0) for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens", "output_tokens"))
                total += n
                key = re.sub(r"^claude-|-\d.*$", "", str(m.get("model", "")))
                models[key] = models.get(key, 0) + n
    return total, models


def report(session, date=None):
    """One day of the team, as data for the report page / 팀의 하루, 리포트 화면용 자료"""
    import datetime
    session, folder = project(session)
    team = load(team_dir(folder))
    day = datetime.date.fromisoformat(date) if date else datetime.date.today()
    start = int(datetime.datetime.combine(day, datetime.time()).timestamp())
    end = start + 86400
    now = int(time.time())
    names = {r["id"]: label(r) for r in team["role"]}
    roles = {r["id"]: {"id": r["id"], "name": label(r), "model": r["model"], "effort": r["effort"], "segs": [], "work": 0,
                       "files": [], "commits": [], "tokens": 0, "models": {}, "diets": 0, "honey": 0, "handoffs": 0} for r in ranked(team)}
    # states: what each role did when (a state lasts until the next one) / 상태: 다음 상태까지 이어진다
    by = {}
    for at, rid, st in _log(folder, "states.log", start - 86400, end, 3):
        by.setdefault(rid, []).append((int(at), st))
    for rid, ev in by.items():
        if rid not in roles:
            continue
        ev.sort()
        for i, (at, st) in enumerate(ev):
            if st not in ("run", "wait"):
                continue
            stop = ev[i + 1][0] if i + 1 < len(ev) else min(now, end)
            a, b = max(at, start), min(stop, end, at + 4 * 3600)     # a lost end counts four hours at most / 끝을 놓쳐도 최대 4시간
            if b - a < 20:
                continue
            segs = roles[rid]["segs"]
            if segs and segs[-1]["kind"] == st and a - segs[-1]["end"] < 90:
                segs[-1]["end"] = b
            else:
                segs.append({"start": a, "end": b, "kind": st})
    for r in roles.values():
        r["work"] = sum(x["end"] - x["start"] for x in r["segs"] if x["kind"] == "run")
    hand = []
    for at, frm, to, text in _log(folder, "handoffs.log", start, end, 4):
        if to not in names:                 # a reply logged by its address / 주소로 남은 답장
            r = role_by_address(session, team, to)
            to = r["id"] if r else to
            names.setdefault(to, tr("다른 세션", "another session"))
        hand.append({"at": int(at), "from": frm, "to": to, "fromName": names.get(frm, frm), "toName": names.get(to, to), "text": text})
        for k in (frm, to):
            if k in roles:
                roles[k]["handoffs"] += 1
    diets = []
    for at, rid, how, before, after in _log(folder, "diet.log", start, end, 5):
        diets.append({"at": int(at), "role": rid, "name": names.get(rid, rid), "how": how,
                      "before": int(before) if before.isdigit() else 0, "after": int(after) if after.isdigit() else 0})
        if rid in roles:
            roles[rid]["diets"] += 1
    outputs, seen = [], set()
    for at, rid, path in _log(folder, "files.log", start, end, 3):
        rel = path
        for base in (worktree_of(folder, {"id": rid}), folder):
            if path.startswith(base + "/"):
                rel = os.path.relpath(path, base)
                break
        if rid in roles and (rid, rel) not in seen:
            seen.add((rid, rel))
            roles[rid]["files"].append(rel)
            outputs.append({"role": rid, "name": names.get(rid, rid), "path": rel, "at": int(at), "new": not os.path.exists(path) or os.path.getctime(path) >= start})
    # honey: the bee is "<project>/<window name>", the role's name / 꿀: 벌은 "<프로젝트>/<창 이름>" (역할 이름)
    win = {}
    for r in team["role"]:
        for n in (r.get("name"), r.get("name_en"), r["id"]):
            if n:
                win[f"{session}/{n}"] = r["id"]
    ledger = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "hivemux", "honey.log")
    try:
        for line in open(ledger, encoding="utf-8", errors="replace"):
            p = line.split(" ", 2)
            if len(p) >= 2 and p[0].isdigit() and start <= int(p[0]) < end and p[1] in win:
                roles[win[p[1]]]["honey"] += 1
    except OSError:
        pass
    allsids = {}
    try:
        for line in open(os.path.join(team_dir(folder), "sessions.tsv")):
            p = line.rstrip("\n").split("\t")
            if len(p) >= 2:
                allsids.setdefault(p[0], []).append(p[1])
    except OSError:
        pass
    for rid, r in roles.items():
        r["tokens"], r["models"] = _tokens(allsids.get(rid, []), start, end)
        rr = next(x for x in team["role"] if x["id"] == rid)
        if rr["worktree"]:
            g = subprocess.run(["git", "-C", folder, "log", f"team/{rid}", f"--since=@{start}", f"--until=@{end}", "--format=%h\t%ct\t%s"],
                               capture_output=True, text=True)
            r["commits"] = [{"hash": a, "at": int(b), "subject": c} for a, b, c in
                            (l.split("\t", 2) for l in g.stdout.splitlines() if l.count("\t") == 2)]
    waits = sorted(({"role": rid, "name": r["name"], "start": x["start"], "end": x["end"]} for rid, r in roles.items()
                    for x in r["segs"] if x["kind"] == "wait"), key=lambda w: w["end"] - w["start"], reverse=True)[:5]
    try:
        summary = open(os.path.join(team_dir(folder), "reports", f"{day.isoformat()}.md"), encoding="utf-8").read()
    except OSError:
        summary = ""
    # the day's span: work, hand-offs and diets / 하루의 범위: 일, 넘김, 다이어트
    times = [x[k] for r in roles.values() for x in r["segs"] for k in ("start", "end")] + [h["at"] for h in hand] + [d["at"] for d in diets]
    return {"project": session, "folder": folder, "date": day.isoformat(), "team": label(team), "flow": team.get("flow") or list(roles),
            "start": min(times, default=start + 9 * 3600), "end": max(times, default=start + 18 * 3600),
            "roles": list(roles.values()), "handoffs": hand, "diets": diets, "outputs": outputs[-40:], "waits": waits, "summary": summary,
            "today": day == datetime.date.today(), "first": first_day(folder)}


def first_day(folder):
    """The day the team began: its first logged state or hand-off, else when its folder was made
    팀이 시작한 날: 처음 기록된 상태나 넘김, 없으면 폴더를 만든 때"""
    import datetime
    d = team_dir(folder)
    at = []
    for name in ("states.log", "handoffs.log"):
        try:
            with open(os.path.join(d, name), encoding="utf-8") as f:
                head = f.readline().split("\t", 1)[0]
            if head.isdigit():
                at.append(int(head))
        except OSError:
            pass
    if not at:
        try:
            st = os.stat(d)
            at.append(int(getattr(st, "st_birthtime", st.st_mtime)))
        except OSError:
            return datetime.date.today().isoformat()
    return datetime.date.fromtimestamp(min(at)).isoformat()


def summarize(session, date=None):
    """A short story of the day by a small model (asked for on the report page), kept in .hivemux/reports/
    작은 모델이 쓰는 하루 이야기 (리포트 화면에서 요청), .hivemux/reports/ 에 남긴다"""
    rep = report(session, date)
    digest = {"team": rep["team"], "date": rep["date"],
              "roles": [{"name": r["name"], "worked_minutes": r["work"] // 60, "files": r["files"][:12], "commits": [c["subject"] for c in r["commits"]][:8]} for r in rep["roles"]],
              "handoffs": [f"{time.strftime('%H:%M', time.localtime(h['at']))} {h['fromName']} -> {h['toName']}: {h['text']}" for h in rep["handoffs"]][:60],
              "waits": [f"{w['name']} {(w['end'] - w['start']) // 60}min" for w in rep["waits"]]}
    ask = tr("아래는 한 팀의 하루 기록이다. 하루에 일이 어떻게 흘렀는지 한국어 한 문단(4~6문장, 평서문 '~했습니다')으로 써라. "
             "역할 이름을 주어로 쓰고, 넘김 순서대로, 막힌 것과 끝낸 것을 담아라. 기록에 없는 것은 쓰지 마라. 문단만 출력하라.\n\n",
             "Below is one team's day. Write one paragraph (4-6 sentences) on how the work flowed: roles as subjects, in hand-off "
             "order, with what got stuck and what got done. Nothing that is not in the record. Output the paragraph only.\n\n")
    claude = shlex.split(claude_cmd())
    r = subprocess.run(claude + ["-p", "--model", "haiku", ask + json.dumps(digest, ensure_ascii=False)],
                       capture_output=True, text=True, timeout=180, stdin=subprocess.DEVNULL, cwd=rep["folder"])
    text = r.stdout.strip()
    if r.returncode != 0 or not text:
        die(tr("요약을 만들지 못했습니다", "Could not write the summary") + (f": {r.stderr.strip()[:200]}" if r.stderr.strip() else ""))
    d = os.path.join(team_dir(rep["folder"]), "reports")
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, f"{rep['date']}.md"), "w", encoding="utf-8") as f:
        f.write(text + "\n")
    return text


def diet_now(session, rid):
    """The team page's diet button: now if it rests, else at its next rest / 팀 화면의 다이어트 버튼: 쉬면 지금, 아니면 다음 쉴 때"""
    session, folder = project(session)
    p = next((p for p in panes(session) if p["role"] == rid and not SHELLS.match(p["cmd"])), None)
    if not p:
        die(tr("그 역할은 지금 돌고 있지 않습니다", "That role is not running"))
    team = load(team_dir(folder))
    role = next(r for r in team["role"] if r["id"] == rid)
    if p["state"] in ("done", "idle") and diet_begin(p["pane"], folder, role, int(p["ctx"] or 0)):
        print(tr(f"{label(role)}: 다이어트를 시작했습니다", f"{label(role)}: diet started"))
    else:
        tmux("set", "-p", "-t", p["pane"], "@hivemux-diet", "pending")
        print(tr(f"{label(role)}: 일을 마치고 쉬면 다이어트합니다", f"{label(role)}: diets once it finishes and rests"))


def main(argv):
    def opt(name, default=None):
        if name in argv:
            i = argv.index(name)
            v = argv[i + 1] if i + 1 < len(argv) else default
            del argv[i:i + 2]
            return v
        return default
    session = opt("-s") or opt("--session")
    only = opt("--role")
    force = "--force" in argv and not argv.remove("--force")
    as_json = "--json" in argv and not argv.remove("--json")
    cmd, args = (argv[0] if argv else "help"), argv[1:]
    if cmd == "templates":
        ts = templates()
        if as_json:
            print(json.dumps(ts, ensure_ascii=False))
        else:
            for t in ts:
                print(f"{t['id']:<16} {t['name']} · {len(t['roles'])}{tr('명', ' roles')}" + ("" if t["builtin"] else tr(" (내 템플릿)", " (yours)")))
    elif cmd == "use" and args:
        use(args[0], session, force)
    elif cmd == "up":
        up(session, only)
    elif cmd == "down":
        down(session, only)
    elif cmd == "status":
        print(json.dumps(status(session), ensure_ascii=False))
    elif cmd == "prompt" and args:
        s, folder = project(session)
        team = load(team_dir(folder))
        role = next((r for r in team["role"] if r["id"] == args[0]), None) or die(tr("역할이 없습니다", "No such role"))
        sys.stdout.write(build_prompt(s, folder, team, role))
    elif cmd == "save" and args:
        save(args[0], session)
    elif cmd == "resume-args" and len(args) == 3:
        print(resume_args(*args))
    elif cmd == "record" and len(args) == 2:
        record(*args)
    elif cmd == "stop" and len(args) == 2:
        on_stop(*args)
    elif cmd == "start" and len(args) == 3:
        on_start(*args)
    elif cmd == "handoff" and len(args) == 3:
        handoff(*args)
    elif cmd == "rename" and args:
        rename_team(session, " ".join(args))
    elif cmd == "trust":
        trust(session)
    elif cmd == "goal" and args:
        kickoff(session, " ".join(args))
    elif cmd == "report":
        print(json.dumps(report(session, args[0] if args else None), ensure_ascii=False))
    elif cmd == "summarize":
        print(summarize(session, args[0] if args else None))
    elif cmd == "diet" and args:
        diet_now(session, args[0])
    else:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
