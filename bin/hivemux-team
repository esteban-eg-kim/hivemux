#!/usr/bin/env python3
"""A team: Claudes with roles in one project (planner, dev, QA...), each in its own window, passing work to each
other by name with Claude Code's messages between sessions.
팀: 한 프로젝트 안의 역할이 다른 Claude 들 (기획, 개발, QA...). 역할마다 자기 창에서 돌고, Claude Code 의
세션 간 메시지로 서로 이름을 불러 일을 넘긴다.

  hivemux-team templates [--json]             the templates: built in (share/teams) and yours / 기본 템플릿과 내 템플릿
  hivemux-team use <template> [-s S] [--force]  copy a template into the project's .hivemux/ / 템플릿을 프로젝트 .hivemux/ 로
  hivemux-team up [-s S] [--role R]           open the roles not running yet / 아직 안 도는 역할을 연다
  hivemux-team down [-s S] [--role R]         stop the roles' Claudes; the conversations stay (like clocking out)
                                              역할의 Claude 를 끈다. 대화는 남는다 (퇴근처럼)
  hivemux-team status [-s S]                  the team and each role's pane and state, as JSON / 팀과 역할별 칸, 상태 (JSON)
  hivemux-team prompt <role> [-s S]           the role's full prompt (its file + the team block) / 역할의 최종 지시문
  hivemux-team save <id> [-s S]               keep this project's team as your template / 이 프로젝트의 팀을 내 템플릿으로
  hivemux-team resume-args <target> <sid> <cwd>   (resume paths) the role flags for that conversation, if it is a role
                                              (재개하는 곳에서) 그 대화가 역할이면 역할 실행 옵션
  hivemux-team record <pane> <sid>            (bin/hivemux-hook, SessionStart) remember which conversation a role runs
                                              (bin/hivemux-hook, SessionStart) 역할이 어느 대화로 도는지 적는다
-s S: the project (tmux session); default the current one / 프로젝트 (tmux 세션). 기본은 지금 것

A template is one folder, team.toml + roles/<role>.md (<role>.en.md in English), so it can be shared as is.
In a project it is copied to <project>/.hivemux/, which also keeps:
템플릿은 폴더 하나 (team.toml + roles/<역할>.md, 영어는 <역할>.en.md) 라 그대로 나눌 수 있다. 프로젝트에서는
<프로젝트>/.hivemux/ 로 복사되고, 거기 이것도 둔다:
  notes/<role>.md     the role's notes: state, decisions, what is left (it keeps them; read after a fresh start)
                      역할 노트: 상태, 결정, 남은 일 (역할이 직접 쓴다. 새로 시작하면 먼저 읽는다)
  run/<role>.md       the prompt it was started with (role file + team block) / 시작할 때 쓴 지시문 (역할 파일 + 팀 블록)
  sessions.tsv        "<role> <session id>" as conversations start / 대화가 시작될 때마다
  worktrees/<role>/   a role with worktree = true works there, on branch team/<role> / worktree = true 인 역할의 작업 위치
A role's Claude is `claude -n <project>-<role> --model … --effort … --append-system-prompt-file run/<role>.md`
(readonly: without Edit and Write), in a window named after the role. Its conversation is named <project>-<role>,
the name the others message it by. After a reboot or an update hivemux resumes it with the same flags
(resume-args), since `claude --resume` alone would drop them.
역할의 Claude 는 역할 이름의 창에서 위 명령으로 돈다 (readonly: Edit, Write 없이). 대화 이름 <프로젝트>-<역할> 이
다른 역할이 메시지를 보내는 이름이다. 재부팅이나 업데이트 뒤에도 같은 옵션으로 재개한다 (resume-args).
`claude --resume` 만으로는 옵션이 빠지기 때문이다.
"""
import json, os, re, shlex, shutil, subprocess, sys, time

HERE = os.path.dirname(os.path.realpath(__file__))
TMUX = shutil.which("tmux") or "/opt/homebrew/bin/tmux"
BUILTIN = os.path.join(os.path.dirname(HERE), "share", "teams")
MINE = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "hivemux", "teams")
SHELLS = re.compile(r"^-?(zsh|bash|fish|sh|dash|tcsh|ksh|login)$")
MODELS = ("opus", "sonnet", "haiku")
EFFORTS = ("low", "medium", "high", "xhigh", "max")
READONLY_TOOLS = "Edit,Write,NotebookEdit"


def tmux(*a):
    return subprocess.run([TMUX, *a], capture_output=True, text=True, stdin=subprocess.DEVNULL).stdout


def lang():
    v = os.environ.get("HIVEMUX_LANG") or tmux("show", "-gqv", "@hivemux-lang").strip()
    return "ko" if (v or os.environ.get("LANG", "")).startswith("ko") else "en"


def tr(ko, en):
    return ko if lang() == "ko" else en


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


# ── team.toml: the subset templates use (Python 3.9 on macOS has no tomllib) ─────────────────────────────
# ── team.toml: 템플릿이 쓰는 부분만 (macOS 의 Python 3.9 에는 tomllib 이 없다) ────────────────────────────
def _value(s, i):
    """Parse one value at s[i:]: "string", number, true/false, [array], {inline table}. Returns (value, next i)."""
    while s[i] in " \t\n":
        i += 1
    c = s[i]
    if c == '"':
        out, i = [], i + 1
        while s[i] != '"':
            if s[i] == "\\":
                i += 1
                out.append({"n": "\n", "t": "\t", '"': '"', "\\": "\\"}.get(s[i], s[i]))
            else:
                out.append(s[i])
            i += 1
        return "".join(out), i + 1
    if c in "[{":
        close, items, i = "]" if c == "[" else "}", [] if c == "[" else {}, i + 1
        while True:
            while s[i] in " \t\n,":
                i += 1
            if s[i] == close:
                return items, i + 1
            if c == "[":
                v, i = _value(s, i)
                items.append(v)
            else:
                m = re.compile(r"\s*([A-Za-z0-9_-]+)\s*=").match(s, i)
                v, i = _value(s, m.end())
                items[m.group(1)] = v
    m = re.compile(r"true|false|-?\d+(\.\d+)?").match(s, i)
    if not m:
        raise ValueError("bad value near: " + s[i:i + 20])
    t = m.group(0)
    return (t == "true") if t in ("true", "false") else (float(t) if "." in t else int(t)), m.end()


def _strip_comment(line):
    q = False
    for i, ch in enumerate(line):
        if ch == '"' and (i == 0 or line[i - 1] != "\\"):
            q = not q
        elif ch == "#" and not q:
            return line[:i]
    return line


def toml_loads(text):
    try:
        import tomllib
        return tomllib.loads(text)
    except ImportError:
        pass
    root, cur = {}, None
    cur = root
    lines = [_strip_comment(l) for l in text.splitlines()]
    k = 0
    while k < len(lines):
        line = lines[k].strip()
        k += 1
        if not line:
            continue
        if line.startswith("[["):
            name = line.strip("[] ")
            cur = {}
            root.setdefault(name, []).append(cur)
        elif line.startswith("["):
            name = line.strip("[] ")
            cur = root.setdefault(name, {})
        else:
            key, _, rest = line.partition("=")
            # an array or table may go on over lines / 배열이나 표는 여러 줄에 걸칠 수 있다
            while rest.count("[") > rest.count("]") or rest.count("{") > rest.count("}"):
                rest += "\n" + lines[k]
                k += 1
            cur[key.strip()], _ = _value(rest + "\n", 0)
    return root


def _toml_value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return str(v)
    if isinstance(v, list):
        return "[" + ", ".join(_toml_value(x) for x in v) + "]"
    if isinstance(v, dict):
        return "{ " + ", ".join(f"{k} = {_toml_value(x)}" for k, x in v.items()) + " }"
    return json.dumps(str(v), ensure_ascii=False)


def toml_dumps(d):
    out = []
    for k, v in d.items():
        if not isinstance(v, dict) and not (isinstance(v, list) and v and isinstance(v[0], dict)):
            out.append(f"{k} = {_toml_value(v)}")
    for k, v in d.items():
        if isinstance(v, dict):
            out += ["", f"[{k}]"] + [f"{a} = {_toml_value(b)}" for a, b in v.items()]
    for k, v in d.items():
        if isinstance(v, list) and v and isinstance(v[0], dict):
            for t in v:
                out += ["", f"[[{k}]]"] + [f"{a} = {_toml_value(b)}" for a, b in t.items()]
    return "\n".join(out) + "\n"


# ── teams ──────────────────────────────────────────────────────────────────────────────────────────────
def load(folder):
    """team.toml of a template or a project's .hivemux/, with each role's defaults filled in
    템플릿이나 프로젝트 .hivemux/ 의 team.toml. 역할마다 기본값을 채운다"""
    with open(os.path.join(folder, "team.toml"), encoding="utf-8") as f:
        team = toml_loads(f.read())
    diet = {"at": 60, "how": "renew", **(team.get("diet") or {})}
    roles = []
    for r in team.get("role") or []:
        if not re.fullmatch(r"[a-z][a-z0-9_-]{0,23}", str(r.get("id", ""))):
            continue
        r = {"model": "sonnet", "effort": "medium", "prompt": f"roles/{r['id']}.md", "lead": False, "readonly": False,
             "worktree": False, "owns": "", **r}
        r["diet"] = {**diet, **(r.get("diet") or {})}
        roles.append(r)
    team["role"] = roles
    team["diet"] = diet
    team["folder"] = folder
    return team


def label(obj, key="name"):
    """The Korean or English field (name / name_en) / 한국어 또는 영어 칸"""
    return (lang() == "en" and obj.get(key + "_en")) or obj.get(key) or obj.get("id", "")


def templates():
    out = []
    for base, builtin in ((BUILTIN, True), (MINE, False)):
        if not os.path.isdir(base):
            continue
        for d in sorted(os.listdir(base)):
            if os.path.isfile(os.path.join(base, d, "team.toml")):
                try:
                    t = load(os.path.join(base, d))
                except (OSError, ValueError, KeyError, AttributeError) as e:
                    print(f"hivemux-team: {d}: {e}", file=sys.stderr)
                    continue
                out.append({"id": t.get("id") or d, "name": label(t), "description": label(t, "description"),
                            "builtin": builtin, "path": t["folder"], "flow": t.get("flow") or [r["id"] for r in t["role"]],
                            "roles": [{"id": r["id"], "name": label(r), "model": r["model"], "effort": r["effort"]} for r in t["role"]]})
    return out


def project(session):
    """(session, folder) of the project: the tmux session and its folder / 프로젝트의 tmux 세션과 폴더"""
    if not session:
        session = os.environ.get("TMUX") and tmux("display", "-p", "#{session_name}").strip()
    if not session:
        die(tr("프로젝트를 정하세요: -s <세션> (tmux 안에서는 지금 세션)", "Name the project: -s <session> (inside tmux: the current one)"))
    folder = tmux("display", "-p", "-t", f"={session}:", "#{session_path}").strip()
    if not folder:
        die(tr(f"프로젝트가 없습니다: {session}", f"No such project: {session}"))
    return session, folder


def team_dir(folder):
    return os.path.join(folder, ".hivemux")


def role_text(team, role):
    """The role's own prompt file, in English when there is one and the screen is English
    역할 지시문 파일. 화면이 영어이고 영어 파일이 있으면 그것"""
    path = os.path.join(team["folder"], role["prompt"])
    en = re.sub(r"\.md$", ".en.md", path)
    if lang() == "en" and os.path.isfile(en):
        path = en
    try:
        with open(path, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def worktree_of(folder, role):
    return os.path.join(team_dir(folder), "worktrees", role["id"])


def build_prompt(session, folder, team, role):
    """The role file plus the team block: who the others are, the names to message, how to hand off, the notes
    역할 파일과 팀 블록: 다른 역할, 메시지를 보낼 이름, 넘기는 방법, 노트"""
    ko = lang() == "ko"
    lead = next((r for r in team["role"] if r["lead"]), None)
    me = f"{session}-{role['id']}"
    lines = [role_text(team, role), "", "## 팀 (hivemux)" if ko else "## Team (hivemux)"]
    lines.append((f"프로젝트: {session} ({folder})" if ko else f"Project: {session} ({folder})"))
    lines.append((f"너: {me} ({label(role)}" if ko else f"You: {me} ({label(role)}") + (", 리드)" if ko and role["lead"] else ", lead)" if role["lead"] else ")"))
    lines.append("팀원 (세션 간 메시지 SendMessage 로 이 이름에 보낸다):" if ko else "Teammates (message them by these names with SendMessage):")
    for r in team["role"]:
        if r["id"] == role["id"]:
            continue
        bits = [label(r)] + (["리드" if ko else "lead"] if r["lead"] else [])
        owns = r["owns"] if not r["worktree"] else ("자기 워크트리" if ko else "its own worktree")
        lines.append(f"- {session}-{r['id']}: {', '.join(bits)}" + (f" · {'맡는 곳' if ko else 'owns'}: {owns}" if owns else ""))
    if ko:
        lines.append("넘길 때는 짧게: 무엇을 했는지 한 줄, 결과 파일 경로, 상대에게 바라는 것, 확인하는 방법.")
        if lead and lead["id"] != role["id"]:
            lines.append(f"막히거나 판단이 필요하면 리드({session}-{lead['id']})에게 보낸다.")
        lines.append("다른 역할이 맡은 곳의 파일은 고치지 않는다.")
        if role["readonly"]:
            lines.append("너는 읽기 전용 역할이다. 파일을 고치지 않고, 고칠 것은 맡은 역할에게 넘긴다.")
        if role["worktree"]:
            lines.append(f"너는 자기 워크트리 {worktree_of(folder, role)} 에서 브랜치 team/{role['id']} 로 일한다.")
        lines += ["", "## 노트",
                  f"{os.path.join(team_dir(folder), 'notes', role['id'] + '.md')} 를 최신으로 둔다: 지금 상태, 결정한 것, 남은 일, 중요한 파일.",
                  "일을 한 차례 끝낼 때마다 고친다. 대화가 비워지면(새로 시작) 이 노트를 먼저 읽고 이어 간다."]
    else:
        lines.append("Hand off briefly: what you did in one line, the result's file path, what you want from them, how to check it.")
        if lead and lead["id"] != role["id"]:
            lines.append(f"When blocked or a decision is needed, message the lead ({session}-{lead['id']}).")
        lines.append("Do not change files another role owns.")
        if role["readonly"]:
            lines.append("You are a read-only role: do not change files; hand what needs fixing to the role that owns it.")
        if role["worktree"]:
            lines.append(f"You work in your own worktree {worktree_of(folder, role)}, on branch team/{role['id']}.")
        lines += ["", "## Notes",
                  f"Keep {os.path.join(team_dir(folder), 'notes', role['id'] + '.md')} current: state, decisions, what is left, key files.",
                  "Update it after each piece of work. When the conversation is cleared (a fresh start), read it first and go on."]
    return "\n".join(lines) + "\n"


def flags(session, folder, team, role):
    """Write run/<role>.md and return the role's claude flags / run/<역할>.md 를 쓰고 역할의 claude 옵션을 돌려준다"""
    run = os.path.join(team_dir(folder), "run")
    os.makedirs(run, exist_ok=True)
    os.makedirs(os.path.join(team_dir(folder), "notes"), exist_ok=True)
    path = os.path.join(run, role["id"] + ".md")
    with open(path, "w", encoding="utf-8") as f:
        f.write(build_prompt(session, folder, team, role))
    out = []
    if role["model"] in MODELS or role["model"].startswith("claude-"):
        out += ["--model", role["model"]]
    if role["effort"] in EFFORTS:
        out += ["--effort", role["effort"]]
    out += ["--append-system-prompt-file", path]
    if role["readonly"]:
        out += ["--disallowedTools", READONLY_TOOLS]
    return out


def ensure_worktree(folder, role):
    """<project>/.hivemux/worktrees/<role> on branch team/<role>; the project folder when it is not a git repo
    git 저장소가 아니면 프로젝트 폴더"""
    path = worktree_of(folder, role)
    if os.path.isdir(path):
        return path
    if subprocess.run(["git", "-C", folder, "rev-parse", "--is-inside-work-tree"], capture_output=True).returncode != 0:
        print(tr(f"  {role['id']}: git 저장소가 아니라 프로젝트 폴더에서 일합니다", f"  {role['id']}: not a git repo, so it works in the project folder"))
        return folder
    branch = f"team/{role['id']}"
    has = subprocess.run(["git", "-C", folder, "rev-parse", "--verify", "--quiet", branch], capture_output=True).returncode == 0
    r = subprocess.run(["git", "-C", folder, "worktree", "add", "-q", path] + ([branch] if has else ["-b", branch]),
                       capture_output=True, text=True)
    if r.returncode != 0:
        print(tr(f"  {role['id']}: 워크트리를 만들지 못해 프로젝트 폴더에서 일합니다 ({r.stderr.strip()})",
                 f"  {role['id']}: could not make its worktree, so it works in the project folder ({r.stderr.strip()})"))
        return folder
    return path


def exclude(folder):
    """Keep hivemux's own files out of git (team.toml, roles/ and notes/ may be committed)
    hivemux 자체 파일은 git 에서 뺀다 (team.toml, roles/, notes/ 는 커밋해도 된다)"""
    r = subprocess.run(["git", "-C", folder, "rev-parse", "--git-path", "info/exclude"], capture_output=True, text=True)
    if r.returncode != 0:
        return
    path = os.path.join(folder, r.stdout.strip()) if not os.path.isabs(r.stdout.strip()) else r.stdout.strip()
    want = [".hivemux/run/", ".hivemux/worktrees/", ".hivemux/sessions.tsv"]
    try:
        have = open(path).read().splitlines()
    except OSError:
        have = []
    missing = [w for w in want if w not in have]
    if missing:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "a") as f:
            f.write("".join(w + "\n" for w in missing))


def sessions(folder):
    """{role: session id}, the last one for each / 역할마다 마지막 대화"""
    out = {}
    try:
        with open(os.path.join(team_dir(folder), "sessions.tsv")) as f:
            for line in f:
                p = line.rstrip("\n").split("\t")
                if len(p) >= 2:
                    out[p[0]] = p[1]
    except OSError:
        pass
    return out


def panes(session):
    """The project's panes / 프로젝트의 칸"""
    fmt = "\t".join(["#{pane_id}", "#{window_name}", "#{@hivemux-role}", "#{@claude_session}", "#{pane_current_command}",
                     "#{@claude_state}", "#{window_index}", "#{@hivemux-role-at}"])
    out = []
    for line in tmux("list-panes", "-s", "-t", f"={session}", "-F", fmt).splitlines():
        p = line.split("\t")
        if len(p) == 8:
            out.append(dict(zip(("pane", "window", "role", "sid", "cmd", "state", "index", "at"), p)))
    return out


def claude_cmd():
    v = os.environ.get("HIVEMUX_CLAUDE") or tmux("show-environment", "-g", "HIVEMUX_CLAUDE").strip().partition("=")[2]
    return v or "claude"


def offwork(pane):
    """Clocked out by itself (bin/hivemux-shift)? / 혼자 퇴근했나"""
    path = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "hivemux", "offwork.tsv")
    try:
        return any(l.split("\t")[0] == pane for l in open(path))
    except OSError:
        return False


def up(session, only=None):
    session, folder = project(session)
    if not os.path.isfile(os.path.join(team_dir(folder), "team.toml")):
        die(tr(f"{session} 에는 팀이 없습니다. 먼저: hivemux team use web-app -s {session}",
               f"{session} has no team. First: hivemux team use web-app -s {session}"))
    team = load(team_dir(folder))
    known = sessions(folder)
    have = {p["role"]: p for p in panes(session) if p["role"]}
    started = 0
    for role in team["role"]:
        if only and role["id"] != only:
            continue
        p = have.get(role["id"])
        if p and not SHELLS.match(p["cmd"]):
            print(f"  {label(role)}: " + tr("이미 도는 중", "already running"))
            continue
        # sent a moment ago and its shell has not run it yet: do not send it twice / 방금 보냈고 셸이 아직 실행 전: 두 번 보내지 않는다
        if p and p["at"].isdigit() and time.time() - int(p["at"]) < 20:
            print(f"  {label(role)}: " + tr("시작하는 중", "starting"))
            continue
        cwd = ensure_worktree(folder, role) if role["worktree"] else folder
        if p is None:
            pane = tmux("new-window", "-d", "-t", f"={session}:", "-c", cwd, "-n", label(role), "-P", "-F", "#{pane_id}").strip()
            if not pane:
                print(f"  {label(role)}: " + tr("창을 열지 못했습니다", "could not open a window"))
                continue
            tmux("set", "-p", "-t", pane, "@hivemux-role", role["id"])
        else:
            pane = p["pane"]
        if p and offwork(pane):
            # clocked out with `team down`: clocking in resumes it with the role flags (resume-args)
            # `team down` 으로 퇴근함: 출근하면 역할 옵션으로 재개된다 (resume-args)
            subprocess.run([os.path.join(HERE, "hivemux-shift"), "on", "--pane", pane], capture_output=True)
            print(f"  {label(role)}: " + tr("출근", "back to work"))
            started += 1
            continue
        args = flags(session, folder, team, role)
        sid = known.get(role["id"])
        if p and sid:
            cmd = f" cd {shlex.quote(cwd)} && {claude_cmd()} --resume {shlex.quote(sid)} {shlex.join(args)}"
            what = tr("이어서 시작", "resumed")
        else:
            cmd = f" cd {shlex.quote(cwd)} && {claude_cmd()} -n {shlex.quote(session + '-' + role['id'])} {shlex.join(args)}"
            what = tr("시작", "started")
        tmux("send-keys", "-t", pane, cmd, "Enter")
        tmux("set", "-p", "-t", pane, "@hivemux-role-at", str(int(time.time())))
        print(f"  {label(role)}: {what} ({role['model']} · {role['effort']})")
        started += 1
    exclude(folder)
    return started


def down(session, only=None):
    session, folder = project(session)
    for p in panes(session):
        if p["role"] and (not only or p["role"] == only) and not SHELLS.match(p["cmd"]):
            subprocess.run([os.path.join(HERE, "hivemux-shift"), "off", "--pane", p["pane"]], capture_output=True)
            print(f"  {p['window']}: " + tr("퇴근", "clocked out"))


def status(session):
    session, folder = project(session)
    path = team_dir(folder)
    if not os.path.isfile(os.path.join(path, "team.toml")):
        return {"project": session, "folder": folder, "team": None}
    team = load(path)
    have = {p["role"]: p for p in panes(session) if p["role"]}
    roles = []
    for r in team["role"]:
        p = have.get(r["id"]) or {}
        running = bool(p) and not SHELLS.match(p.get("cmd", ""))
        roles.append({**{k: r[k] for k in ("id", "model", "effort", "lead", "readonly", "worktree", "owns", "diet", "prompt")},
                      "name": label(r), "session": f"{session}-{r['id']}", "pane": p.get("pane", ""),
                      "running": running, "state": p.get("state", "") if running else ("off" if p else "")})
    return {"project": session, "folder": folder,
            "team": {"id": team.get("id", ""), "name": label(team), "description": label(team, "description"),
                     "flow": team.get("flow") or [r["id"] for r in team["role"]], "diet": team["diet"], "roles": roles}}


def find_team(cwd):
    """The project folder above cwd that has a team / cwd 위로 팀이 있는 프로젝트 폴더"""
    d = os.path.abspath(cwd or "/")
    while True:
        if os.path.isfile(os.path.join(d, ".hivemux", "team.toml")):
            return d
        up_ = os.path.dirname(d)
        if up_ == d:
            return None
        d = up_


def resume_args(target, sid, cwd):
    folder = find_team(cwd)
    if not folder:
        return ""
    role_id = next((r for r, s in sessions(folder).items() if s == sid), None)
    if not role_id:
        return ""
    team = load(team_dir(folder))
    role = next((r for r in team["role"] if r["id"] == role_id), None)
    if not role:
        return ""
    session = tmux("display", "-p", "-t", target, "#{session_name}").strip() or os.path.basename(folder)
    tmux("set", "-p", "-t", target, "@hivemux-role", role_id)
    return shlex.join(flags(session, folder, team, role))


def record(pane, sid):
    role = tmux("show", "-pqv", "-t", pane, "@hivemux-role").strip()
    tmux("set", "-pu", "-t", pane, "@hivemux-role-at")      # it started (see up) / 시작했다 (up 참고)
    folder = find_team(tmux("display", "-p", "-t", pane, "#{session_path}").strip())
    if role and sid and folder and sessions(folder).get(role) != sid:
        with open(os.path.join(team_dir(folder), "sessions.tsv"), "a") as f:
            f.write(f"{role}\t{sid}\n")


def use(name, session, force):
    session, folder = project(session)
    src = next((t["path"] for t in templates() if t["id"] == name), None)
    if not src:
        die(tr(f"템플릿이 없습니다: {name} (hivemux team templates)", f"No such template: {name} (hivemux team templates)"))
    dst = team_dir(folder)
    if os.path.isfile(os.path.join(dst, "team.toml")) and not force:
        die(tr(f"{session} 에는 이미 팀이 있습니다 (바꾸려면 --force)", f"{session} already has a team (--force replaces it)"))
    os.makedirs(dst, exist_ok=True)
    shutil.copy(os.path.join(src, "team.toml"), os.path.join(dst, "team.toml"))
    if os.path.isdir(os.path.join(dst, "roles")):
        shutil.rmtree(os.path.join(dst, "roles"))
    shutil.copytree(os.path.join(src, "roles"), os.path.join(dst, "roles"))
    os.makedirs(os.path.join(dst, "notes"), exist_ok=True)
    exclude(folder)
    print(tr(f"{session} 에 팀을 만들었습니다: {dst}", f"Made the team in {session}: {dst}"))


def save(name, session):
    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,39}", name):
        die(tr("이름은 영문 소문자, 숫자, - 로", "Use lowercase letters, digits and -"))
    session, folder = project(session)
    src = team_dir(folder)
    dst = os.path.join(MINE, name)
    os.makedirs(MINE, exist_ok=True)
    if os.path.isdir(dst):
        shutil.rmtree(dst)
    os.makedirs(dst)
    with open(os.path.join(src, "team.toml"), encoding="utf-8") as f:
        team = toml_loads(f.read())
    team["id"] = name
    with open(os.path.join(dst, "team.toml"), "w", encoding="utf-8") as f:
        f.write(toml_dumps(team))
    shutil.copytree(os.path.join(src, "roles"), os.path.join(dst, "roles"))
    print(tr(f"내 템플릿으로 저장했습니다: {dst}", f"Saved as your template: {dst}"))


def main(argv):
    def opt(name, default=None):
        if name in argv:
            i = argv.index(name)
            v = argv[i + 1] if i + 1 < len(argv) else default
            del argv[i:i + 2]
            return v
        return default
    session = opt("-s") or opt("--session")
    only = opt("--role")
    force = "--force" in argv and not argv.remove("--force")
    as_json = "--json" in argv and not argv.remove("--json")
    cmd, args = (argv[0] if argv else "help"), argv[1:]
    if cmd == "templates":
        ts = templates()
        if as_json:
            print(json.dumps(ts, ensure_ascii=False))
        else:
            for t in ts:
                print(f"{t['id']:<16} {t['name']} · {len(t['roles'])}{tr('명', ' roles')}" + ("" if t["builtin"] else tr(" (내 템플릿)", " (yours)")))
    elif cmd == "use" and args:
        use(args[0], session, force)
    elif cmd == "up":
        up(session, only)
    elif cmd == "down":
        down(session, only)
    elif cmd == "status":
        print(json.dumps(status(session), ensure_ascii=False))
    elif cmd == "prompt" and args:
        s, folder = project(session)
        team = load(team_dir(folder))
        role = next((r for r in team["role"] if r["id"] == args[0]), None) or die(tr("역할이 없습니다", "No such role"))
        sys.stdout.write(build_prompt(s, folder, team, role))
    elif cmd == "save" and args:
        save(args[0], session)
    elif cmd == "resume-args" and len(args) == 3:
        print(resume_args(*args))
    elif cmd == "record" and len(args) == 2:
        record(*args)
    else:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
