#!/bin/bash
# Close one Claude from the sidebar menu, after asking.
# 사이드바 메뉴에서 Claude 하나를 닫는다. 먼저 묻는다.
#   hivemux-close-claude <pane> <client>     ask in a popup / 팝업에서 묻는다
#   hivemux-close-claude --ask <pane>        (inside the popup / 팝업 안에서)
#   hivemux-close-claude --now <pane>        close without asking / 묻지 않고 닫는다
# Its pane closes (its window too when nothing else is left in it but the sidebar); the last window of a
# project stays with its shell, since closing it would close the project. It is closed on purpose, as with
# /exit: it is not resumed after a reboot or on clocking in, and its bee leaves the company. The conversation
# stays; `claude --resume` continues it.
# 그 칸을 닫는다 (사이드바 말고 남는 것이 없으면 창까지). 프로젝트의 마지막 창은 셸과 함께 남긴다: 닫으면
# 프로젝트가 닫힌다. /exit 처럼 직접 닫은 것이라 재부팅이나 출근 때 다시 띄우지 않고, 그 벌은 퇴사한다. 대화는
# 남아 `claude --resume` 으로 이어갈 수 있다.
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin"
TMUX_BIN="$(command -v tmux || echo /opt/homebrew/bin/tmux)"
say() { local v="${HIVEMUX_LANG:-$("$TMUX_BIN" show -gqv @hivemux-lang 2>/dev/null)}"; if [[ "${v:-$LANG}" == ko* ]]; then printf '%s' "$1"; else printf '%s' "$2"; fi; }
t() { "$TMUX_BIN" "$@" 2>/dev/null; }
HM_BIN="$(cd "$(dirname "$(realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"
SHELLS='^-?(zsh|bash|fish|sh|dash|tcsh|ksh|login)$'

claude_pid() { ps -ax -o pid=,ppid=,comm= | awk -v p="$1" '$2 == p && $3 ~ /(^|\/)(claude|node)$/ { print $1; exit }'; }
# the other work panes of its window and work windows of its project (not the sidebar, not the "·" spare)
# 같은 창의 다른 작업 칸, 같은 프로젝트의 다른 작업 창 (사이드바와 "·" 예비 창은 빼고)
others_in_window() { t list-panes -t "$1" -F '#{pane_id} #{pane_title}' | awk -v p="$1" '$1 != p && $2 != "hivemux-sidebar"' | wc -l | tr -d ' '; }
others_in_project() {
  local win; win="$(t display -p -t "$1" '#{window_id}')"
  t list-windows -t "$1" -F '#{window_id} #{window_name}' | awk -v w="$win" '$1 != w && $2 != "·"' | wc -l | tr -d ' '
}

close_now() {
  local pane="$1" pp pid i
  t display -p -t "$pane" '#{pane_id}' >/dev/null || return 0
  # on purpose: its bee leaves, and nothing brings it back / 직접 닫음: 벌은 퇴사하고, 다시 띄우는 것도 없다
  "$HM_BIN/hivemux-bees" quit "$pane" >/dev/null 2>&1
  "$HM_BIN/hivemux-shift" forget --pane "$pane" >/dev/null 2>&1
  t set -pu -t "$pane" @claude_session; t set -pu -t "$pane" @claude_cwd; t set -pu -t "$pane" @claude_offwork
  if [ "$(others_in_window "$pane")" -gt 0 ]; then t kill-pane -t "$pane"
  elif [ "$(others_in_project "$pane")" -gt 0 ]; then t kill-window -t "$pane"
  else
    # the project's last window: stop the Claude, keep the shell / 프로젝트의 마지막 창: Claude 만 끄고 셸은 남긴다
    pp="$(t display -p -t "$pane" '#{pane_pid}')"; pid="$(claude_pid "$pp")"
    [ -n "$pid" ] && kill -TERM "$pid" 2>/dev/null
    for i in $(seq 25); do [[ "$(t display -p -t "$pane" '#{pane_current_command}')" =~ $SHELLS ]] && break; sleep 0.2; done
  fi
  "$HM_BIN/hivemux-sidebar" wake >/dev/null 2>&1
}

ask() {
  local pane="$1" st
  st="$(t show -pqv -t "$pane" @claude_state)"
  echo "$(say "이 Claude 를 닫을까요?" "Close this Claude?")"
  case "$st" in
    run) echo "$(say "지금 일하는 중입니다. 닫으면 하던 일이 멈춥니다." "It is working now; closing stops what it is doing.")" ;;
    wait) echo "$(say "지금 답을 기다리는 중입니다." "It is waiting for your answer.")" ;;
  esac
  if [ "$(others_in_window "$pane")" -gt 0 ] || [ "$(others_in_project "$pane")" -gt 0 ]; then
    echo "$(say "그 칸도 닫힙니다. 대화는 남아 claude --resume 으로 이어갈 수 있습니다." "Its pane closes too. The conversation stays: claude --resume continues it.")"
  else
    echo "$(say "프로젝트의 마지막 창이라 셸은 남깁니다. 대화는 claude --resume 으로 이어갈 수 있습니다." "The project's last window keeps its shell. claude --resume continues the conversation.")"
  fi
  "$HM_BIN/hivemux-confirm" --danger "$(say "닫기" "Close")" "$(say "취소" "Cancel")" && close_now "$pane"
}

case "${1:-}" in
  --ask) ask "$2" ;;
  --now) close_now "$2" ;;
  %*)
    "$HM_BIN/hivemux-modal" "${2:-}" -E -w 62 -h 9 -b rounded \
      -T "#[fg=#f06262,bold] $(say "Claude 닫기" "Close Claude") " -S "fg=#f06262" -s "bg=#1e2128" \
      "$(printf '%q ' "$0" --ask "$1")" ;;
  *) sed -n '4,6p' "$0" >&2; exit 2 ;;
esac
