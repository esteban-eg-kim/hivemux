#!/bin/bash
# Rename a task from the sidebar.
# 사이드바에서 작업 이름 바꾸기.
#   hivemux-rename prompt <pane_id> <client>   open the name popup (prefilled with the current name)
#                                              이름 입력 칸 띄우기 (지금 이름이 채워짐)
#   hivemux-rename apply  <pane_id>            apply the entered name
#                                              입력값 적용
#   hivemux-rename flush  <pane_id>            send a pending name (called from the Stop hook)
#                                              보류된 이름 보내기 (Stop 훅에서 호출)
#   hivemux-rename auto   <pane_id> <session id> <transcript>
#                                              a session with no name yet gets the sidebar's (Stop hook)
#                                              아직 이름이 없는 세션에 사이드바 이름을 준다 (Stop 훅)
# Apply: change the sidebar name (@claude_name) at once and send "/rename <name>" to Claude.
# 적용: 사이드바 표시 이름(@claude_name)을 바로 바꾸고, Claude에 "/rename 이름"을 보낸다.
# If Claude is working or waiting for approval, typed keys could become an answer,
# Claude가 작업 중이거나 승인을 기다리면 키 입력이 대답으로 들어갈 수 있으므로
# so keep it pending (@claude_rename_pending) and send it when the turn ends (Stop).
# 보류(@claude_rename_pending)했다가 응답이 끝날 때(Stop) 보낸다.
HM_BIN="$(cd "$(dirname "$(realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"
TMUX_BIN="$(command -v tmux || echo /opt/homebrew/bin/tmux)"
# UI language: HIVEMUX_LANG > tmux @hivemux-lang (set by hivemux setup) > LANG
# 화면 언어: HIVEMUX_LANG > tmux @hivemux-lang (hivemux setup 이 정함) > LANG
say() { local v="${HIVEMUX_LANG:-$("$TMUX_BIN" show -gqv @hivemux-lang 2>/dev/null)}"; if [[ "${v:-$LANG}" == ko* ]]; then printf '%s' "$1"; else printf '%s' "$2"; fi; }
t() { "$TMUX_BIN" "$@"; }
pane="%${2#%}"   # inside prompt templates %1..%9 become the answer, so pass the number only / 입력 칸 명령 안에서는 %1..%9 가 입력값으로 바뀌므로 숫자만 주고받는다
num="${pane#%}"

send_rename() {
  local name="$1"
  t send-keys -t "$pane" -l "/rename $name"
  t send-keys -t "$pane" Enter
  t set -pu -t "$pane" @claude_rename_pending
}

# Reconnect Remote Control with a name. On a connected session /remote-control opens a menu (Disconnect this
# session / Show QR code / Continue, on Continue); on one that is not, it connects at once, without the name,
# so open the menu again. Disconnect, then /remote-control <name>
# Remote Control 을 이름을 붙여 다시 연결한다. 연결된 세션에서 /remote-control 은 메뉴를 띄운다 (Disconnect this
# session / Show QR code / Continue, Continue 에 놓임). 연결이 없던 세션은 이름 없이 바로 연결되므로 메뉴를 다시
# 연다. 끊고 나서 /remote-control <이름>
rc_reconnect() {
  local name="$1" i j
  for i in 1 2; do
    t send-keys -t "$pane" -l "/remote-control"; t send-keys -t "$pane" Enter
    sleep 2
    if t capture-pane -p -t "$pane" | grep -q 'Disconnect this session'; then
      for j in 1 2 3; do
        t capture-pane -p -t "$pane" | grep -q '❯ *Disconnect this session' && break
        t send-keys -t "$pane" Up; sleep 0.2
      done
      t send-keys -t "$pane" Enter; sleep 2
      t send-keys -t "$pane" -l "/remote-control $name"; t send-keys -t "$pane" Enter
      return 0
    fi
  done
  return 1
}

case "$1" in
  prompt)
    client="$3"
    cur="$(t show -pqv -t "$pane" @claude_name)"
    [ -z "$cur" ] && cur="$("$HM_BIN/hivemux-sidebar-view" --name "$pane" 2>/dev/null)"
    proj="$(t display -p -t "$pane" '#{session_name}')"
    st="$(t show -pqv -t "$pane" @claude_state)"
    # Centered popup (tmux 3.3+); fall back to the status-line prompt.
    # 화면 가운데 팝업 (tmux 3.3+). 안 되면 상태줄 입력 칸으로.
    # Choose by popup support, not by the popup's exit status (cancel returns non-zero)
    # 팝업이 끝난 결과(취소 포함)로 판단하지 않고, 팝업 기능이 있는지로만 고른다
    if t list-commands display-popup 2>/dev/null | grep -q -- '-b border-lines'; then
      # Pause sidebar drawing while the popup is open (each redraw would flicker it)
      # 팝업이 떠 있는 동안 사이드바 애니메이션을 멈춘다 (다시 그릴 때마다 팝업이 깜빡이므로)
      pause="/tmp/hivemux-pause-$(id -u)-$(t display -p '#{pid}')"   # per tmux server / tmux 서버마다
      : > "$pause"; trap 'rm -f "$pause"' EXIT
      "$HM_BIN/hivemux-modal" "$client" -E -w 64 -h 11 -b rounded \
        -T "#[fg=#e6e9ef,bold] $(say "작업 이름 바꾸기" "Rename task") " -S "fg=#5aa9ff" -s "bg=#1e2128" \
        "$HM_BIN/hivemux-rename-ui" "$num" "$cur" "$proj" "$st" 2>/dev/null || true   # cancel (Esc) is not an error / 취소(Esc)도 정상 종료
    else
      t command-prompt ${client:+-t "$client"} -I "$cur" -p "$(say "작업 이름:" "Task name:")" \
        "set -g @hivemux-name-input-$num '%%' ; run-shell -b '$HM_BIN/hivemux-rename apply $num'"
    fi
    ;;
  apply)
    name="$(t show -gqv "@hivemux-name-input-$num" | tr -d '\n' | sed 's/^ *//; s/ *$//')"
    t set -gu "@hivemux-name-input-$num"
    [ -n "$name" ] || exit 0
    t set -p -t "$pane" @claude_name "$name"
    st="$(t show -pqv -t "$pane" @claude_state)"
    case "$st" in
      idle|done) send_rename "$name"; t display -d 1500 "$(say "이름 변경" "Renamed"): $name" ;;
      *) t set -p -t "$pane" @claude_rename_pending "$name"
         t display -d 2500 "$(say "Claude가 작업 중이라 끝나면 이름을 보냅니다" "Claude is busy; will rename when it finishes"): $name" ;;
    esac
    ;;
  flush)
    name="$(t show -pqv -t "$pane" @claude_rename_pending)"
    [ -n "$name" ] || exit 0
    sleep 1.5   # wait until the turn ends and the prompt is back / 응답이 끝나고 입력창이 돌아올 때까지
    [ "$(t show -pqv -t "$pane" @claude_state)" = done ] || [ "$(t show -pqv -t "$pane" @claude_state)" = idle ] || exit 0
    send_rename "$name"
    ;;
  auto)
    # Remote Control lists a session with no name as "<host>-local-<word>-<word>" (the Claude app's Code list),
    # so it gets the name the sidebar shows, once per session. A name given by /rename or --name is left alone:
    # Claude writes it to the transcript as a custom-title line. @hivemux-autoname off turns this off
    # Remote Control 은 이름 없는 세션을 "<호스트>-local-<단어>-<단어>" 로 보인다 (Claude 앱의 Code 목록).
    # 그래서 사이드바에 보이는 이름을 세션마다 한 번 준다. /rename 이나 --name 으로 준 이름은 두는데,
    # Claude 가 대화 기록에 custom-title 줄로 적는다. @hivemux-autoname off 로 끈다
    sid="$3"; tr_="$4"
    [ -n "$sid" ] && [ -f "$tr_" ] || exit 0
    [ "$(t show -gqv @hivemux-autoname)" = off ] && exit 0
    [ -n "$(t show -pqv -t "$pane" @claude_rename_pending)" ] && exit 0
    # A reconnected Remote Control (the Mac woke up, the network came back, /remote-control again) drops the
    # name: the app shows a title made up from the last turn ("Interrupted request") and a later /rename does
    # not reach it. Each connection has its own bridgeSessionId in the transcript; the first one seen is the
    # one made at start, which has the name. A new one gets reconnected with the name (/remote-control <name>)
    # 다시 연결된 Remote Control (맥이 깨어남, 네트워크가 돌아옴, /remote-control 을 다시 함) 은 이름을 잃는다:
    # 앱에는 마지막 턴으로 지은 제목 ("Interrupted request") 이 보이고, 그 뒤의 /rename 은 닿지 않는다.
    # 연결마다 대화 기록에 bridgeSessionId 가 따로 있다. 처음 본 것은 시작할 때 이름과 함께 만든 연결이다.
    # 새 연결이면 이름을 붙여 다시 연결한다 (/remote-control <이름>)
    bridge="$(tail -c 400000 "$tr_" 2>/dev/null | grep -o '"bridgeSessionId":"[^"]*"' | tail -1 | cut -d'"' -f4)"
    seen="$(t show -pqv -t "$pane" @claude_rc_bridge)"
    # kept out of the Claude app (bin/hivemux-account hide): never connect it again / Claude 앱에서 숨김: 다시 연결하지 않는다
    [ -n "$(t show -pqv -t "$pane" @hivemux-hidden)" ] && bridge=""
    grep -qxF "$(t display -p -t "$pane" '#{session_name}')" "${XDG_DATA_HOME:-$HOME/.local/share}/hivemux/hidden-projects" 2>/dev/null && bridge=""
    if [ -n "$bridge" ] && [ "$seen" != "$bridge" ]; then
      t set -p -t "$pane" @claude_rc_bridge "$bridge"
      # the first connection of this pane, or the one our own reconnect made: nothing to do
      # 이 칸의 첫 연결, 또는 우리가 다시 연결해서 생긴 연결: 할 일 없음
      if [ -n "$seen" ] && [ "$seen" != reconnecting ]; then
        name="$(grep -o '"type":"custom-title","customTitle":"[^"]*"' "$tr_" 2>/dev/null | tail -1 | cut -d'"' -f8)"
        [ -n "$name" ] || name="$("$HM_BIN/hivemux-sidebar-view" --name "$pane" 2>/dev/null | tr -d '\n')"
        case "$name" in ""|"새 대화"|"new chat") ;; *)
          sleep 1.5   # wait until the turn ends and the prompt is back / 응답이 끝나고 입력창이 돌아올 때까지
          st="$(t show -pqv -t "$pane" @claude_state)"
          [ "$st" = done ] || [ "$st" = idle ] || { t set -p -t "$pane" @claude_rc_bridge "$seen"; exit 0; }
          t set -p -t "$pane" @claude_rc_bridge reconnecting
          rc_reconnect "$name"
          t set -p -t "$pane" @claude_autonamed "$sid"
          exit 0 ;;
        esac
      fi
    fi
    [ "$(t show -pqv -t "$pane" @claude_autonamed)" = "$sid" ] && exit 0
    grep -q '"type":"custom-title"' "$tr_" 2>/dev/null && { t set -p -t "$pane" @claude_autonamed "$sid"; exit 0; }
    name="$("$HM_BIN/hivemux-sidebar-view" --name "$pane" 2>/dev/null | tr -d '\n')"
    # nothing to go by yet ("new chat"): try again at the next Stop / 아직 이름 거리가 없음 ("새 대화"): 다음 Stop 에 다시
    case "$name" in ""|"새 대화"|"new chat") exit 0 ;; esac
    t set -p -t "$pane" @claude_autonamed "$sid"
    sleep 1.5   # wait until the turn ends and the prompt is back / 응답이 끝나고 입력창이 돌아올 때까지
    st="$(t show -pqv -t "$pane" @claude_state)"
    [ "$st" = done ] || [ "$st" = idle ] || { t set -pu -t "$pane" @claude_autonamed; exit 0; }
    send_rename "$name"
    ;;
  *) echo "usage: $0 prompt <pane> [client] | apply <pane> | flush <pane> | auto <pane> <sid> <transcript>" >&2; exit 2 ;;
esac
exit 0
