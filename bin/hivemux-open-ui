#!/usr/bin/env python3
"""Open-path popup (runs inside tmux display-popup).
경로 골라 열기 팝업 (tmux display-popup 안에서 실행).

  hivemux-open-ui <pane_id> [client]

Lists existing file/dir paths found in that pane's recent output, newest first.
그 칸의 최근 출력에서 실제로 있는 파일/폴더 경로를 모아 최근 것부터 보여 준다.
  ↑↓ / Ctrl+P N   select / 고르기       type   filter / 걸러 보기
  Enter           open in the editor of Settings (at the line) / 설정의 편집기로 열기 (그 줄로)
  Tab             default app / 기본 앱     Ctrl+F  reveal in Finder / Finder에서 보기
  Ctrl+Y          copy path (on that Mac too) / 경로 복사 (그 Mac 에도)     Esc     close / 닫기
On a screen attached from another Mac with VS Code or Cursor, Enter opens the file on that Mac,
over Remote-SSH (bin/hivemux-ports there picks up @hivemux-edit-<Mac>); otherwise on this Mac.
다른 Mac 에서 붙은 화면이고 편집기가 VS Code 나 Cursor 면, Enter 는 그 Mac 에서 원격 SSH 로 연다
(그 Mac 의 bin/hivemux-ports 가 @hivemux-edit-<Mac> 을 가져간다). 아니면 이 Mac 에서 연다.
There, Tab copies the file to that Mac and opens it with its default app (bin/hivemux-show), and so do
Enter with another editor and Ctrl+F, which would otherwise open it on this Mac where nobody looks.
그런 화면에서 Tab 은 파일을 그 Mac 으로 복사해 기본 앱으로 연다 (bin/hivemux-show). 다른 편집기의 Enter 와
Ctrl+F 도 그렇게 한다. 아니면 아무도 안 보는 이 Mac 에서 열리기 때문이다.
"""
import glob, shutil, os, re, subprocess, sys, termios, time, tty, unicodedata, urllib.parse

TMUX = shutil.which("tmux") or "/opt/homebrew/bin/tmux"
OS = os.path.join(os.path.dirname(os.path.realpath(__file__)), "hivemux-os")   # open, copy on macOS or Linux / macOS 나 Linux 에서 열기, 복사


def _is_ko():
    """UI language: HIVEMUX_LANG > tmux @hivemux-lang (set by hivemux setup) > LANG / 화면 언어: HIVEMUX_LANG > tmux @hivemux-lang (hivemux setup 이 정함) > LANG"""
    v = os.environ.get("HIVEMUX_LANG") or subprocess.run([TMUX, "show", "-gqv", "@hivemux-lang"],
                                                          capture_output=True, text=True).stdout.strip()
    return (v or os.environ.get("LANG", "")).startswith("ko")


KO = _is_ko()


def tr(ko, en):
    return ko if KO else en
PANE = sys.argv[1] if len(sys.argv) > 1 else ""
CLIENT = sys.argv[2] if len(sys.argv) > 2 and sys.argv[2] != "--list" else ""
VSCODE = os.path.exists("/Applications/Visual Studio Code.app")
# editor for Enter (Settings → Editor, @hivemux-editor) / Enter 로 열 편집기 (설정 → 편집기)
EDITORS = {"vscode": ("VS Code", "Visual Studio Code", None), "cursor": ("Cursor", "Cursor", None),
           "zed": ("Zed", "Zed", "zed"), "sublime": ("Sublime Text", "Sublime Text", "subl")}

TEXT, T2, T3 = (230, 233, 239), (154, 163, 178), (98, 106, 120)
ACC, SEL_BG, BG = (90, 169, 255), (42, 47, 58), (30, 33, 40)


def fg(c): return "\x1b[38;2;%d;%d;%dm" % c
def bg(c): return "\x1b[48;2;%d;%d;%dm" % c
RST, BOLD = "\x1b[0m", "\x1b[1m"


def tmux(*a):
    return subprocess.run([TMUX, *a], capture_output=True, text=True).stdout


def width(s):
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def cut_left(s, w):
    """Shorten from the left (…) to width w; the end of a path matters most. / 앞을 줄여서(…) 폭 w에 맞춘다. 경로는 끝부분이 중요하다."""
    if width(s) <= w:
        return s
    out = ""
    for c in reversed(s):
        if width(out) + width(c) > w - 1:
            break
        out = c + out
    return "…" + out


# Path candidates: /abs, ~/home, ./rel, ../rel, a/b with a slash, or name.ext
# 경로 후보: /abs, ~/home, ./rel, ../rel, 또는 슬래시가 있는 a/b.ext, 또는 이름.ext
PATH_RE = re.compile(
    r"(?<![\w/~.@-])("
    r"(?:~|\.{1,2})?/[^\s'\"`<>()\[\]{},;|:]+"       # /abs  ~/x  ./x  ../x
    r"|[\w.@-]+(?:/[^\s'\"`<>()\[\]{},;|:]+)+/?"      # a/b/c  dir/
    r"|[\w@-][\w.@-]*\.[A-Za-z][\w]{0,7}"            # name.ext
    r")(?::(\d+))?(?::(\d+))?")


# The rest of a wrapped path on an indented next line, and the joined path with its :line:col
# 들여쓴 다음 줄에 이어진 경로 나머지, 그리고 이어 붙인 경로와 :줄:열
WRAP_RE = re.compile(r"\s+([^\s'\"`<>()\[\]{},;|]+)")
TAIL_RE = re.compile(r"(.+?)(?::(\d+))?(?::(\d+))?$")


# Folders below the bases, for a relative path printed from a folder Claude cd'ed into earlier
# (a worktree, a sub project). Shallow and capped so a huge tree does not stall the popup.
# 기준 폴더 아래 폴더들: Claude 가 앞서 cd 해 들어간 폴더(워크트리, 하위 프로젝트)에서 찍힌 상대 경로용.
# 큰 폴더에서 팝업이 멈추지 않게 얕게, 개수도 제한한다.
SKIP_DIRS = {"node_modules", "__pycache__", "venv", "dist", "build", "target", "vendor", "Pods"}


def below(bases, depth=4, cap=4000):
    out, seen = [], set()
    level = [b for b in bases]
    for _ in range(depth):
        nxt = []
        for d in level:
            try:
                ents = sorted(os.scandir(d), key=lambda e: e.name)
            except OSError:
                continue
            for e in ents:
                if e.name.startswith(".") or e.name in SKIP_DIRS or not e.is_dir(follow_symlinks=False):
                    continue
                if e.path in seen:
                    continue
                seen.add(e.path)
                nxt.append(e.path)
                if len(seen) >= cap:
                    return out + nxt
        out += nxt
        level = nxt
    return out


def candidates(pane):
    cwd = tmux("display", "-p", "-t", pane, "#{pane_current_path}").strip()
    ccwd = tmux("show", "-pqv", "-t", pane, "@claude_cwd").strip()
    pwd = tmux("show", "-pqv", "-t", pane, "@claude_pwd").strip()   # Claude's folder now / Claude 의 지금 폴더
    # the session's own folder under /tmp/claude-<uid>/<project>/<session id>: Claude names its scratchpad
    # files from there ("scratchpad/brand/sheet.png"), which no folder of the pane had
    # 세션 자신의 폴더 (/tmp/claude-<uid>/<프로젝트>/<세션 ID>): Claude 는 스크래치패드 파일을 거기서부터 적는다
    # ("scratchpad/brand/sheet.png"). 칸의 어느 폴더에도 없었다
    sid = tmux("show", "-pqv", "-t", pane, "@claude_session").strip()
    sess = sorted(glob.glob(f"/tmp/claude-{os.getuid()}/*/{glob.escape(sid)}")) if sid else []
    bases = list(dict.fromkeys(b for b in (pwd, ccwd, cwd, *sess) if b))
    deep = None   # built on first need / 처음 필요할 때 만든다
    text = tmux("capture-pane", "-p", "-J", "-S", "-3000", "-t", pane)

    def resolve(path):
        nonlocal deep
        path = os.path.expanduser(path)
        if os.path.isabs(path):
            return path if os.path.exists(path) else None
        for b in bases:
            c = os.path.normpath(os.path.join(b, path))
            if os.path.exists(c):
                return c
        if "/" in path.strip("/") and not path.startswith("."):
            if deep is None:
                deep = below(bases)
            for b in deep:
                c = os.path.join(b, path)
                if os.path.exists(c):
                    return os.path.normpath(c)
        return None

    lines = text.splitlines()
    seen, out = set(), []
    for i in range(len(lines) - 1, -1, -1):
        line = lines[i]
        for m in reversed(list(PATH_RE.finditer(line))):
            raw = m.group(1).rstrip(".:")
            if raw.startswith("http") or "://" in line[max(0, m.start() - 8):m.start() + 3]:
                continue
            ln, col = m.group(2), m.group(3)
            full = None
            # A long path Claude wrapped itself goes on in the next indented lines (-J does not join those);
            # the joined path wins, since the cut piece may name a folder of it
            # Claude 가 직접 줄바꿈한 긴 경로는 들여쓴 다음 줄로 이어진다 (-J 로는 안 붙는다).
            # 잘린 앞 조각이 그 경로의 폴더일 수 있어서, 이어 붙인 경로가 먼저다
            if m.end() == len(line.rstrip()):
                joined = m.group(0)
                for nxt in lines[i + 1:i + 4]:
                    w = WRAP_RE.match(nxt)
                    if not w:
                        break
                    joined += w.group(1)
                    j = TAIL_RE.match(joined)
                    if j and (f := resolve(j.group(1).rstrip(".:"))):
                        full, raw, ln, col = f, j.group(1).rstrip(".:"), j.group(2), j.group(3)
                        break
            full = full or resolve(raw)
            if not full or full in ("/", os.path.expanduser("~")):
                continue
            # skip the working directory shown in the shell prompt (and its parents)
            # 셸 프롬프트에 찍힌 작업 폴더(와 그 상위 폴더)는 뺀다
            if os.path.isdir(full) and any(b == full or b.startswith(full.rstrip("/") + "/") for b in bases):
                continue
            key = (full, ln)
            if key in seen:
                continue
            seen.add(key)
            out.append(dict(full=full, line=ln, col=col, shown=raw + (f":{ln}" if ln else ""),
                            isdir=os.path.isdir(full)))
            if len(out) >= 200:
                return out, bases
    return out, bases


def run(cmd, **kw):
    dry = os.environ.get("HIVEMUX_DRYRUN")
    if dry:  # for tests: record instead of running / 테스트용: 실행하지 않고 기록만
        with open(dry, "a") as f:
            f.write(" ".join(cmd) + "\n")
        return
    subprocess.run(cmd, **kw)


def editor():
    e = tmux("show", "-gqv", "@hivemux-editor").strip()
    return e if e in EDITORS or e == "default" else ("vscode" if VSCODE else "default")


def editor_name(e):
    return EDITORS[e][0] if e in EDITORS else tr("텍스트 편집기", "text editor")


def from_mac():
    """The Mac this popup's screen is attached from, if its hivemux-ports is polling (bin/hivemux-ports)
    이 팝업이 뜬 화면이 붙어 온 Mac. 그 Mac 의 hivemux-ports 가 묻고 있을 때만 (bin/hivemux-ports)"""
    if not CLIENT:
        return None
    mac = next((l.split(" ", 1)[1] for l in tmux("show", "-gqv", "@hivemux-remote-from").splitlines()
                if l.split(" ", 1)[0] == CLIENT and " " in l), None)
    seen = tmux("show", "-gqv", f"@hivemux-seen-{mac}").strip() if mac else ""
    return mac if seen.isdigit() and time.time() - int(seen) < 20 else None


def show_there(it):
    """Copy the file to the Mac this screen comes from and open it there; returns what to say
    파일을 이 화면이 붙어 온 Mac 으로 복사해 거기서 연다. 알릴 말을 돌려준다"""
    if it["isdir"]:
        return tr("폴더는 다른 컴퓨터에서 열 수 없습니다. ^Y 로 경로를 복사하세요", "A folder cannot be opened on another computer; ^Y copies the path")
    if os.environ.get("HIVEMUX_DRYRUN"):
        run(["hivemux-show", "--client", CLIENT, it["full"]])
        return ""
    r = subprocess.run([os.path.join(os.path.dirname(os.path.realpath(__file__)), "hivemux-show"), "--client", CLIENT,
                        it["full"]], capture_output=True, text=True)
    return (r.stdout or r.stderr).strip()


def open_editor(it):
    """Open in the editor; returns a note when it opens on another Mac / 편집기로 연다. 다른 Mac 에서 열면 알릴 말을 돌려준다"""
    e = editor()
    mac = from_mac()
    if mac and e in ("vscode", "cursor"):
        run([TMUX, "set", "-g", f"@hivemux-edit-{mac}", f"{e} {it['line'] or 0} {it['col'] or 0} {it['full']}"])
        return tr(f"{mac} 의 {editor_name(e)} 로 엽니다", f"Opening in {editor_name(e)} on {mac}")
    if mac:                 # no remote editor: bring the file over / 원격 편집기가 없으면 파일을 가져가 연다
        return show_there(it)
    if e == "default":
        run([OS, "open", it["full"]] if it["isdir"] else [OS, "edit", it["full"]])
        return None
    name, app, cli = EDITORS[e]
    if e in ("vscode", "cursor") and not it["isdir"]:
        url = f"{e}://file" + urllib.parse.quote(it["full"])
        if it["line"]:
            url += f":{it['line']}" + (f":{it['col']}" if it["col"] else "")
        run([OS, "open", url])
    elif cli and shutil.which(cli) and not it["isdir"]:
        run([shutil.which(cli), it["full"] + (f":{it['line']}" if it["line"] else "") + (f":{it['col']}" if it["line"] and it["col"] else "")])
    else:
        run([OS, "app", app, it["full"]])
    return None


def main():
    items, bases = candidates(PANE)
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setraw(fd)
    out = sys.stdout
    q, sel, top, msg = "", 0, 0, ""
    try:
        while True:
            cols, rows = os.get_terminal_size()
            shown = [it for it in items if q.lower() in it["shown"].lower()] if q else items
            sel = max(0, min(sel, len(shown) - 1))
            list_h = max(1, rows - 5)
            if sel < top:
                top = sel
            if sel >= top + list_h:
                top = sel - list_h + 1
            buf = ["\x1b[H\x1b[2J", bg(BG)]
            head = f"  {fg(T3)}{tr('찾기', 'filter')} {fg(TEXT)}{BOLD}{q}{RST}{bg(BG)}{fg(ACC)}▏{RST}{bg(BG)}"
            cnt = tr(f"{len(shown)}개", f"{len(shown)}")
            buf.append(head + " " * max(1, cols - width(f"  {tr('찾기', 'filter')} {q}▏") - width(cnt) - 2) + fg(T3) + cnt + "  \r\n")
            buf.append(fg((44, 48, 57)) + "  " + "─" * (cols - 4) + "  \r\n")
            if not shown:
                buf.append(f"  {fg(T2)}" + (tr("이 칸의 최근 출력에 열 수 있는 경로가 없습니다", "No openable paths in this pane's recent output") if not q else tr("맞는 경로가 없습니다", "No matching paths")) + "\r\n")
            for i in range(top, min(len(shown), top + list_h)):
                it = shown[i]
                icon = "▸" if it["isdir"] else "•"
                name = cut_left(it["shown"] + ("/" if it["isdir"] else ""), cols - 8)
                if i == sel:
                    line = f"{bg(SEL_BG)}{fg(ACC)} ▌{fg(TEXT)}{BOLD} {icon} {name}{RST}{bg(SEL_BG)}"
                    line += " " * max(0, cols - 5 - width(name)) + RST + bg(BG)
                else:
                    line = f"{bg(BG)}   {fg(T3)}{icon} {fg(T2)}{name}"
                buf.append(line + "\r\n")
            buf.append(f"\x1b[{rows - 1};1H{fg((44, 48, 57))}  " + "─" * (cols - 4) + "\r\n")
            there = from_mac()
            hint = msg or (f"{fg(TEXT)}Enter{fg(T3)} {editor_name(editor())}   "
                           f"{fg(TEXT)}Tab{fg(T3)} {tr('기본 앱', 'default app')}   {fg(TEXT)}^F{fg(T3)} Finder   "
                           if not there else
                           f"{fg(TEXT)}Enter{fg(T3)} {editor_name(editor()) if editor() in ('vscode', 'cursor') else tr(f'{there} 에서 열기', f'open on {there}')}   "
                           f"{fg(TEXT)}Tab{fg(T3)} {tr(f'{there} 기본 앱', f'default app on {there}')}   "
                           f"{fg(TEXT)}^Y{fg(T3)} {tr('복사', 'copy')}   {fg(TEXT)}Esc{fg(T3)} {tr('닫기', 'close')}")
            buf.append("  " + hint + RST)
            out.write("".join(buf))
            out.flush()
            msg = ""
            ch = os.read(fd, 32).decode(errors="ignore")
            if ch in ("\x1b", "\x03") or ch == "\x1bq":
                return
            if ch in ("\x1b[A", "\x10", "\x1bOA"):
                sel -= 1
            elif ch in ("\x1b[B", "\x0e", "\x1bOB"):
                sel += 1
            elif ch in ("\x1b[5~",):
                sel -= list_h
            elif ch in ("\x1b[6~",):
                sel += list_h
            elif ch in ("\r", "\n") and shown:
                note = open_editor(shown[sel])
                if note:            # opening on another Mac: say so for a moment / 다른 Mac 에서 열면 잠깐 알린다
                    out.write(f"\x1b[{rows};1H\x1b[2K  {fg(ACC)}{note}{RST}")
                    out.flush()
                    time.sleep(1.2)
                return
            elif ch in ("\t", "\x06") and shown:
                # on a screen from another Mac, it opens there (bin/hivemux-show); ^F too, Finder here is out of sight
                # 다른 Mac 에서 붙은 화면이면 거기서 연다 (bin/hivemux-show). ^F 도: 여기 Finder 는 안 보인다
                if from_mac():
                    note = show_there(shown[sel])
                    if note:
                        out.write(f"\x1b[{rows};1H\x1b[2K  {fg(ACC)}{note}{RST}")
                        out.flush()
                        time.sleep(1.5 if shown[sel]["isdir"] else 1.2)
                elif ch == "\t":
                    run([OS, "open", shown[sel]["full"]])
                else:
                    run([OS, "reveal", shown[sel]["full"]])
                return
            elif ch == "\x19" and shown:
                run([OS, "copy"], input=shown[sel]["full"].encode())
                if from_mac():      # and to that Mac's clipboard, by OSC 52 / 그 Mac 의 클립보드에도 (OSC 52)
                    run([TMUX, "set-buffer", "-w", "-t", CLIENT, "--", shown[sel]["full"]])
                msg = f"{fg(ACC)}{tr('복사했습니다', 'Copied')}  {fg(T2)}{cut_left(shown[sel]['full'], cols - 14)}"
            elif ch in ("\x7f", "\x08"):
                q = q[:-1]; sel = 0
            elif ch == "\x15":
                q = ""; sel = 0
            elif ch.isprintable() and not ch.startswith("\x1b"):
                q += ch; sel = 0
    finally:
        out.write(RST + "\x1b[2J")
        out.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


if __name__ == "__main__":
    if len(sys.argv) > 2 and sys.argv[2] == "--list":
        its, _ = candidates(PANE)
        for it in its:
            print(it["shown"], "->", it["full"])
        sys.exit(0)
    main()
