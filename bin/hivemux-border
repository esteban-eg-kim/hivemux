#!/bin/bash
# Border/grip drag feedback (called from tmux mouse bindings).
# 칸 경계선 끌기 피드백 (tmux 마우스 바인딩에서 호출).
#   hivemux-border down <client_tty>              resize pointer, highlight borders
#                                                 포인터를 좌우 크기 조절 모양으로, 경계선 강조
#   hivemux-border up   <client_tty> <window_id>  restore pointer/borders, save sidebar width, apply to all windows
#                                                 포인터/경계선 되돌리기, 사이드바 폭 저장 후 모든 창에 맞춤
# The pointer shape is sent to Ghostty as OSC 22 directly (tmux does not pass it through).
# 포인터 모양은 Ghostty 에 OSC 22 를 직접 보낸다 (tmux 는 이 신호를 넘기지 않음).
HM_BIN="$(cd "$(dirname "$(realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"
TMUX_BIN="$(command -v tmux || echo /opt/homebrew/bin/tmux)"
# UI language: HIVEMUX_LANG > tmux @hivemux-lang (set by hivemux setup) > LANG
# 화면 언어: HIVEMUX_LANG > tmux @hivemux-lang (hivemux setup 이 정함) > LANG
say() { local v="${HIVEMUX_LANG:-$("$TMUX_BIN" show -gqv @hivemux-lang 2>/dev/null)}"; if [[ "${v:-$LANG}" == ko* ]]; then printf '%s' "$1"; else printf '%s' "$2"; fi; }
t() { "$TMUX_BIN" "$@"; }
tty="$2"
shape() { [ -w "$tty" ] && printf '\033]22;%s\033\\' "$1" > "$tty"; }
GRIP="/tmp/hivemux-grip-$(id -u)"
# Redraw the grip now: signal only the sidebars of this tmux server
# 사이드바 핸들 색 바로 갱신: 이 tmux 서버의 사이드바 프로세스에만 신호를 보낸다
wake() {
  t list-panes -a -F '#{pane_pid} #{pane_title} #{m:*hivemux-sidebar-view*,#{pane_start_command}}' 2>/dev/null | awk '$2=="hivemux-sidebar" && $3==1{print $1}' |
    while read -r p; do kill -USR1 "$p" 2>/dev/null; done
}
case "$1" in
  down)
    shape ew-resize
    : > "$GRIP"; wake
    t set -g pane-border-style "fg=#5aa9ff"; t set -g pane-active-border-style "fg=#5aa9ff" ;;
  up)
    shape default
    rm -f "$GRIP"; wake
    t set -g pane-border-style "fg=#23262e"; t set -g pane-active-border-style "fg=#2c3039"
    w="$(t list-panes -t "$3" -F '#{pane_title} #{pane_width}' 2>/dev/null | awk '$1=="hivemux-sidebar"{print $2; exit}')"
    # the width a narrow window holds its sidebar at (bin/hivemux-sidebar width_for) is not a new choice:
    # a click on that border must not save it / 좁은 창이 줄여 둔 폭 (bin/hivemux-sidebar width_for) 은 새로 고른
    # 폭이 아니다: 그 경계를 클릭만 해서 저장되면 안 된다
    cur="$(t show -gqv @hivemux-sidebar-width)"; cur="${cur:-32}"
    ww="$(t display -p -t "$3" '#{window_width}' 2>/dev/null)"; held="$cur"
    [ -n "$ww" ] && [ $((ww - 41)) -lt "$held" ] && held=$((ww - 41)); [ "$held" -lt 16 ] && held=16
    if [ -n "$w" ] && [ "$w" != "$cur" ] && [ "$w" != "$held" ] && [ "$w" -ge 16 ]; then
      t set -g @hivemux-sidebar-width "$w"
      d="${XDG_DATA_HOME:-$HOME/.local/share}/hivemux"; mkdir -p "$d"; echo "$w" > "$d/sidebar-width"
      "$HM_BIN/hivemux-sidebar" fix
      t display -d 1200 "$(say "사이드바 폭 $w 칸" "Sidebar width $w")"
    elif [ -n "$w" ]; then
      # dragged under 16 columns (or not changed): every sidebar back to the width that holds
      # 16칸보다 좁게 끌었거나 그대로: 모든 사이드바를 정해진 폭으로 되돌린다
      "$HM_BIN/hivemux-sidebar" fix
    fi ;;
esac
exit 0
