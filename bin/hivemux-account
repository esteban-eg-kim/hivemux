#!/usr/bin/env python3
"""Claude accounts: log in to more than one and switch between them, for all projects or for one project.
Claude 계정: 여러 계정에 로그인해 두고 바꿔 쓴다. 모든 프로젝트에, 또는 프로젝트 하나에.

  hivemux-account list [--json]                  the accounts and who uses which / 계정과 쓰는 곳
  hivemux-account add <name>                     log in to another account (opens the browser) / 다른 계정에 로그인 (브라우저)
  hivemux-account use <name|default>             the account for all projects / 모든 프로젝트의 계정
  hivemux-account use <name|default|all> -s <project>   this project's own account; all = as for all projects
                                                 이 프로젝트만의 계정. all = 모든 프로젝트 설정을 따른다
  hivemux-account remove <name>                  log out and forget it / 로그아웃하고 지운다
  hivemux-account add-key <name>                 an account that uses an API key (asks for it) / API 키로 쓰는 계정 (키를 묻는다)
  hivemux-account fallback <name|off>            when a subscription hits its usage limit, its Claudes go on with
                                                 this API key account in the same conversation until the limit
                                                 resets / 구독이 사용 한도에 걸리면 그 Claude 들을 한도가 풀릴
                                                 때까지 이 API 키 계정으로 같은 대화에서 이어 간다
  hivemux-account fallback <name|off|all> -s <project>   the same for one project; all = as for all projects
                                                 프로젝트 하나만. all = 모든 프로젝트 설정을 따른다
  hivemux-account hide <name|default> [on|off]   keep its Claudes out of the Claude app and claude.ai (no Remote
                                                 Control), for an account shared with others / 이 계정의 Claude 를
                                                 Claude 앱과 claude.ai 에 보이지 않게 (Remote Control 없이). 같이 쓰는 계정에
  hivemux-account hide -s <project> [on|off]     the same for one project (its team too) / 프로젝트 하나 (그 팀도)
  hivemux-account hide --pane <pane> [on|off]    the same for one Claude (sidebar menu) / Claude 하나 (사이드바 메뉴)
  hivemux-account current [-s <project>]         the account a project uses / 프로젝트가 쓰는 계정
  hivemux-account env                            (tmux start) set tmux's environment again / (tmux 시작) tmux 환경을 다시 맞춘다
  hivemux-account --popup <client> [-s <project>]  the picker in a popup (sidebar menu) / 고르는 팝업 (사이드바 메뉴)

"default" is the login in ~/.claude. Another account is its own Claude config dir, $XDG_DATA_HOME/hivemux/accounts/<name>,
used through CLAUDE_CONFIG_DIR; it has its own login and links the rest of ~/.claude (settings, conversations,
skills, plugins, history), so a conversation goes on under any account and artifacts are not involved.
The choice is in $XDG_DATA_HOME/hivemux/account (all projects) and account-projects (<project>\\t<name>), read by
bin/hivemux-claude each time Claude starts. Switching restarts the Claudes now on another account in the same
conversation (bin/hivemux-claude-update watch), once they are not working or waiting for an answer.
"default" 는 ~/.claude 의 로그인이다. 다른 계정은 자기 Claude 설정 폴더 $XDG_DATA_HOME/hivemux/accounts/<이름> 이고,
CLAUDE_CONFIG_DIR 로 쓴다. 로그인만 따로이고 나머지(설정, 대화, 스킬, 플러그인, 기록)는 ~/.claude 를 링크해서, 대화는
어느 계정으로든 이어진다. 고른 것은 $XDG_DATA_HOME/hivemux/account (모든 프로젝트) 와 account-projects
(<프로젝트>\\t<이름>) 에 있고, Claude 가 시작할 때마다 bin/hivemux-claude 가 읽는다. 바꾸면 다른 계정으로 도는 Claude 를
같은 대화로 다시 시작한다 (bin/hivemux-claude-update watch). 일하거나 답을 기다리는 중이면 끝난 뒤에.
"""
import datetime, fcntl, getpass, json, os, re, shlex, shutil, subprocess, sys, termios, time, tty, unicodedata
import urllib.error, urllib.request

HERE = os.path.dirname(os.path.realpath(__file__))
os.environ["PATH"] = os.environ.get("PATH", "") + ":/opt/homebrew/bin:/usr/local/bin:" + os.path.expanduser("~/.local/bin")
TMUX = shutil.which("tmux") or "/opt/homebrew/bin/tmux"
DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "hivemux")
ACCOUNTS = os.path.join(DATA, "accounts")
GLOBAL = os.path.join(DATA, "account")
PROJECTS = os.path.join(DATA, "account-projects")
HIDDEN = os.path.join(DATA, "hidden-accounts")     # one name a line, read by bin/hivemux-claude / 한 줄에 이름 하나
HIDDEN_PROJECTS = os.path.join(DATA, "hidden-projects")    # project (tmux session) names / 프로젝트 (tmux 세션) 이름
HIDDEN_CLAUDES = os.path.join(DATA, "hidden-claudes")      # conversation ids, so a reboot keeps one hidden / 대화 id. 재부팅해도 숨긴 채
# An API key account keeps its key in its dir (read by bin/hivemux-claude); the fallback is one such account's name,
# and the accounts at their usage limit are lines "<account>\t<until, epoch>"
# API 키 계정은 키를 자기 폴더에 둔다 (bin/hivemux-claude 가 읽는다). fallback 은 그런 계정 하나의 이름, 사용 한도에
# 걸린 계정은 "<계정>\t<풀리는 시각, epoch>" 줄이다
KEY_FILE = "api-key"
FALLBACK = os.path.join(DATA, "account-fallback")
FALLBACK_PROJECTS = os.path.join(DATA, "account-fallback-projects")     # <project>\t<name|off>
LIMITED = os.path.join(DATA, "account-limited")
HOME_DIR = os.path.expanduser("~/.claude")
HOME_JSON = os.path.expanduser("~/.claude.json")
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$")
# ~/.claude entries that belong to one login or one running Claude; the rest are linked
# ~/.claude 에서 로그인 하나나 실행 중인 Claude 하나의 것. 나머지는 링크한다
PRIVATE = re.compile(r"^(\.credentials\.json|\.DS_Store|\.last-cleanup|session-env|daemon.*|jobs|shell-snapshots"
                     r"|cache|backups|channels|statsig|telemetry|mcp-needs-auth-cache\.json|ide)$")
# ~/.claude.json keys that belong to the login or are caches of it; the rest (trusted folders, MCP servers,
# onboarding) is copied so the new account does not ask everything again
# ~/.claude.json 에서 로그인의 것이거나 그 캐시인 키. 나머지(신뢰한 폴더, MCP 서버, 첫 안내)는 복사해서 새 계정이 다시 묻지 않게
LOGIN_KEYS = re.compile(r"^(oauthAccount|userID|groveChoiceSeenAt|summonSidKey|claudeAiMcpEverConnected|s1mAccessCache)$"
                        r"|[Cc]ache|^cached|^passes|^metricsStatus|^remoteControl|^replBridge|^apiCreditLink")


def tmux(*a):
    return subprocess.run([TMUX, *a], capture_output=True, text=True, stdin=subprocess.DEVNULL).stdout


def tr(ko, en):
    v = os.environ.get("HIVEMUX_LANG") or tmux("show", "-gqv", "@hivemux-lang").strip()
    return ko if (v or os.environ.get("LANG", "")).startswith("ko") else en


def config_dir(name):
    return os.path.join(ACCOUNTS, name)


def names():
    """The accounts besides default, in name order / default 말고 계정들, 이름순"""
    try:
        return sorted(n for n in os.listdir(ACCOUNTS) if NAME_RE.match(n) and os.path.isdir(config_dir(n)))
    except OSError:
        return []


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def write_atomic(path, text):
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def api_key(name):
    """The account's API key ("" = a login account) / 계정의 API 키 ("" = 로그인 계정)"""
    if name in ("default", "all"):
        return ""
    try:
        return open(os.path.join(config_dir(name), KEY_FILE)).read().strip()
    except OSError:
        return ""


def who(name):
    """{email, plan} of the account's login ({} when not logged in) / 그 계정 로그인의 이메일, 요금제 (로그인 전이면 {})"""
    k = api_key(name)
    if k:
        return {"email": tr(f"API 키 …{k[-4:]}", f"API key …{k[-4:]}"), "plan": "API"}
    acc = read_json(HOME_JSON if name == "default" else os.path.join(config_dir(name), ".claude.json")).get("oauthAccount") or {}
    return {"email": acc.get("emailAddress", ""), "plan": acc.get("planDisplayName") or acc.get("billingType") or ""} if acc else {}


def chosen():
    """(the account for all projects, {project: account}) / (모든 프로젝트의 계정, {프로젝트: 계정})"""
    try:
        g = open(GLOBAL).read().strip()
    except OSError:
        g = ""
    known = {"default", *names()}
    proj = {}
    try:
        for ln in open(PROJECTS):
            s, _, n = ln.rstrip("\n").partition("\t")
            if s and n in known:
                proj[s] = n
    except OSError:
        pass
    return (g if g in known else "default"), proj


def save(g, proj):
    os.makedirs(DATA, exist_ok=True)
    write_atomic(GLOBAL, g + "\n")
    write_atomic(PROJECTS, "".join(f"{s}\t{n}\n" for s, n in sorted(proj.items())))


def resolve(session):
    g, proj = chosen()
    return proj.get(session, g)


# ── the usage limit / 사용 한도 ──

def fallbacks():
    """(the one for all projects, {project: name or "off"}) as set / (모든 프로젝트의 것, {프로젝트: 이름 또는 "off"})"""
    try:
        g = open(FALLBACK).read().strip()
    except OSError:
        g = ""
    proj = {}
    try:
        for ln in open(FALLBACK_PROJECTS):
            p, _, n = ln.rstrip("\n").partition("\t")
            if p and n:
                proj[p] = n
    except OSError:
        pass
    return g, proj


def fallback(session=None):
    """The API key account Claudes go on with at a usage limit, the project's own when it has one ("" = none)
    사용 한도에서 이어 갈 API 키 계정. 프로젝트에 정한 것이 있으면 그것 ("" = 없음)"""
    g, proj = fallbacks()
    n = proj.get(session, g) if session else g
    return n if n != "off" and api_key(n) else ""


def set_fallback(name, session=None):
    """name: an API key account, "off", or (a project) "all" = as for all projects
    name: API 키 계정, "off", 또는 (프로젝트) "all" = 모든 프로젝트 설정을 따른다"""
    g, proj = fallbacks()
    os.makedirs(DATA, exist_ok=True)
    if session:
        if name == "all":
            proj.pop(session, None)
        else:
            proj[session] = name
        write_atomic(FALLBACK_PROJECTS, "".join(f"{p}\t{n}\n" for p, n in sorted(proj.items())))
    elif name == "off":
        try:
            os.unlink(FALLBACK)
        except OSError:
            pass
    else:
        write_atomic(FALLBACK, name + "\n")


def limited():
    """{account: until (epoch)} of the accounts at their usage limit now / 지금 사용 한도에 걸린 계정: 풀리는 시각"""
    out, now = {}, time.time()
    try:
        for ln in open(LIMITED):
            a, _, u = ln.rstrip("\n").partition("\t")
            if a and u.isdigit() and int(u) > now:
                out[a] = int(u)
    except OSError:
        pass
    return out


def effective(name, lim=None, session=None):
    """The account a Claude chosen for name (in project session) runs on: the fallback while name is at its limit
    (프로젝트 session 에서) name 으로 정한 Claude 가 실제로 도는 계정: name 이 한도에 걸린 동안은 fallback"""
    fb = fallback(session)
    if fb and fb != name and name in (limited() if lim is None else lim):
        return fb
    return name


# a subscription's limit: "You've hit your weekly limit", "You've reached your Fable limit"; not "Server is temporarily
# limiting requests" nor "Rate limit reached" / 구독의 한도. 서버가 잠시 요청을 줄이는 것이 아니다
SUB_LIMIT = re.compile(r"(hit|reached) your\b.*\blimit", re.I)
MONTHS = ("jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec")


def reset_at(msg, now=None):
    """When a limit message says it resets, e.g. "You've hit your weekly limit · resets Nov 24 at 1am (Asia/Seoul)"
    or "resets 3:45pm"; None when it does not say / 한도 메시지가 말하는 풀리는 시각. 말하지 않으면 None"""
    m = re.search(r"resets\s+(?:([A-Za-z]{3})[a-z]*\.?\s+(\d{1,2}),?\s+)?(?:at\s+)?(\d{1,2})(?::(\d{2}))?\s*(am|pm)"
                  r"(?:\s*\(([^)]+)\))?", msg, re.I)
    if not m:
        return None
    mon, day, h, mi, ap, tz = m.groups()
    try:
        from zoneinfo import ZoneInfo
        zone = ZoneInfo(tz) if tz else None
    except Exception:
        zone = None
    now = datetime.datetime.fromtimestamp(now or time.time(), zone or datetime.datetime.now().astimezone().tzinfo)
    h = int(h) % 12 + (12 if ap.lower() == "pm" else 0)
    t = now.replace(hour=h, minute=int(mi or 0), second=0, microsecond=0)
    if mon and mon.lower() in MONTHS:
        t = t.replace(month=MONTHS.index(mon.lower()) + 1, day=int(day))
        if t < now - datetime.timedelta(days=1):
            t = t.replace(year=t.year + 1)
    elif t <= now:
        t += datetime.timedelta(days=1)
    return int(t.timestamp())


def limit_text(msg, transcript):
    """The limit message: the hook's text, else the conversation's last API error line
    한도 메시지: 훅이 준 글, 없으면 대화의 마지막 API 오류 줄"""
    if SUB_LIMIT.search(msg or ""):
        return msg
    try:
        with open(transcript, "rb") as f:
            f.seek(max(0, os.path.getsize(transcript) - 400000))
            lines = f.read().decode(errors="ignore").splitlines()
    except (OSError, TypeError):
        return msg or ""
    for ln in reversed(lines):
        if '"isApiErrorMessage":true' not in ln:
            continue
        try:
            c = json.loads(ln).get("message", {}).get("content") or []
        except ValueError:
            continue
        return " ".join(b.get("text", "") for b in c if isinstance(b, dict)) if isinstance(c, list) else str(c)
    return msg or ""


# the subscription cannot be used at all (a payment past due, billing, an account on hold): no time it comes back
# 구독을 아예 쓸 수 없다 (결제 밀림, 청구, 계정 보류): 돌아오는 시각이 없다
SUB_ERRORS = ("oauth_org_not_allowed", "billing_error", "account_on_hold")


def at_limit(pane, msg, transcript="", error="rate_limit"):
    """(the StopFailure hook) A subscription account hit its usage limit, or cannot be used (SUB_ERRORS): its Claudes
    go on with the fallback until it resets (a day for an error: choosing the account again tries it at once), this
    one also goes on with what it was doing. Not for an API key account (its rate limits pass by)
    (StopFailure 훅) 구독 계정이 사용 한도에 걸렸거나 쓸 수 없다 (SUB_ERRORS): 그 계정의 Claude 들은 풀릴 때까지
    fallback 으로 이어 가고 (오류는 하루. 그 계정을 다시 고르면 바로 다시 써 본다), 이 Claude 는 하던 일도 이어 간다.
    API 키 계정은 아니다 (그 요청 한도는 곧 풀린다)"""
    g, proj = fallbacks()
    if not g and not [n for n in proj.values() if n != "off"]:
        return 0
    shell = tmux("display", "-p", "-t", pane, "#{pane_pid}").strip()
    pid = claude_pid(shell) if shell else None
    if not pid:
        return 0
    d = os.path.normpath(running_dir(pid) or HOME_DIR)
    name = "default" if d == os.path.normpath(HOME_DIR) else os.path.basename(d)
    if api_key(name):
        return 0
    if error in SUB_ERRORS:
        until = int(time.time()) + 24 * 3600
    else:
        msg = limit_text(msg, transcript)
        if not SUB_LIMIT.search(msg):
            return 0
        until = reset_at(msg) or int(time.time()) + 5 * 3600  # says nothing: try again in five hours / 말이 없으면 5시간 뒤
    lim = limited()
    lim[name] = max(until, lim.get(name, 0))
    os.makedirs(DATA, exist_ok=True)
    write_atomic(LIMITED, "".join(f"{a}\t{u}\n" for a, u in sorted(lim.items())))
    # the account is at its limit for every project; this one goes on only where a fallback is set
    # 계정은 모든 프로젝트에서 한도에 걸렸다. 이 Claude 는 이어 갈 계정을 정한 프로젝트에서만 이어 간다
    if fallback(tmux("display", "-p", "-t", pane, "#{session_name}").strip()):
        tmux("set", "-p", "-t", pane, "@hivemux-continue", "1")
    env()
    n = restart()
    watch_limits()
    return n


def watch_limits():
    """Start the watcher that moves the Claudes back when a limit resets / 한도가 풀리면 Claude 를 되돌리는 감시를 띄운다"""
    if limited():
        subprocess.Popen([os.path.realpath(__file__), "watch-limits"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def watch_loop():
    """Wait for each limit to reset, then restart its Claudes on their own account, once they are free and off the
    screens; one watcher at a time / 한도가 풀리길 기다렸다가 그 Claude 들을 원래 계정으로 다시 시작한다. 한가하고 화면에
    없을 때. 감시는 하나만"""
    lock = open(os.path.join(DATA, ".account-limited.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return
    known = set(limited())
    while known:
        lim = limited()
        if set(lim) != known:
            env()
            restart(now=False)
            known = set(lim)
            continue
        time.sleep(max(5, min(600, min(lim.values()) - time.time() + 5)))


# ── an account's config dir / 계정의 설정 폴더 ──

# kept apart by an earlier version, now shared: the running sessions (one file each), so Claudes on different
# accounts see each other to send messages / 예전 버전은 따로 두었고 이제 함께 쓴다: 실행 중인 세션 명부 (세션마다
# 파일 하나). 그래야 다른 계정의 Claude 끼리 서로 보고 메시지를 보낸다
JOIN = ("sessions",)


def join_dir(d, e):
    """Move a dir of the account's own into ~/.claude's and link it there; live sessions keep writing to the same path
    계정만의 폴더를 ~/.claude 쪽으로 옮기고 링크한다. 실행 중인 세션은 같은 경로에 계속 쓴다"""
    own, home = os.path.join(d, e), os.path.join(HOME_DIR, e)
    if os.path.islink(own) or not os.path.isdir(own):
        return
    os.makedirs(home, exist_ok=True)
    for _ in range(3):                  # a session may add a file meanwhile / 그 사이 세션이 파일을 더할 수 있다
        merge_into(own, home)
        tmp = f"{own}.{os.getpid()}"
        try:
            os.rename(own, tmp)
        except OSError:
            continue
        os.symlink(home, own)
        merge_into(tmp, home)           # written in the moment between / 그 짧은 사이에 쓰인 것
        shutil.rmtree(tmp, ignore_errors=True)
        return


def merge_into(src, dst):
    """Move src's files into dst, folders too (projects/<folder>/<id>.jsonl). A conversation in both is one log
    written in two places: src's lines go on the end of dst's. Another file in both keeps dst's
    src 의 파일을 dst 로 옮긴다. 폴더도 (projects/<폴더>/<id>.jsonl). 양쪽에 있는 대화는 두 곳에 쓴 한 기록이라
    src 의 줄을 dst 끝에 붙인다. 그 밖에 양쪽에 있는 파일은 dst 것을 둔다"""
    for f in os.listdir(src):
        s, t = os.path.join(src, f), os.path.join(dst, f)
        if os.path.isdir(s) and not os.path.islink(s):
            if not os.path.lexists(t):
                os.replace(s, t)
            elif os.path.isdir(t):
                merge_into(s, t)
                shutil.rmtree(s, ignore_errors=True)
            continue
        if not os.path.lexists(t):
            os.replace(s, t)
            continue
        if f.endswith(".jsonl") and os.path.isfile(t):
            with open(s, "rb") as a, open(t, "rb+") as b:
                b.seek(0, 2)
                if b.tell():
                    b.seek(-1, 2)
                    if b.read(1) != b"\n":
                        b.write(b"\n")
                shutil.copyfileobj(a, b)
        os.unlink(s)


def link_shared(d):
    """Link what is not the login's from ~/.claude, also entries that appeared there since
    ~/.claude 에서 로그인의 것이 아닌 것을 링크한다. 그 뒤에 생긴 것도"""
    try:
        entries = os.listdir(HOME_DIR)
    except OSError:
        return
    for e in entries:
        dst = os.path.join(d, e)
        # also a folder made in the account before it was linked (a Claude started on it then wrote projects/
        # there, and resuming found none of the conversations) / 링크하기 전에 계정 안에 생긴 폴더도 (거기서
        # 시작한 Claude 가 projects/ 를 만들어, 재개할 때 대화를 하나도 찾지 못했다)
        if e in JOIN or (not PRIVATE.match(e) and os.path.isdir(dst) and not os.path.islink(dst)
                         and os.path.isdir(os.path.join(HOME_DIR, e))):
            join_dir(d, e)
        if PRIVATE.match(e) or os.path.lexists(dst):
            continue
        os.symlink(os.path.join(HOME_DIR, e), dst)


def sync_config(d):
    """Copy the non-login keys of ~/.claude.json the account lacks, and folders trusted since
    ~/.claude.json 에서 로그인 아닌 키 중 계정에 없는 것과, 그 뒤에 신뢰한 폴더를 복사한다"""
    src = read_json(HOME_JSON)
    if not src:
        return
    path = os.path.join(d, ".claude.json")
    cur = read_json(path)
    changed = not os.path.exists(path)
    for k, v in src.items():
        if LOGIN_KEYS.search(k):
            continue
        if k not in cur:
            cur[k], changed = v, True
        elif k == "projects" and isinstance(v, dict) and isinstance(cur[k], dict):
            for p, pv in v.items():
                if p not in cur[k]:
                    cur[k][p], changed = pv, True
    if changed:
        write_atomic(path, json.dumps(cur, indent=2, ensure_ascii=False))


def prepare(name):
    d = config_dir(name)
    os.makedirs(d, exist_ok=True)
    link_shared(d)
    sync_config(d)
    return d


def login(name):
    """Log the account in, in this terminal (the browser opens) / 이 터미널에서 계정에 로그인 (브라우저가 열린다)"""
    d = prepare(name)
    env = dict(os.environ, CLAUDE_CONFIG_DIR=d)
    print(tr(f"'{name}' 계정으로 로그인합니다. 브라우저에서 로그인을 마쳐 주십시오.",
             f"Logging in as '{name}'. Please finish logging in in the browser."), flush=True)
    subprocess.run(["claude", "auth", "login"], env=env)
    return bool(who(name))


def check_key(key):
    """None when Anthropic takes the key, else why not / Anthropic 이 키를 받으면 None, 아니면 이유"""
    req = urllib.request.Request("https://api.anthropic.com/v1/models?limit=1",
                                 headers={"x-api-key": key, "anthropic-version": "2023-06-01"})
    try:
        urllib.request.urlopen(req, timeout=15).read()
        return None
    except urllib.error.HTTPError as e:
        try:
            why = json.loads(e.read()).get("error", {}).get("message", "")
        except (OSError, ValueError, AttributeError):
            why = ""
        return (tr("키가 맞지 않습니다", "The key was not accepted") if e.code in (401, 403) else f"HTTP {e.code}") + (
            f" ({why})" if why else "")
    except OSError as e:
        return str(e)


def clean_key(k):
    """The key as pasted, without what came with it: the paste brackets (ESC[200~ … ESC[201~, also cut in two by a
    read), spaces and line ends. A key is letters, digits, - and _
    붙여 넣은 키에서 함께 온 것을 뺀다: 붙여 넣기 괄호 (ESC[200~ … ESC[201~, 읽다가 둘로 잘린 것도), 공백, 줄 끝.
    키는 글자, 숫자, - 와 _ 이다"""
    return re.sub(r"[^A-Za-z0-9_-]", "", re.sub(r"\x1b?\[?20[01]~", "", k))


def add_key(name, key):
    """An account that runs on an API key. Claude Code asks once whether to use a key it finds: answered here
    API 키로 도는 계정. Claude Code 는 찾은 키를 쓸지 한 번 묻는다: 여기서 미리 답해 둔다"""
    d = prepare(name)
    path = os.path.join(d, KEY_FILE)
    fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(key + "\n")
    os.replace(path + ".tmp", path)
    cj = os.path.join(d, ".claude.json")
    cur = read_json(cj)
    r = cur.get("customApiKeyResponses") if isinstance(cur.get("customApiKeyResponses"), dict) else {}
    r = {"approved": [k for k in r.get("approved", []) if k != key[-20:]] + [key[-20:]],
         "rejected": [k for k in r.get("rejected", []) if k != key[-20:]]}
    cur["customApiKeyResponses"] = r
    write_atomic(cj, json.dumps(cur, indent=2, ensure_ascii=False))
    env()


def go_on(pane):
    """(SessionStart after a move at the limit) Ask the Claude to go on with what the limit cut, once it rests with an
    empty prompt / (한도로 옮긴 뒤 SessionStart) 한도로 끊긴 일을 이어 하라고 한다. 쉬고 입력창이 비면"""
    time.sleep(8)                       # after the hook's other keys (bin/hivemux-rename rc-off-hidden) / 훅의 다른 키 다음에
    for _ in range(30):
        st = tmux("show", "-pqv", "-t", pane, "@claude_state").strip()
        free = subprocess.run([os.path.join(HERE, "hivemux-team"), "prompt-free", pane],
                              stdin=subprocess.DEVNULL, capture_output=True).returncode == 0
        if st in ("idle", "done") and free:
            tmux("send-keys", "-t", pane, "-l", tr("사용 한도 때문에 끊겼던 일을 이어서 해 주세요.",
                                                   "Please go on with the work the usage limit cut off."))
            tmux("send-keys", "-t", pane, "Enter")
            return
        time.sleep(2)


# ── tmux and running Claudes / tmux 와 실행 중인 Claude ──

def env():
    """Set tmux's environment from the choice: new windows start Claude on their project's account, and the resume
    paths go through bin/hivemux-claude. The status line shows the account when it is not default.
    고른 것대로 tmux 환경을 맞춘다: 새 창은 그 프로젝트의 계정으로 Claude 를 시작하고, 재개하는 곳은
    bin/hivemux-claude 를 거친다. 기본 계정이 아니면 상태줄에 계정을 보인다."""
    g, proj = chosen()
    for n in names():                   # what a newer version shares, and new entries of ~/.claude / 새 버전이 함께 쓰는 것, ~/.claude 에 새로 생긴 것
        link_shared(config_dir(n))
    if names():
        tmux("set-environment", "-g", "HIVEMUX_CLAUDE", os.path.join(HERE, "hivemux-claude"))
    else:
        tmux("set-environment", "-gu", "HIVEMUX_CLAUDE")
    if g == "default":
        tmux("set-environment", "-gu", "CLAUDE_CONFIG_DIR")
    else:
        tmux("set-environment", "-g", "CLAUDE_CONFIG_DIR", config_dir(g))
    # the status line names the account Claudes run on: the fallback while one is at its limit
    # 상태줄은 Claude 가 실제로 도는 계정을 보인다: 한도에 걸린 동안은 fallback
    lim = limited()
    glabel = effective(g, lim)
    tmux("set", "-g", "@hivemux-account", "" if glabel == "default" else glabel)
    for s in tmux("list-sessions", "-F", "#{session_name}").splitlines():
        n = proj.get(s)
        if n is None:
            tmux("set-environment", "-u", "-t", f"={s}", "CLAUDE_CONFIG_DIR")
            tmux("set", "-u", "-t", f"={s}:", "@hivemux-account")
        else:
            if n == "default":      # removed, so it is not taken from the global one / 지워 둔다. 전역 것을 받지 않게
                tmux("set-environment", "-r", "-t", f"={s}", "CLAUDE_CONFIG_DIR")
            else:
                tmux("set-environment", "-t", f"={s}", "CLAUDE_CONFIG_DIR", config_dir(n))
        # the account it runs on: its own, or the global one's fallback differs for it (its own fallback)
        # 실제로 도는 계정: 자기 계정이거나, 자기 fallback 때문에 전역과 다를 때
        e = effective(proj.get(s, g), lim, s)
        if n is not None or e != glabel:
            tmux("set", "-t", f"={s}:", "@hivemux-account", "" if e == "default" else e)
    for c in tmux("list-clients", "-F", "#{client_name}").splitlines():
        tmux("refresh-client", "-t", c, "-S")


def claude_pid(shell_pid):
    """The Claude under a pane's shell: its child, or a grandchild (a shell the profile starts again)
    칸 셸 아래의 Claude: 자식, 또는 손자 (프로필이 셸을 한 번 더 띄운 경우)"""
    kids = {}
    for ln in subprocess.run(["ps", "-ax", "-o", "pid=,ppid=,comm="], capture_output=True, text=True).stdout.splitlines():
        p = ln.split(None, 2)
        if len(p) == 3:
            kids.setdefault(p[1], []).append((p[0], p[2]))
    level = [shell_pid]
    for _ in range(2):
        level_next = []
        for pp in level:
            for pid, comm in kids.get(pp, []):
                if re.search(r"(^|/)(claude|node)$", comm):
                    return pid
                level_next.append(pid)
        level = level_next
    return None


def running_dir(pid):
    """The CLAUDE_CONFIG_DIR a process runs with ("" = ~/.claude) / 프로세스의 CLAUDE_CONFIG_DIR ("" = ~/.claude)"""
    try:
        with open(f"/proc/{pid}/environ", "rb") as f:
            for kv in f.read().split(b"\0"):
                if kv.startswith(b"CLAUDE_CONFIG_DIR="):
                    return kv.split(b"=", 1)[1].decode()
            return ""
    except OSError:
        pass
    out = subprocess.run(["ps", "-E", "-ww", "-o", "command=", "-p", pid], capture_output=True, text=True).stdout
    m = re.search(r"(?:^|\s)CLAUDE_CONFIG_DIR=(\S+)", out)
    return m.group(1) if m else ""


def movers(g, proj):
    """[(pane, project)]: the Claudes running on another account than (g, proj) gives their project
    [(칸, 프로젝트)]: (g, proj) 가 그 프로젝트에 정하는 것과 다른 계정으로 도는 Claude"""
    out, lim = [], limited()
    for ln in tmux("list-panes", "-a", "-F", "#{pane_id}\t#{pane_pid}\t#{session_name}\t#{@claude_session}").splitlines():
        pane, shell, sess, sid = (ln.split("\t") + ["", "", "", ""])[:4]
        if not sid:
            continue
        pid = claude_pid(shell)
        if not pid:
            continue
        want = effective(proj.get(sess, g), lim, sess)
        want_dir = "" if want == "default" else config_dir(want)
        if os.path.normpath(running_dir(pid) or HOME_DIR) != os.path.normpath(want_dir or HOME_DIR):
            out.append((pane, sess))
    return out


def choice(name, session=None):
    """(g, proj) after choosing name, not saved / name 을 고른 뒤의 (g, proj). 저장하지 않는다"""
    g, proj = chosen()
    proj = dict(proj)
    if session:
        if name == "all":
            proj.pop(session, None)
        else:
            proj[session] = name
    else:
        g = name
    return g, proj


def restart(now=True):
    """Mark the Claudes on another account than their project's now and let the watcher restart them, even on a
    screen (you just chose this), also those stopped by a rate limit; returns how many. now=False: once they are
    off the screens and not working (a limit reset), also stopped by an API error
    프로젝트의 지금 계정과 다른 계정으로 도는 Claude 를 표시하고 watch 가 다시 시작하게 한다. 화면에 보여도 (방금
    고른 것이므로), 한도에 걸려 멈춘 것도. 몇 개인지 돌려준다. now=False: 화면에 없고 일하지 않을 때 (한도가 풀림).
    API 오류로 멈춘 것도"""
    moved = movers(*chosen())
    for pane, _ in moved:
        tmux("set", "-p", "-t", pane, "@claude_restart_pending", "now" if now else "back")
    n = len(moved)
    if n:
        subprocess.Popen([os.path.join(HERE, "hivemux-claude-update"), "watch"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return n


def use(name, session=None):
    """Choose an account and restart the Claudes it moves; returns how many / 계정을 고르고 옮겨 갈 Claude 를 다시 시작한다"""
    if name != "all" and name != "default" and name not in names():
        raise SystemExit(tr(f"'{name}' 계정이 없습니다. hivemux account add {name}", f"No account '{name}'. hivemux account add {name}"))
    if name == "all" and not session:
        raise SystemExit("all: -s <project>")
    if name not in ("default", "all"):
        prepare(name)
    # chosen again while at its limit: try it again now / 한도에 걸린 계정을 다시 고름: 지금 다시 써 본다
    lim = limited()
    if lim.pop(name, None):
        write_atomic(LIMITED, "".join(f"{a}\t{u}\n" for a, u in sorted(lim.items())))
    save(*choice(name, session))
    env()
    return restart()


def remove(name):
    if name not in names():
        raise SystemExit(tr(f"'{name}' 계정이 없습니다.", f"No account '{name}'."))
    g, proj = chosen()
    d = config_dir(name)
    subprocess.run(["claude", "auth", "logout"], env=dict(os.environ, CLAUDE_CONFIG_DIR=d),
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL)
    shutil.rmtree(d)        # the links go, not what they point at / 링크만 지워지고 가리키는 것은 남는다
    save("default" if g == name else g, {s: n for s, n in proj.items() if n != name})
    env()
    return restart()


def hidden(path=HIDDEN):
    try:
        return {l.strip() for l in open(path) if l.strip()}
    except OSError:
        return set()


def set_hidden(path, name, on):
    h = hidden(path) | {name} if on else hidden(path) - {name}
    os.makedirs(DATA, exist_ok=True)
    write_atomic(path, "".join(n + "\n" for n in sorted(h)))


def rc_panes(panes, on):
    """Disconnect (or connect again) these Claudes' Remote Control, from the command itself (bin/hivemux-rename
    rc-off / rc-on): a resting one now, a busy one when its turn ends (the Stop hook). Returns how many
    이 Claude 들의 Remote Control 을 명령으로 끊는다 (또는 다시 잇는다): 쉬는 것은 지금, 일하는 것은 턴이 끝날 때
    (Stop 훅). 몇 개인지 돌려준다"""
    for pane in panes:
        subprocess.Popen([os.path.join(HERE, "hivemux-rename"), "rc-off" if not on else "rc-on", pane], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return len(panes)


def running(where):
    """[(pane, claude session id)] of the Claudes running in a project (-s) or all / 프로젝트 (또는 전부) 에서 도는 Claude"""
    out = []
    for ln in tmux("list-panes", *(["-s", "-t", f"={where}"] if where else ["-a"]), "-F", "#{pane_id}\t#{pane_pid}\t#{@claude_session}").splitlines():
        pane, shell, sid = (ln.split("\t") + ["", "", ""])[:3]
        if sid and claude_pid(shell):
            out.append((pane, sid))
    return out


def hide_project(session, on=True):
    """A project's Claudes (its team too) out of the Claude app / 프로젝트의 Claude (그 팀도) 를 Claude 앱에서 숨긴다"""
    set_hidden(HIDDEN_PROJECTS, session, on)
    return rc_panes([p for p, _ in running(session)], not on)


def hide_pane(pane, on=True):
    """One Claude out of the Claude app: marked on its pane (bin/hivemux-claude) and by its conversation, which the
    hook carries on to the next one after /clear (bin/hivemux-hook)
    Claude 하나를 Claude 앱에서 숨긴다: 칸에 표시하고 (bin/hivemux-claude) 대화로도 적는다. /clear 뒤 새 대화로는 훅이 옮긴다"""
    sid = tmux("show", "-pqv", "-t", pane, "@claude_session").strip()
    if on:
        tmux("set", "-p", "-t", pane, "@hivemux-hidden", "1")
    else:
        tmux("set", "-pu", "-t", pane, "@hivemux-hidden")
    if sid:
        set_hidden(HIDDEN_CLAUDES, sid, on)
    return rc_panes([p for p, _ in running("") if p == pane], not on)


def hide(name, on=True):
    """Keep an account's Claudes out of the Claude app and claude.ai: bin/hivemux-claude starts them without Remote
    Control. The ones running now restart in the same conversation (busy ones once done); returns how many
    계정의 Claude 를 Claude 앱과 claude.ai 에 보이지 않게: bin/hivemux-claude 가 Remote Control 없이 시작한다. 지금 도는
    것은 같은 대화로 다시 시작한다 (일하는 중이면 끝난 뒤). 몇 개인지 돌려준다"""
    if name != "default" and name not in names():
        raise SystemExit(tr(f"'{name}' 계정이 없습니다.", f"No account '{name}'."))
    set_hidden(HIDDEN, name, on)
    d = os.path.normpath(HOME_DIR if name == "default" else config_dir(name))
    return rc_panes([p for p, _ in running("") if os.path.normpath(running_dir(claude_pid(
        tmux("display", "-p", "-t", p, "#{pane_pid}").strip())) or HOME_DIR) == d], not on)


def listing():
    g, proj = chosen()
    out = []
    for n in ["default", *names()]:
        out.append({"name": n, **who(n), "all": n == g, "projects": sorted(s for s, v in proj.items() if v == n),
                    "hidden": n in hidden()})
    return out


# ── the popup / 팝업 ──

TEXT, T2, T3 = (230, 233, 239), (154, 163, 178), (98, 106, 120)
ACC, OK, BAD, SEL_BG, BG = (90, 169, 255), (62, 207, 142), (240, 98, 98), (42, 47, 58), (30, 33, 40)


def fg(c): return "\x1b[38;2;%d;%d;%dm" % c
def bg(c): return "\x1b[48;2;%d;%d;%dm" % c
RST, BOLD = "\x1b[0m", "\x1b[1m"


def width(s):
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def label(n):
    return tr("기본 계정", "Default account") if n == "default" else n


def draw(out, rows, sel, here, session, proj, typing, asking, msg, cols, lines, keying=None):
    buf = ["\x1b[H\x1b[2J", bg(BG), "\r\n"]
    head = (tr(f"프로젝트 {session} 에서 사용할 계정을 선택하십시오.", f"Choose the account for project {session}.") if session
            else tr("모든 프로젝트에서 사용할 계정을 선택하십시오.", "Choose the account for all projects."))
    buf.append(f"  {fg(T2)}{head}\r\n\r\n")
    for i, (key, name, sub) in enumerate(rows):
        on = key == here or (key == "fb" and fallback(session))
        mark = "●" if on else ("+" if key in ("+", "+key") else "○")
        mc = OK if on else T3
        extra = f"  {sub}" if sub else ""
        if not session and key in names() + ["default"]:
            ps = [s for s, v in proj.items() if v == key]
            if ps:
                extra += tr(f"  · 프로젝트 {len(ps)}개", f"  · {len(ps)} project(s)")
        raw = f"   {mark} {name}{extra}"
        if i == sel:
            buf.append(f"{bg(SEL_BG)}   {fg(mc)}{mark} {fg(TEXT)}{BOLD}{name}{RST}{bg(SEL_BG)}{fg(T3)}{extra}"
                       + " " * max(0, cols - 2 - width(raw)) + RST + bg(BG) + "\r\n")
        else:
            buf.append(f"{bg(BG)}   {fg(mc)}{mark} {fg(TEXT)}{name}{fg(T3)}{extra}\r\n")
    if keying is not None:
        name, k = keying
        # shown as pasted, so a wrong paste is seen; the middle of a long one is left out
        # 붙여 넣은 대로 보인다. 잘못 붙여 넣은 것이 보이게. 긴 키는 가운데를 줄인다
        k = clean_key(k)
        shown = k if len(k) <= cols - 8 else k[:cols // 2 - 6] + "…" + k[-(cols // 2 - 6):]
        buf.append(f"\r\n  {fg(T2)}{tr(f'{name} 의 API 키 (sk-ant-…, 붙여 넣기)', f'API key for {name} (sk-ant-…, paste)')}:\r\n"
                   f"  {fg(TEXT)}{shown}█  {fg(T3)}{tr(f'{len(k)}자', f'{len(k)} chars')}\r\n")
    elif typing is not None:
        buf.append(f"\r\n  {fg(T2)}{tr('계정 이름 (영문, 숫자, . _ -)', 'Account name (letters, digits, . _ -)')}: {fg(TEXT)}{typing}█\r\n")
    buf.append(f"\x1b[{lines - 1};1H{fg((44, 48, 57))}  " + "─" * (cols - 4) + "\r\n")
    if msg:
        hint = msg
    elif isinstance(asking, tuple):     # (account, Claudes it restarts, their projects) / (계정, 다시 시작할 Claude 수, 그 프로젝트)
        _, n, ps = asking
        where = ", ".join(ps[:3]) + (tr(f" 외 {len(ps) - 3}개", f" and {len(ps) - 3} more") if len(ps) > 3 else "")
        hint = (f"{fg(ACC)}{tr(f'Claude {n}개({where})가 같은 대화로 다시 시작됩니다. 바꾸시겠습니까?', f'{n} Claude(s) ({where}) restart in the same conversation. Switch?')}"
                f"  {fg(TEXT)}y{fg(T3)} / n")
    elif asking:
        hint = f"{fg(BAD)}{tr(f'{asking} 계정에서 로그아웃하고 삭제하시겠습니까?', f'Log out of {asking} and remove it?')}  {fg(TEXT)}y{fg(T3)} / n"
    elif keying is not None or typing is not None:
        what = tr("추가", "add") if keying is not None else tr("다음", "next") if adding_key else tr("로그인", "log in")
        hint = f"{fg(TEXT)}Enter{fg(T3)} {what}   {fg(TEXT)}Esc{fg(T3)} {tr('취소', 'cancel')}"
    elif rows[sel][0] == "fb":
        hint = (f"{fg(TEXT)}Enter{fg(T3)} {tr('바꾸기 (끔 → API 키 계정)', 'change (off → API key accounts)')}   "
                f"{fg(TEXT)}Esc{fg(T3)} {tr('닫기', 'close')}")
    else:
        hint = (f"{fg(TEXT)}Enter{fg(T3)} {tr('사용', 'use')}   {fg(TEXT)}d{fg(T3)} {tr('삭제', 'remove')}   "
                f"{fg(TEXT)}Esc{fg(T3)} {tr('닫기', 'close')}")
    buf.append("  " + hint + RST)
    out.write("".join(buf))
    out.flush()


adding_key = False     # the name typed is for an API key account / 입력하는 이름이 API 키 계정의 것


def ui(session):
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    out = sys.stdout
    global adding_key
    sel, msg, typing, asking, keys, keying = None, "", None, None, [], None
    try:
        while True:
            # TCSANOW: the default flushes the input not read yet, and a pasted key lost all past its first 64 bytes
            # TCSANOW: 기본값은 아직 읽지 않은 입력을 버려, 붙여 넣은 키가 처음 64바이트 뒤로 모두 사라졌다
            tty.setraw(fd, termios.TCSANOW)
            g, proj = chosen()
            here = proj.get(session, "all") if session else g
            rows = ([("all", tr(f"모든 프로젝트 설정을 따릅니다 (지금: {label(g)})", f"Same as all projects (now: {label(g)})"), "")]
                    if session else [])
            for a in ["default", *names()]:
                w = who(a)
                rows.append((a, label(a), w.get("email") or tr("로그인되어 있지 않습니다", "Not logged in")))
            rows.append(("+", tr("계정 추가…", "Add account…"), ""))
            rows.append(("+key", tr("API 키 계정 추가…", "Add API key account…"), ""))
            # the account Claudes go on with at a usage limit: for all projects, or this project's own
            # 사용 한도에서 이어 갈 계정: 모든 프로젝트의 것, 또는 이 프로젝트만의 것
            fg_, fproj = fallbacks()
            if session and session not in fproj:
                fsub = tr(f"모든 프로젝트 설정을 따릅니다 (지금: {label(fallback()) if fallback() else '끔'})",
                          f"Same as all projects (now: {label(fallback()) if fallback() else 'off'})")
            else:
                fsub = label(fallback(session)) if fallback(session) else tr("끔", "off")
            rows.append(("fb", tr("사용 한도에 걸리면 이어 갈 계정", "At a usage limit, go on with"), fsub))
            if sel is None:
                sel = next((i for i, r in enumerate(rows) if r[0] == here), 0)
            sel = max(0, min(sel, len(rows) - 1))
            cols, lines = os.get_terminal_size()
            if not keys:
                draw(out, rows, sel, here, session, proj, typing, asking, msg, cols, lines, keying)
                msg = ""
                # keys one by one: several can come in one read / 키를 하나씩: 한 번에 여러 개가 올 수 있다
                keys = re.findall(r"\x1b\[[0-9;]*[A-Za-z~]|\x1bO[A-Z]|[\s\S]", os.read(fd, 64).decode(errors="ignore"))
            ch = keys.pop(0)
            if isinstance(asking, tuple):
                key, asking = asking[0], None
                if ch in ("y", "Y", "\r", "\n"):
                    switched(out, use(key, session), lines)
                    return
                continue
            if asking:
                if ch in ("y", "Y"):
                    n = remove(asking)
                    msg = f"{fg(OK)}{tr(f'{asking} 계정을 삭제했습니다.', f'Removed {asking}.')}" + (
                        tr(f" Claude {n}개를 다시 시작합니다.", f" Restarting {n} Claude(s).") if n else "")
                asking = None
                continue
            if keying is not None:
                name, k = keying
                if ch in ("\x1b", "\x03"):
                    keying = None
                elif ch in ("\x7f", "\b"):
                    keying = (name, k[:-1])
                elif ch in ("\r", "\n"):
                    k = clean_key(k)
                    if not k:
                        continue
                    if not k.startswith("sk-ant-"):
                        msg = f"{fg(BAD)}{tr('sk-ant- 로 시작하는 API 키가 아닙니다.', 'That is not an API key (sk-ant-…).')}"
                        continue
                    draw(out, rows, sel, here, session, proj, None, None,
                         f"{fg(T2)}{tr('키를 확인하는 중입니다…', 'Checking the key…')}", cols, lines, keying)
                    why = check_key(k)
                    if why:
                        msg = f"{fg(BAD)}{tr(f'키를 확인하지 못했습니다: {why}', f'Could not check the key: {why}')}"
                        continue
                    keying = None
                    add_key(name, k)
                    # the first one is what an API key account is added for here / 첫 API 키 계정은 이어 가려고 더하는 것이다
                    first = not fallback(session)
                    if first:
                        set_fallback(name, session)
                    msg = f"{fg(OK)}" + (tr(f"{name} 계정을 추가했습니다. 사용 한도에 걸리면 이 계정으로 이어 갑니다.",
                                            f"Added {name}. At a usage limit, Claudes go on with it.") if first else
                                         tr(f"{name} 계정을 추가했습니다.", f"Added {name}."))
                elif len(ch) == 1 and ch.isprintable():      # not the paste brackets / 붙여 넣기 괄호는 뺀다
                    keying = (name, (k + ch)[:300])
                continue
            if typing is not None:
                if ch in ("\x1b", "\x03"):
                    typing = None
                elif ch in ("\x7f", "\b"):
                    typing = typing[:-1]
                elif ch in ("\r", "\n"):
                    name = typing.strip()
                    if not NAME_RE.match(name) or name in ("default", "all") or name in names():
                        msg = f"{fg(BAD)}{tr('사용할 수 없는 이름입니다.', 'That name cannot be used.')}"
                        continue
                    typing = None
                    if adding_key:
                        keying = (name, "")
                        continue
                    termios.tcsetattr(fd, termios.TCSADRAIN, old)
                    out.write(RST + "\x1b[H\x1b[2J")
                    out.flush()
                    if login(name):
                        msg = f"{fg(OK)}{tr(f'{name} 계정을 추가했습니다. Enter 를 누르면 사용합니다.', f'Added {name}. Press Enter to use it.')}"
                        sel = ["default", *names()].index(name) + (1 if session else 0)
                    else:
                        shutil.rmtree(config_dir(name), ignore_errors=True)
                        msg = f"{fg(BAD)}{tr('로그인하지 못했습니다.', 'Login did not finish.')}"
                elif ch.isprintable():
                    typing = (typing + ch)[:32]
                continue
            if ch in ("\x1b", "\x03", "q"):
                return
            if ch in ("\x1b[A", "\x10", "\x1bOA", "k"):
                sel -= 1
            elif ch in ("\x1b[B", "\x0e", "\x1bOB", "j"):
                sel += 1
            elif ch == "d" and rows[sel][0] in names():
                asking = rows[sel][0]
            elif ch in ("\r", "\n"):
                key = rows[sel][0]
                if key in ("+", "+key"):
                    typing, adding_key = ("api" if key == "+key" and "api" not in names() else ""), key == "+key"
                    continue
                if key == "fb":
                    apis = [n for n in names() if api_key(n)]
                    if not apis:
                        msg = f"{fg(BAD)}{tr('먼저 API 키 계정을 추가하십시오.', 'Add an API key account first.')}"
                        continue
                    # all projects: off → each API key account; a project: as for all → off → each
                    # 모든 프로젝트: 끔 → API 키 계정들. 프로젝트: 모든 프로젝트 설정 → 끔 → API 키 계정들
                    fg_, fproj = fallbacks()
                    opts = (["all", "off"] if session else ["off"]) + apis
                    cur = (fproj.get(session, "all") if session else (fg_ if fg_ in apis else "off"))
                    nxt = opts[(opts.index(cur) + 1) % len(opts)] if cur in opts else opts[0]
                    set_fallback(nxt, session)
                    msg = f"{fg(OK)}" + (tr("모든 프로젝트 설정을 따릅니다.", "Same as all projects.") if nxt == "all" else
                                         tr("사용 한도에 걸려도 다른 계정으로 넘어가지 않습니다.", "A usage limit no longer moves Claudes.")
                                         if nxt == "off" else
                                         tr(f"사용 한도에 걸리면 {nxt} 로 이어 갑니다.", f"At a usage limit, Claudes go on with {nxt}."))
                    env()
                    continue
                if key != "all" and not who(key):      # not logged in yet: log in first / 아직 로그인 전: 먼저 로그인
                    termios.tcsetattr(fd, termios.TCSADRAIN, old)
                    out.write(RST + "\x1b[H\x1b[2J")
                    out.flush()
                    if not login(key):
                        msg = f"{fg(BAD)}{tr('로그인하지 못했습니다.', 'Login did not finish.')}"
                        continue
                # first say how many Claudes restart: switching all projects restarted every one of them
                # 먼저 몇 개가 다시 시작되는지 묻는다: 모든 프로젝트를 바꾸면 전부 다시 시작했다
                moved = movers(*choice(key, session))
                if moved:
                    asking = (key, len(moved), sorted({s for _, s in moved}))
                    continue
                switched(out, use(key, session), lines)
                return
    finally:
        out.write(RST + "\x1b[2J")
        out.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def switched(out, n, lines):
    out.write(f"\x1b[{lines};1H\x1b[2K  {fg(OK)}" + (
        tr(f"✓ 바꿨습니다. Claude {n}개를 같은 대화로 다시 시작합니다 (일하는 중이면 끝난 뒤).",
           f"✓ Switched. Restarting {n} Claude(s) in the same conversation (busy ones once done).") if n
        else tr("✓ 바꿨습니다.", "✓ Switched.")) + RST)
    out.flush()
    time.sleep(1.6)


def popup(client, session):
    pause = f"/tmp/hivemux-pause-{os.getuid()}-{tmux('display', '-p', '#{pid}').strip()}"   # per tmux server / tmux 서버마다
    open(pause, "w").close()
    try:
        title = tr("계정", "Account") if not session else tr(f"{session} 의 계정", f"Account for {session}")
        cmd = shlex.join([os.path.realpath(__file__), "--ui"] + ([session] if session else []))
        subprocess.run([os.path.join(HERE, "hivemux-modal"), client, "-E", "-w", "78", "-h", "20", "-b", "rounded",
                        "-T", f"#[fg=#e6e9ef,bold] {title} ", "-S", "fg=#5aa9ff", "-s", "bg=#1e2128", cmd],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    finally:
        try:
            os.unlink(pause)
        except OSError:
            pass


def main(argv):
    session = None
    if "-s" in argv:
        i = argv.index("-s")
        session = argv[i + 1] if i + 1 < len(argv) else None
        argv = argv[:i] + argv[i + 2:]
    cmd = argv[0] if argv else "list"
    if cmd == "list":
        rows = listing()
        if "--json" in argv:
            print(json.dumps(rows, ensure_ascii=False))
            return
        for r in rows:
            print(("* " if r["all"] else "  ") + r["name"].ljust(16) + (r.get("email") or tr("(로그인 안 됨)", "(not logged in)"))
                  + (f"   [{', '.join(r['projects'])}]" if r["projects"] else "")
                  + (tr("   (앱에 숨김)", "   (hidden from the app)") if r["hidden"] else "")
                  + (tr("   (한도 시 이어 감)", "   (goes on at a limit)") if r["name"] == fallback() else ""))
        for p_, n in sorted(fallbacks()[1].items()):
            print(tr(f"  프로젝트 {p_}: 한도 시 {'넘어가지 않음' if n == 'off' else n + ' 로 이어 감'}",
                     f"  project {p_}: at a limit {'stays' if n == 'off' else 'goes on with ' + n}"))
        for a, u in sorted(limited().items()):
            print(tr(f"  {a} 는 사용 한도에 걸려 {time.strftime('%m-%d %H:%M', time.localtime(u))} 까지 {fallback() or '-'} 로 돕니다",
                     f"  {a} is at its usage limit: on {fallback() or '-'} until {time.strftime('%m-%d %H:%M', time.localtime(u))}"))
    elif cmd == "add" and len(argv) > 1:
        name = argv[1]
        if not NAME_RE.match(name) or name in ("default", "all"):
            raise SystemExit(tr("사용할 수 없는 이름입니다.", "That name cannot be used."))
        if not login(name):
            shutil.rmtree(config_dir(name), ignore_errors=True)
            raise SystemExit(tr("로그인하지 못했습니다.", "Login did not finish."))
        env()
        print(tr(f"{name} 계정을 추가했습니다: hivemux account use {name}", f"Added {name}: hivemux account use {name}"))
    elif cmd == "add-key" and len(argv) > 1:
        name = argv[1]
        if not NAME_RE.match(name) or name in ("default", "all") or (name in names() and not api_key(name)):
            raise SystemExit(tr("사용할 수 없는 이름입니다.", "That name cannot be used."))
        key = (getpass.getpass(tr("API 키 (sk-ant-…, 화면에 보이지 않습니다): ", "API key (sk-ant-…, not shown): "))
               if sys.stdin.isatty() else sys.stdin.readline())
        key = clean_key(key)
        if not key.startswith("sk-ant-"):
            raise SystemExit(tr("sk-ant- 로 시작하는 API 키가 아닙니다.", "That is not an API key (sk-ant-…)."))
        why = check_key(key)
        if why:
            raise SystemExit(tr(f"키를 확인하지 못했습니다: {why}", f"Could not check the key: {why}"))
        add_key(name, key)
        print(tr(f"{name} 계정을 추가했습니다 (API 키). 한도에 걸리면 이어 가게 하려면: hivemux account fallback {name}",
                 f"Added {name} (API key). To go on with it at a usage limit: hivemux account fallback {name}"))
    elif cmd == "fallback" and len(argv) > 1:
        where = tr(f"프로젝트 {session}: ", f"Project {session}: ") if session else ""
        if argv[1] == "all" and session:
            set_fallback("all", session)
            print(where + tr("모든 프로젝트 설정을 따릅니다.", "same as all projects."))
        elif argv[1] == "off":
            set_fallback("off", session)
            print(where + tr("사용 한도에 걸려도 다른 계정으로 넘어가지 않습니다.", "A usage limit no longer moves Claudes to another account."))
        elif api_key(argv[1]):
            set_fallback(argv[1], session)
            print(where + tr(f"구독이 사용 한도에 걸리면 그 Claude 들을 {argv[1]} (API 키) 로 같은 대화에서 이어 갑니다. 한도가 풀리면 되돌립니다.",
                     f"At a subscription's usage limit its Claudes go on with {argv[1]} (API key) in the same conversation, and come back when it resets."))
        else:
            raise SystemExit(tr(f"{argv[1]} 는 API 키 계정이 아닙니다: hivemux account add-key {argv[1]}",
                                f"{argv[1]} is not an API key account: hivemux account add-key {argv[1]}"))
        env()
    elif cmd == "limit" and len(argv) > 1:        # the StopFailure hook / StopFailure 훅
        at_limit(argv[1], argv[2] if len(argv) > 2 else "", argv[3] if len(argv) > 3 else "",
                 argv[4] if len(argv) > 4 else "rate_limit")
    elif cmd == "go-on" and len(argv) > 1:        # the SessionStart hook / SessionStart 훅
        go_on(argv[1])
    elif cmd == "watch-limits":
        watch_loop()
    elif cmd == "use" and len(argv) > 1:
        n = use(argv[1], session)
        if n:
            print(tr(f"Claude {n}개를 같은 대화로 다시 시작합니다 (일하는 중이면 끝난 뒤).",
                     f"Restarting {n} Claude(s) in the same conversation (busy ones once done)."))
    elif cmd == "remove" and len(argv) > 1:
        remove(argv[1])
    elif cmd == "hide" and (session or (len(argv) > 1 and argv[1] not in ("on", "off") and (argv[1] != "--pane" or len(argv) > 2))):
        on = argv[-1] != "off"
        if session:
            what, n = tr(f"{session} 프로젝트의 Claude 를", f"{session}:"), hide_project(session, on)
        elif argv[1] == "--pane" and len(argv) > 2:
            what, n = tr("이 Claude 를", "This Claude:"), hide_pane(argv[2], on)
        else:
            what, n = tr(f"{argv[1]} 계정의 Claude 를", f"{argv[1]}:"), hide(argv[1], on)
        print(what + " " + tr("Claude 앱과 claude.ai 에 보이지 않게 했습니다." if on else "다시 Claude 앱에 보이게 했습니다.",
                              "kept out of the Claude app and claude.ai." if on else "shown in the Claude app again.")
              + ((tr(f" 도는 Claude {n}개의 Remote Control 을 끊습니다 (일하는 중이면 끝난 뒤).", f" Disconnecting Remote Control of {n} running Claude(s) (busy ones once done).") if on else
                  tr(f" 도는 Claude {n}개를 Remote Control 에 다시 연결합니다.", f" Connecting {n} running Claude(s) to Remote Control again.")) if n else ""))
    elif cmd == "current":
        print(resolve(session) if session else chosen()[0])
    elif cmd == "env":
        env()
    elif cmd == "--popup" and len(argv) > 1:
        popup(argv[1], session)
    elif cmd == "--ui":
        ui(argv[1] if len(argv) > 1 else None)
    else:
        print(__doc__.split("\n\n")[1])
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
