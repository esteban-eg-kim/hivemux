#!/bin/bash
# 칸 경계선 끌기 피드백 (tmux 마우스 바인딩에서 호출).
#   claude-border down <client_tty>              포인터를 좌우 크기 조절 모양으로, 경계선 강조
#   claude-border up   <client_tty> <window_id>  포인터/경계선 되돌리기, 사이드바 폭 저장 후 모든 창에 맞춤
# 포인터 모양은 Ghostty 에 OSC 22 를 직접 보낸다 (tmux 는 이 신호를 넘기지 않음).
R="$(cd "$(dirname "$0")/.." && pwd)"
TMUX_BIN="$(command -v tmux || echo /opt/homebrew/bin/tmux)"
t() { "$TMUX_BIN" "$@"; }
tty="$2"
shape() { [ -w "$tty" ] && printf '\033]22;%s\033\\' "$1" > "$tty"; }
GRIP="/tmp/claude-sidebar-grip-$(id -u)"
# 사이드바 핸들 색 바로 갱신: 이 tmux 서버의 사이드바 프로세스에만 신호를 보낸다
wake() {
  t list-panes -a -F '#{pane_pid} #{pane_title}' 2>/dev/null | awk '$2=="claude-sidebar"{print $1}' |
    while read -r p; do kill -USR1 "$p" 2>/dev/null; done
}
case "$1" in
  down)
    shape ew-resize
    : > "$GRIP"; wake
    t set -g pane-border-style "fg=#5aa9ff"; t set -g pane-active-border-style "fg=#5aa9ff" ;;
  up)
    shape default
    rm -f "$GRIP"; wake
    t set -g pane-border-style "fg=#23262e"; t set -g pane-active-border-style "fg=#2c3039"
    w="$(t list-panes -t "$3" -F '#{pane_title} #{pane_width}' 2>/dev/null | awk '$1=="claude-sidebar"{print $2; exit}')"
    if [ -n "$w" ] && [ "$w" != "$(t show -gqv @sidebar-width)" ] && [ "$w" -ge 16 ]; then
      t set -g @sidebar-width "$w"
      d="${XDG_DATA_HOME:-$HOME/.local/share}/tmux"; mkdir -p "$d"; echo "$w" > "$d/claude-sidebar-width"
      "$R/bin/claude-sidebar" fix
      t display -d 1200 "사이드바 폭 $w 칸"
    fi ;;
esac
exit 0
