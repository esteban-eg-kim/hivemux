# ~/.config/ghostty/config -> /Users/esteban/project/claude/tools/ghostty-tumx/ghostty/config

# Every Ghostty window/tab attaches to tmux (state lives in tmux, not here)
command = /Users/esteban/project/claude/tools/ghostty-tumx/bin/tmx
window-save-state = always
confirm-close-surface = false

# Claude Code: Option-key shortcuts (Option+Enter, Option+P ...)
macos-option-as-alt = true
desktop-notifications = true

# Large scrollback is handled by tmux; keep Ghostty light
scrollback-limit = 10000000

# Font
font-family = "D2Coding"
font-size = 15